{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  {%- assign gift_card_value = gift_card.initial_value | money_without_trailing_zeros -%}
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card_value, shop: shop.name }}</title>
  <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-gift-card color-scheme-paper">
  <main class="page-width page-width--text section" id="MainContent" style="--section-pt: var(--section-padding); --section-pb: var(--section-padding)">
    <header class="text-center stack">
      <a href="{{ shop.url }}" class="h4 link--plain">{{ shop.name }}</a>
      <h1 class="h2">{{ 'gift_cards.issued.subtext' | t }}</h1>
      <p class="h1">{{ gift_card.initial_value | money_without_trailing_zeros }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="badge badge--sold-out">{{ 'gift_cards.issued.expired' | t }}</p>{%- endif -%}
    </header>
    <div class="stack stack--lg text-center" style="margin-top: var(--space-10)">
      <div class="media" style="--aspect: 16/9; max-width: 480px; margin-inline: auto">{{ 'gift-card/card.svg' | shopify_asset_url | image_tag: alt: '' }}</div>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:flex;justify-content:center"></div>
      <p class="text-muted">{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
      <p><input type="text" class="field__input text-center h3" readonly value="{{ gift_card.code | format_code }}" aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}" style="max-width: 360px; margin-inline: auto"></p>
      {%- if gift_card.expires_on -%}<p class="text-caption">{{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card.expires_on | date: '%B %d, %Y' }}</p>{%- endif -%}
      <div class="flex flex-wrap gap-4" style="justify-content:center">
        <a class="button" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button class="button button--secondary" type="button" onclick="window.print()">Print</button>
      </div>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}" class="link">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>{%- endif -%}
    </div>
  </main>
  <script>document.addEventListener('DOMContentLoaded', function () { var el = document.getElementById('QrCode'); if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 }); });</script>
</body>
</html>
