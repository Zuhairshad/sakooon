{%- comment -%} Mega menu feature cards from a header "item" block. Param: b {%- endcomment -%}
{%- liquid
  assign bs = b.settings
  assign n = 0
  if bs.f1_title != blank or bs.f1_image != blank
    assign n = n | plus: 1
  endif
  if bs.f2_title != blank or bs.f2_image != blank
    assign n = n | plus: 1
  endif
-%}
{%- if n > 0 -%}
<div class="snh__feats" style="--n: {{ n }};">
  {%- if bs.f1_title != blank or bs.f1_image != blank -%}
    <a class="snh__feat" href="{{ bs.f1_link | default: bs.url | default: '#' }}" style="--i: 0;">
      {% render 'sn-media', image: bs.f1_image, art: bs.f1_art, width: 800, sizes: '30vw' %}
      <span class="snh__feat-t">{%- if bs.f1_kicker != blank -%}<small>{{ bs.f1_kicker }}</small>{%- endif -%}<b>{{ bs.f1_title }}</b>{%- if bs.f1_cta != blank -%}<em>{{ bs.f1_cta }} →</em>{%- endif -%}</span>
    </a>
  {%- endif -%}
  {%- if bs.f2_title != blank or bs.f2_image != blank -%}
    <a class="snh__feat" href="{{ bs.f2_link | default: bs.url | default: '#' }}" style="--i: 1;">
      {% render 'sn-media', image: bs.f2_image, art: bs.f2_art, width: 800, sizes: '30vw' %}
      <span class="snh__feat-t">{%- if bs.f2_kicker != blank -%}<small>{{ bs.f2_kicker }}</small>{%- endif -%}<b>{{ bs.f2_title }}</b>{%- if bs.f2_cta != blank -%}<em>{{ bs.f2_cta }} →</em>{%- endif -%}</span>
    </a>
  {%- endif -%}
</div>
{%- endif -%}
