{%- comment -%} Standard section header. See docs/component-contracts.md section 7. {%- endcomment -%}
{%- liquid
  assign heading_tag = heading_tag | default: 'h2'
  assign heading_size = heading_size | default: 'h2'
  assign align = align | default: 'left'
-%}
{%- if eyebrow != blank or heading != blank or text != blank or link_label != blank -%}
<header class="section-heading section-heading--{{ align }}">
  <div class="section-heading__text">
    {%- if eyebrow != blank -%}<p class="eyebrow section-heading__eyebrow">{{ eyebrow }}</p>{%- endif -%}
    {%- if heading != blank -%}<{{ heading_tag }} class="section-heading__title {{ heading_size }}">{{ heading }}</{{ heading_tag }}>{%- endif -%}
    {%- if text != blank -%}<div class="section-heading__body rte measure">{{ text }}</div>{%- endif -%}
  </div>
  {%- if link_label != blank and link_url != blank -%}
    <a class="section-heading__link link link--arrow" href="{{ link_url }}">{{ link_label }}{% render 'icon', icon: 'arrow-right', size: 16 %}</a>
  {%- endif -%}
</header>
{%- endif -%}
