{%- comment -%} Visual breadcrumbs (JSON-LD lives in structured-data.liquid). {% render 'breadcrumbs' %} {%- endcomment -%}
{%- unless request.page_type == 'index' or request.page_type == 'cart' -%}
<nav class="breadcrumbs text-small" aria-label="{{ 'general.breadcrumbs.label' | t }}">
  <ol class="breadcrumbs__list list-unstyled">
    <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
    {%- case request.page_type -%}
      {%- when 'product' -%}
        {%- if collection -%}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{%- endif -%}
        <li aria-current="page">{{ product.title }}</li>
      {%- when 'collection' -%}
        <li aria-current="page">{{ collection.title }}</li>
      {%- when 'page' -%}
        <li aria-current="page">{{ page.title }}</li>
      {%- when 'blog' -%}
        <li aria-current="page">{{ blog.title }}</li>
      {%- when 'article' -%}
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li aria-current="page">{{ article.title }}</li>
      {%- when 'search' -%}
        <li aria-current="page">{{ 'templates.search.title' | t }}</li>
      {%- else -%}
        <li aria-current="page">{{ page_title }}</li>
    {%- endcase -%}
  </ol>
</nav>
{%- endunless -%}
