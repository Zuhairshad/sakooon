{%- comment -%}
  Variant picker for [data-sn-product]. Params: product, style ('pills' | 'select'), swatches (bool), uid (unique id), size_link (optional label), size_target (overlay id)
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  {%- assign cv = product.selected_or_first_available_variant -%}
  <div class="sn-pick">
    {%- for option in product.options_with_values -%}
      {%- assign oi = forloop.index0 -%}
      {%- assign oname = option.name | downcase -%}
      {%- assign is_col = false -%}
      {%- if swatches and oname contains 'colo' -%}{%- assign is_col = true -%}{%- endif -%}
      <fieldset class="sn-pick__opt{% if is_col %} is-col{% endif %}">
        <legend class="sn-pick__lg"><span>{{ option.name }}:</span> <b data-sn-optv="{{ oi }}">{{ cv.options[oi] }}</b>
          {%- if size_link != blank and oname contains 'size' -%}<button type="button" class="sn-pick__guide" data-sn-open="{{ size_target }}">{% render 'sn-icon', name: 'ruler', class: 'icon' %}{{ size_link }}</button>{%- endif -%}
        </legend>
        {%- if style == 'select' and is_col == false -%}
          <div class="sn-pick__sel"><select class="sn-select" data-sn-opt-sel="{{ oi }}" aria-label="{{ option.name | escape }}">
            {%- for value in option.values -%}<option value="{{ value | escape }}"{% if cv.options[oi] == value %} selected{% endif %}>{{ value }}</option>{%- endfor -%}
          </select></div>
        {%- else -%}
          <div class="sn-pick__vals">
            {%- for value in option.values -%}
              {%- assign vid = uid | append: '-' | append: oi | append: '-' | append: forloop.index0 -%}
              {%- liquid
                assign css = ''
                if is_col
                  if value.swatch.color
                    assign css = value.swatch.color
                  elsif value.swatch.image
                    assign css = value.swatch.image | image_url: width: 80 | prepend: 'url(' | append: ') center/cover'
                  else
                    capture css
                      render 'sn-color', name: value
                    endcapture
                    assign css = css | strip
                  endif
                endif
              -%}
              <input class="sr" type="radio" id="{{ vid }}" name="{{ uid }}-o{{ oi }}" value="{{ value | escape }}" data-sn-opt-i="{{ oi }}"{% if cv.options[oi] == value %} checked{% endif %}>
              {%- if is_col -%}
                <label for="{{ vid }}" class="sn-pick__sw" title="{{ value | escape }}" style="--sw: {% if css != '' %}{{ css }}{% else %}#ddd{% endif %};"><i></i><span class="sr">{{ value }}</span></label>
              {%- else -%}
                <label for="{{ vid }}" class="sn-pick__pill">{{ value }}</label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </div>
{%- endunless -%}
