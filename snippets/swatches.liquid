{%- comment -%}
  Colour swatches for a product. Owner: shad-d8. Decision D10 / docs/metafield-contracts.md.
  Source order: the product's colour option (names in settings.swatch_option_names), else sakooon.siblings.
  Colour order per swatch:
    option value: native value.swatch (image/color) -> variant sakooon.swatch_color (+ swatch_color_secondary: split chip)
                  -> the value's variant image (zoomed crop) -> text chip
    sibling:      sakooon.swatch_color -> sakooon.swatch_image -> featured image
  Each swatch is a link (variant URL, or the sibling product URL), so it works without JS.

  {% render 'swatches', product: card_product, limit: 3, size: 'sm' %}
  Params: product (required), limit (default 0 = all; the rest collapse into "+N"), size ('sm' card | 'md' PDP),
          current_url (url of the product being shown; marks the selected sibling), class.
{%- endcomment -%}
{%- liquid
  assign limit = limit | default: 0
  assign size = size | default: 'sm'

  assign colour_names = settings.swatch_option_names | default: 'Color, Colour' | downcase | split: ','
  assign colour_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for name in colour_names
      assign wanted = name | strip
      if option_name == wanted
        assign colour_option = option
        break
      endif
    endfor
    if colour_option
      break
    endif
  endfor

  # The selected chip matches the image the card shows: the value whose variant image is the product's featured image
  # (the two-tone set's first image is Forest Green while its first variant is Grey / White). Else the selected value.
  assign featured_value = nil
  if colour_option and product.featured_image != blank
    assign featured_src = product.featured_image.src | split: '?' | first
    assign colour_idx = colour_option.position | minus: 1
    for v in product.variants
      assign v_src = v.featured_image.src | split: '?' | first
      if v_src == featured_src
        assign featured_value = v.options[colour_idx]
        break
      endif
    endfor
  endif

  assign siblings = product.metafields.sakooon.siblings.value
  if colour_option
    assign total = colour_option.values.size
  elsif siblings != blank
    assign total = siblings.count | default: siblings.size
    assign self_listed = false
    for sibling in siblings
      if sibling.id == product.id
        assign self_listed = true
      endif
    endfor
    unless self_listed
      assign total = total | plus: 1
    endunless
  else
    assign total = 0
  endif

  if limit > 0 and total > limit
    assign shown = limit
    assign more = total | minus: limit
  else
    assign shown = total
    assign more = 0
  endif

-%}
{%- if total > 0 -%}
  <ul class="swatches swatches--{{ size }}{% if class %} {{ class }}{% endif %}" role="list">
    {%- if colour_option -%}
      {%- liquid
        # Featured value first so the selected chip is always among the visible ones, then the rest in option order.
        assign ordered = ''
        if featured_value != nil
          assign ordered = featured_value
        endif
        for v in colour_option.values
          assign v_name = v.name | default: v
          if v_name != featured_value
            assign ordered = ordered | append: '||' | append: v_name
          endif
        endfor
        assign ordered_names = ordered | remove_first: '||' | split: '||'
        if featured_value != nil
          assign ordered_names = ordered | split: '||'
        endif
      -%}
      {%- for wanted in ordered_names limit: shown -%}
        {%- liquid
          for v in colour_option.values
            assign v_name = v.name | default: v
            if v_name == wanted
              assign value = v
              break
            endif
          endfor
          assign value_name = value.name | default: value
          assign value_url = value.variant.url
          assign value_variant = value.variant
          if value.product_url != blank
            assign value_url = value.product_url
          endif
          if value_variant == blank
            assign idx = colour_option.position | minus: 1
            for v in product.variants
              if v.options[idx] == value_name
                assign value_variant = v
                if v.available
                  break
                endif
              endif
            endfor
          endif
          if value_url == blank
            assign value_url = value_variant.url
          endif
          assign value_url = value_url | default: product.url
          assign is_selected = false
          if featured_value != nil
            if featured_value == value_name
              assign is_selected = true
            endif
          elsif value.selected or colour_option.selected_value == value_name
            assign is_selected = true
          endif
          assign chip_style = ''
          assign chip_class = 'swatch__chip'
          assign chip_colour = value_variant.metafields.sakooon.swatch_color.value
          assign chip_colour_2 = value_variant.metafields.sakooon.swatch_color_secondary.value
          if value.swatch.image
            assign swatch_src = value.swatch.image | image_url: width: 72
            assign chip_style = 'background-image: url(' | append: swatch_src | append: ')'
          elsif value.swatch.color
            assign chip_style = 'background-color: ' | append: value.swatch.color
          elsif chip_colour != blank
            if chip_colour_2 != blank
              assign chip_style = 'background: linear-gradient(135deg, ' | append: chip_colour | append: ' 50%, ' | append: chip_colour_2 | append: ' 50%)'
            else
              assign chip_style = 'background-color: ' | append: chip_colour
            endif
          elsif value_variant.featured_image != blank
            assign swatch_src = value_variant.featured_image | image_url: width: 360
            assign chip_style = 'background-image: url(' | append: swatch_src | append: ')'
            assign chip_class = 'swatch__chip swatch__chip--image'
          else
            assign chip_class = 'swatch__chip swatch__chip--text'
          endif
        -%}
        <li class="swatches__item">
          <a class="swatch{% if is_selected %} is-selected{% endif %}{% if chip_class contains '--text' %} swatch--text{% endif %}" href="{{ value_url }}" title="{{ value_name | escape }}"{% if is_selected %} aria-current="true"{% endif %}>
            <span class="{{ chip_class }}"{% if chip_style != blank %} style="{{ chip_style }}"{% endif %} aria-hidden="true">
              {%- if chip_class contains '--text' -%}{{ value_name }}{%- endif -%}
            </span>
            <span class="visually-hidden">{{ value_name }}</span>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Siblings: the current product first (selected), then the others in metafield order. {%- endcomment -%}
      {%- assign rendered = 0 -%}
      {%- for i in (0..shown) -%}
        {%- liquid
          if i == 0
            assign sibling = product
          else
            assign sibling = nil
            assign seen = 0
            for candidate in siblings
              if candidate.id == product.id
                continue
              endif
              assign seen = seen | plus: 1
              if seen == i
                assign sibling = candidate
                break
              endif
            endfor
          endif
          if sibling == nil or rendered >= shown
            break
          endif
          assign rendered = rendered | plus: 1
          assign chip_style = ''
          assign swatch_color = sibling.metafields.sakooon.swatch_color.value
          assign swatch_image = sibling.metafields.sakooon.swatch_image.value
          if swatch_color != blank
            assign chip_style = 'background-color: ' | append: swatch_color
          elsif swatch_image != blank
            assign swatch_src = swatch_image | image_url: width: 72
            assign chip_style = 'background-image: url(' | append: swatch_src | append: ')'
          elsif sibling.featured_image != blank
            assign swatch_src = sibling.featured_image | image_url: width: 72
            assign chip_style = 'background-image: url(' | append: swatch_src | append: ')'
          endif
        -%}
        <li class="swatches__item">
          <a class="swatch{% if i == 0 %} is-selected{% endif %}" href="{{ sibling.url }}" title="{{ sibling.title | escape }}"{% if i == 0 %} aria-current="true"{% endif %}>
            <span class="swatch__chip"{% if chip_style != blank %} style="{{ chip_style }}"{% endif %} aria-hidden="true"></span>
            <span class="visually-hidden">{{ sibling.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    {%- endif -%}
    {%- if more > 0 -%}
      <li class="swatches__item swatches__more">
        <a href="{{ product.url }}" class="swatches__more-link">
          <span aria-hidden="true">+{{ more }}</span>
          <span class="visually-hidden">{{ 'products.product.more_colours' | t: count: more }}</span>
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
