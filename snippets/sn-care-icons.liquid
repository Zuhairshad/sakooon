{%- comment -%} Laundry care symbols row (product page care tab). {%- endcomment -%}
<ul class="sk-care" aria-label="Care instructions">
  <li><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 12l3 20h24l3-20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 16c3 2 5 2 7 0s4-2 7 0 5 2 7 0 4-2 6 0" fill="none" stroke="currentColor" stroke-width="1.4"/><text x="20" y="28.5" text-anchor="middle" font-size="8.5" font-family="sans-serif" fill="currentColor">40°</text></svg><span>Machine wash 30–40°C</span></li>
  <li><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 8 34 32H6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 9l22 24M31 9 9 33" stroke="currentColor" stroke-width="1.4"/></svg><span>Do not bleach</span></li>
  <li><svg viewBox="0 0 40 40" aria-hidden="true"><rect x="7" y="7" width="26" height="26" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="20" cy="20" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="20" cy="20" r="1.6" fill="currentColor"/></svg><span>Tumble dry low</span></li>
  <li><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M6 29h28v-5a9 9 0 0 0-9-9H13M6 29l3-10h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="17" cy="24" r="1.4" fill="currentColor"/><circle cx="23" cy="24" r="1.4" fill="currentColor"/></svg><span>Iron medium heat</span></li>
  <li><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="12" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 10l20 20M30 10 10 30" stroke="currentColor" stroke-width="1.4"/></svg><span>Do not dry clean</span></li>
</ul>
<style>
  .sk-care { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 12px; margin: 0 0 18px; padding: 0; list-style: none; }
  .sk-care li { display: grid; justify-items: center; gap: 8px; padding: 14px 8px; border-radius: 12px; border: 1px solid color-mix(in srgb, currentColor 14%, transparent); text-align: center; font-size: 12px; line-height: 1.35; }
  .sk-care svg { width: 34px; height: 34px; color: var(--color-accent); }
</style>
