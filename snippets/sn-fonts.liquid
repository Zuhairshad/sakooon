{%- comment -%} Self-hosted fonts. "Heading size" (Theme settings > Typography) scales headings through size-adjust. {%- endcomment -%}
{%- assign hs = settings.head_scale | default: 100 -%}
<style>
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-300.woff2' | asset_url }}') format('woff2'); font-weight: 100 300; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-500.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-600.woff2' | asset_url }}') format('woff2'); font-weight: 600 900; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-300-i.woff2' | asset_url }}') format('woff2'); font-weight: 100 300; font-style: italic; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-400-i.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-500-i.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: italic; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Fraunces'; src: url('{{ 'sn-fraunces-600-i.woff2' | asset_url }}') format('woff2'); font-weight: 600 900; font-style: italic; font-display: swap; size-adjust: {{ hs }}%; }
  @font-face { font-family: 'SN Cormorant'; src: url('{{ 'sn-cormorant-500.woff2' | asset_url }}') format('woff2'); font-weight: 100 500; font-display: swap; size-adjust: {{ hs | plus: 12 }}%; }
  @font-face { font-family: 'SN Cormorant'; src: url('{{ 'sn-cormorant-600.woff2' | asset_url }}') format('woff2'); font-weight: 600 900; font-display: swap; size-adjust: {{ hs | plus: 12 }}%; }
  @font-face { font-family: 'SN Cormorant'; src: url('{{ 'sn-cormorant-500i.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-style: italic; font-display: swap; size-adjust: {{ hs | plus: 12 }}%; }
  @font-face { font-family: 'SN Figtree'; src: url('{{ 'sn-figtree-400.woff2' | asset_url }}') format('woff2'); font-weight: 100 400; font-display: swap; }
  @font-face { font-family: 'SN Figtree'; src: url('{{ 'sn-figtree-500.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-display: swap; }
  @font-face { font-family: 'SN Figtree'; src: url('{{ 'sn-figtree-600.woff2' | asset_url }}') format('woff2'); font-weight: 600; font-display: swap; }
  @font-face { font-family: 'SN Figtree'; src: url('{{ 'sn-figtree-700.woff2' | asset_url }}') format('woff2'); font-weight: 700 900; font-display: swap; }
  @font-face { font-family: 'SN Jost'; src: url('{{ 'sn-jost-400.woff2' | asset_url }}') format('woff2'); font-weight: 100 400; font-display: swap; }
  @font-face { font-family: 'SN Jost'; src: url('{{ 'sn-jost-500.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-display: swap; }
  @font-face { font-family: 'SN Jost'; src: url('{{ 'sn-jost-600.woff2' | asset_url }}') format('woff2'); font-weight: 600 900; font-display: swap; }
</style>
{%- case settings.font_head -%}
  {%- when 'cormorant' -%}<link rel="preload" as="font" type="font/woff2" href="{{ 'sn-cormorant-500.woff2' | asset_url }}" crossorigin>
  {%- when 'figtree' -%}
  {%- else -%}<link rel="preload" as="font" type="font/woff2" href="{{ 'sn-fraunces-300.woff2' | asset_url }}" crossorigin>
{%- endcase -%}
<link rel="preload" as="font" type="font/woff2" href="{{ 'sn-figtree-400.woff2' | asset_url }}" crossorigin>
