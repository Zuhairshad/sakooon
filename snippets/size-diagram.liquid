  {%- when 'duvet' -%}
    <figure class="size-diagram size-diagram--duvet"><svg class="size-diagram__svg" viewBox="0 0 420 300" role="img" aria-labelledby="{{ sd_id }}-t {{ sd_id }}-d" focusable="false"><title id="{{ sd_id }}-t">{{ 'editorial.size_diagram.duvet.title' | t }}</title><desc id="{{ sd_id }}-d">{{ 'editorial.size_diagram.duvet.desc' | t }}</desc><rect class="sd-fill-3 sd-line" x="100" y="214" width="220" height="14"/><rect class="sd-fill-2 sd-line" x="100" y="160" width="220" height="54"/><path class="sd-fill-1 sd-line" d="M78 244 V150 Q78 126 102 126 H318 Q342 126 342 150 V244"/><path class="sd-line sd-dashed" d="M88 236 V152 Q88 136 104 136 H316 Q332 136 332 152 V236"/><text class="sd-label sd-muted" x="210" y="192" text-anchor="middle">{{ 'editorial.size_diagram.mattress_label' | t }}</text><g class="sd-callout"><circle cx="360" cy="112" r="10"/><text x="360" y="116.5" text-anchor="middle">1</text></g><text class="sd-label" x="376" y="116" text-anchor="start">{{ 'editorial.size_diagram.cover' | t }}</text><g class="sd-callout"><circle cx="210" cy="112" r="10"/><text x="210" y="116.5" text-anchor="middle">2</text></g><text class="sd-label" x="226" y="116" text-anchor="start">{{ 'editorial.size_diagram.filling' | t }}</text><g class="sd-callout"><circle cx="46" cy="232" r="10"/><text x="46" y="236.5" text-anchor="middle">3</text></g><line class="sd-dim" x1="78" y1="262" x2="100" y2="262"/><line class="sd-dim" x1="78" y1="268" x2="78" y2="256"/><polyline class="sd-dim" points="85.0,265.0 78,262 85.0,259.0"/><line class="sd-dim" x1="100" y1="268" x2="100" y2="256"/><polyline class="sd-dim" points="93.0,265.0 100,262 93.0,259.0"/><line class="sd-dim" x1="320" y1="262" x2="342" y2="262"/><line class="sd-dim" x1="320" y1="268" x2="320" y2="256"/><polyline class="sd-dim" points="327.0,265.0 320,262 327.0,259.0"/><line class="sd-dim" x1="342" y1="268" x2="342" y2="256"/><polyline class="sd-dim" points="335.0,265.0 342,262 335.0,259.0"/><text class="sd-label" x="210" y="282" text-anchor="middle">{{ 'editorial.size_diagram.overhang' | t }}</text></svg></figure>
  {%- when 'pillow' -%}
