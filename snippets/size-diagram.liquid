{%- comment -%}
  Original line-drawing size diagrams (inline SVG, drawn for Sakooon; no third-party artwork). Owner: shad-8b.
  {% render 'size-diagram', type: 'mattress' %}  types: mattress, flat, fitted, duvet, pillow
  {% render 'size-diagram', category: product.type | handle %}  maps bed-sheet-set > flat, duvet-cover-set > duvet,
    duvet > duvet, pillow > pillow; unknown categories render nothing.
  id_prefix: optional, keeps title/desc ids unique when several diagrams share a page (defaults to a per-type id).
  Numbers appear only where verified (the pillow: 20 x 30 in, 48 x 76 cm as the product states); everything else is
  lettered and the table beside the drawing gives the sizes. Strokes and fills use currentColor (see editorial.css).
{%- endcomment -%}
{%- liquid
  assign sd_type = type
  if sd_type == blank
    case category
      when 'bed-sheet-set', 'bed-sheets', 'flat-sheets'
        assign sd_type = 'flat'
      when 'duvet-cover-set', 'duvet-covers', 'duvet', 'duvets'
        assign sd_type = 'duvet'
      when 'pillow', 'pillows'
        assign sd_type = 'pillow'
      when 'fitted-sheet', 'fitted-sheets'
        assign sd_type = 'fitted'
      when 'mattress'
        assign sd_type = 'mattress'
    endcase
  endif
  assign sd_id = id_prefix | default: 'size-diagram' | append: '-' | append: sd_type
-%}
{%- case sd_type -%}
  {%- when 'mattress' -%}
    <figure class="size-diagram size-diagram--mattress"><svg class="size-diagram__svg" viewBox="0 0 420 300" role="img" aria-labelledby="{{ sd_id }}-t {{ sd_id }}-d" focusable="false"><title id="{{ sd_id }}-t">{{ 'editorial.size_diagram.mattress.title' | t }}</title><desc id="{{ sd_id }}-d">{{ 'editorial.size_diagram.mattress.desc' | t }}</desc><polygon class="sd-fill-1 sd-line" points="70,160 290,160 350,105 130,105"/><polygon class="sd-fill-2 sd-line" points="70,160 290,160 290,202 70,202"/><polygon class="sd-fill-3 sd-line" points="290,160 350,105 350,147 290,202"/><rect class="sd-fill-3 sd-line" x="40" y="232" width="34" height="30" rx="6"/><circle class="sd-line" cx="57" cy="247" r="7" fill="none"/><line class="sd-line" x1="74" y1="240" x2="120" y2="240"/><line class="sd-line" x1="80" y1="240" x2="80" y2="244"/><line class="sd-line" x1="88" y1="240" x2="88" y2="244"/><line class="sd-line" x1="96" y1="240" x2="96" y2="244"/><line class="sd-line" x1="104" y1="240" x2="104" y2="244"/><line class="sd-line" x1="112" y1="240" x2="112" y2="244"/><line class="sd-dim" x1="70" y1="224" x2="290" y2="224"/><line class="sd-dim" x1="70" y1="230" x2="70" y2="218"/><polyline class="sd-dim" points="77.0,227.0 70,224 77.0,221.0"/><line class="sd-dim" x1="290" y1="230" x2="290" y2="218"/><polyline class="sd-dim" points="283.0,227.0 290,224 283.0,221.0"/><g class="sd-callout"><circle cx="180" cy="244" r="10"/><text x="180" y="248.5" text-anchor="middle">1</text></g><text class="sd-label" x="196" y="248" text-anchor="start">A&#8202; {{ 'editorial.size_diagram.width' | t }}</text><line class="sd-dim" x1="312" y1="224" x2="372" y2="169"/><line class="sd-dim" x1="316.054" y1="228.423" x2="307.946" y2="219.577"/><polyline class="sd-dim" points="319.2,221.5 312,224 315.1,217.1"/><line class="sd-dim" x1="376.054" y1="173.423" x2="367.946" y2="164.577"/><polyline class="sd-dim" points="368.9,175.9 372,169 364.8,171.5"/><g class="sd-callout"><circle cx="372" cy="206" r="10"/><text x="372" y="210.5" text-anchor="middle">2</text></g><text class="sd-label" x="372" y="232" text-anchor="middle">B&#8202; {{ 'editorial.size_diagram.length' | t }}</text><line class="sd-dim" x1="48" y1="160" x2="48" y2="202"/><line class="sd-dim" x1="42" y1="160" x2="54" y2="160"/><polyline class="sd-dim" points="45.0,167.0 48,160 51.0,167.0"/><line class="sd-dim" x1="42" y1="202" x2="54" y2="202"/><polyline class="sd-dim" points="45.0,195.0 48,202 51.0,195.0"/><g class="sd-callout"><circle cx="26" cy="181" r="10"/><text x="26" y="185.5" text-anchor="middle">3</text></g><text class="sd-label" x="26" y="150" text-anchor="middle">C&#8202; {{ 'editorial.size_diagram.depth' | t }}</text></svg></figure>
  {%- when 'flat' -%}
