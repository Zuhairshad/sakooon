{%- comment -%}
  Returns (prints) a CSS colour for a colour option name, e.g. "Navy" -> #1F2A44.
  Usage: {%- capture c -%}{% render 'sn-color', name: value %}{%- endcapture -%}
  Input is normalised: lower-case, "gray" -> "grey", hyphens/underscores -> spaces.
{%- endcomment -%}
{%- liquid
  assign key = name | append: '' | downcase | strip
  assign key = key | replace: 'gray', 'grey' | replace: '-', ' ' | replace: '_', ' ' | replace: '  ', ' '
  assign css = ''
  case key
    when 'forest green / lime green', 'forest green/lime green'
      assign css = '#1F4D36'
    when 'grey / white', 'grey/white'
      assign css = '#6B6B6B'
    when 'black / white', 'black/white'
      assign css = '#1E2126'
    when 'rust / peach', 'rust/peach'
      assign css = '#9C4A2C'
    when 'royal blue / sky blue', 'royal blue/sky blue'
      assign css = '#1F4FB0'
    when 'white', 'pure white', 'optic white', 'snow'
      assign css = '#FBFAF7'
    when 'ivory'
      assign css = '#EFE8D6'
    when 'off white', 'offwhite', 'cream', 'vanilla'
      assign css = '#F2EAD8'
    when 'beige', 'sand', 'linen', 'natural', 'oat', 'oatmeal'
      assign css = '#DCCBB0'
    when 'champagne'
      assign css = '#E4CFA6'
    when 'taupe', 'mocha', 'latte', 'mushroom'
      assign css = '#A68F7A'
    when 'camel', 'caramel'
      assign css = '#B98A5A'
    when 'brown', 'chocolate', 'coffee'
      assign css = '#6B4A35'
    when 'rust', 'cinnamon', 'terracotta', 'copper'
      assign css = '#B4683F'
    when 'orange', 'tangerine'
      assign css = '#E07B39'
    when 'grey', 'light grey', 'silver', 'dove', 'ash grey', 'pearl grey'
      assign css = '#C3C2BE'
    when 'slate grey', 'slate', 'steel grey'
      assign css = '#4F5A63'
    when 'charcoal grey', 'charcoal', 'dark grey', 'graphite'
      assign css = '#4A4D4B'
    when 'black', 'jet black'
      assign css = '#1E2126'
    when 'navy', 'navy blue', 'midnight', 'midnight blue'
      assign css = '#1F2A44'
    when 'blue', 'royal blue'
      assign css = '#3D5A92'
    when 'dusty blue', 'denim', 'denim blue'
      assign css = '#6E9BD1'
    when 'periwinkle blue', 'periwinkle'
      assign css = '#8AA6DB'
    when 'sky', 'sky blue', 'light blue'
      assign css = '#9CC6EA'
    when 'powder blue', 'baby blue', 'ice blue'
      assign css = '#B9CDE3'
    when 'teal', 'peacock'
      assign css = '#2E6E72'
    when 'turquoise', 'aqua', 'ferozi'
      assign css = '#3FB8B0'
    when 'emerald green', 'emerald', 'bottle green', 'dark green'
      assign css = '#1F5E45'
    when 'forest green', 'forest'
      assign css = '#1F4D36'
    when 'green'
      assign css = '#2F6B4F'
    when 'lime green', 'lime'
      assign css = '#B5D99C'
    when 'sage green'
      assign css = '#9DC3B3'
    when 'sage', 'pistachio'
      assign css = '#B3C2A7'
    when 'mint', 'mint green'
      assign css = '#BFE3D0'
    when 'olive', 'olive green', 'khaki'
      assign css = '#757A4A'
    when 'blush pink', 'blush', 'peach blush'
      assign css = '#E3A89A'
    when 'pink', 'baby pink', 'light pink'
      assign css = '#E8C1C0'
    when 'rose', 'dusty pink', 'dusty rose', 'old rose'
      assign css = '#C98D94'
    when 'peach', 'apricot'
      assign css = '#EFB79C'
    when 'coral'
      assign css = '#E8806E'
    when 'red'
      assign css = '#B5292F'
    when 'maroon', 'burgundy', 'wine'
      assign css = '#7D2A34'
    when 'purple', 'plum', 'aubergine'
      assign css = '#5E3A62'
    when 'lilac', 'lavender'
      assign css = '#C2B2D9'
    when 'mauve'
      assign css = '#A88497'
    when 'butter yellow', 'butter', 'lemon', 'lemon yellow'
      assign css = '#F0E08A'
    when 'yellow'
      assign css = '#F2CC3D'
    when 'mustard', 'gold', 'golden'
      assign css = '#D2A74C'
    else
      assign css = ''
  endcase
  echo css
-%}