{%- comment -%}
  Shared icon system. Owner: Fable. 24px grid, 1.5 stroke, currentColor.
  Usage: {% render 'icon', icon: 'search', size: 20, class: 'extra' %}
  Icons: search, bag, cart, account, menu, close, chevron-down, chevron-up, chevron-left, chevron-right, arrow-right, arrow-left,
  arrow-up-right, plus, minus, check, filter, sliders, heart, star, zoom, info, share, mail, phone, map-pin, truck, refresh,
  shield, leaf, drop, wind, sun, moon, thermometer, wash, no-bleach, tumble, iron, dry-clean, hang-dry, instagram, facebook,
  tiktok, pinterest, youtube, whatsapp, error, success, play, pause.
{%- endcomment -%}
{%- liquid
  assign size = size | default: 20
  assign label = label | default: ''
-%}
<svg class="icon icon-{{ icon }}{% if class %} {{ class }}{% endif %}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" {% if label != '' %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}>
