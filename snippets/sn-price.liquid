{%- comment -%} Price. Params: product, variant (optional), from (bool) {%- endcomment -%}
{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  assign sale = false
  if v.compare_at_price > v.price
    assign sale = true
  endif
-%}
<span class="sn-price">
  {%- if v.price == 0 -%}
    <span class="sn-price__now">{{ settings.zero_text | default: 'Price on request' }}</span>
  {%- else -%}
    <span class="sn-price__now{% if sale %} is-sale{% endif %}">{% if from and product.price_varies %}<span class="sn-price__from">From</span> {% endif %}{{ v.price | money }}</span>
    {%- if sale -%}<s class="sn-price__was">{{ v.compare_at_price | money }}</s>{%- endif -%}
  {%- endif -%}
</span>
