{%- comment -%}
  Responsive image. Owner: Fable. See docs/component-contracts.md section 6.
  {% render 'image', image: product.featured_image, sizes: '(min-width: 1024px) 50vw, 100vw', aspect: '4/5', priority: true, class: 'card__img' %}
  Renders a placeholder when image is blank (placeholder: 'product-1' etc.).
  decorative: true (or alt: '') renders alt="" for images next to visible text (cards), avoiding redundant alt.
  crop: 'center' | 'top' | 'bottom' | 'left' | 'right' (with aspect): every srcset candidate is cropped server-side to the aspect ratio,
  so a portrait packshot shown in a 21:10 banner downloads only the banner pixels (Shopify image_url width + height + crop).
  region_height: 1-99 (with aspect + crop): first limit the source to its top N% (e.g. the main photograph of a collage packshot),
  then cut the aspect from that area, centred horizontally (Shopify image_url crop: 'region' + crop_left/top/width/height).
  region: 'x,y,w,h' in percent of the source (with aspect + crop), e.g. '50,62,25,38' = a detail tile of a collage; the aspect is cut
  from that rectangle, centred. Takes precedence over region_height.
{%- endcomment -%}
{%- liquid
  assign widths_str = widths | default: '320,480,640,768,960,1280,1600,1920,2400'
  assign widths_arr = widths_str | split: ','
  assign sizes = sizes | default: '100vw'
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if priority
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
  assign img = image
  if image.preview_image
    assign img = image.preview_image
  endif
  if decorative or alt == ''
    assign alt_text = ''
  else
    assign alt_text = alt | default: img.alt | default: ''
  endif
-%}
{%- if img != blank -%}
  {%- liquid
    assign max_w = img.width
    assign crop_ratio = 0
    if crop and aspect and aspect != 'natural'
      assign crop_parts = aspect | split: '/'
      if crop_parts.size == 2
        assign crop_ratio = crop_parts[1] | plus: 0.0 | divided_by: crop_parts[0]
      endif
    endif
    assign use_region = false
    if crop_ratio > 0 and region != blank
      assign region_parts = region | split: ','
      if region_parts.size == 4
        assign use_region = true
        assign area_left = region_parts[0] | strip | times: img.width | divided_by: 100 | floor
        assign area_top = region_parts[1] | strip | times: img.height | divided_by: 100 | floor
        assign area_w = region_parts[2] | strip | times: img.width | divided_by: 100 | floor
        assign area_h = region_parts[3] | strip | times: img.height | divided_by: 100 | floor
        assign rect_h = area_w | times: crop_ratio | floor
        if rect_h <= area_h
          assign rect_w = area_w
          assign rect_left = area_left
          assign rect_top = area_h | minus: rect_h | divided_by: 2 | floor | plus: area_top
        else
          assign rect_h = area_h
          assign rect_w = area_h | divided_by: crop_ratio | floor
          assign rect_left = area_w | minus: rect_w | divided_by: 2 | floor | plus: area_left
          assign rect_top = area_top
        endif
        assign max_w = rect_w
      endif
    endif
    if crop_ratio > 0 and region_height and use_region == false
      assign region_pct = region_height | plus: 0
      if region_pct > 0 and region_pct < 100
        assign use_region = true
        assign area_h = img.height | times: region_pct | divided_by: 100 | floor
        assign area_w = img.width
        assign rect_h = area_w | times: crop_ratio | floor
        if rect_h <= area_h
          assign rect_w = area_w
          assign rect_left = 0
          assign rect_top = area_h | minus: rect_h | divided_by: 2 | floor
        else
          assign rect_h = area_h
          assign rect_w = area_h | divided_by: crop_ratio | floor
          assign rect_left = area_w | minus: rect_w | divided_by: 2 | floor
          assign rect_top = 0
        endif
        assign max_w = rect_w
      endif
    endif
    if crop_ratio > 0 and use_region == false
      comment
        Cropped candidates: the source can only be cropped as far as its own height allows (no enlargement).
      endcomment
      assign crop_max_w = img.height | divided_by: crop_ratio | floor
      if crop_max_w < max_w
        assign max_w = crop_max_w
      endif
    endif
    assign srcset = ''
    for w in widths_arr
      assign wn = w | strip | plus: 0
      if wn < max_w
        if use_region
          assign hn = wn | times: crop_ratio | round
          assign src_w = img | image_url: width: wn, height: hn, crop: 'region', crop_left: rect_left, crop_top: rect_top, crop_width: rect_w, crop_height: rect_h
        elsif crop_ratio > 0
          assign hn = wn | times: crop_ratio | round
          assign src_w = img | image_url: width: wn, height: hn, crop: crop
        else
          assign src_w = img | image_url: width: wn
        endif
        assign srcset = srcset | append: src_w | append: ' ' | append: wn | append: 'w, '
      endif
    endfor
    if use_region
      assign hmax = max_w | times: crop_ratio | round
      assign src_max = img | image_url: width: max_w, height: hmax, crop: 'region', crop_left: rect_left, crop_top: rect_top, crop_width: rect_w, crop_height: rect_h
    elsif crop_ratio > 0
      assign hmax = max_w | times: crop_ratio | round
      assign src_max = img | image_url: width: max_w, height: hmax, crop: crop
    else
      assign src_max = img | image_url: width: max_w
    endif
    assign srcset = srcset | append: src_max | append: ' ' | append: max_w | append: 'w'
    assign base_w = 1600
    if max_w < base_w
      assign base_w = max_w
    endif
    if use_region
      assign base_h = base_w | times: crop_ratio | round
      assign src_base = img | image_url: width: base_w, height: base_h, crop: 'region', crop_left: rect_left, crop_top: rect_top, crop_width: rect_w, crop_height: rect_h
    elsif crop_ratio > 0
      assign base_h = base_w | times: crop_ratio | round
      assign src_base = img | image_url: width: base_w, height: base_h, crop: crop
    else
      assign src_base = img | image_url: width: base_w
    endif
    assign out_h = img.height
    assign out_w = img.width
    if aspect and aspect != 'natural'
      assign ratio_parts = aspect | split: '/'
      if ratio_parts.size == 2
        assign out_w = ratio_parts[0] | times: 100
        assign out_h = ratio_parts[1] | times: 100
      endif
    endif
  -%}
  <img
    src="{{ src_base }}"
    srcset="{{ srcset }}"
    sizes="{{ sizes }}"
    width="{{ out_w }}"
    height="{{ out_h }}"
    alt="{{ alt_text | escape }}"
    loading="{{ loading }}"
    fetchpriority="{{ fetchpriority }}"
    decoding="async"
    class="image{% if class %} {{ class }}{% endif %}"
    {%- if aspect and aspect != 'natural' %} style="--aspect: {{ aspect }}"{% endif -%}
  >
{%- else -%}
  {% render 'placeholder', name: placeholder, class: class, aspect: aspect %}
{%- endif -%}
