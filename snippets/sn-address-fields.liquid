{%- comment -%} Address form fields. Params: form, fid, s (labels) {%- endcomment -%}
<div class="sn-field"><label for="AddrFirst-{{ fid }}">{{ s.l_first }}</label><input class="sn-input" id="AddrFirst-{{ fid }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
<div class="sn-field"><label for="AddrLast-{{ fid }}">{{ s.l_last }}</label><input class="sn-input" id="AddrLast-{{ fid }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
<div class="sn-field is-full"><label for="AddrCompany-{{ fid }}">{{ s.l_company }}</label><input class="sn-input" id="AddrCompany-{{ fid }}" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
<div class="sn-field is-full"><label for="AddrA1-{{ fid }}">{{ s.l_a1 }}</label><input class="sn-input" id="AddrA1-{{ fid }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
<div class="sn-field is-full"><label for="AddrA2-{{ fid }}">{{ s.l_a2 }}</label><input class="sn-input" id="AddrA2-{{ fid }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
<div class="sn-field"><label for="AddrCity-{{ fid }}">{{ s.l_city }}</label><input class="sn-input" id="AddrCity-{{ fid }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
<div class="sn-field"><label for="AddrCountry-{{ fid }}">{{ s.l_country }}</label><select class="sn-select" id="AddrCountry-{{ fid }}" name="address[country]" data-snad-country="{{ fid }}" data-default="{{ form.country | default: 'Pakistan' }}" autocomplete="country">{{ all_country_option_tags }}</select></div>
<div class="sn-field" id="AddrProvinceWrap-{{ fid }}"><label for="AddrProvince-{{ fid }}">{{ s.l_prov }}</label><select class="sn-select" id="AddrProvince-{{ fid }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select></div>
<div class="sn-field"><label for="AddrZip-{{ fid }}">{{ s.l_zip }}</label><input class="sn-input" id="AddrZip-{{ fid }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
<div class="sn-field"><label for="AddrPhone-{{ fid }}">{{ s.l_phone }}</label><input class="sn-input" type="tel" id="AddrPhone-{{ fid }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
<label class="sn-check is-full"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox contains 'checked' %} checked{% endif %}><span>{{ s.l_default }}</span></label>
