{%- comment -%}
  Storefront filters. Params: results (collection or search), uid, terms (search only), show_counts (bool), swatch (bool), open_n (number of open groups)
{%- endcomment -%}
<form class="sn-fac" data-sn-facets id="{{ uid }}-form">
  {%- if terms != blank -%}<input type="hidden" name="q" value="{{ terms | escape }}"><input type="hidden" name="options[prefix]" value="last">{%- endif -%}
  <input type="hidden" name="sort_by" value="{{ results.sort_by | default: results.default_sort_by | escape }}" data-sn-fsort>
  {%- for filter in results.filters -%}
    {%- assign fo = false -%}{%- if forloop.index <= open_n or filter.active_values.size > 0 -%}{%- assign fo = true -%}{%- endif -%}
    <details class="sn-fac__g" data-fid="{{ filter.param_name | escape }}"{% if fo %} open{% endif %}>
      <summary><span>{{ filter.label }}{%- if filter.active_values.size > 0 -%}<i class="sn-fac__n">{{ filter.active_values.size }}</i>{%- endif -%}</span>{% render 'sn-icon', name: 'chevron-down', class: 'icon' %}</summary>
      <div class="sn-fac__b">
        {%- case filter.type -%}
          {%- when 'price_range' -%}
            {%- assign maxp = filter.range_max | divided_by: 100.0 | ceil -%}
            {%- assign vmin = filter.min_value.value | divided_by: 100.0 | floor -%}
            {%- assign vmax = filter.max_value.value | divided_by: 100.0 | ceil -%}
            <div class="sn-fac__price" data-sn-price style="--a: {% if filter.min_value.value %}{{ vmin | times: 100.0 | divided_by: maxp }}{% else %}0{% endif %}%; --b: {% if filter.max_value.value %}{{ vmax | times: 100.0 | divided_by: maxp }}{% else %}100{% endif %}%;">
              <div class="sn-fac__rng">
                <i></i>
                <input type="range" min="0" max="{{ maxp }}" step="1" value="{% if filter.min_value.value %}{{ vmin }}{% else %}0{% endif %}" data-sn-pr="min" aria-label="Min">
                <input type="range" min="0" max="{{ maxp }}" step="1" value="{% if filter.max_value.value %}{{ vmax }}{% else %}{{ maxp }}{% endif %}" data-sn-pr="max" aria-label="Max">
              </div>
              <div class="sn-fac__pin">
                <label><span>{{ cart.currency.symbol | default: 'Rs.' }}</span><input type="number" min="0" max="{{ maxp }}" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ vmin }}{% endif %}" placeholder="0" data-sn-pn="min"></label>
                <em>—</em>
                <label><span>{{ cart.currency.symbol | default: 'Rs.' }}</span><input type="number" min="0" max="{{ maxp }}" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ vmax }}{% endif %}" placeholder="{{ maxp }}" data-sn-pn="max"></label>
              </div>
            </div>
          {%- when 'boolean' -%}
            {%- for value in filter.values -%}
              <label class="sn-fac__opt"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}><i></i><span>{{ value.label }}</span></label>
            {%- endfor -%}
          {%- else -%}
            {%- assign fl = filter.label | downcase -%}
            {%- assign is_sw = false -%}
            {%- if swatch and fl contains 'colo' -%}{%- assign is_sw = true -%}{%- endif -%}
            <div class="sn-fac__list{% if is_sw %} is-sw{% endif %}">
              {%- for value in filter.values -%}
                {%- liquid
                  assign css = ''
                  if is_sw
                    if value.swatch.color
                      assign css = value.swatch.color
                    elsif value.swatch.image
                      assign css = value.swatch.image | image_url: width: 60 | prepend: 'url(' | append: ') center/cover'
                    else
                      capture css
                        render 'sn-color', name: value.label
                      endcapture
                      assign css = css | strip
                    endif
                  endif
                -%}
                <label class="sn-fac__opt{% if value.count == 0 and value.active == false %} is-zero{% endif %}">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                  {%- if is_sw -%}<i class="sn-fac__sw" style="--sw: {% if css != '' %}{{ css }}{% else %}#ddd{% endif %};"></i>{%- else -%}<i></i>{%- endif -%}
                  <span>{{ value.label }}</span>{%- if show_counts -%}<small>{{ value.count }}</small>{%- endif -%}
                </label>
              {%- endfor -%}
            </div>
        {%- endcase -%}
      </div>
    </details>
  {%- endfor -%}
</form>
