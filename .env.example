# ---------------------------------------------------------------------------
# Everything here is optional. With no variables set, the site runs on the
# local sample data in data/store.json + public/images (no Shopify needed).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://sakooon.com

# --- Shopify (fill in when your store is ready) ----------------------------
# Setting SHOPIFY_STORE_DOMAIN switches products, collections, pages, search,
# cart and checkout from the local sample data to the Storefront API.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Redirects for /account, /checkouts, /cart/c and /policies (next.config.ts)
SHOPIFY_MYSHOPIFY_DOMAIN=
SHOPIFY_SHOP_ID=
# Newsletter / popup signups saved as customers (write_customers)
SHOPIFY_ADMIN_TOKEN=
# Webhook cache refresh (/api/revalidate)
SHOPIFY_WEBHOOK_SECRET=
REVALIDATE_SECRET=

# --- Forms ------------------------------------------------------------------
CONTACT_WEBHOOK_URL=
NEXT_PUBLIC_WELCOME_CODE=
