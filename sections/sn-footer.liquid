{%- liquid
  assign s = section.settings
  assign c_bg = s.bg_color | default: settings.color_dark_bg
  assign c_tx = s.text_color | default: settings.color_dark_text
  assign c_ac = s.accent_color | default: settings.color_moon
-%}
<footer id="snf" class="snf" style="--bg: {{ c_bg }}; --tx: {{ c_tx }}; --ac: {{ c_ac }}; --soft: color-mix(in srgb, {{ c_tx }} 66%, transparent); --line: color-mix(in srgb, {{ c_tx }} 14%, transparent); --line2: color-mix(in srgb, {{ c_tx }} 26%, transparent); --ac-ink: {{ c_bg }};">
  <div class="snf__sky" aria-hidden="true">
    {%- if s.silk -%}<div class="snf__silk" data-sn-silk data-c1="{{ c_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ c_ac }}" data-speed=".55" data-amp=".9"></div>{%- endif -%}
    {%- if s.feathers -%}<div data-sn-feathers="40" data-color="{{ c_ac }}" style="position:absolute;inset:0"></div>{%- endif -%}
    <svg class="snf__wave" viewBox="0 0 2880 80" preserveAspectRatio="none"><path d="M0 0V40C240 80 480 80 720 40S1200 0 1440 40 1920 80 2160 40 2640 0 2880 40V0Z"/></svg>
  </div>

  {%- if s.show_cta -%}
    <div class="snf__cta sn-wrap">
      <div class="snf__moon" aria-hidden="true">
        <svg viewBox="0 0 120 120"><defs><radialGradient id="snf-mg" cx="38%" cy="35%" r="70%"><stop offset="0" stop-color="#fff8e6"/><stop offset="1" stop-color="{{ c_ac }}"/></radialGradient><clipPath id="snf-mc"><circle cx="60" cy="60" r="44"/></clipPath></defs>
          <circle cx="60" cy="60" r="56" fill="none" stroke="{{ c_ac }}" stroke-opacity=".3" stroke-dasharray="1 6"/>
          <circle cx="60" cy="60" r="44" fill="url(#snf-mg)"/><g clip-path="url(#snf-mc)"><circle class="snf__moon-sh" cx="38" cy="52" r="46" fill="{{ c_bg }}"/></g>
        </svg>
      </div>
      <div class="snf__cta-copy">
        {%- if s.cta_eyebrow != blank -%}<p class="sn-eyebrow" data-r>{{ s.cta_eyebrow }}</p>{%- endif -%}
        <h2 class="sn-h sn-h--xl" data-sn-split>{{ s.cta_heading }}{% if s.cta_highlight != blank %} <em>{{ s.cta_highlight }}</em>{% endif %}</h2>
        {%- if s.cta_text != blank -%}<p class="sn-lead" data-r style="--i: 2;">{{ s.cta_text }}</p>{%- endif -%}
      </div>
      {%- if s.show_newsletter -%}
        <div class="snf__news" data-r style="--i: 3;">
          {%- form 'customer', id: 'snf-news', class: 'snf__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="sn-msg">{{ s.news_success }}</p>
            {%- else -%}
              <label class="sr" for="snf-email">{{ s.news_placeholder }}</label>
              <div class="sn-pill-form">
                <input id="snf-email" type="email" name="contact[email]" placeholder="{{ s.news_placeholder | escape }}" required autocomplete="email">
                <button class="sn-btn sn-btn--gold sn-btn--sm" type="submit"><span>{{ s.news_button }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
              </div>
              {%- if form.errors -%}<p class="sn-msg sn-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
          {%- if s.news_fine != blank -%}<p class="sn-small">{{ s.news_fine }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="snf__main sn-wrap">
    <div class="snf__brand" data-r>
      <a href="{{ routes.root_url }}" class="snf__logo" aria-label="{{ shop.name | escape }}">
        {%- assign fl = settings.logo_light -%}
        {%- if fl != blank -%}<img src="{{ fl | image_url: width: 500 }}" alt="{{ shop.name | escape }}" width="{{ s.logo_width }}" height="{{ s.logo_width | divided_by: fl.aspect_ratio | round }}" loading="lazy">{%- else -%}{% render 'sn-logo' %}{%- endif -%}
      </a>
      {%- if s.about != blank -%}<p class="snf__about">{{ s.about }}</p>{%- endif -%}
      <ul class="snf__contact">
        {%- if settings.phone != blank -%}<li><a href="tel:{{ settings.phone | remove: ' ' }}">{% render 'sn-icon', name: 'phone', class: 'icon' %}{{ settings.phone }}</a></li>{%- endif -%}
        {%- if settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">{% render 'sn-icon', name: 'whatsapp', class: 'icon' %}WhatsApp</a></li>{%- endif -%}
        {%- if settings.email != blank -%}<li><a href="mailto:{{ settings.email }}">{% render 'sn-icon', name: 'mail', class: 'icon' %}{{ settings.email }}</a></li>{%- endif -%}
        {%- if s.address != blank -%}<li><span>{% render 'sn-icon', name: 'map-pin', class: 'icon' %}{{ s.address }}</span></li>{%- endif -%}
        {%- if s.hours != blank -%}<li><span>{% render 'sn-icon', name: 'clock', class: 'icon' %}{{ s.hours }}</span></li>{%- endif -%}
      </ul>
      <div class="snf__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'sn-icon', name: 'instagram', class: 'icon' %}</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'sn-icon', name: 'facebook', class: 'icon' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'sn-icon', name: 'tiktok', class: 'icon' %}</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'sn-icon', name: 'youtube', class: 'icon' %}</a>{%- endif -%}
        {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">P</a>{%- endif -%}
      </div>
    </div>

    <div class="snf__cols">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="snf__col" data-r style="--i: {{ forloop.index }};" {{ block.shopify_attributes }}>
          <details class="snf__d" open>
            <summary><span>{{ b.heading }}</span><i></i></summary>
            <ul>
              {%- if block.type == 'menu' and b.menu != blank -%}
                {%- for link in b.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              {%- elsif block.type == 'menu' -%}
                {%- assign lines = b.links | newline_to_br | split: '<br />' -%}
                {%- for l in lines -%}{%- if l contains '|' -%}{%- assign pr = l | strip | split: '|' -%}<li><a href="{{ pr[1] | strip }}">{{ pr[0] | strip }}</a></li>{%- endif -%}{%- endfor -%}
              {%- elsif block.type == 'text' -%}
                <li class="snf__txt">{{ b.text }}</li>
              {%- endif -%}
            </ul>
          </details>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if s.show_wordmark -%}
    <div class="snf__mark sn-wrap--wide" aria-hidden="true" data-snf-mark>{% render 'sn-logo' %}</div>
  {%- endif -%}

  <div class="snf__bottom sn-wrap">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ s.copyright }}</p>
    {%- if s.show_policies -%}
      <ul class="snf__pol">
        {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.show_payments -%}
      <ul class="snf__pay">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}{%- if s.cod_text != blank -%}<li class="snf__cod">{{ s.cod_text }}</li>{%- endif -%}</ul>
    {%- endif -%}
  </div>
</footer>
<style>
#snf { position: relative; isolation: isolate; overflow: hidden; background: var(--bg); color: var(--tx); padding-top: {{ s.pad_top }}px; }
#snf .snf__sky { position: absolute; inset: 0 0 auto 0; height: 760px; z-index: -1; -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent); mask-image: linear-gradient(180deg, #000 45%, transparent); }
#snf .snf__silk { position: absolute; inset: 0; }
#snf .snf__wave { position: absolute; left: 0; top: 0; width: 200%; max-width: none; height: 60px; fill: {{ s.wave_color | default: settings.color_paper }}; animation: sn-div-drift 26s linear infinite; }
#snf .snf__cta { display: grid; grid-template-columns: auto minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; gap: clamp(24px, 4vw, 60px); padding-bottom: clamp(60px, 8vw, 110px); }
#snf .snf__moon { width: clamp(90px, 10vw, 140px); }
#snf .snf__moon svg { width: 100%; height: auto; overflow: visible; filter: drop-shadow(0 0 40px color-mix(in srgb, var(--ac) 50%, transparent)); }
#snf .snf__moon-sh { transition: cx 2.4s cubic-bezier(.3, .6, .2, 1); }
#snf .snf__cta-copy { display: grid; gap: 16px; }
#snf .snf__cta .sn-lead { color: var(--soft); }
#snf .snf__news { display: grid; gap: 12px; }
#snf .snf__main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(30px, 5vw, 90px); padding-block: 56px; border-top: 1px dashed color-mix(in srgb, var(--ac) 35%, transparent); }
#snf .snf__logo { display: block; width: {{ s.logo_width }}px; max-width: 100%; }
#snf .snf__logo .sn-logo, #snf .snf__logo img { width: 100%; height: auto; color: var(--tx); --sn-logo-accent: var(--ac); }
#snf .snf__about { margin-top: 18px; color: var(--soft); line-height: 1.75; max-width: 40ch; font-size: 14.5px; }
#snf .snf__contact { display: grid; gap: 10px; margin-top: 22px; font-size: 14.5px; }
#snf .snf__contact a, #snf .snf__contact span { display: inline-flex; align-items: center; gap: 12px; color: var(--soft); transition: color .3s; }
#snf .snf__contact a:hover { color: var(--ac); }
#snf .snf__contact .icon { width: 17px; height: 17px; color: var(--ac); flex: none; }
#snf .snf__social { display: flex; gap: 8px; margin-top: 24px; }
#snf .snf__social a { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line2); transition: background .4s, color .4s, transform .5s cubic-bezier(.3, 1.5, .5, 1); }
#snf .snf__social a:hover { background: var(--ac); color: var(--bg); transform: translateY(-4px) rotate(-8deg); }
#snf .snf__social .icon { width: 17px; height: 17px; }
#snf .snf__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 30px; }
#snf .snf__d summary { list-style: none; display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; font: 600 11.5px/1.2 var(--f-body); letter-spacing: .26em; text-transform: uppercase; color: var(--ac); pointer-events: none; }
#snf .snf__d summary::-webkit-details-marker { display: none; }
#snf .snf__d summary i { display: none; }
#snf .snf__d ul { display: grid; gap: 4px; }
#snf .snf__d li a { position: relative; display: inline-block; padding: 5px 0; color: var(--soft); transition: color .3s, transform .4s cubic-bezier(.3, 1.4, .5, 1); }
#snf .snf__d li a:hover { color: var(--tx); transform: translateX(5px); }
#snf .snf__txt { color: var(--soft); line-height: 1.75; font-size: 14.5px; }
#snf .snf__mark { padding-top: 10px; line-height: 0; }
#snf .snf__mark .sn-logo { width: 100%; height: auto; color: transparent; overflow: visible; }
#snf .snf__mark .sn-logo__type path { fill: transparent; stroke: color-mix(in srgb, var(--tx) 22%, transparent); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 3s cubic-bezier(.6, .1, .3, 1), fill 1.4s ease 2.4s; }
#snf .snf__mark .sn-logo__moon circle, #snf .snf__mark .sn-logo__moon path { stroke: color-mix(in srgb, var(--ac) 60%, transparent); fill: transparent; transition: fill 1.2s ease 2.6s; }
#snf .snf__mark.is-drawn .sn-logo__type path { stroke-dashoffset: 0; fill: color-mix(in srgb, var(--tx) 5%, transparent); }
#snf .snf__mark.is-drawn .sn-logo__moon > :not(.sn-logo__ring) { fill: color-mix(in srgb, var(--ac) 40%, transparent); }
#snf .snf__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 28px; padding-block: 26px 34px; border-top: 1px solid var(--line); font-size: 13px; color: var(--soft); }
#snf .snf__pol { display: flex; flex-wrap: wrap; gap: 6px 18px; } #snf .snf__pol a:hover { color: var(--ac); }
#snf .snf__pay { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
#snf .snf__pay svg { width: 38px; height: 24px; border-radius: 4px; }
#snf .snf__cod { padding: 4px 10px; border-radius: 6px; border: 1px dashed var(--line2); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
@media (max-width: 989px) {
  #snf .snf__cta { grid-template-columns: 1fr; }
  #snf .snf__main { grid-template-columns: 1fr; }
}
@media (max-width: 599px) {
  #snf .snf__cols { grid-template-columns: 1fr; gap: 0; }
  #snf .snf__d { border-bottom: 1px solid var(--line); }
  #snf .snf__d summary { margin: 0; padding: 18px 0; pointer-events: auto; cursor: pointer; }
  #snf .snf__d summary i { display: block; position: relative; width: 14px; height: 14px; }
  #snf .snf__d summary i::before, #snf .snf__d summary i::after { content: ""; position: absolute; left: 0; top: 50%; width: 14px; height: 1.4px; background: currentColor; transition: transform .4s; }
  #snf .snf__d summary i::after { transform: rotate(90deg); } #snf .snf__d[open] summary i::after { transform: none; }
  #snf .snf__d ul { padding-bottom: 16px; }
}
</style>
<script>
(function () {
  var f = document.getElementById('snf'); if (!f || f.dataset.on) return; f.dataset.on = 1;
  if (window.innerWidth < 600) f.querySelectorAll('.snf__d').forEach(function (d) { d.removeAttribute('open'); });
  var mark = f.querySelector('[data-snf-mark]'), sh = f.querySelector('.snf__moon-sh');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { if (e.target === mark) mark.classList.add('is-drawn'); else if (sh) sh.setAttribute('cx', '150'); io.unobserve(e.target); } }); }, { threshold: .3 });
    if (mark) io.observe(mark); var mo = f.querySelector('.snf__moon'); if (mo) io.observe(mo);
  } else { if (mark) mark.classList.add('is-drawn'); }
})();
</script>
{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Goodnight call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "Small heading",
      "default": "Goodnight from Sakooon"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Sleep softer,"
    },
    {
      "type": "text",
      "id": "cta_highlight",
      "label": "Heading, italic part",
      "default": "wake brighter."
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Text",
      "default": "Bedtime letters with new colours, restocks and members-only offers. Only when it's worth waking up for."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Newsletter form",
      "default": true
    },
    {
      "type": "text",
      "id": "news_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "news_button",
      "label": "Button",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "news_success",
      "label": "Thank-you message",
      "default": "You're in. Sweet dreams!"
    },
    {
      "type": "text",
      "id": "news_fine",
      "label": "Small print",
      "default": "No spam. Unsubscribe any time."
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 190
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "Premium bed sheets, duvets, pillows and towels — woven for deep, peaceful sleep in every Pakistani home."
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Lahore, Pakistan"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Opening hours",
      "default": "Mon – Sat · 10 AM – 8 PM"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Giant stitched wordmark",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "Woven with care in Pakistan."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "cod_text",
      "label": "Extra payment label",
      "default": "Cash on delivery"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "checkbox",
      "id": "silk",
      "label": "Live silk night sky",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "feathers",
      "label": "Stardust",
      "default": true
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Wave colour (match the section above)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Optional. Empty = links below."
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links (one per line: Label | /url)",
          "default": "Bed sheets | /collections/bed-sheets\nDuvets | /collections/duvets\nBath towels | /collections/bath-towels\nPillows | /collections/pillows"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our promise"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every piece is checked by hand, folded with care and exchangeable within 7 days.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
