{%- comment -%}
  Fabric discovery ("Choose by fabric"). Owner: shad-2d.
  A band of its own: section heading + intro, then large fabric tabs (heading serif + round texture swatch, a real
  tablist via <theme-tabs>: arrow keys, one tab stop, horizontal scroll row on phones). Each panel is a 5/7 split at
  >=1024: name at display size, the fabric's overview, hairline fact rows (composition, feel, care; only the ones that
  exist), "Shop <fabric>" + "About this fabric"; beside it one 4:5 photograph of a product in that fabric (region_height
  keeps only the main shot of a collage packshot) and up to two compact product links (title + price).
  Data: each block picks a fabric metaobject (sakooon fabric definition). Block settings override name, image and products.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign base_id = 'Fabrics-' | append: section.id
-%}
<div class="section fabric-discovery color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <theme-tabs class="page-width fabric-discovery__inner">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="fabric-discovery__head">
        {%- if s.heading != blank -%}<h2 class="fabric-discovery__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="fabric-discovery__text rte">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fabric-discovery__tabs no-scrollbar" role="tablist" aria-label="{{ s.heading | default: 'Fabrics' | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign fabric = block.settings.fabric
            if fabric != blank and fabric.system == blank
              assign fabric = shop.metaobjects.fabric[block.settings.fabric]
            endif
            assign tab_name = block.settings.name | default: fabric.name.value | default: fabric.name
            assign swatch = block.settings.swatch_image | default: fabric.texture_image.value
          -%}
          <button type="button" role="tab" class="fabric-discovery__tab" id="{{ base_id }}-tab-{{ forloop.index }}" aria-controls="{{ base_id }}-panel-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
            <span class="fabric-discovery__swatch" aria-hidden="true">
              {%- if swatch != blank -%}
                {%- render 'image', image: swatch, sizes: '48px', widths: '96,144', aspect: '1/1', crop: 'top', class: 'fabric-discovery__swatch-img', alt: '' -%}
              {%- endif -%}
            </span>
            <span class="fabric-discovery__tab-label">{{ tab_name | escape }}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign fabric = b.fabric
          if fabric != blank and fabric.system == blank
            assign fabric = shop.metaobjects.fabric[b.fabric]
          endif
          assign full_name = fabric.name.value | default: fabric.name | default: b.name
          assign tab_name = b.name | default: full_name
          assign products = b.products
          if products == blank or products.size == 0
            assign products = fabric.related_products.value
          endif
          assign photo = b.image
          if photo == blank and products.size > 0
            assign photo = products.first.featured_image
          endif
          assign region = nil
          if b.region_height < 100
            assign region = b.region_height
          endif
          assign shop_url = b.shop_link
          if shop_url == blank and products.size > 0
            assign shop_url = products.first.url
          endif
          assign about_url = fabric.system.url
          assign care_line = ''
          if fabric.care.value != blank
            assign care_line = fabric.care.value | strip_html | split: '. ' | first | strip | remove: '.' | append: '.'
          endif
          assign care_guide_url = fabric.care_guide.value.url
          assign shop_name = tab_name | downcase
        -%}
        <div class="fabric-discovery__panel" id="{{ base_id }}-panel-{{ forloop.index }}" role="tabpanel" aria-labelledby="{{ base_id }}-tab-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %} tabindex="0">
          <div class="fabric-discovery__copy">
            {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
            <h3 class="fabric-discovery__name">{{ full_name | escape }}</h3>
            {%- assign overview = fabric.overview.value | default: fabric.summary.value -%}
            {%- if overview != blank -%}<p class="fabric-discovery__overview">{{ overview | escape }}</p>{%- endif -%}
            {%- if fabric.composition.value != blank or fabric.feel.value != blank or care_line != '' or care_guide_url != blank -%}
              <dl class="fabric-discovery__facts">
                {%- if fabric.composition.value != blank -%}<div class="fabric-discovery__fact"><dt>{{ 'storefront.sections.fabric_composition' | t }}</dt><dd>{{ fabric.composition.value | escape }}</dd></div>{%- endif -%}
                {%- if fabric.feel.value != blank -%}<div class="fabric-discovery__fact"><dt>{{ 'storefront.sections.fabric_feel' | t }}</dt><dd>{{ fabric.feel.value | escape }}</dd></div>{%- endif -%}
                {%- if care_line != '' -%}
                  <div class="fabric-discovery__fact"><dt>{{ 'storefront.sections.fabric_care' | t }}</dt><dd>{{ care_line | escape }}</dd></div>
                {%- elsif care_guide_url != blank -%}
                  <div class="fabric-discovery__fact"><dt>{{ 'storefront.sections.fabric_care' | t }}</dt><dd><a class="link" href="{{ care_guide_url }}">{{ 'storefront.sections.fabric_care_guide' | t }}</a></dd></div>
                {%- endif -%}
              </dl>
            {%- endif -%}
            <div class="fabric-discovery__actions">
              {%- if shop_url != blank -%}
                {%- assign shop_label = b.shop_label | default: 'storefront.sections.shop_fabric' -%}
                {%- if b.shop_label == blank -%}{%- assign shop_label = 'storefront.sections.shop_fabric' | t: name: shop_name -%}{%- endif -%}
                {%- render 'button', label: shop_label, url: shop_url -%}
              {%- endif -%}
              {%- if about_url != blank -%}
                <a class="link link--arrow fabric-discovery__about" href="{{ about_url }}">{{ 'storefront.sections.about_this_fabric' | t }}{% render 'icon', icon: 'arrow-right', size: 16 %}</a>
              {%- endif -%}
            </div>
          </div>

          <div class="fabric-discovery__media">
            <a class="media fabric-discovery__photo" style="--aspect: 4/5" href="{{ shop_url | default: about_url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image', image: photo, sizes: '(min-width: 1440px) 560px, (min-width: 1024px) 40vw, 100vw', widths: '360,480,640,800,1000,1200', aspect: '4/5', crop: 'top', region_height: region, placeholder: 'lifestyle-1', alt: '' -%}
            </a>
            {%- if products.size > 0 -%}
              <ul class="fabric-discovery__products list-unstyled" role="list">
                {%- for product in products limit: 2 -%}
                  <li>
                    <a class="fabric-discovery__product" href="{{ product.url }}">
                      <span class="media fabric-discovery__product-media" style="--aspect: 1/1">
                        {%- render 'image', image: product.featured_image, sizes: '88px', widths: '120,180', aspect: '1/1', crop: 'top', alt: '' -%}
                      </span>
                      <span class="fabric-discovery__product-text">
                        <span class="fabric-discovery__product-title">{{ product.title | escape }}</span>
                        <span class="fabric-discovery__product-price">
                          {%- if product.price_varies -%}{{ 'storefront.sections.price_from' | t: price: product.price_min | money_without_trailing_zeros }}{%- else -%}{{ product.price | money_without_trailing_zeros }}{%- endif -%}
                        </span>
                      </span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </theme-tabs>
</div>

{% schema %}
{
  "name": "Fabric discovery",
  "tag": "section",
  "class": "section-fabric-discovery",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose by fabric" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h2", "options": [ { "value": "h1", "label": "t:sections.all.heading_size.options.h1" }, { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" } ] },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pick a fabric to see it up close.</p>" },
    { "type": "text", "id": "eyebrow", "label": "Label above each fabric name", "default": "Fabric" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "sage" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "shade", "name": "Fabric",
      "settings": [
        { "type": "metaobject", "id": "fabric", "label": "Fabric", "metaobject_type": "fabric", "info": "Fills the name, overview, facts, swatch, products and link from the fabric entry." },
        { "type": "text", "id": "name", "label": "Tab name", "info": "Optional short name for the tab. The panel shows the fabric's full name." },
        { "type": "image_picker", "id": "swatch_image", "label": "Swatch image", "info": "Optional. Defaults to the fabric's texture image." },
        { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Optional. Defaults to the first product's main image." },
        { "type": "range", "id": "region_height", "label": "Use top part of image (%)", "min": 20, "max": 100, "step": 1, "default": 100, "info": "For collage packshots: the share of the image height that holds the main photo" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 2, "info": "Optional. Defaults to the fabric's related products." },
        { "type": "text", "id": "shop_label", "label": "Button label", "info": "Defaults to \"Shop <tab name>\"." },
        { "type": "url", "id": "shop_link", "label": "Button link", "info": "Defaults to the first product." }
      ]
    }
  ],
  "presets": [ { "name": "Fabric discovery", "blocks": [ { "type": "shade", "settings": { "name": "Cotton satin" } }, { "type": "shade", "settings": { "name": "Quilted cotton" } } ] } ]
}
{% endschema %}
