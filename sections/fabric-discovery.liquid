{%- comment -%}
  Fabric / shade discovery. Owner: shad-2d. Pattern: Parachute "palette" section: wide side padding, heading + lead
  on the left, a grid of swatches on the right; choosing a swatch swaps the rail of tall (9:16) images below.
  Swatches are tabs (<theme-tabs>, global.js); each shade block holds up to 6 images and a link.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign base_id = 'Discovery-' | append: section.id
-%}
<div class="section fabric-discovery color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --discovery-card: {{ s.card_width }}px;">
  <theme-tabs class="fabric-discovery__inner page-width page-width--full">
    <div class="fabric-discovery__head">
      <div class="fabric-discovery__intro">
        {%- if s.heading != blank -%}<h2 class="fabric-discovery__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="fabric-discovery__text rte text-large">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="fabric-discovery__swatches" role="tablist" aria-label="{{ s.swatch_label | escape }}">
          {%- for block in section.blocks -%}
            <button type="button" role="tab" class="fabric-discovery__swatch" id="{{ base_id }}-tab-{{ forloop.index }}" aria-controls="{{ base_id }}-panel-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}
              style="--swatch: {{ block.settings.color }};{% if block.settings.swatch_image != blank %} --swatch-image: url('{{ block.settings.swatch_image | image_url: width: 96 }}');{% endif %}">
              <span class="visually-hidden">{{ block.settings.name | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      <scroll-rail class="fabric-discovery__panel" id="{{ base_id }}-panel-{{ forloop.index }}" role="tabpanel" aria-labelledby="{{ base_id }}-tab-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
        <div class="fabric-discovery__bar">
          <p class="fabric-discovery__current"><span class="text-muted">{{ s.swatch_label | escape }}:</span> {{ block.settings.name | escape }}</p>
          <div class="rail-buttons">
            <button type="button" class="rail-button" data-rail-prev aria-label="{{ 'storefront.sections.previous' | t }}">{% render 'icon', icon: 'chevron-left', size: 18 %}</button>
            <button type="button" class="rail-button" data-rail-next aria-label="{{ 'storefront.sections.next' | t }}">{% render 'icon', icon: 'chevron-right', size: 18 %}</button>
          </div>
        </div>
        <ul class="fabric-discovery__track list-unstyled no-scrollbar" role="list" data-rail-track tabindex="0" aria-label="{{ block.settings.name | escape }}">
          {%- for i in (1..6) -%}
            {%- assign key = 'image_' | append: i -%}
            {%- assign img = block.settings[key] -%}
            {%- if img == blank and i > 4 -%}{%- continue -%}{%- endif -%}
            <li class="fabric-discovery__item">
              <a class="fabric-discovery__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                <div class="media" style="--aspect: 9/16">
                  {%- render 'image', image: img, sizes: '(min-width: 1280px) 343px, (min-width: 768px) 240px, 62vw', widths: '240,360,480,720', aspect: '9/16', placeholder: 'lifestyle-1' -%}
                </div>
                <span class="fabric-discovery__arrow" aria-hidden="true">{% render 'icon', icon: 'arrow-right', size: 14 %}</span>
                <span class="visually-hidden">{{ block.settings.name | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </scroll-rail>
    {%- endfor -%}
  </theme-tabs>
</div>

{% schema %}
{
  "name": "Fabric discovery",
  "tag": "section",
  "class": "section-fabric-discovery",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A considered palette" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h3", "options": [ { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" } ] },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Introduce your colours or fabrics and how they work together.</p>" },
    { "type": "text", "id": "swatch_label", "label": "Swatch label", "default": "Discover by shade" },
    { "type": "range", "id": "card_width", "label": "Image width (desktop)", "min": 200, "max": 400, "step": 8, "unit": "px", "default": 344 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "white" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 160 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "shade", "name": "Shade",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Shade" },
        { "type": "color", "id": "color", "label": "Swatch colour", "default": "#E9E3DA" },
        { "type": "image_picker", "id": "swatch_image", "label": "Swatch image", "info": "Optional. A fabric close-up used instead of the colour." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "image_picker", "id": "image_4", "label": "Image 4" },
        { "type": "image_picker", "id": "image_5", "label": "Image 5" },
        { "type": "image_picker", "id": "image_6", "label": "Image 6" }
      ]
    }
  ],
  "presets": [ { "name": "Fabric discovery", "blocks": [ { "type": "shade", "settings": { "name": "White", "color": "#F6F4F0" } }, { "type": "shade", "settings": { "name": "Sand", "color": "#D9CDBB" } }, { "type": "shade", "settings": { "name": "Sage", "color": "#A7B09A" } }, { "type": "shade", "settings": { "name": "Ink", "color": "#2E3440" } } ] } ]
}
{% endschema %}
