{%- liquid
  assign s = section.settings
  assign sid = 'sngl-' | append: section.id
  assign arts = 'bed,bed-sheet,pillow-cover,duvet,towel,bed-cover,duvet-cover,pillow' | split: ','
-%}
<section id="{{ sid }}" class="sn-s sngl sngl--{{ s.layout }}" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {%- capture lk -%}{%- if s.handle != blank -%}{{ s.handle }}{%- endif -%}{%- endcapture -%}
    {% render 'sn-head', s: s, k: 3, link_label: lk, link_url: s.handle_link %}
  </div>

  {%- if s.layout == 'drift' -%}
    <div class="sngl__drift">
      {%- for row in (1..2) -%}
        <div class="sn-marq sngl__row{% if row == 2 %} sn-marq--rev{% endif %}" style="--dur: {{ s.speed }}s; --gap: 18px;">
          {%- for c in (1..2) -%}
            <div class="sn-marq__t is-pausable"{% if c == 2 %} aria-hidden="true"{% endif %}>
              {%- for block in section.blocks -%}
                {%- assign odd = forloop.index | modulo: 2 -%}
                {%- if section.blocks.size > 5 -%}
                  {%- if row == 1 and odd == 0 -%}{%- continue -%}{%- endif -%}
                  {%- if row == 2 and odd == 1 -%}{%- continue -%}{%- endif -%}
                {%- endif -%}
                {%- assign b = block.settings -%}
                {%- assign ai = forloop.index0 | modulo: 8 -%}
                {%- assign tile_url = b.link | default: b.product.url -%}
                <figure class="sngl__tile" style="--w: {% if odd == 1 %}300{% else %}240{% endif %}px;" {{ block.shopify_attributes }}>
                  <{% if tile_url != blank %}a href="{{ tile_url }}"{% else %}div{% endif %} class="sngl__a">
                    {% render 'sn-media', image: b.image, art: arts[ai], width: 700, sizes: '300px', class: 'sngl__m sn-ripple' %}
                    <span class="sngl__hov">{% render 'sn-icon', name: b.icon, class: 'icon' %}{% if b.caption != blank %}<em>{{ b.caption }}</em>{% endif %}</span>
                  </{% if tile_url != blank %}a{% else %}div{% endif %}>
                </figure>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="sn-wrap">
      <div class="sngl__mosaic" data-sngl-mosaic>
        {%- for col in (1..3) -%}
          <div class="sngl__col" data-speed="{% case col %}{% when 1 %}.06{% when 2 %}-.08{% else %}.12{% endcase %}">
            {%- for block in section.blocks -%}
              {%- assign m = forloop.index0 | modulo: 3 | plus: 1 -%}
              {%- if m != col -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              {%- assign ai = forloop.index0 | modulo: 8 -%}
              {%- assign tall = forloop.index | modulo: 2 -%}
              {%- assign tile_url = b.link | default: b.product.url -%}
              <figure class="sngl__tile" data-r="zoom" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
                <{% if tile_url != blank %}a href="{{ tile_url }}"{% else %}div{% endif %} class="sngl__a">
                  {%- if tall == 1 -%}{%- assign rt = '4 / 5' -%}{%- else -%}{%- assign rt = '1 / 1' -%}{%- endif -%}
                  {% render 'sn-media', image: b.image, art: arts[ai], width: 900, sizes: '(min-width: 990px) 33vw, 50vw', class: 'sngl__m sn-ripple', ratio: rt %}
                  <span class="sngl__hov">{% render 'sn-icon', name: b.icon, class: 'icon' %}{% if b.caption != blank %}<em>{{ b.caption }}</em>{% endif %}</span>
                </{% if tile_url != blank %}a{% else %}div{% endif %}>
                {%- if b.product != blank -%}
                  <figcaption class="sngl__prod sn-glass">
                    <span class="sngl__dot" aria-hidden="true"></span>
                    <span><b>{{ b.product.title }}</b>{% render 'sn-price', product: b.product %}</span>
                    {%- if b.product.has_only_default_variant -%}<button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-add="{{ b.product.selected_or_first_available_variant.id }}" aria-label="Add {{ b.product.title | escape }}">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- else -%}<button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-quick="{{ b.product.handle }}" aria-label="Quick view {{ b.product.title | escape }}">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- endif -%}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
<style>
#{{ sid }} .sngl__drift { display: grid; gap: 18px; transform: rotate(-{{ s.tilt }}deg) scale(1.04); padding-block: 20px; }
#{{ sid }} .sngl__row .sngl__tile { width: var(--w); flex: none; }
#{{ sid }} .sngl__row .sngl__m { aspect-ratio: 4 / 5; }
#{{ sid }} .sngl__row:nth-child(2) .sngl__m { aspect-ratio: 1; }
#{{ sid }} .sngl__a { position: relative; display: block; border-radius: var(--r); overflow: hidden; }
#{{ sid }} .sngl__hov { position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; justify-items: center; gap: 10px; padding: 14px; text-align: center; color: #fff; background: color-mix(in srgb, var(--c-dark) 45%, transparent); opacity: 0; backdrop-filter: blur(0); transition: opacity .5s, backdrop-filter .5s; }
#{{ sid }} .sngl__hov .icon { width: 30px; height: 30px; transform: scale(.6) rotate(-20deg); transition: transform .6s cubic-bezier(.3, 1.5, .5, 1); }
#{{ sid }} .sngl__hov em { font: italic 300 1.15rem/1.3 var(--f-head); }
#{{ sid }} .sngl__a:hover .sngl__hov { opacity: 1; backdrop-filter: blur(2px); }
#{{ sid }} .sngl__a:hover .sngl__hov .icon { transform: none; }
#{{ sid }} .sngl__mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); align-items: start; }
#{{ sid }} .sngl__col { display: grid; gap: clamp(12px, 1.6vw, 22px); will-change: transform; }
#{{ sid }} .sngl__col:nth-child(2) { margin-top: 60px; }
#{{ sid }} .sngl__tile { position: relative; }
#{{ sid }} .sngl__prod { position: absolute; z-index: 3; left: 12px; right: 12px; bottom: 12px; display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 14px; border-radius: 999px; font-size: 13px; transform: translateY(8px); opacity: .0; transition: opacity .5s, transform .6s cubic-bezier(.3, 1.3, .4, 1); }
#{{ sid }} .sngl__tile:hover .sngl__prod, #{{ sid }} .sngl__prod:focus-within { opacity: 1; transform: none; }
@media (hover: none) { #{{ sid }} .sngl__prod { opacity: 1; transform: none; } }
#{{ sid }} .sngl__prod > span:nth-child(2) { flex: 1; display: grid; gap: 2px; min-width: 0; }
#{{ sid }} .sngl__prod b { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#{{ sid }} .sngl__dot { width: 10px; height: 10px; flex: none; border-radius: 50%; background: var(--ac); box-shadow: 0 0 0 0 var(--ac); animation: sngl-ping 2s infinite; }
@keyframes sngl-ping { 70% { box-shadow: 0 0 0 10px transparent; } }
@media (max-width: 749px) {
  #{{ sid }} .sngl__mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #{{ sid }} .sngl__col { display: contents; }
  #{{ sid }} .sngl__tile:nth-child(even) { translate: 0 24px; }
  #{{ sid }} .sngl__row .sngl__tile { width: calc(var(--w) * .62); }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var m = r.querySelector('[data-sngl-mosaic]'); if (!m) return;
  if (document.body.getAttribute('data-motion') === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var cols = [].slice.call(m.children), tk = false;
  function upd() { tk = false; var b = m.getBoundingClientRect(), c = Math.max(-innerHeight, Math.min(innerHeight, b.top + b.height / 2 - innerHeight / 2)); cols.forEach(function (e) { e.style.transform = 'translateY(' + (c * parseFloat(e.getAttribute('data-speed'))).toFixed(1) + 'px)'; }); }
  addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(upd); } }, { passive: true }); upd();
})();
</script>
{% schema %}
{
