{%- liquid
  assign s = section.settings
  assign sid = 'sncat-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s sncat sncat--{{ s.layout }}" style="{% render 'sn-vars', s: s %} --cols: {{ s.columns }};" data-sncat>
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, link_label: s.link_label, link_url: s.link_url, k: 2 %}
    {%- if s.layout == 'index' -%}
      <ol class="sncat__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign c = b.collection
            assign title = b.title | default: c.title | default: 'Category'
            assign url = b.link | default: c.url | default: routes.collections_url
            assign img = b.image | default: c.image
          -%}
          <li class="sncat__row" data-r style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <a href="{{ url }}" class="sncat__a" data-sncat-a>
              <span class="sncat__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span class="sncat__thumb sn-media">{%- if img != blank -%}<img src="{{ img | image_url: width: 300 }}" alt="" loading="lazy" width="150" height="190">{%- else -%}{% render 'sn-art', name: b.art %}{%- endif -%}</span>
              <span class="sncat__name">{{ title }}</span>
              {%- if b.badge != blank -%}<span class="sncat__badge">{{ b.badge }}</span>{%- endif -%}
              <span class="sncat__meta">{% if b.subtitle != blank %}{{ b.subtitle }}{% elsif c != blank and s.show_count %}{{ c.products_count }} {{ s.count_word }}{% endif %}</span>
              <span class="sncat__go">{% render 'sn-icon', name: 'arrow-up-right', class: 'icon' %}</span>
            </a>
            <template data-sncat-media>{%- if img != blank -%}<img src="{{ img | image_url: width: 800 }}" alt="" width="400" height="500">{%- else -%}{% render 'sn-art', name: b.art %}{%- endif -%}</template>
          </li>
        {%- endfor -%}
      </ol>
      <div class="sncat__float" data-sncat-float aria-hidden="true"><div class="sncat__float-in" data-sncat-fin></div><span class="sncat__float-stitch"></span></div>
    {%- else -%}
      <div class="{% if s.layout == 'rail' %}sn-rail sn-rail--bleed sncat__rail{% else %}sncat__grid{% endif %}" {% if s.layout == 'rail' %}data-sn-rail data-sn-auto="{{ s.autoplay }}" style="--col: {{ s.card_width }}px;"{% endif %} data-sn-railwrap>
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign c = b.collection
            assign title = b.title | default: c.title | default: 'Category'
            assign url = b.link | default: c.url | default: routes.collections_url
            assign img = b.image | default: c.image
          -%}
          <a class="sncat__card sn-zoom" href="{{ url }}" data-r="zoom" style="--i: {{ forloop.index0 | modulo: 6 }};" {{ block.shopify_attributes }}>
            <div class="sncat__pil sn-stitch">
              {% render 'sn-media', image: img, art: b.art, width: 900, sizes: '(min-width: 990px) 25vw, 70vw', class: 'sncat__m sn-ripple' %}
              {%- if b.badge != blank -%}<span class="sncat__tag">{{ b.badge }}</span>{%- endif -%}
            </div>
            <div class="sncat__cap">
              <span class="sncat__name">{{ title }}</span>
              <span class="sncat__go">{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</span>
            </div>
            {%- if b.subtitle != blank -%}<span class="sncat__meta">{{ b.subtitle }}</span>{%- elsif c != blank and s.show_count -%}<span class="sncat__meta">{{ c.products_count }} {{ s.count_word }}</span>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
      {%- if s.layout == 'rail' -%}
        <div class="sncat__railnav" data-sn-railwrap>
          <div class="sn-progress" data-sn-prog><i></i></div>
          <div class="sn-rail-nav"><button type="button" class="sn-ibtn" data-sn-prev aria-label="Previous">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}</button><button type="button" class="sn-ibtn" data-sn-next aria-label="Next">{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button></div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
<style>
/* index list with floating image */
#{{ sid }} .sncat__list { border-top: 1px solid var(--line); }
#{{ sid }} .sncat__row { position: relative; border-bottom: 1px solid var(--line); }
#{{ sid }} .sncat__row::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: repeating-linear-gradient(90deg, var(--ac) 0 6px, transparent 6px 11px); transform: scaleX(0); transform-origin: left; transition: transform .9s cubic-bezier(.7, 0, .2, 1); }
#{{ sid }} .sncat__row:hover::after { transform: scaleX(1); }
#{{ sid }} .sncat__a { display: grid; grid-template-columns: 54px max-content auto 1fr 56px; align-items: center; gap: 24px; padding: clamp(16px, 2.2vw, 28px) 0; transition: color .4s; }
#{{ sid }} .sncat__n { font: italic 300 1rem var(--f-head); color: var(--ac); }
#{{ sid }} .sncat__thumb { display: none; }
#{{ sid }} .sncat__name { font-family: var(--f-head); font-weight: var(--head-w); font-size: clamp(2rem, 4.6vw, 4.2rem); line-height: 1; letter-spacing: -.03em; transition: transform .7s cubic-bezier(.3, 1.2, .4, 1), color .4s, font-style .4s; }
#{{ sid }} .sncat__a:hover .sncat__name { transform: translateX(22px); color: var(--ac); font-style: italic; }
#{{ sid }} .sncat__badge { padding: 7px 14px; border-radius: 999px; border: 1px dashed var(--line2); font-size: 11.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; transition: transform .7s cubic-bezier(.3, 1.2, .4, 1); }
#{{ sid }} .sncat__a:hover .sncat__badge { transform: translateX(22px); }
#{{ sid }} .sncat__meta { justify-self: end; font-size: 13px; letter-spacing: .08em; color: var(--soft); }
#{{ sid }} .sncat__go { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line2); transition: background .5s, color .5s, border-color .5s, transform .6s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .sncat__a:hover .sncat__go { background: var(--ac); border-color: var(--ac); color: var(--ac-ink); transform: rotate(45deg); }
#{{ sid }} .sncat__go .icon { width: 20px; height: 20px; }
#{{ sid }} .sncat__float { position: fixed; z-index: 30; left: 0; top: 0; width: {{ s.float_w }}px; aspect-ratio: 4 / 5; border-radius: calc(var(--r) * 1.4); overflow: hidden; pointer-events: none; opacity: 0; transform: translate3d(var(--fx, 0), var(--fy, 0), 0) rotate(var(--fr, 0deg)) scale(.6); transition: opacity .45s ease, transform .55s cubic-bezier(.2, .8, .2, 1); box-shadow: 0 40px 80px -30px rgba(20, 22, 40, .55); }
#{{ sid }} .sncat__float.is-on { opacity: 1; transform: translate3d(var(--fx, 0), var(--fy, 0), 0) rotate(var(--fr, 0deg)) scale(1); }
#{{ sid }} .sncat__float-in, #{{ sid }} .sncat__float-in > * { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .sncat__float-in > * { animation: sncat-in .6s cubic-bezier(.2, .8, .2, 1); }
@keyframes sncat-in { from { opacity: 0; transform: scale(1.15); filter: blur(8px); } }
#{{ sid }} .sncat__float-stitch { position: absolute; inset: 8px; border-radius: calc(var(--r) * 1.4 - 6px); border: 1px dashed rgba(255, 255, 255, .7); }
body[data-ripple="on"] #{{ sid }} .sncat__float-in img { filter: url(#sn-ripple); }

/* grid + rail cards */
#{{ sid }} .sncat__grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: clamp(14px, 2vw, 28px); }
#{{ sid }} .sncat__card { display: grid; gap: 14px; }
#{{ sid }} .sncat__pil { position: relative; border-radius: calc(var(--r) * 1.3); overflow: hidden; transition: transform .7s cubic-bezier(.3, 1.2, .4, 1), border-radius .7s; }
#{{ sid }} .sncat__card:hover .sncat__pil { transform: translateY(-8px); border-radius: calc(var(--r) * 1.7); }
#{{ sid }} .sncat__m { aspect-ratio: {{ s.ratio }}; border-radius: 0; }
#{{ sid }} .sncat__tag { position: absolute; z-index: 2; left: 14px; bottom: 14px; padding: 7px 13px; border-radius: 999px; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--tx); }
#{{ sid }} .sncat__cap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-inline: 4px; }
#{{ sid }} .sncat__card .sncat__name { font-size: clamp(1.35rem, 1.9vw, 1.75rem); letter-spacing: -.01em; }
#{{ sid }} .sncat__card .sncat__go { width: 42px; height: 42px; }
#{{ sid }} .sncat__card:hover .sncat__go { background: var(--tx); color: var(--bg); border-color: var(--tx); transform: translateX(4px); }
#{{ sid }} .sncat__card .sncat__meta { justify-self: start; padding-inline: 4px; margin-top: -8px; }
#{{ sid }} .sncat__railnav { display: flex; align-items: center; gap: 24px; margin-top: 34px; }
#{{ sid }} .sncat__railnav .sn-progress { flex: 1; }
@media (max-width: 989px) {
  #{{ sid }} .sncat__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #{{ sid }} .sncat__a { grid-template-columns: 74px minmax(0, 1fr) 44px; gap: 14px; }
  #{{ sid }} .sncat__n, #{{ sid }} .sncat__meta, #{{ sid }} .sncat__badge { display: none; }
  #{{ sid }} .sncat__thumb { display: block; aspect-ratio: 4 / 5; border-radius: calc(var(--r) * .5); }
  #{{ sid }} .sncat__go { width: 44px; height: 44px; }
  #{{ sid }} .sncat__float { display: none; }
  #{{ sid }} .sncat__name { font-size: clamp(1.7rem, 7vw, 2.4rem); }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var fl = r.querySelector('[data-sncat-float]'); if (!fl || !matchMedia('(hover: hover) and (min-width: 990px)').matches) return;
  var fin = r.querySelector('[data-sncat-fin]'), x = 0, y = 0, tx = 0, ty = 0, raf = null, last = null, vx = 0;
  function loop() { raf = null; var px = x; x += (tx - x) * .14; y += (ty - y) * .14; vx = x - px; fl.style.setProperty('--fx', x + 'px'); fl.style.setProperty('--fy', y + 'px'); fl.style.setProperty('--fr', Math.max(-12, Math.min(12, vx * .6)) + 'deg'); if (Math.abs(tx - x) > .5 || Math.abs(ty - y) > .5) raf = requestAnimationFrame(loop); }
  r.querySelectorAll('[data-sncat-a]').forEach(function (a) {
    a.addEventListener('mouseenter', function () {
      var t = a.parentNode.querySelector('template[data-sncat-media]');
      if (t && last !== a) { fin.innerHTML = ''; fin.appendChild(t.content.cloneNode(true)); last = a; }
      fl.classList.add('is-on');
    });
    a.addEventListener('mouseleave', function () { fl.classList.remove('is-on'); });
  });
  r.addEventListener('pointermove', function (e) { var w = fl.offsetWidth, h = fl.offsetHeight; tx = e.clientX + 30; ty = e.clientY - h / 2; if (tx + w > innerWidth - 20) tx = e.clientX - w - 30; if (!raf) raf = requestAnimationFrame(loop); });
})();
</script>
