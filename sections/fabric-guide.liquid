{%- comment -%}
  Fabric index: a grid of fabric cards with optional ratings and weave/fibre filter chips.
  Source order: picked fabric blocks -> page.metafields.sakooon.related_fabrics -> all fabrics by sort_order
  (snippets/fabric-handles.liquid). Reference: Tekla textile-care index (docs/reference/editorial.md 2.3). Owner: shad-8b.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign exclude = ''
  if s.exclude_current and metaobject != blank
    assign exclude = metaobject.system.handle
  endif
-%}
{%- capture handles -%}{% render 'fabric-handles', blocks: section.blocks, page: page, exclude: exclude, limit: s.limit %}{%- endcapture -%}
{%- liquid
  assign handle_list = handles | strip | split: ','
  assign filter_values = ''
  for h in handle_list
    assign f = shop.metaobjects.fabric[h]
    assign v = f[s.filter_by].value
    if v != blank
      assign key = v | handleize
      unless filter_values contains key
        assign filter_values = filter_values | append: key | append: '::' | append: v | append: '||'
      endunless
    endif
  endfor
  assign filters = filter_values | split: '||'
  assign col_vw = 100 | divided_by: s.columns
  assign card_sizes = '(min-width: 1024px) ' | append: col_vw | append: 'vw, (min-width: 768px) 50vw, 100vw'
-%}
{%- liquid
  assign item_tag = 'h2'
  if section.settings.heading != blank
    assign item_tag = 'h3'
  endif
-%}
<div class="section ed-section fabric-guide color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --ed-cols: {{ s.columns }}">
  <fabric-guide class="page-width ed-wide" data-filter-by="{{ s.filter_by }}">
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, heading_size: s.heading_size, text: s.text, link_label: s.link_label, link_url: s.link_url %}
    {%- if s.show_filters and filters.size > 1 -%}
      <div class="fabric-guide__filters" role="group" aria-label="{{ 'editorial.fabric_guide.filter_label' | t }}">
        <button type="button" class="fabric-guide__chip" aria-pressed="true" data-filter="">{{ 'editorial.fabric_guide.all' | t }}</button>
        {%- for item in filters -%}
          {%- assign parts = item | split: '::' -%}
          <button type="button" class="fabric-guide__chip" aria-pressed="false" data-filter="{{ parts[0] }}">{{ parts[1] | capitalize }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if s.layout == 'panels' and handles != blank -%}
      <div class="fabric-guide__panels">
        {%- for h in handle_list -%}
          {%- assign f = shop.metaobjects.fabric[h] -%}
          {%- if f == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign banner = f.texture_image.value | default: f.lifestyle_image.value
            assign chips = f.feel.value | split: ','
            if chips.size == 0 and f.best_for.value != blank
              assign chips = f.best_for.value
            endif
            assign products = f.related_products.value
            if products == blank and f.collection.value != blank
              assign products = f.collection.value.products
            endif
            assign panel_id = 'fabric-panel-' | append: section.id | append: '-' | append: h
            assign sub_tag = 'h4'
            if item_tag == 'h2'
              assign sub_tag = 'h3'
            endif
          -%}
          <article class="fabric-panel fabric-guide__item" data-weave="{{ f.weave.value | handleize }}" data-fibre="{{ f.fibre.value | handleize }}" aria-labelledby="{{ panel_id }}-title">
            <div class="fabric-panel__banner media">
              {% render 'image', image: banner, sizes: '(min-width: 1280px) 1168px, 100vw', aspect: 'natural', alt: '', placeholder: 'collection-1' %}
              <{{ item_tag }} class="fabric-panel__name h2" id="{{ panel_id }}-title">
                {%- if f.system.url != blank -%}<a href="{{ f.system.url }}">{{ f.name.value }}</a>{%- else -%}{{ f.name.value }}{%- endif -%}
              </{{ item_tag }}>
            </div>
            <div class="fabric-panel__body">
              <div class="fabric-panel__info">
                {%- if chips.size > 0 -%}
                  <ul class="fabric-panel__chips list-unstyled" role="list">{%- for c in chips limit: 4 -%}{%- assign chip = c | strip -%}{%- if chip != blank -%}<li>{{ chip | capitalize }}</li>{%- endif -%}{%- endfor -%}</ul>
                {%- endif -%}
                {%- if f.summary.value != blank -%}<p class="fabric-panel__statement">{{ f.summary.value }}</p>{%- endif -%}
                <div class="fabric-panel__accordions">
                  {%- capture feel_content -%}
                    {%- if f.description.value != blank -%}{{ f.description | metafield_tag }}{%- endif -%}
                    {%- if s.show_ratings -%}{% render 'fabric-rating', fabric: f, compact: true %}{%- endif -%}
                  {%- endcapture -%}
                  {%- if feel_content != blank -%}
                    {%- assign acc_id = panel_id | append: '-feel' -%}
                    {% render 'accordion', id: acc_id, title: s.panel_feel_label, content: feel_content, icon: 'chevron-down', heading_tag: sub_tag %}
                  {%- endif -%}
                  {%- capture care_content -%}
                    {%- if f.care_symbols.value != blank -%}{% render 'care-icons', symbols: f.care_symbols.value %}{%- endif -%}
                    {%- if f.care.value != blank -%}{{ f.care | metafield_tag }}{%- endif -%}
                    {%- if f.care_guide.value != blank -%}<p><a class="link" href="{{ f.care_guide.value.url }}">{{ f.care_guide.value.title }}</a></p>{%- endif -%}
                  {%- endcapture -%}
                  {%- if care_content != blank -%}
                    {%- assign acc_id = panel_id | append: '-care' -%}
                    {% render 'accordion', id: acc_id, title: s.panel_care_label, content: care_content, icon: 'chevron-down', heading_tag: sub_tag %}
                  {%- endif -%}
                </div>
              </div>
              {%- if products != blank or f.collection.value != blank -%}
                <div class="fabric-panel__shop">
                  {%- if products != blank -%}
                    <ul class="fabric-panel__products list-unstyled" role="list" tabindex="0" aria-label="{{ 'editorial.fabric.shop' | t: name: f.name.value | escape }}">
                      {%- for product in products limit: 6 -%}<li>{% render 'product-card', product: product, columns_desktop: 3, image_ratio: 'portrait', heading_tag: sub_tag, show_swatches: true %}</li>{%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if f.collection.value != blank -%}
                    {%- assign shop_label = 'editorial.fabric.shop_all' | t: name: f.name.value -%}
                    {% render 'button', label: shop_label, url: f.collection.value.url, style: 'primary', full_width: true %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
    <ul class="fabric-guide__grid list-unstyled" role="list">
      {%- if handles != blank -%}
        {%- for h in handle_list -%}
          {%- assign f = shop.metaobjects.fabric[h] -%}
          {%- if f != blank -%}
            <li class="fabric-guide__item">{% render 'fabric-card', fabric: f, ratio: s.image_ratio, show_summary: s.show_summary, show_rating: s.show_ratings, heading_tag: item_tag, sizes: card_sizes, link_label: s.card_link_label %}</li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.columns) -%}
          <li class="fabric-guide__item">{% render 'fabric-card', fabric: blank, ratio: s.image_ratio, show_summary: s.show_summary, heading_tag: item_tag %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- endif -%}
    <p class="fabric-guide__empty" hidden>{{ 'editorial.fabric_guide.no_results' | t }}</p>
  </fabric-guide>
</div>

{% schema %}
{
  "name": "t:sections.fabric-guide.name",
  "tag": "section",
  "class": "section-fabric-guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.editorial.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.editorial.settings.heading.label", "default": "Our fabrics" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h3", "options": [
      { "value": "h2", "label": "t:sections.all.heading_size.options.h2" },
      { "value": "h3", "label": "t:sections.all.heading_size.options.h3" },
      { "value": "h4", "label": "t:sections.all.heading_size.options.h4" }
    ] },
    { "type": "richtext", "id": "text", "label": "t:sections.editorial.settings.text.label" },
    { "type": "text", "id": "link_label", "label": "t:sections.editorial.blocks.button.settings.label.label" },
    { "type": "url", "id": "link_url", "label": "t:sections.editorial.blocks.button.settings.url.label" },
    { "type": "paragraph", "content": "t:sections.fabric-guide.settings.source.content" },
    { "type": "range", "id": "limit", "min": 2, "max": 24, "step": 1, "label": "t:sections.fabric-guide.settings.limit.label", "default": 12 },
    { "type": "checkbox", "id": "exclude_current", "label": "t:sections.fabric-guide.settings.exclude_current.label", "default": true },
    { "type": "select", "id": "layout", "label": "t:sections.fabric-guide.settings.layout.label", "default": "grid", "options": [
      { "value": "grid", "label": "t:sections.fabric-guide.settings.layout.options.grid" },
      { "value": "panels", "label": "t:sections.fabric-guide.settings.layout.options.panels" }
    ] },
    { "type": "text", "id": "panel_feel_label", "label": "t:sections.fabric-guide.settings.panel_feel_label.label", "default": "Feel and benefits" },
    { "type": "text", "id": "panel_care_label", "label": "t:sections.fabric-guide.settings.panel_care_label.label", "default": "Craftsmanship and care" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "t:sections.editorial.settings.columns.label", "default": 3 },
    { "type": "select", "id": "image_ratio", "label": "t:sections.editorial.settings.image_ratio.label", "default": "4/5", "options": [
      { "value": "4/5", "label": "t:sections.editorial.settings.image_ratio.options.portrait" },
      { "value": "1/1", "label": "t:sections.editorial.settings.image_ratio.options.square" },
      { "value": "5/4", "label": "t:sections.editorial.settings.image_ratio.options.landscape" }
    ] },
    { "type": "checkbox", "id": "show_summary", "label": "t:sections.fabric-guide.settings.show_summary.label", "default": true },
    { "type": "checkbox", "id": "show_ratings", "label": "t:sections.fabric-guide.settings.show_ratings.label", "default": false },
    { "type": "text", "id": "card_link_label", "label": "t:sections.fabric-guide.settings.card_link_label.label", "default": "Read more" },
    { "type": "checkbox", "id": "show_filters", "label": "t:sections.fabric-guide.settings.show_filters.label", "default": false },
    { "type": "select", "id": "filter_by", "label": "t:sections.fabric-guide.settings.filter_by.label", "default": "weave", "options": [
      { "value": "weave", "label": "t:sections.fabric-guide.settings.filter_by.options.weave" },
      { "value": "fibre", "label": "t:sections.fabric-guide.settings.filter_by.options.fibre" }
    ] },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "paper" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    { "type": "fabric", "name": "t:sections.fabric-guide.blocks.fabric.name", "settings": [
      { "type": "metaobject", "id": "fabric", "metaobject_type": "fabric", "label": "t:sections.fabric-guide.blocks.fabric.settings.fabric.label" }
    ] }
  ],
  "presets": [ { "name": "t:sections.fabric-guide.presets.name" } ]
}
{% endschema %}
