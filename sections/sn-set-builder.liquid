{%- liquid
  assign s = section.settings
  assign sid = 'snsb-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snsb" style="{% render 'sn-vars', s: s %}" data-snsb data-discount="{{ s.discount }}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 3 %}
    <div class="snsb__grid">
      <div class="snsb__stack-wrap" data-r="zoom">
        <div class="snsb__stack" data-snsb-stack>
          <div class="snsb__empty" data-snsb-empty>{% render 'sn-art', name: 'bed' %}<p>{{ s.empty_text }}</p></div>
        </div>
        <div class="snsb__sum sn-pillow sn-stitch">
          <div class="snsb__row"><span>{{ s.items_label }}</span><b data-snsb-n>0</b></div>
          <div class="snsb__row"><span>{{ s.total_label }}</span><b class="snsb__tot"><s data-snsb-was hidden></s><span data-snsb-total>{{ 0 | money }}</span></b></div>
          {%- if s.discount > 0 -%}<p class="snsb__save" data-snsb-save hidden>{{ s.save_text | replace: '[percent]', s.discount }}</p>{%- endif -%}
          <button type="button" class="sn-btn sn-btn--gold sn-btn--block" data-snsb-add disabled><span>{{ s.add_label }}</span>{% render 'sn-icon', name: 'bag', class: 'icon' %}</button>
          {%- if s.note != blank -%}<p class="sn-small">{{ s.note }}</p>{%- endif -%}
        </div>
      </div>
      <ol class="snsb__steps">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="snsb__step{% if forloop.first %} is-open{% endif %}" data-snsb-step data-req="{{ b.required }}" {{ block.shopify_attributes }} data-r style="--i: {{ forloop.index0 }};">
            <button type="button" class="snsb__sh" data-snsb-toggle>
              <span class="snsb__num">{{ forloop.index }}</span>
              <span class="snsb__st"><b>{{ b.title }}</b><small data-snsb-picked>{% if b.required %}{{ s.required_word }}{% else %}{{ s.optional_word }}{% endif %}</small></span>
              <i class="snsb__chev">{% render 'sn-icon', name: 'chevron-down', class: 'icon' %}</i>
            </button>
            <div class="snsb__body">
              <div class="snsb__opts">
                {%- if b.collection != blank and b.collection.products.size > 0 -%}
                  {%- for p in b.collection.products limit: s.per_step -%}
                    {%- assign v = p.selected_or_first_available_variant -%}
                    <label class="snsb__opt{% unless p.available %} is-out{% endunless %}">
                      <input type="radio" name="snsb-{{ section.id }}-{{ forloop.parentloop.index }}" value="{{ v.id }}" data-price="{{ v.price }}" data-cmp="{{ v.compare_at_price | default: v.price }}" data-title="{{ p.title | escape }}" data-img="{% if p.featured_media %}{{ p.featured_media | image_url: width: 500 }}{% endif %}" {% unless p.available %}disabled{% endunless %}>
                      <span class="snsb__oimg sn-media">{%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 200 }}" alt="" loading="lazy" width="100" height="125">{%- else -%}{% render 'sn-art', name: b.art %}{%- endif -%}</span>
                      <span class="snsb__ot"><b>{{ p.title }}</b><small>{{ v.price | money }}</small></span>
                      {%- if p.variants.size > 1 -%}
                        <select class="snsb__vs" aria-label="Options for {{ p.title | escape }}" data-snsb-vs>
                          {%- for vv in p.variants -%}<option value="{{ vv.id }}" data-price="{{ vv.price }}" data-cmp="{{ vv.compare_at_price | default: vv.price }}"{% unless vv.available %} disabled{% endunless %}{% if vv.id == v.id %} selected{% endif %}>{{ vv.title }}</option>{%- endfor -%}
                        </select>
                      {%- endif -%}
                      <i class="snsb__tick">{% render 'sn-icon', name: 'check', class: 'icon' %}</i>
                    </label>
                  {%- endfor -%}
                  {%- unless b.required -%}
                    <label class="snsb__opt snsb__opt--skip"><input type="radio" name="snsb-{{ section.id }}-{{ forloop.index }}" value="" checked><span class="snsb__ot"><b>{{ s.skip_label }}</b>{%- if s.skip_note != blank -%}<small>{{ s.skip_note }}</small>{%- endif -%}</span><i class="snsb__tick">{% render 'sn-icon', name: 'check', class: 'icon' %}</i></label>
                  {%- endunless -%}
                {%- else -%}
                  <p class="sn-small">{{ s.no_products }}</p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snsb__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(30px, 5vw, 80px); align-items: start; }
#{{ sid }} .snsb__stack-wrap { position: sticky; top: 110px; display: grid; gap: 22px; }
#{{ sid }} .snsb__stack { position: relative; aspect-ratio: 1; border-radius: calc(var(--r) * 1.4); background: radial-gradient(circle at 50% 60%, color-mix(in srgb, var(--ac) 14%, transparent), transparent 70%), var(--card2); overflow: hidden; perspective: 1200px; }
#{{ sid }} .snsb__empty { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity .5s; }
#{{ sid }} .snsb__empty .sn-art { position: absolute; inset: 0; opacity: .35; filter: grayscale(.4); }
#{{ sid }} .snsb__empty p { position: relative; padding: 10px 18px; border-radius: 999px; background: var(--bg); font: italic 300 1.1rem var(--f-head); }
#{{ sid }} .snsb__stack.has-items .snsb__empty { opacity: 0; }
#{{ sid }} .snsb__layer { position: absolute; left: 50%; top: 50%; width: 46%; aspect-ratio: 4 / 5; margin: -29% 0 0 -23%; border-radius: calc(var(--r) * .9); overflow: hidden; background: var(--card); box-shadow: 0 30px 50px -24px rgba(20, 22, 40, .5); transform: translate(var(--tx, 0), var(--ty, 0)) rotate(var(--rot, 0deg)); animation: snsb-drop .9s cubic-bezier(.3, 1.3, .4, 1) both; }
#{{ sid }} .snsb__layer img { width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .snsb__layer::after { content: ""; position: absolute; inset: 6px; border-radius: calc(var(--r) * .9 - 5px); border: 1px dashed rgba(255, 255, 255, .7); }
@keyframes snsb-drop { from { opacity: 0; transform: translate(var(--tx, 0), -140%) rotate(calc(var(--rot, 0deg) * -3)) scale(1.1); } }
#{{ sid }} .snsb__sum { display: grid; gap: 12px; padding: 24px; }
#{{ sid }} .snsb__row { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snsb__row b { font: 300 1.7rem/1 var(--f-head); letter-spacing: 0; text-transform: none; color: var(--tx); }
#{{ sid }} .snsb__sum .snsb__row, #{{ sid }} .snsb__sum .sn-small { color: color-mix(in srgb, var(--tx) 78%, transparent); }
#{{ sid }} .snsb__tot s { font-size: .6em; color: var(--mute); margin-right: 8px; }
#{{ sid }} .snsb__save { padding: 10px 14px; border-radius: 12px; background: color-mix(in srgb, var(--c-signal) 14%, transparent); font-size: 13.5px; }
#{{ sid }} .snsb__steps { display: grid; gap: 12px; }
#{{ sid }} .snsb__step { border-radius: calc(var(--r) * .9); border: 1px solid var(--line); background: var(--card); overflow: hidden; transition: border-color .4s, box-shadow .4s; }
#{{ sid }} .snsb__step.is-open { border-color: color-mix(in srgb, var(--ac) 50%, transparent); box-shadow: 0 30px 60px -44px rgba(20, 22, 40, .5); }
#{{ sid }} .snsb__sh { width: 100%; display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 16px; padding: 18px 20px; text-align: left; }
#{{ sid }} .snsb__num { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 1px dashed var(--ac); font: 300 1.2rem var(--f-head); color: var(--ac); transition: background .4s, color .4s; }
#{{ sid }} .snsb__step.is-done .snsb__num { background: var(--ac); color: var(--ac-ink); border-style: solid; }
#{{ sid }} .snsb__st b { display: block; font: 400 1.25rem/1.2 var(--f-head); }
#{{ sid }} .snsb__st small { font-size: 12.5px; color: var(--soft); }
#{{ sid }} .snsb__chev .icon { width: 18px; height: 18px; transition: transform .5s; }
#{{ sid }} .snsb__step.is-open .snsb__chev .icon { transform: rotate(180deg); }
#{{ sid }} .snsb__body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .6s cubic-bezier(.3, .7, .2, 1); }
#{{ sid }} .snsb__step.is-open .snsb__body { grid-template-rows: 1fr; }
#{{ sid }} .snsb__opts { min-height: 0; overflow: hidden; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 0 20px; }
#{{ sid }} .snsb__step.is-open .snsb__opts { padding-bottom: 20px; }
#{{ sid }} .snsb__opt { position: relative; display: grid; grid-template-columns: 56px 1fr; align-items: center; gap: 12px; padding: 10px 36px 10px 10px; border-radius: calc(var(--r) * .6); border: 1px solid var(--line); cursor: pointer; transition: border-color .3s, background .3s, transform .4s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .snsb__opt:hover { transform: translateY(-2px); border-color: var(--line2); }
#{{ sid }} .snsb__opt input[type=radio] { position: absolute; opacity: 0; pointer-events: none; }
#{{ sid }} .snsb__opt:has(input:checked) { border-color: var(--ac); background: color-mix(in srgb, var(--ac) 8%, transparent); }
#{{ sid }} .snsb__opt.is-out { opacity: .45; cursor: not-allowed; }
#{{ sid }} .snsb__opt--skip { grid-column: 1 / -1; grid-template-columns: 1fr; padding: 11px 44px 11px 16px; border-style: dashed; }
#{{ sid }} .snsb__opt--skip .snsb__ot { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 8px; }
#{{ sid }} .snsb__opt--skip .snsb__tick { top: calc(50% - 11px); }
#{{ sid }} .snsb__oimg { aspect-ratio: 4 / 5; border-radius: 10px; }
#{{ sid }} .snsb__ot { display: grid; gap: 2px; } #{{ sid }} .snsb__ot b { font-weight: 500; font-size: 14px; line-height: 1.3; } #{{ sid }} .snsb__ot small { color: var(--soft); font-size: 12.5px; }
#{{ sid }} .snsb__vs { grid-column: 1 / -1; padding: 8px 10px; border-radius: 10px; border: 1px solid var(--line2); background: var(--bg); font-size: 13px; }
#{{ sid }} .snsb__tick { position: absolute; right: 10px; top: 10px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--ac); color: #fff; transform: scale(0); transition: transform .4s cubic-bezier(.3, 1.6, .5, 1); }
#{{ sid }} .snsb__tick .icon { width: 12px; height: 12px; }
#{{ sid }} .snsb__opt:has(input:checked) .snsb__tick { transform: scale(1); }
@media (max-width: 989px) { #{{ sid }} .snsb__grid { grid-template-columns: 1fr; } #{{ sid }} .snsb__stack-wrap { position: static; } #{{ sid }} .snsb__stack { max-width: 420px; width: 100%; justify-self: center; } }
@media (max-width: 599px) { #{{ sid }} .snsb__opts { grid-template-columns: 1fr; } }
</style>
<script>
SN.ready(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var steps = r.querySelectorAll('[data-snsb-step]'), stack = r.querySelector('[data-snsb-stack]'), add = r.querySelector('[data-snsb-add]');
  var disc = parseFloat(r.getAttribute('data-discount')) || 0;
  var pos = [['-22%', '-8%', '-9deg'], ['18%', '-14%', '7deg'], ['-12%', '16%', '4deg'], ['20%', '14%', '-6deg'], ['0%', '0%', '2deg'], ['-26%', '22%', '-3deg']];
  steps.forEach(function (st) { st.querySelector('[data-snsb-toggle]').addEventListener('click', function () { var o = st.classList.contains('is-open'); steps.forEach(function (x) { x.classList.remove('is-open'); }); if (!o) st.classList.add('is-open'); }); });
  function chosen() {
    var out = [];
    steps.forEach(function (st, i) {
      var inp = st.querySelector('input:checked'); if (!inp || !inp.value) return;
      var opt = inp.closest('.snsb__opt'), vs = opt.querySelector('[data-snsb-vs]'), id = inp.value, pr = +inp.getAttribute('data-price'), cm = +inp.getAttribute('data-cmp');
      if (vs) { var o = vs.options[vs.selectedIndex]; id = o.value; pr = +o.getAttribute('data-price'); cm = +o.getAttribute('data-cmp'); }
      out.push({ i: i, id: +id, price: pr, cmp: cm, img: inp.getAttribute('data-img'), title: inp.getAttribute('data-title') });
    });
    return out;
  }
  function paint(changed) {
    var c = chosen(), tot = 0, cmp = 0;
    c.forEach(function (x) { tot += x.price; cmp += Math.max(x.cmp, x.price); });
    var fin = disc > 0 && c.length > 1 ? Math.round(tot * (1 - disc / 100)) : tot;
    r.querySelector('[data-snsb-n]').textContent = c.length;
    r.querySelector('[data-snsb-total]').textContent = SN.money(fin);
    var was = r.querySelector('[data-snsb-was]'); if (was) { was.hidden = !(cmp > fin && c.length); was.textContent = SN.money(cmp); }
    var sv = r.querySelector('[data-snsb-save]'); if (sv) sv.hidden = !(disc > 0 && c.length > 1);
    var ok = c.length > 0; steps.forEach(function (st) { var inp = st.querySelector('input:checked'); var done = inp && inp.value; st.classList.toggle('is-done', !!done); if (st.getAttribute('data-req') === 'true' && !done) ok = false; var lbl = st.querySelector('[data-snsb-picked]'); if (done) lbl.textContent = inp.getAttribute('data-title'); });
    add.disabled = !ok;
    if (changed != null) {
      stack.querySelectorAll('.snsb__layer[data-i="' + changed + '"]').forEach(function (l) { l.remove(); });
      var it = c.find(function (x) { return x.i === changed; });
      if (it) { var p = pos[changed % pos.length], d = document.createElement('div'); d.className = 'snsb__layer'; d.setAttribute('data-i', changed); d.style.cssText = '--tx:' + p[0] + ';--ty:' + p[1] + ';--rot:' + p[2] + ';z-index:' + (changed + 1); d.innerHTML = it.img ? '<img src="' + it.img + '" alt="">' : ''; if (!it.img) d.style.background = 'linear-gradient(160deg,var(--card),var(--card2))'; stack.appendChild(d); }
      stack.classList.toggle('has-items', c.length > 0);
    }
  }
  steps.forEach(function (st, i) {
    st.addEventListener('change', function (e) {
      paint(i);
      if (e.target.type === 'radio' && e.target.value) setTimeout(function () { var nx = steps[i + 1]; if (nx && !nx.classList.contains('is-done')) { st.classList.remove('is-open'); nx.classList.add('is-open'); } }, 350);
    });
  });
  add.addEventListener('click', function () { var items = chosen().map(function (x) { return { id: x.id, quantity: 1, properties: { _bundle: 'Sakooon set' } }; }); if (!items.length) return; add.classList.add('is-busy'); SN.cart.add(items).catch(function () {}).then(function () { add.classList.remove('is-busy'); }); });
  steps.forEach(function (st, i) { if (st.querySelector('input:checked') && st.querySelector('input:checked').value) paint(i); });
  paint();
});
</script>
