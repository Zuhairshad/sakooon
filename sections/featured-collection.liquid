{%- comment -%}
  Featured collection. Owner: shad-2d. Pattern: Parachute product rail (fixed-width cards, horizontal scroll with
  prev/next, "view all" button below) or a static grid. Cards: snippets/product-card.liquid (owner shad-d8).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign limit = s.products_to_show
  assign heading_id = 'FeaturedCollection-' | append: section.id
-%}
<div class="section product-rail product-rail--{{ s.layout }} color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --rail-card: {{ s.card_width }}px; --rail-columns: {{ s.columns_desktop }};">
  <scroll-rail class="page-width page-width--full product-rail__inner">
    <div class="product-rail__head">
      {%- render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, heading_size: s.heading_size, text: s.text, link_label: s.link_label, link_url: collection.url -%}
      {%- if s.layout == 'carousel' -%}
        <div class="rail-buttons">
          <button type="button" class="rail-button" data-rail-prev aria-label="{{ 'storefront.sections.previous' | t }}" aria-controls="{{ heading_id }}-track">{% render 'icon', icon: 'chevron-left', size: 18 %}</button>
          <button type="button" class="rail-button" data-rail-next aria-label="{{ 'storefront.sections.next' | t }}" aria-controls="{{ heading_id }}-track">{% render 'icon', icon: 'chevron-right', size: 18 %}</button>
        </div>
      {%- endif -%}
    </div>
    <ul id="{{ heading_id }}-track" class="product-rail__track list-unstyled{% if s.layout == 'carousel' %} no-scrollbar{% endif %}" role="list" data-rail-track{% if s.layout == 'carousel' %} tabindex="0" aria-label="{{ s.heading | default: collection.title | escape }}"{% endif %}>
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li class="product-rail__item">
            {%- render 'product-card', product: product, columns_desktop: s.columns_desktop, image_ratio: s.image_ratio, lazy: true, sizes: '(min-width: 768px) 320px, 60vw' -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li class="product-rail__item">{%- render 'product-card', product: blank, image_ratio: s.image_ratio -%}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if s.view_all_label != blank -%}
      <div class="product-rail__footer">
        {%- assign view_all_url = collection.url | default: routes.all_products_collection_url -%}
        {%- render 'button', label: s.view_all_label, url: view_all_url, style: s.view_all_style -%}
      </div>
    {%- endif -%}
  </scroll-rail>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the collection" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h3", "options": [ { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" }, { "value": "h4", "label": "t:sections.all.heading_size.options.h4" } ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Heading link label", "info": "Links to the collection." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [ { "value": "carousel", "label": "Carousel" }, { "value": "grid", "label": "Grid" } ] },
    { "type": "range", "id": "card_width", "label": "Card width (carousel, desktop)", "min": 200, "max": 400, "step": 8, "unit": "px", "default": 256 },
    { "type": "range", "id": "columns_desktop", "label": "Columns (grid, desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "adapt", "label": "Adapt to image" } ] },
    { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "View all" },
    { "type": "select", "id": "view_all_style", "label": "View all button style", "default": "primary", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "tertiary", "label": "Text link" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "white" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
