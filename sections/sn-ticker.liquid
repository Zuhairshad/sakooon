{%- liquid
  assign s = section.settings
  assign sid = 'sntk-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s sntk sntk--{{ s.style }} sntk--{{ s.size }}" style="{% render 'sn-vars', s: s %}" aria-label="{{ s.label | escape }}">
  {% render 'sn-divider', s: s %}
  {%- for row in (1..2) -%}
    {%- if row == 2 and s.style != 'ribbons' -%}{%- break -%}{%- endif -%}
    <div class="sntk__band{% if row == 2 %} sntk__band--2{% endif %}">
      <div class="sn-marq{% if row == 2 %} sn-marq--rev{% endif %}" style="--dur: {{ s.speed }}s; --gap: {{ s.gap }}px;">
        {%- for copy in (1..2) -%}
          <div class="sn-marq__t{% if s.pause %} is-pausable{% endif %}"{% if copy == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <span class="sntk__w{% if b.italic %} is-it{% endif %}{% if b.outline %} is-ol{% endif %}" {{ block.shopify_attributes }}>
                {%- if b.image != blank -%}<span class="sntk__img"><img src="{{ b.image | image_url: width: 200 }}" alt="" loading="lazy" width="100" height="100"></span>{%- endif -%}
                {%- if b.link != blank -%}<a href="{{ b.link }}">{{ b.text }}</a>{%- else -%}{{ b.text }}{%- endif -%}
              </span>
              <span class="sntk__sep" aria-hidden="true">{% render 'sn-icon', name: s.separator, class: 'icon' %}</span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}
</section>
<style>
#{{ sid }} { overflow: hidden; }
#{{ sid }} .sntk__band { position: relative; padding-block: 14px; }
#{{ sid }}.sntk--ribbons { padding-block: calc(var(--pt) + 40px) calc(var(--pb) + 40px); }
#{{ sid }}.sntk--ribbons .sntk__band { width: 110%; margin-left: -5%; background: var(--tx); color: var(--bg); transform: rotate(-3deg); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .4); }
#{{ sid }}.sntk--ribbons .sntk__band::before, #{{ sid }}.sntk--ribbons .sntk__band::after { content: ""; position: absolute; left: 0; right: 0; height: 1px; border-top: 1px dashed color-mix(in srgb, var(--bg) 45%, transparent); }
#{{ sid }}.sntk--ribbons .sntk__band::before { top: 6px; } #{{ sid }}.sntk--ribbons .sntk__band::after { bottom: 6px; }
#{{ sid }}.sntk--ribbons .sntk__band--2 { position: absolute; left: 0; top: 50%; translate: 0 -50%; transform: rotate(3deg); background: var(--ac); color: var(--ac-ink, #fff); z-index: -1; }
#{{ sid }}.sntk--ribbons .sn-marq { -webkit-mask-image: none; mask-image: none; }
#{{ sid }}.sntk--line { border-block: 1px solid var(--line); }
#{{ sid }} .sn-marq__t { align-items: center; }
#{{ sid }} .sntk__w { display: inline-flex; align-items: center; gap: 18px; font-family: var(--f-head); font-weight: var(--head-w); line-height: 1.1; white-space: nowrap; letter-spacing: -.015em; transition: color .4s; }
#{{ sid }}.sntk--s .sntk__w { font-size: clamp(1.3rem, 2.2vw, 1.8rem); }
#{{ sid }}.sntk--m .sntk__w { font-size: clamp(2rem, 4vw, 3.4rem); }
#{{ sid }}.sntk--l .sntk__w { font-size: clamp(2.8rem, 7.4vw, 7rem); }
#{{ sid }} .sntk__w.is-it { font-style: italic; color: var(--ac); }
#{{ sid }}.sntk--ribbons .sntk__band .sntk__w.is-it { color: inherit; }
#{{ sid }} .sntk__w.is-ol { color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, currentColor 60%, transparent); }
#{{ sid }} .sntk__w.is-ol { -webkit-text-stroke-color: color-mix(in srgb, var(--tx) 55%, transparent); }
#{{ sid }} .sntk__w:hover { color: var(--ac); }
#{{ sid }} .sntk__img { width: 1.2em; height: 1.2em; border-radius: 50%; overflow: hidden; flex: none; }
#{{ sid }} .sntk__img img { width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .sntk__sep { display: grid; place-items: center; color: var(--ac); }
#{{ sid }}.sntk--ribbons .sntk__sep { color: inherit; opacity: .7; }
#{{ sid }} .sntk__sep .icon { width: .7em; height: .7em; font-size: clamp(1.4rem, 3vw, 2.6rem); animation: sn-spin 14s linear infinite; }
</style>
