{%- liquid
  assign s = section.settings
  assign sid = 'snod-' | append: section.id
  assign step = 0
  if order.financial_status == 'paid' or order.financial_status == 'partially_paid'
    assign step = 1
  endif
  if order.fulfillment_status == 'partial'
    assign step = 2
  endif
  if order.fulfillment_status == 'fulfilled'
    assign step = 3
  endif
  if order.cancelled
    assign step = 0
  endif
-%}
<section id="{{ sid }}" class="sn-s snod" style="{% render 'sn-vars', s: s %}">
  <div class="sn-wrap">
    <a class="sn-link snod__back" href="{{ routes.account_url }}">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}{{ s.back }}</a>
    <div class="snod__head">
      <div>
        <p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 2 %}{{ order.created_at | date: '%B %d, %Y · %H:%M' }}</p>
        <h1 class="sn-h sn-h--l" data-sn-split>{{ s.title }} <em>{{ order.name }}</em></h1>
      </div>
      {%- if order.cancelled -%}<p class="sn-msg sn-msg--err">{{ s.cancelled }} {{ order.cancelled_at | date: '%b %d, %Y' }} · {{ order.cancel_reason_label }}</p>{%- endif -%}
    </div>
    {%- unless order.cancelled -%}
      <ol class="snod__steps sn-pillow" style="--s: {{ step }};" data-r>
        {%- assign labels = s.steps | split: ',' -%}
        {%- for l in labels -%}
          {%- assign k = forloop.index0 | times: 4 | divided_by: 3 -%}
          <li class="{% if forloop.index0 <= step %}is-on{% endif %}"><span>{% render 'sn-phase', k: k %}</span><b>{{ l | strip }}</b></li>
        {%- endfor -%}
        <i class="snod__line" aria-hidden="true"></i>
      </ol>
    {%- endunless -%}
    <div class="snod__grid">
      <div class="snod__items sn-pillow">
        {%- for li in order.line_items -%}
          <div class="snod__li">
            <a class="snod__img" href="{{ li.url }}">{%- if li.image -%}<img src="{{ li.image | image_url: width: 200 }}" alt="" width="80" height="100" loading="lazy">{%- else -%}{% render 'sn-art', name: 'bed-sheet' %}{%- endif -%}</a>
            <div>
              <p class="snod__t">{{ li.title }}</p>
              <p class="sn-small">{{ li.quantity }} × {{ li.final_price | money }}{% if li.sku != blank %} · {{ li.sku }}{% endif %}</p>
              {%- if li.fulfillment -%}<p class="snod__trk">{% render 'sn-icon', name: 'truck', class: 'icon' %}{{ li.fulfillment.created_at | date: '%b %d' }}{% if li.fulfillment.tracking_url %} · <a href="{{ li.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ s.track }} {{ li.fulfillment.tracking_number }}</a>{% endif %}</p>{%- endif -%}
            </div>
            <b>{{ li.final_line_price | money }}</b>
          </div>
        {%- endfor -%}
        <dl class="snod__tot">
          <div><dt>{{ s.sub }}</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
          {%- for d in order.cart_level_discount_applications -%}<div class="is-disc"><dt>{{ d.title }}</dt><dd>−{{ d.total_allocated_amount | money }}</dd></div>{%- endfor -%}
          {%- for sl in order.shipping_methods -%}<div><dt>{{ s.ship }} ({{ sl.title }})</dt><dd>{{ sl.price | money }}</dd></div>{%- endfor -%}
          {%- for t in order.tax_lines -%}<div><dt>{{ t.title }} ({{ t.rate_percentage }}%)</dt><dd>{{ t.price | money }}</dd></div>{%- endfor -%}
          <div class="is-total"><dt>{{ s.total }}</dt><dd>{{ order.total_price | money_with_currency }}</dd></div>
        </dl>
      </div>
      <aside class="snod__side">
        <div class="sn-pillow snod__box"><p class="snod__bt">{% render 'sn-icon', name: 'home', class: 'icon' %}{{ s.ship_addr }}</p><address>{{ order.shipping_address | format_address }}</address><p class="sn-small">{{ order.fulfillment_status_label }}</p></div>
        <div class="sn-pillow snod__box"><p class="snod__bt">{% render 'sn-icon', name: 'credit-card', class: 'icon' %}{{ s.bill_addr }}</p><address>{{ order.billing_address | format_address }}</address><p class="sn-small">{{ order.financial_status_label }}</p></div>
        {%- if settings.whatsapp != blank -%}<a class="sn-btn sn-btn--ghost sn-btn--block" href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}?text={{ s.wa_msg | append: ' ' | append: order.name | url_encode }}" target="_blank" rel="noopener"><span>{{ s.help }}</span>{% render 'sn-icon', name: 'whatsapp', class: 'icon' %}</a>{%- endif -%}
      </aside>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snod__back { margin-bottom: 26px; }
#{{ sid }} .snod__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 26px; }
#{{ sid }} .snod__head > div { display: grid; gap: 12px; }
#{{ sid }} .snod__steps { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); padding: 26px 20px; margin: 0 0 22px; list-style: none; }
#{{ sid }} .snod__steps li { position: relative; z-index: 1; display: grid; justify-items: center; gap: 10px; text-align: center; color: var(--mute); font-size: 13px; }
#{{ sid }} .snod__steps li span { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: var(--card); border: 1px solid var(--line2); transition: all .6s; }
#{{ sid }} .snod__steps .sn-ph { width: 20px; height: 20px; }
#{{ sid }} .snod__steps li.is-on { color: var(--tx); }
#{{ sid }} .snod__steps li.is-on span { color: var(--ac); border-color: var(--ac); box-shadow: 0 0 0 5px color-mix(in srgb, var(--ac) 12%, transparent), 0 0 24px color-mix(in srgb, var(--ac) 30%, transparent); }
#{{ sid }} .snod__line { position: absolute; left: 12.5%; right: 12.5%; top: 49px; border-top: 1px dashed var(--line2); }
#{{ sid }} .snod__line::after { content: ""; position: absolute; left: 0; top: -1.5px; height: 2px; width: calc(var(--s) / 3 * 100%); background: var(--ac); animation: snod-g 1.6s cubic-bezier(.3, .8, .2, 1); }
@keyframes snod-g { from { width: 0; } }
#{{ sid }} .snod__grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, .9fr); gap: 18px; align-items: start; }
#{{ sid }} .snod__items { padding: clamp(18px, 2.6vw, 30px); }
#{{ sid }} .snod__li { display: grid; grid-template-columns: 72px 1fr auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px dashed var(--line2); }
#{{ sid }} .snod__img { aspect-ratio: 4 / 5; border-radius: 12px; overflow: hidden; background: var(--card2); }
#{{ sid }} .snod__img img, #{{ sid }} .snod__img svg { width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .snod__t { font: 400 1.08rem/1.3 var(--f-head); }
#{{ sid }} .snod__trk { display: flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 12.5px; color: var(--soft); }
#{{ sid }} .snod__trk .icon { width: 14px; height: 14px; color: var(--ac); }
#{{ sid }} .snod__trk a { text-decoration: underline; }
#{{ sid }} .snod__tot { display: grid; gap: 10px; margin: 18px 0 0; }
#{{ sid }} .snod__tot > div { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
#{{ sid }} .snod__tot dt { color: var(--soft); } #{{ sid }} .snod__tot dd { margin: 0; }
#{{ sid }} .snod__tot .is-disc { color: var(--c-danger); }
#{{ sid }} .snod__tot .is-total { padding-top: 12px; border-top: 1px solid var(--line); font-size: 1.2rem; }
#{{ sid }} .snod__tot .is-total dd { font-family: var(--f-head); }
#{{ sid }} .snod__side { display: grid; gap: 14px; }
#{{ sid }} .snod__box { display: grid; gap: 10px; padding: 22px; }
#{{ sid }} .snod__bt { display: flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
#{{ sid }} .snod__bt .icon { width: 16px; height: 16px; color: var(--ac); }
#{{ sid }} .snod__box address { font-style: normal; font-size: 14px; line-height: 1.7; color: var(--soft); }
@media (max-width: 899px) { #{{ sid }} .snod__grid { grid-template-columns: 1fr; } #{{ sid }} .snod__steps { padding: 20px 6px; } #{{ sid }} .snod__steps li { font-size: 11px; } }
</style>
{% schema %}
{
  "name": "Order",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "back",
      "label": "Back link",
      "default": "Back to account"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Order"
    },
    {
      "type": "text",
      "id": "steps",
      "label": "Steps (4, comma separated)",
      "default": "Placed, Confirmed, On its way, Delivered"
    },
    {
      "type": "text",
      "id": "cancelled",
      "label": "Cancelled text",
      "default": "Cancelled on"
    },
    {
      "type": "text",
      "id": "track",
      "label": "Tracking label",
      "default": "Track"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subtotal",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "ship",
      "label": "Shipping",
      "default": "Delivery"
    },
    {
      "type": "text",
      "id": "total",
      "label": "Total",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "ship_addr",
      "label": "Shipping address",
      "default": "Delivery address"
    },
    {
      "type": "text",
      "id": "bill_addr",
      "label": "Billing address",
      "default": "Billing address"
    },
    {
      "type": "text",
      "id": "help",
      "label": "Help button",
      "default": "Ask about this order"
    },
    {
      "type": "text",
      "id": "wa_msg",
      "label": "WhatsApp message",
      "default": "Hi Sakooon, I have a question about order"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ]
}
{% endschema %}
