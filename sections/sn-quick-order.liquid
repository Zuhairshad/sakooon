{%- liquid
  assign s = section.settings
  assign sid = 'snqo-' | append: section.id
  assign col = s.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section id="{{ sid }}" class="sn-s snqo" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 2 %}
    <div class="snqo__table sn-pillow sn-stitch" data-r="rise">
      <div class="snqo__row snqo__row--h" aria-hidden="true"><span>{{ s.l_product }}</span><span>{{ s.l_option }}</span><span>{{ s.l_price }}</span><span>{{ s.l_qty }}</span></div>
      {%- for p in col.products limit: s.limit -%}
        {%- assign cv = p.selected_or_first_available_variant -%}
        <div class="snqo__row" data-snqo-row style="--i: {{ forloop.index0 }};">
          <a class="snqo__p" href="{{ p.url }}">
            <span class="snqo__img">{%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 160 }}" alt="" width="64" height="80" loading="lazy">{%- else -%}{% render 'sn-art', name: 'bed-sheet' %}{%- endif -%}</span>
            <span><b>{{ p.title }}</b>{%- if p.metafields.specs.line_1 != blank -%}<small>{{ p.metafields.specs.line_1 }}</small>{%- endif -%}</span>
          </a>
          <span class="snqo__o">
            {%- if p.has_only_default_variant -%}<input type="hidden" value="{{ cv.id }}" data-snqo-v data-price="{{ cv.price }}"><span class="sn-small">—</span>
            {%- else -%}
              <select class="sn-select snqo__sel" data-snqo-v aria-label="{{ p.title | escape }}">
                {%- for v in p.variants -%}<option value="{{ v.id }}" data-price="{{ v.price }}"{% unless v.available %} disabled{% endunless %}{% if v.id == cv.id %} selected{% endif %}>{{ v.title }}{% unless v.available %} · {{ 'products.product.sold_out' | t }}{% endunless %}</option>{%- endfor -%}
              </select>
            {%- endif -%}
          </span>
          <span class="snqo__pr" data-snqo-price>{{ cv.price | money }}</span>
          <span class="sn-qty sn-qty--sm"><button type="button" data-snqo-q="-1" aria-label="Decrease">{% render 'sn-icon', name: 'minus', class: 'icon' %}</button><input type="number" min="0" value="0" data-snqo-qty aria-label="Quantity"><button type="button" data-snqo-q="1" aria-label="Increase">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button></span>
        </div>
      {%- endfor -%}
      <div class="snqo__foot">
        <p><span>{{ s.l_total }}</span> <b data-snqo-total>{{ 0 | money }}</b> <small data-snqo-items>0 {{ s.l_items }}</small></p>
        <button type="button" class="sn-btn sn-btn--gold" data-snqo-add disabled><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'bag', class: 'icon' %}</button>
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snqo__table { padding: clamp(10px, 2vw, 24px); }
#{{ sid }} .snqo__row { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) minmax(0, .8fr) auto; gap: 18px; align-items: center; padding: 14px 10px; border-bottom: 1px dashed var(--line2); transition: background .4s; border-radius: 12px; }
#{{ sid }} .snqo__row.is-on { background: color-mix(in srgb, var(--ac) 8%, transparent); }
#{{ sid }} .snqo__row--h { padding-block: 6px 12px; font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--mute); }
#{{ sid }} .snqo__p { display: flex; align-items: center; gap: 14px; min-width: 0; }
#{{ sid }} .snqo__img { width: 52px; aspect-ratio: 4 / 5; flex: none; border-radius: 10px; overflow: hidden; background: var(--card2); }
#{{ sid }} .snqo__img img, #{{ sid }} .snqo__img svg { width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .snqo__p b { display: block; font: 400 1.05rem/1.3 var(--f-head); }
#{{ sid }} .snqo__p small { font-size: 12px; color: var(--soft); }
#{{ sid }} .snqo__sel { min-height: 42px; padding-block: 8px; font-size: 13.5px; }
#{{ sid }} .snqo__pr { font-variant-numeric: tabular-nums; font-weight: 600; }
#{{ sid }} .snqo__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 10px 6px; }
#{{ sid }} .snqo__foot p { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; color: var(--soft); }
#{{ sid }} .snqo__foot b { font: 400 1.8rem/1 var(--f-head); color: var(--tx); font-variant-numeric: tabular-nums; }
@media (max-width: 749px) {
  #{{ sid }} .snqo__row--h { display: none; }
  #{{ sid }} .snqo__row { grid-template-columns: 1fr auto; gap: 10px 12px; }
  #{{ sid }} .snqo__p { grid-column: 1 / -1; }
  #{{ sid }} .snqo__o { grid-column: 1 / -1; }
  #{{ sid }} .snqo__foot .sn-btn { width: 100%; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var rows = [].slice.call(r.querySelectorAll('[data-snqo-row]')), btn = r.querySelector('[data-snqo-add]');
  function price(row) { var v = row.querySelector('[data-snqo-v]'), o = v.tagName === 'SELECT' ? v.options[v.selectedIndex] : v; return +o.getAttribute('data-price') || 0; }
  function upd() {
    var tot = 0, n = 0;
    rows.forEach(function (row) { var q = Math.max(0, +row.querySelector('[data-snqo-qty]').value || 0), p = price(row); row.querySelector('[data-snqo-price]').textContent = SN.money(p); tot += q * p; n += q; row.classList.toggle('is-on', q > 0); });
    r.querySelector('[data-snqo-total]').textContent = SN.money(tot); r.querySelector('[data-snqo-items]').textContent = n + ' {{ s.l_items | escape }}'; btn.disabled = !n;
  }
  r.addEventListener('click', function (e) { var b = e.target.closest('[data-snqo-q]'); if (!b) return; var i = b.parentNode.querySelector('input'); i.value = Math.max(0, (+i.value || 0) + (+b.getAttribute('data-snqo-q'))); upd(); });
  r.addEventListener('input', upd); r.addEventListener('change', upd);
  btn.addEventListener('click', function () {
    var items = rows.map(function (row) { return { id: +row.querySelector('[data-snqo-v]').value, quantity: +row.querySelector('[data-snqo-qty]').value || 0 }; }).filter(function (x) { return x.quantity > 0; });
    if (!items.length) return; btn.classList.add('is-busy');
    SN.cart.add(items).then(function () { rows.forEach(function (row) { row.querySelector('[data-snqo-qty]').value = 0; }); upd(); }).catch(function () {}).then(function () { btn.classList.remove('is-busy'); });
  });
  SN.ready(upd);
})();
</script>
{% schema %}
{
  "name": "Quick order list",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Hotels & bulk"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order in"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "one go"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Choose sizes and quantities, then add everything to your cart at once."
    },
    {
      "type": "select",
      "id": "head_size",
      "label": "Heading size",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "m"
    },
    {
      "type": "select",
      "id": "head_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 40,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "l_product",
      "label": "Product column",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "l_option",
      "label": "Option column",
      "default": "Size / colour"
    },
    {
      "type": "text",
      "id": "l_price",
      "label": "Price column",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "l_qty",
      "label": "Quantity column",
      "default": "Qty"
    },
    {
      "type": "text",
      "id": "l_total",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "l_items",
      "label": "Items label",
      "default": "items"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button",
      "default": "Add all to cart"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Quick order list"
    }
  ]
}
{% endschema %}
