{%- liquid
  assign s = section.settings
  assign sid = 'snms-' | append: section.id
  assign uid = 'ms' | append: section.id
  assign prods = search.results | where: 'object_type', 'product'
  assign others = search.results | where: 'object_type', 'article'
  assign pages = search.results | where: 'object_type', 'page'
  assign sugs = s.suggestions | split: ','
-%}
<section id="{{ sid }}" class="sn-s snms" style="{% render 'sn-vars', s: s %}" data-sn-fhost data-section="{{ section.id }}">
  <div class="snms__top" data-sn-silk-host>
    {%- if s.silk -%}<div class="sn-silk" data-sn-silk data-c1="{{ settings.color_dark_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ settings.color_moon }}" data-speed=".45" data-amp=".8"></div>{%- endif -%}
    <div class="sn-wrap snms__tin">
      <p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 2 %}{{ s.eyebrow }}</p>
      <h1 class="sn-h sn-h--l" data-sn-split>{%- if search.performed and search.terms != blank -%}{{ s.results_for }} <em>“{{ search.terms | escape }}”</em>{%- else -%}{{ s.heading }} <em>{{ s.highlight }}</em>{%- endif -%}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="snms__form" data-r style="--i: 2;" data-sn-psearch>
        <label class="snms__field">
          {% render 'sn-icon', name: 'search', class: 'icon' %}
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ s.placeholder | escape }}" aria-label="{{ s.placeholder | escape }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="sn-btn sn-btn--gold sn-btn--sm"><span>{{ s.btn }}</span></button>
        </label>
        <div class="snms__pres" data-sn-presults></div>
      </form>
      {%- if sugs.size > 0 and s.suggestions != blank -%}
        <div class="snms__sugs" data-r style="--i: 3;"><span>{{ s.sug_label }}</span>{%- for t in sugs -%}{%- assign tt = t | strip -%}<a class="sn-chip" href="{{ routes.search_url }}?q={{ tt | url_encode }}&options[prefix]=last">{{ tt }}</a>{%- endfor -%}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="sn-wrap snms__body">
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="sn-empty snms__none">
          <span class="snms__moon"><i></i></span>
          <p class="sn-h sn-h--m">{{ s.none_title }}</p>
          <p class="sn-lead">{{ s.none_text }}</p>
        </div>
        {%- if s.none_collection != blank -%}
          <p class="sn-eyebrow snms__alt">{% render 'sn-phase', k: 3 %}{{ s.none_products }}</p>
          <div class="sn-grid" style="--cols: 4;">{%- for p in s.none_collection.products limit: 4 -%}{% render 'sn-card', product: p, i: forloop.index0 %}{%- endfor -%}</div>
        {%- endif -%}
      {%- else -%}
        {%- paginate search.results by s.per_page -%}
        <div class="snms__bar">
          <p class="snms__count" data-sn-region="count">{{ s.count_text | replace: '[n]', search.results_count }}</p>
          <div class="snms__types">
            <a class="sn-chip{% if search.types.size > 1 %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&options[prefix]=last">{{ s.all_label }}</a>
            <a class="sn-chip{% if search.types.size == 1 and search.types.first == 'product' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product&options[prefix]=last">{{ s.prod_label }}</a>
            <a class="sn-chip{% if search.types.size == 1 and search.types.first == 'article' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=article&options[prefix]=last">{{ s.art_label }}</a>
            <a class="sn-chip{% if search.types.size == 1 and search.types.first == 'page' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=page&options[prefix]=last">{{ s.page_label }}</a>
          </div>
          {%- if search.sort_options.size > 0 -%}
            <label class="snms__sort"><select class="sn-select" data-sn-sort aria-label="Sort">{%- for o in search.sort_options -%}<option value="{{ o.value | escape }}"{% if o.value == search.sort_by %} selected{% endif %}>{{ o.name }}</option>{%- endfor -%}</select></label>
          {%- endif -%}
        </div>
        <div class="snms__layout{% if search.filters.size > 0 and s.filters %} has-f{% endif %}">
          {%- if search.filters.size > 0 and s.filters -%}
            <details class="snms__side" open>
              <summary class="snms__fsum">{% render 'sn-icon', name: 'filter', class: 'icon' %}{{ s.filter_label }}</summary>
              <div data-sn-region="filters">{% render 'sn-facets', results: search, uid: uid, terms: search.terms, show_counts: true, swatch: true, open_n: 2 %}</div>
            </details>
          {%- endif -%}
          <div class="snms__main">
            <div class="sn-grid snms__grid" style="--cols: {% if search.filters.size > 0 and s.filters %}3{% else %}4{% endif %};" data-sn-grid data-sn-region="grid">
              {%- for item in search.results -%}
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- assign ci = forloop.index0 | modulo: 8 -%}
                    {% render 'sn-card', product: item, i: ci %}
                  {%- else -%}
                    <a class="snms__doc sn-pillow sn-stitch" href="{{ item.url }}" data-r="rise" style="--i: {{ forloop.index0 | modulo: 8 }};">
                      {%- if item.image -%}{% render 'sn-media', image: item.image, width: 600, class: 'snms__dimg', ratio: '16 / 10' %}{%- else -%}<span class="snms__dic">{% if item.object_type == 'article' %}{% render 'sn-icon', name: 'feather', class: 'icon' %}{% else %}{% render 'sn-icon', name: 'info', class: 'icon' %}{% endif %}</span>{%- endif -%}
                      <small>{% if item.object_type == 'article' %}{{ s.art_label }}{% else %}{{ s.page_label }}{% endif %}</small>
                      <b class="sn-h sn-h--xs">{{ item.title }}</b>
                      <p>{{ item.excerpt_or_content | default: item.content | strip_html | truncatewords: 18 }}</p>
                      <span class="sn-link">{{ s.read_label }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</span>
                    </a>
                {%- endcase -%}
              {%- endfor -%}
            </div>
            <div data-sn-region="pager">
              {%- if paginate.pages > 1 and paginate.next -%}
                <div class="snms__more"><a class="sn-btn sn-btn--ghost" href="{{ paginate.next.url }}" data-sn-more><span>{{ s.more_label }}</span>{% render 'sn-icon', name: 'plus', class: 'icon' %}</a></div>
              {%- endif -%}
            </div>
          </div>
        </div>
        {%- endpaginate -%}
      {%- endif -%}
    {%- else -%}
      {%- if s.empty_collection != blank -%}
        <p class="sn-eyebrow snms__alt">{% render 'sn-phase', k: 3 %}{{ s.trending }}</p>
        <div class="sn-grid" style="--cols: 4;">{%- for p in s.empty_collection.products limit: 8 -%}{% render 'sn-card', product: p, i: forloop.index0 %}{%- endfor -%}</div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
<script src="{{ 'sn-facets.js' | asset_url }}" defer></script>
<style>
#{{ sid }} { padding-top: 0; }
#{{ sid }} .snms__top { position: relative; isolation: isolate; overflow: visible; padding: clamp(80px, 9vw, 130px) 0 clamp(50px, 6vw, 80px); background: {{ settings.color_dark_bg }}; color: {{ settings.color_dark_text }}; --tx: {{ settings.color_dark_text }}; --soft: color-mix(in srgb, {{ settings.color_dark_text }} 72%, transparent); --ac: {{ settings.color_moon }}; --line2: rgba(255,255,255,.24); --line: rgba(255,255,255,.14); }
#{{ sid }} .snms__top .sn-silk { overflow: hidden; }
#{{ sid }} .snms__tin { position: relative; z-index: 2; display: grid; justify-items: center; gap: 22px; text-align: center; }
#{{ sid }} .snms__form { position: relative; width: min(720px, 100%); }
#{{ sid }} .snms__field { display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 22px; border-radius: 999px; background: color-mix(in srgb, #fff 10%, transparent); border: 1px solid rgba(255,255,255,.24); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: border-color .4s, box-shadow .4s; }
#{{ sid }} .snms__field:focus-within { border-color: var(--ac); box-shadow: 0 0 0 6px color-mix(in srgb, var(--ac) 18%, transparent), 0 0 60px color-mix(in srgb, var(--ac) 20%, transparent); }
#{{ sid }} .snms__field .icon { width: 20px; height: 20px; color: var(--ac); flex: none; }
#{{ sid }} .snms__field input[type="search"] { flex: 1; min-width: 0; border: 0; background: none; outline: none; color: #fff; font-size: 17px; padding: 10px 4px; }
#{{ sid }} .snms__field input::placeholder { color: rgba(255,255,255,.55); }
#{{ sid }} .snms__field input::-webkit-search-cancel-button { filter: invert(1); }
#{{ sid }} .snms__pres { position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 10px); text-align: left; border-radius: calc(var(--r) * 1.1); background: var(--c-surface); color: var(--c-ink); --tx: var(--c-ink); --soft: var(--c-ink-soft); --ac: var(--c-accent); box-shadow: 0 40px 80px -30px rgba(0,0,0,.5); }
#{{ sid }} .snms__pres:empty { display: none; }
#{{ sid }} .snms__pres:not(:empty) { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; padding: 22px; animation: sn-acc-in .5s cubic-bezier(.2, .7, .2, 1); }
#{{ sid }} .snms__pres ul { display: grid; gap: 6px; margin-top: 10px; }
#{{ sid }} .snms__pres a { display: flex; align-items: center; gap: 12px; padding: 6px; border-radius: 10px; font-size: 14px; transition: background .3s; }
#{{ sid }} .snms__pres a:hover { background: color-mix(in srgb, var(--c-accent) 10%, transparent); }
#{{ sid }} .snms__pres .snps__img { width: 44px; height: 54px; flex: none; border-radius: 8px; overflow: hidden; background: color-mix(in srgb, var(--c-ink) 6%, transparent); }
#{{ sid }} .snms__pres .snps__img img { width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .snms__pres b { display: block; font-weight: 500; } #{{ sid }} .snms__pres small { color: var(--c-ink-soft); }
#{{ sid }} .snms__pres .snps__all { grid-column: 1 / -1; justify-self: start; padding: 6px 0; }
#{{ sid }} .snms__sugs { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; }
#{{ sid }} .snms__sugs > span { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); margin-right: 4px; }
#{{ sid }} .snms__sugs .sn-chip { border-color: rgba(255,255,255,.24); color: #fff; }
#{{ sid }} .snms__sugs .sn-chip:hover { background: var(--ac); color: {{ settings.color_dark_bg }}; border-color: var(--ac); }
#{{ sid }} .snms__body { padding-top: clamp(30px, 4vw, 50px); }
#{{ sid }} .snms__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; padding-bottom: 18px; margin-bottom: 26px; border-bottom: 1px solid var(--line); }
#{{ sid }} .snms__count { font-size: 14px; color: var(--soft); }
#{{ sid }} .snms__types { display: flex; flex-wrap: wrap; gap: 6px; }
#{{ sid }} .snms__sort { margin-left: auto; }
#{{ sid }} .snms__sort .sn-select { min-height: 44px; padding-block: 8px; border-radius: 999px; font-size: 13px; }
#{{ sid }} .snms__layout.has-f { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; align-items: start; }
#{{ sid }} .snms__fsum { display: none; }
#{{ sid }} .snms__main { position: relative; min-width: 0; }
#{{ sid }}.is-loading .snms__grid { opacity: .35; filter: blur(3px); }
#{{ sid }} .snms__grid { transition: opacity .4s, filter .4s; row-gap: 36px; }
#{{ sid }} .snms__doc { align-self: start; display: grid; gap: 10px; align-content: start; padding: 16px 16px 20px; transition: transform .6s cubic-bezier(.3, 1.2, .4, 1); }
#{{ sid }} .snms__doc:hover { transform: translateY(-6px); }
#{{ sid }} .snms__dimg { border-radius: calc(var(--r) * .7); }
#{{ sid }} .snms__dic { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--ac) 14%, transparent); color: var(--ac); }
#{{ sid }} .snms__dic .icon { width: 22px; height: 22px; }
#{{ sid }} .snms__doc small { font-size: 10.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--ac); }
#{{ sid }} .snms__doc p { font-size: 14px; color: var(--soft); }
#{{ sid }} .snms__more { display: flex; justify-content: center; margin-top: 50px; }
#{{ sid }} .snms__none { padding-top: 30px; }
#{{ sid }} .snms__moon { position: relative; width: 90px; height: 90px; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 35% 35%, #fff, var(--c-moon) 60%); box-shadow: 0 0 50px color-mix(in srgb, var(--c-moon) 50%, transparent); }
#{{ sid }} .snms__moon i { position: absolute; inset: -2px; border-radius: 50%; background: var(--bg); animation: snms-ph 6s ease-in-out infinite alternate; }
@keyframes snms-ph { from { transform: translateX(20%); } to { transform: translateX(80%); } }
#{{ sid }} .snms__alt { margin: 30px 0 22px; }
#{{ sid }} .sn-fac__g { border-bottom: 1px solid var(--line); }
#{{ sid }} .sn-fac__g summary { list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 16px 0; cursor: pointer; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
#{{ sid }} .sn-fac__g summary::-webkit-details-marker { display: none; }
#{{ sid }} .sn-fac__g summary .icon { width: 15px; height: 15px; }
#{{ sid }} .sn-fac__n { margin-left: 6px; padding: 1px 6px; border-radius: 999px; background: var(--ac); color: var(--ac-ink); font-style: normal; font-size: 10px; }
#{{ sid }} .sn-fac__b { padding-bottom: 16px; }
#{{ sid }} .sn-fac__list { display: grid; gap: 4px; max-height: 260px; overflow-y: auto; }
#{{ sid }} .sn-fac__opt { display: flex; align-items: center; gap: 10px; padding: 5px 0; font-size: 14px; cursor: pointer; }
#{{ sid }} .sn-fac__opt input { accent-color: var(--ac); width: 17px; height: 17px; }
#{{ sid }} .sn-fac__opt > i { display: none; }
#{{ sid }} .sn-fac__opt > i.sn-fac__sw { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--sw); box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
#{{ sid }} .sn-fac__opt small { margin-left: auto; color: var(--mute); font-size: 11.5px; }
#{{ sid }} .sn-fac__rng { display: none; }
#{{ sid }} .sn-fac__pin { display: flex; align-items: center; gap: 8px; }
#{{ sid }} .sn-fac__pin label { flex: 1; display: flex; gap: 4px; align-items: center; padding: 8px 10px; border: 1px solid var(--line2); border-radius: 10px; font-size: 12px; color: var(--soft); }
#{{ sid }} .sn-fac__pin input { width: 100%; border: 0; background: none; outline: none; color: var(--tx); }
@media (max-width: 989px) {
  #{{ sid }} .snms__layout.has-f { grid-template-columns: 1fr; gap: 10px; }
  #{{ sid }} .snms__side:not([open]) [data-sn-region] { display: none; }
  #{{ sid }} .snms__fsum { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--line2); font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; list-style: none; cursor: pointer; }
  #{{ sid }} .snms__fsum::-webkit-details-marker { display: none; }
  #{{ sid }} .snms__fsum .icon { width: 16px; height: 16px; }
  #{{ sid }} .snms__grid { --cols: 2 !important; }
  #{{ sid }} .snms__pres:not(:empty) { grid-template-columns: 1fr; }
  #{{ sid }} .snms__sort { margin-left: 0; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on2) return; r.dataset.on2 = 1;
  var d = r.querySelector('.snms__side'); if (d && innerWidth < 990) d.open = false;
})();
</script>
{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "silk",
      "label": "Silk header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Search Sakooon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (no search)",
      "default": "What are you"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "dreaming of?"
    },
    {
      "type": "text",
      "id": "results_for",
      "label": "Results heading",
      "default": "Results for"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Try “sateen king”, “towels”, “T300”…"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "sug_label",
      "label": "Suggestions label",
      "default": "Popular:"
    },
    {
      "type": "text",
      "id": "suggestions",
      "label": "Suggestions (comma separated)",
      "default": "Bed sheets, T300, Duvet, Towels, Pillow covers"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "filters",
      "label": "Filters",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "Filter"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Count text ([n])",
      "default": "[n] results"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All tab",
      "default": "All"
    },
    {
      "type": "text",
      "id": "prod_label",
      "label": "Products tab",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "art_label",
      "label": "Articles tab",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "page_label",
      "label": "Pages tab",
      "default": "Pages"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Read link",
      "default": "Read"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Load more",
      "default": "Load more"
    },
    {
      "type": "text",
      "id": "none_title",
      "label": "No results title",
      "default": "Nothing under this moon"
    },
    {
      "type": "text",
      "id": "none_text",
      "label": "No results text",
      "default": "Check the spelling or try a broader word like “sheets” or “towel”."
    },
    {
      "type": "collection",
      "id": "none_collection",
      "label": "No results: show products from"
    },
    {
      "type": "text",
      "id": "none_products",
      "label": "No results: products heading",
      "default": "You might like"
    },
    {
      "type": "collection",
      "id": "empty_collection",
      "label": "Before searching: show products from"
    },
    {
      "type": "text",
      "id": "trending",
      "label": "Before searching heading",
      "default": "Trending now"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ]
}
{% endschema %}
