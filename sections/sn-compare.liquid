    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
