{%- liquid
  assign s = section.settings
  assign sid = 'sncp-' | append: section.id
  assign rows = s.rows | newline_to_br | split: '<br />'
  assign n = section.blocks.size
-%}
<section id="{{ sid }}" class="sn-s sncp" style="{% render 'sn-vars', s: s %} --n: {{ n }};">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 2 %}
    <div class="sncp__grid">
      <ul class="sncp__labels" aria-hidden="true">
        <li class="sncp__lh"></li>
        {%- for r in rows -%}{%- assign rr = r | strip -%}{%- if rr != blank -%}<li>{{ rr }}</li>{%- endif -%}{%- endfor -%}
      </ul>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign vals = b.values | newline_to_br | split: '<br />' -%}
        <article class="sncp__col sn-pillow sn-stitch{% if b.featured %} is-f{% endif %}" data-r="rise" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}<span class="sncp__badge">{% render 'sn-icon', name: 'sparkle', class: 'icon' %}{{ b.badge }}</span>{%- endif -%}
          <div class="sncp__top">
            {% render 'sn-media', image: b.image, art: b.art, width: 700, sizes: '30vw', class: 'sncp__img' %}
            <h3 class="sn-h sn-h--m">{{ b.title }}</h3>
            {%- if b.price != blank -%}<p class="sncp__price">{{ b.price }}</p>{%- endif -%}
          </div>
          <ul class="sncp__vals">
            {%- assign vi = 0 -%}
            {%- for r in rows -%}
              {%- assign rr = r | strip -%}
              {%- if rr != blank -%}
                {%- assign v = vals[vi] | strip -%}
                <li><span class="sncp__ml">{{ rr }}</span>
                  {%- if v == 'yes' or v == 'Yes' -%}<i class="sncp__y">{% render 'sn-icon', name: 'check', class: 'icon' %}</i>
                  {%- elsif v == 'no' or v == 'No' or v == '-' -%}<i class="sncp__n">—</i>
                  {%- else -%}<b>{{ v }}</b>{%- endif -%}
                </li>
                {%- assign vi = vi | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if b.btn != blank -%}<a class="sn-btn{% if b.featured %} sn-btn--gold{% else %} sn-btn--ghost{% endif %} sn-btn--block" href="{{ b.link | default: routes.all_products_collection_url }}"><span>{{ b.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<p class="sncp__note sn-small" data-r>{{ s.note }}</p>{%- endif -%}
  </div>
</section>
<style>
#{{ sid }} .sncp__grid { display: grid; grid-template-columns: minmax(150px, .8fr) repeat(var(--n), minmax(0, 1fr)); gap: 18px; align-items: stretch; }
#{{ sid }} .sncp__labels { display: grid; padding-top: 18px; align-content: start; grid-template-rows: var(--toph, 330px) repeat({{ rows.size }}, 54px); }
#{{ sid }} .sncp__labels li { display: flex; align-items: center; border-bottom: 1px dashed var(--line); font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .sncp__labels .sncp__lh { border: 0; }
#{{ sid }} .sncp__col { position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 0; padding: 18px 18px 22px; transition: transform .7s cubic-bezier(.3, 1.2, .4, 1), box-shadow .6s; }
#{{ sid }} .sncp__col:hover { transform: translateY(-8px); box-shadow: 0 40px 70px -40px rgba(20, 22, 40, .5); }
#{{ sid }} .sncp__col.is-f { background: var(--tx); color: var(--bg); --soft: color-mix(in srgb, var(--bg) 70%, transparent); --line: color-mix(in srgb, var(--bg) 16%, transparent); --b-bd: var(--ac); }
#{{ sid }} .sncp__badge { position: absolute; z-index: 3; top: -14px; left: 50%; translate: -50% 0; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; background: var(--ac); color: var(--ac-ink); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; box-shadow: 0 10px 20px -10px var(--ac); }
#{{ sid }} .sncp__badge .icon { width: 13px; height: 13px; }
#{{ sid }} .sncp__top { display: grid; gap: 12px; justify-items: center; text-align: center; height: var(--toph, 330px); align-content: start; }
#{{ sid }} .sncp__img { width: 100%; aspect-ratio: 16 / 11; border-radius: calc(var(--r) * .7); }
#{{ sid }} .sncp__price { font-size: 14px; letter-spacing: .06em; color: var(--soft); }
#{{ sid }} .sncp__vals li { display: flex; align-items: center; justify-content: center; height: 54px; border-bottom: 1px dashed var(--line); text-align: center; font-size: 14.5px; }
#{{ sid }} .sncp__ml { display: none; }
#{{ sid }} .sncp__y { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--ac) 20%, transparent); color: var(--ac); }
#{{ sid }} .sncp__y .icon { width: 14px; height: 14px; }
#{{ sid }} .sncp__n { font-style: normal; opacity: .45; }
#{{ sid }} .sncp__col .sn-btn { margin-top: 20px; }
#{{ sid }} .sncp__note { margin-top: 26px; text-align: center; }
@media (max-width: 899px) {
  #{{ sid }} .sncp__grid { grid-template-columns: repeat(var(--n), minmax(260px, 1fr)); overflow-x: auto; padding: 18px 2px 6px; scroll-snap-type: x mandatory; }
  #{{ sid }} .sncp__col { scroll-snap-align: start; }
  #{{ sid }} .sncp__labels { display: none; }
  #{{ sid }} .sncp__top { height: auto; }
  #{{ sid }} .sncp__vals li { justify-content: space-between; height: auto; padding: 12px 0; }
  #{{ sid }} .sncp__ml { display: block; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r) return;
  function fit() { var m = 0; r.querySelectorAll('.sncp__top').forEach(function (t) { t.style.height = 'auto'; m = Math.max(m, t.offsetHeight); }); r.querySelector('.sncp__grid').style.setProperty('--toph', m + 'px'); r.querySelectorAll('.sncp__top').forEach(function (t) { t.style.height = ''; }); }
  if (matchMedia('(min-width: 900px)').matches) { fit(); addEventListener('load', fit); addEventListener('resize', fit); }
})();
</script>
{% schema %}
{
  "name": "Comparison",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
