{%- comment -%}
  Site header. Owner: shad-2d. Patterns: docs/reference/storefront.md, docs/reference/storefront-nav.md.
  - Menu: 3-level link list. Level 2 = group heading, level 3 = links. mega_promo blocks attach promo cards to a
    top-level item by its title/handle.
  - sticky_mode: always (data-sticky="true"), hide_on_scroll (data-sticky="hide"), none.
  - transparent_on_home: on the home page the header overlays the first section when that section marks itself with
    [data-header-overlay] (heroes do this only when they have media). Otherwise it stays solid. Pure CSS, no layout shift.
  - Handoff hooks for commerce: data-drawer-open="search-drawer" / "cart-drawer", [data-cart-count] (contracts section 3).
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  if menu == blank or menu.links.size == 0
    assign menu = settings.menu_main
  endif
  assign subnav = section.settings.mobile_subnav_menu
  assign layout = section.settings.layout
  case section.settings.sticky_mode
    when 'always'
      assign sticky_attr = 'true'
    when 'hide_on_scroll'
      assign sticky_attr = 'hide'
    else
      assign sticky_attr = 'false'
  endcase
  assign transparent = false
  if section.settings.transparent_on_home and request.page_type == 'index'
    assign transparent = true
  endif
  assign promo_blocks = section.blocks | where: 'type', 'mega_promo'
-%}

{%- capture logo -%}
  <a class="header__logo" href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>
    {%- if settings.logo != blank -%}<span class="visually-hidden">{{ shop.name }}</span>{%- endif -%}
    {%- render 'brand-logo', variant: 'wordmark', tone: 'dark', width: settings.logo_width, priority: true, class: 'header__logo-img header__logo-img--default' -%}
    {%- if transparent -%}
      {%- if section.settings.transparent_logo != blank -%}
        {%- render 'image', image: section.settings.transparent_logo, sizes: '240px', widths: '120,240,360,480', priority: true, class: 'header__logo-img header__logo-img--transparent', alt: '' -%}
      {%- elsif settings.logo == blank and section.settings.transparent_text == 'light' -%}
        {%- comment -%} Bundled paper wordmark while the header sits over hero media. {%- endcomment -%}
        {%- render 'brand-logo', variant: 'wordmark', tone: 'light', width: settings.logo_width, priority: true, class: 'header__logo-img header__logo-img--transparent' -%}
      {%- endif -%}
    {%- endif -%}
  </a>
{%- endcapture -%}

{%- capture nav -%}
  <header-menu class="header__nav">
    <nav aria-label="{{ 'storefront.header.main_menu' | t }}">
      <ul class="header__menu list-unstyled" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign link_handle = link.handle | default: link.title | handleize
            assign has_promos = false
            for block in promo_blocks
              assign target = block.settings.menu_item | handleize
              if target == link_handle
                assign has_promos = true
                break
              endif
            endfor
            assign panel_id = 'MegaMenu-' | append: section.id | append: '-' | append: forloop.index
          -%}
          {%- if link.links.size > 0 or has_promos -%}
            <li class="header__item" data-mega-item>
              <button type="button" class="header__link header__trigger" aria-expanded="false" aria-haspopup="true" aria-controls="{{ panel_id }}" data-mega-trigger{% if link.active or link.child_active %} data-active{% endif %}>
                {{- link.title | escape -}}
              </button>
              {%- render 'mega-menu', link: link, section: section, id: panel_id -%}
            </li>
          {%- else -%}
            <li class="header__item">
              <a class="header__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}{% if link.active %} data-active{% endif %}>{{ link.title | escape }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  </header-menu>
{%- endcapture -%}

<sticky-header class="header-wrapper" data-mode="{{ section.settings.sticky_mode }}">
  <header
    class="header header--{{ layout }} color-scheme-{{ section.settings.color_scheme }}{% if transparent %} header--transparent-capable header--transparent-{{ section.settings.transparent_text }}{% endif %}{% if section.settings.show_border %} header--border{% endif %}"
    data-header
    data-sticky="{{ sticky_attr }}"
  >
    <div class="header__bar">
      {%- if layout == 'logo_left' -%}{{ logo }}{{ nav }}{%- else -%}{{ nav }}{{ logo }}{%- endif -%}
      <div class="header__actions">
        <a class="header__icon" href="{{ routes.search_url }}" data-drawer-open="search-drawer" aria-label="{{ 'general.search.search' | t }}">
          {%- render 'icon', icon: 'search', size: 20 -%}
        </a>
        {%- if shop.customer_accounts_enabled -%}
          <a class="header__icon hide-mobile" href="{{ routes.account_url }}" aria-label="{{ 'customer.account_fallback' | t }}">
            {%- render 'icon', icon: 'account', size: 20 -%}
          </a>
        {%- endif -%}
        {%- comment -%} Name comes from the content ("Cart, items: 2", or "Cart" when empty), so it includes the visible count and follows global.js updates. {%- endcomment -%}
        <a class="header__icon header__cart" href="{{ routes.cart_url }}" data-drawer-open="cart-drawer">
          {%- render 'icon', icon: 'bag', size: 20 -%}
          <span class="visually-hidden">{{ 'storefront.header.cart' | t }}</span><span class="visually-hidden header__cart-items-label">{{ 'storefront.header.cart_items' | t }}</span>
          <span class="header__cart-count" data-cart-count{% if cart.item_count == 0 %} data-empty{% endif %}>{{ cart.item_count }}</span>
        </a>
        <button type="button" class="header__icon header__menu-toggle hide-desktop" data-drawer-open="mobile-nav" aria-controls="mobile-nav" aria-expanded="false" aria-label="{{ 'general.accessibility.open_menu' | t }}">
          {%- render 'icon', icon: 'menu', size: 22 -%}
        </button>
      </div>
    </div>
    {%- if subnav != blank and subnav.links.size > 0 -%}
      <nav class="header__subnav hide-desktop" aria-label="{{ 'storefront.header.secondary_menu' | t }}">
        <ul class="header__subnav-list list-unstyled no-scrollbar" role="list">
          {%- for link in subnav.links -%}
            <li><a class="header__subnav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    <div class="header__backdrop" data-header-backdrop aria-hidden="true"></div>
  </header>
</sticky-header>

{%- render 'mobile-nav', menu: menu, section: section, promo_blocks: promo_blocks, style: section.settings.mobile_menu_style -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --header-logo-width: {{ settings.logo_width }}px;
    --header-logo-width-mobile: {{ settings.logo_width | times: 0.75 | round }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 24,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "white" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Second level links with their own links become column headings in the mega menu." },
    {
      "type": "select", "id": "layout", "label": "Desktop layout", "default": "nav_left",
      "options": [
        { "value": "nav_left", "label": "Menu left, logo and icons right" },
        { "value": "logo_left", "label": "Logo left, menu beside it" },
        { "value": "logo_center", "label": "Menu left, logo centred" }
      ]
    },
    { "type": "checkbox", "id": "show_border", "label": "Show bottom border", "default": false },
    { "type": "header", "content": "Sticky header" },
    {
      "type": "select", "id": "sticky_mode", "label": "Sticky header", "default": "always",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "hide_on_scroll", "label": "Hide on scroll down, show on scroll up" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "header", "content": "Home page" },
    { "type": "checkbox", "id": "transparent_on_home", "label": "Transparent over the first section", "default": true, "info": "Applies when the first section is a hero with an image or video. The header turns solid on scroll and while a menu is open." },
    {
      "type": "select", "id": "transparent_text", "label": "Transparent header text", "default": "light",
      "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ]
    },
    { "type": "image_picker", "id": "transparent_logo", "label": "Transparent header logo", "info": "Optional. Shown instead of the theme logo while the header is transparent." },
    { "type": "header", "content": "Mobile" },
    {
      "type": "select", "id": "mobile_menu_style", "label": "Menu style", "default": "sheet",
      "options": [ { "value": "sheet", "label": "Sheet from the bottom" }, { "value": "drawer", "label": "Drawer from the left" } ]
    },
    { "type": "link_list", "id": "mobile_subnav_menu", "label": "Quick links row", "info": "Optional. A horizontally scrolling row of links under the mobile header." }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Mega menu promo",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item", "info": "Title of the top-level menu item to show this card in, for example Bedding. Up to 3 cards per item." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Caption", "default": "Shop the set" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
