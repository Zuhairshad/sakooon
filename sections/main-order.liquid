<div class="customer section page-width">
  <header class="customer__header">
    <div><h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1><p class="text-muted text-small">{{ 'customer.order.date_html' | t: date: order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}<p class="text-small" style="margin-top: var(--space-2)">{{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | time_tag: format: 'date_at_time' }} {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>{%- endif -%}</div>
    <a href="{{ routes.account_url }}" class="link text-small">{{ 'customer.account.return' | t }}</a>
  </header>
  <div class="customer__grid">
    <div>
      <table>
        <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.sku' | t }}</th><th>{{ 'customer.order.price' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>{%- if line_item.url != blank -%}<a href="{{ line_item.url }}" class="link">{{ line_item.title }}</a>{%- else -%}{{ line_item.title }}{%- endif -%}
                {%- if line_item.variant.title != 'Default Title' -%}<br><span class="text-muted text-caption">{{ line_item.variant.title }}</span>{%- endif -%}
                {%- if line_item.fulfillment -%}<br><span class="text-caption">{{ 'customer.order.fulfilled_at_html' | t: date: line_item.fulfillment.created_at | time_tag: format: 'date' }}{% if line_item.fulfillment.tracking_url %} &middot; <a href="{{ line_item.fulfillment.tracking_url }}" class="link">{{ 'customer.order.track_shipment' | t }}</a>{% endif %}</span>{%- endif -%}</td>
              <td>{{ line_item.sku }}</td>
              <td>{{ line_item.final_price | money_without_trailing_zeros }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money_without_trailing_zeros }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot class="text-small">
          <tr><td colspan="4">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money_without_trailing_zeros }}</td></tr>
          {%- for discount in order.cart_level_discount_applications -%}<tr><td colspan="4">{{ 'customer.order.discount' | t }} ({{ discount.title }})</td><td>-{{ discount.total_allocated_amount | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
          {%- for tax_line in order.tax_lines -%}<tr><td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td><td>{{ tax_line.price | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
          {%- if order.total_duties -%}<tr><td colspan="4">{{ 'customer.order.total_duties' | t }}</td><td>{{ order.total_duties | money_without_trailing_zeros }}</td></tr>{%- endif -%}
          <tr><td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money_without_trailing_zeros }}</strong></td></tr>
          {%- if order.total_refunded_amount > 0 -%}<tr><td colspan="4">{{ 'customer.order.total_refunded' | t }}</td><td>-{{ order.total_refunded_amount | money_without_trailing_zeros }}</td></tr>{%- endif -%}
        </tfoot>
      </table>
    </div>
    <aside class="stack stack--lg text-small">
      <div class="stack stack--sm"><h2 class="h5">{{ 'customer.order.billing_address' | t }}</h2><p class="text-muted">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>{{ order.billing_address | format_address }}</div>
      <div class="stack stack--sm"><h2 class="h5">{{ 'customer.order.shipping_address' | t }}</h2><p class="text-muted">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>{{ order.shipping_address | format_address }}</div>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "t:sections.main-order.name", "settings": [] }
{% endschema %}
