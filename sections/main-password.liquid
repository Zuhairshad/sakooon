<div class="password color-scheme-{{ section.settings.color_scheme }}">
  <div class="password__media">
    {%- if section.settings.image != blank -%}
      {% render 'image', image: section.settings.image, sizes: '(min-width: 1024px) 50vw, 100vw', priority: true, class: 'password__img' %}
    {%- else -%}
      {% render 'placeholder', name: 'lifestyle-1', class: 'password__img' %}
    {%- endif -%}
  </div>
  <div class="password__content">
    <div class="password__inner stack stack--lg">
      <p class="h3">{{ shop.name }}</p>
      {%- if section.settings.heading != blank -%}<h1 class="h1">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- form 'customer', class: 'password__newsletter' -%}
        {%- if form.posted_successfully? -%}<p class="form__message form__message--success" role="status">{% render 'icon', icon: 'success', size: 16 %}{{ 'sections.newsletter.success' | t }}</p>{%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'sections.newsletter.label' | t }}</label>
        <div class="input-group">
          <input id="PasswordNewsletterEmail" type="email" name="contact[email]" class="field__input" value="{{ form.email }}" placeholder="{{ 'sections.newsletter.label' | t }}" autocomplete="email" required>
          <button type="submit" class="button">{{ 'sections.newsletter.button_label' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="field__error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <div>
        <button type="button" class="link" data-drawer-open="password-dialog">{{ 'general.password_page.login_password_button' | t }}</button>
      </div>
    </div>
  </div>
</div>
<theme-dialog id="password-dialog">
  <div class="overlay" data-drawer-close></div>
  <div class="dialog"><div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="PasswordDialogTitle" style="--dialog-width: 440px">
    <button type="button" class="button--icon dialog__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    <h2 id="PasswordDialogTitle" class="h4">{{ 'general.password_page.login_form_heading' | t }}</h2>
    {%- form 'storefront_password', class: 'stack' -%}
      <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" name="password" id="Password" class="field__input" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" autocomplete="current-password" data-autofocus>
      {%- if form.errors -%}<p class="field__error" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
      <button type="submit" class="button button--full">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}
    <p class="text-caption" style="margin-top: var(--space-4)">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div></div>
</theme-dialog>
{% style %}
  .password { min-height: 100vh; display: grid; }
  .password__media { display: none; }
  .password__content { display: grid; place-items: center; padding: var(--section-padding) var(--page-gutter); }
  .password__inner { width: 100%; max-width: 480px; }
  @media (min-width: 1024px) {
    .password { grid-template-columns: 1fr 1fr; }
    .password__media { display: block; position: relative; }
    .password__media .password__img, .password__media .placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  }
{% endstyle %}
{% schema %}
{
  "name": "t:sections.main-password.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "paper" },
    { "type": "image_picker", "id": "image", "label": "t:sections.main-password.settings.image.label" },
    { "type": "text", "id": "heading", "label": "t:sections.main-password.settings.heading.label", "default": "Opening soon" },
    { "type": "richtext", "id": "text", "label": "t:sections.main-password.settings.text.label", "default": "<p>Be the first to know when we open.</p>" }
  ]
}
{% endschema %}
