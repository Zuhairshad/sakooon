{%- liquid
  assign s = section.settings
  assign sid = 'snft-' | append: section.id
  assign n = section.blocks.size
-%}
<section id="{{ sid }}" class="sn-s snft snft--{{ s.layout }}" style="{% render 'sn-vars', s: s %} --n: {{ n }};" data-sn-silk-host>
  {% render 'sn-divider', s: s %}
  {%- if s.silk -%}<div class="sn-silk" data-sn-silk data-c1="{{ settings.color_dark_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ settings.color_moon }}" data-speed=".45" data-amp=".7"></div>{%- endif -%}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 1 %}

    {%- if s.layout == 'orbit' -%}
      <div class="snft__orbit" data-snft-orbit>
        <div class="snft__core" data-r="zoom">
          <svg class="snft__rings" viewBox="0 0 400 400" aria-hidden="true">
            <circle cx="200" cy="200" r="196" pathLength="100"/>
            <circle cx="200" cy="200" r="150" pathLength="100"/>
            <circle cx="200" cy="200" r="104" pathLength="100"/>
          </svg>
          <div class="snft__moon"><i></i></div>
          {%- if s.core_text != blank -%}<p class="snft__coretext">{{ s.core_text }}</p>{%- endif -%}
        </div>
        <ul class="snft__sats">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign ang = 360 | divided_by: n | times: forloop.index0 | minus: 90 -%}
            <li class="snft__sat" style="--a: {{ ang }}deg; --i: {{ forloop.index0 }};" data-r {{ block.shopify_attributes }}>
              <div class="snft__satin sn-pillow sn-stitch">
                <span class="sn-icon-circle snft__ic">{% render 'sn-icon', name: b.icon, class: 'icon' %}</span>
                <div><h3 class="sn-h sn-h--xs">{{ b.title }}</h3>{%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}</div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      <ul class="snft__list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="snft__item{% if s.layout == 'cards' %} sn-pillow sn-stitch{% endif %}" data-r="rise" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            {%- if b.link != blank -%}<a class="snft__cover" href="{{ b.link }}" aria-label="{{ b.title | escape }}"></a>{%- endif -%}
            <span class="snft__ic">
              <svg class="snft__halo" viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="38" pathLength="100"/></svg>
              {% render 'sn-icon', name: b.icon, class: 'icon' %}
            </span>
            <div class="snft__txt">
              <h3 class="sn-h sn-h--xs">{{ b.title }}</h3>
              {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
<style>
#{{ sid }} .snft__list { display: grid; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px); }
#{{ sid }}.snft--row .snft__list { gap: 0; border-block: 1px solid var(--line); }
#{{ sid }} .snft__item { position: relative; display: flex; gap: 18px; align-items: flex-start; padding: clamp(22px, 2.6vw, 34px); transition: transform .7s cubic-bezier(.3, 1.2, .4, 1), box-shadow .6s, background .5s; }
#{{ sid }}.snft--row .snft__item + .snft__item { border-left: 1px dashed var(--line2); }
#{{ sid }}.snft--cards .snft__item { flex-direction: column; }
#{{ sid }}.snft--cards .snft__item:hover { transform: translateY(-8px); box-shadow: 0 36px 60px -40px rgba(20, 22, 40, .5); }
#{{ sid }}.snft--center .snft__item, #{{ sid }}.snft--cards.snft--c .snft__item { align-items: center; text-align: center; flex-direction: column; }
#{{ sid }} .snft__cover { position: absolute; inset: 0; z-index: 2; }
#{{ sid }} .snft__ic { position: relative; width: 62px; height: 62px; flex: none; display: grid; place-items: center; border-radius: 50%; color: var(--ac); background: color-mix(in srgb, var(--ac) 11%, transparent); transition: background .5s, color .5s, transform .7s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .snft__ic .icon { width: 26px; height: 26px; }
#{{ sid }} .snft__ic .icon :is(path, circle, rect, line, polyline, ellipse) { stroke-dasharray: 80; stroke-dashoffset: 0; }
html.sn-js body[data-motion="on"] #{{ sid }} [data-r]:not(.is-in) .snft__ic .icon :is(path, circle, rect, line, polyline, ellipse) { stroke-dashoffset: 80; }
#{{ sid }} [data-r].is-in .snft__ic .icon :is(path, circle, rect, line, polyline, ellipse) { transition: stroke-dashoffset 1.8s cubic-bezier(.6, 0, .2, 1) calc(var(--i, 0) * 120ms + .25s); }
#{{ sid }} .snft__halo { position: absolute; inset: -6px; width: calc(100% + 12px); height: calc(100% + 12px); transform: rotate(-90deg); }
#{{ sid }} .snft__halo circle { fill: none; stroke: var(--ac); stroke-width: 1; stroke-dasharray: 2 4; opacity: .55; }
#{{ sid }} .snft__item:hover .snft__ic { background: var(--ac); color: var(--ac-ink); transform: rotate(-8deg) scale(1.06); }
#{{ sid }} .snft__item:hover .snft__halo { animation: snft-spin 9s linear infinite; }
@keyframes snft-spin { to { transform: rotate(270deg); } }
#{{ sid }} .snft__txt { display: grid; gap: 6px; }
#{{ sid }} .snft__txt p, #{{ sid }} .snft__satin p { font-size: 14.5px; line-height: 1.6; color: var(--soft); }
@media (max-width: 989px) { #{{ sid }} .snft__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } #{{ sid }}.snft--row .snft__item:nth-child(odd) { border-left: 0; } #{{ sid }}.snft--row .snft__item:nth-child(n + 3) { border-top: 1px dashed var(--line2); } }
@media (max-width: 599px) {
  #{{ sid }} .snft__list { grid-template-columns: 1fr; }
  #{{ sid }}.snft--row .snft__item { border-left: 0 !important; padding: 20px 4px; }
  #{{ sid }}.snft--row .snft__item + .snft__item { border-top: 1px dashed var(--line2); }
  #{{ sid }}.snft--cards .snft__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  #{{ sid }}.snft--cards .snft__item { padding: 18px 14px; gap: 12px; }
  #{{ sid }}.snft--cards .snft__txt p { font-size: 13px; }
}
/* orbit */
#{{ sid }} .snft__orbit { position: relative; width: min(980px, 100%); aspect-ratio: 1.35; margin-inline: auto; }
#{{ sid }} .snft__core { position: absolute; left: 50%; top: 50%; width: 46%; aspect-ratio: 1; translate: -50% -50%; display: grid; place-items: center; }
#{{ sid }} .snft__rings { position: absolute; inset: 0; width: 100%; height: 100%; animation: snft-turn 80s linear infinite; }
#{{ sid }} .snft__rings circle { fill: none; stroke: color-mix(in srgb, var(--ac) 40%, transparent); stroke-width: 1; stroke-dasharray: 1 2.2; vector-effect: non-scaling-stroke; }
#{{ sid }} .snft__rings circle:nth-child(2) { stroke-dasharray: .4 1.6; }
@keyframes snft-turn { to { transform: rotate(360deg); } }
#{{ sid }} .snft__moon { position: relative; width: 38%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 36% 34%, #fff, var(--c-moon) 46%, color-mix(in srgb, var(--c-moon) 60%, #6b5a3a)); box-shadow: 0 0 60px color-mix(in srgb, var(--c-moon) 55%, transparent), 0 0 140px color-mix(in srgb, var(--c-moon) 30%, transparent); }
#{{ sid }} .snft__moon i { position: absolute; inset: -2%; border-radius: 50%; background: var(--bg); transform: translateX(var(--mx, 62%)); transition: transform .2s linear; opacity: .92; }
#{{ sid }} .snft__coretext { position: absolute; bottom: 14%; left: 0; right: 0; text-align: center; font: italic 300 1.05rem/1.3 var(--f-head); color: var(--soft); }
#{{ sid }} .snft__sats { position: absolute; inset: 0; }
#{{ sid }} .snft__sat { position: absolute; left: calc(50% + cos(var(--a)) * 37%); top: calc(50% + sin(var(--a)) * 41%); width: 0; height: 0; }
#{{ sid }} .snft__satin { position: absolute; left: 0; top: 0; translate: -50% -50%; display: flex; align-items: center; gap: 14px; width: 270px; padding: 16px 18px; animation: snft-bob 6s ease-in-out infinite; animation-delay: calc(var(--i) * -1.1s); transition: box-shadow .5s; }
#{{ sid }} .snft__satin:hover { box-shadow: 0 30px 60px -36px rgba(20, 22, 40, .55); }
#{{ sid }} .snft__satin .sn-icon-circle { width: 46px; height: 46px; }
@keyframes snft-bob { 50% { transform: translateY(-10px); } }
@media (max-width: 989px) {
  #{{ sid }} .snft__orbit { aspect-ratio: auto; display: grid; gap: 22px; }
  #{{ sid }} .snft__core { position: relative; left: auto; top: auto; translate: none; width: min(300px, 70%); margin-inline: auto; }
  #{{ sid }} .snft__sats { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #{{ sid }} .snft__sat { position: static; width: auto; height: auto; transform: none; }
  #{{ sid }} .snft__satin { position: static; translate: none; width: auto; height: 100%; animation: none; flex-direction: column; text-align: center; padding: 18px 12px; }
}
@media (prefers-reduced-motion: reduce) { #{{ sid }} .snft__rings, #{{ sid }} .snft__satin { animation: none; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var o = r.querySelector('[data-snft-orbit]'); if (!o) return;
  var m = o.querySelector('.snft__moon i'), tk = false;
  function upd() { tk = false; var b = o.getBoundingClientRect(), p = 1 - Math.min(1, Math.max(0, (b.top + b.height / 2) / innerHeight)); m.style.setProperty('--mx', (62 + p * 70).toFixed(1) + '%'); }
  addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(upd); } }, { passive: true }); upd();
})();
</script>
