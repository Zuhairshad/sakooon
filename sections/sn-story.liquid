{%- liquid
  assign s = section.settings
  assign sid = 'snst-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snst" style="{% render 'sn-vars', s: s %}" data-snst>
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 1 %}
    <div class="snst__wrap" data-snst-wrap>
      <svg class="snst__thread" data-snst-svg aria-hidden="true" preserveAspectRatio="none"><path class="bg" data-snst-bg/><path class="fg" data-snst-fg pathLength="1000"/></svg>
      <span class="snst__needle" data-snst-needle aria-hidden="true"><svg viewBox="0 0 30 30"><path d="M5 25 25 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><ellipse cx="22.5" cy="7.5" rx="2.6" ry="1.1" transform="rotate(-45 22.5 7.5)" fill="none" stroke="currentColor" stroke-width="1.1"/></svg></span>
      <ol class="snst__list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="snst__step{% cycle '', ' snst__step--r' %}" data-snst-step {{ block.shopify_attributes }}>
            <div class="snst__media" data-r="unfold">{% render 'sn-media', image: b.image, art: b.art, width: 1000, sizes: '(min-width: 990px) 40vw, 90vw', class: 'snst__m sn-ripple' %}<span class="snst__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span></div>
            <div class="snst__copy">
              <span class="snst__knot" data-snst-knot aria-hidden="true"></span>
              <p class="sn-eyebrow" data-r>{% render 'sn-icon', name: b.icon, class: 'icon' %}{{ b.kicker }}</p>
              <h3 class="sn-h sn-h--m" data-sn-split>{{ b.title }}</h3>
              <div class="sn-rte" data-r style="--i: 2;">{{ b.text }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snst__wrap { position: relative; }
#{{ sid }} .snst__thread { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
#{{ sid }} .snst__thread path { fill: none; }
#{{ sid }} .snst__thread .bg { stroke: var(--line2); stroke-width: 1.2; stroke-dasharray: 5 7; }
#{{ sid }} .snst__thread .fg { stroke: var(--ac); stroke-width: 2; stroke-dasharray: 1000; stroke-dashoffset: var(--off, 1000); stroke-linecap: round; }
#{{ sid }} .snst__needle { position: absolute; left: 0; top: 0; z-index: 2; width: 30px; height: 30px; margin: -15px 0 0 -15px; color: var(--ac); transform: translate(var(--nx, 0), var(--ny, 0)) rotate(var(--nr, 0deg)); filter: drop-shadow(0 0 8px color-mix(in srgb, var(--ac) 60%, transparent)); transition: opacity .4s; }
#{{ sid }} .snst__needle svg { width: 100%; height: 100%; }
#{{ sid }} .snst__list { position: relative; z-index: 1; display: grid; gap: clamp(60px, 9vw, 140px); }
#{{ sid }} .snst__step { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 140px); align-items: center; }
#{{ sid }} .snst__step--r .snst__media { order: 2; }
#{{ sid }} .snst__media { position: relative; }
#{{ sid }} .snst__m { aspect-ratio: 5 / 6; border-radius: calc(var(--r) * 1.6); box-shadow: 0 50px 90px -60px rgba(20, 22, 40, .6); }
#{{ sid }} .snst__no { position: absolute; z-index: 2; left: -10px; top: -30px; font: italic 300 clamp(4rem, 9vw, 8rem)/1 var(--f-head); color: var(--ac); text-shadow: 0 10px 30px color-mix(in srgb, var(--bg) 60%, transparent); }
#{{ sid }} .snst__step--r .snst__no { left: auto; right: -10px; }
#{{ sid }} .snst__copy { position: relative; display: grid; gap: 16px; max-width: 480px; }
#{{ sid }} .snst__step--r .snst__copy { justify-self: end; }
#{{ sid }} .snst__copy .sn-eyebrow .icon { width: 16px; height: 16px; }
#{{ sid }} .snst__knot { position: absolute; left: -32px; top: 6px; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--ac); background: var(--bg); transition: background .5s, transform .5s cubic-bezier(.3, 1.6, .5, 1); }
#{{ sid }} .snst__knot.is-on { background: var(--ac); transform: scale(1.3); }
@media (max-width: 899px) {
  #{{ sid }} .snst__step, #{{ sid }} .snst__step--r { grid-template-columns: 1fr; gap: 26px; padding-left: 28px; }
  #{{ sid }} .snst__step--r .snst__media { order: 0; }
  #{{ sid }} .snst__step--r .snst__copy { justify-self: start; }
  #{{ sid }} .snst__knot { left: -26px; }
  #{{ sid }} .snst__no, #{{ sid }} .snst__step--r .snst__no { left: auto; right: 10px; top: -20px; font-size: 3.6rem; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var wrap = r.querySelector('[data-snst-wrap]'), svg = r.querySelector('[data-snst-svg]'), bg = r.querySelector('[data-snst-bg]'), fg = r.querySelector('[data-snst-fg]'), nd = r.querySelector('[data-snst-needle]');
  var knots = r.querySelectorAll('[data-snst-knot]'), len = 0, ticking = false;
  function build() {
    var W = wrap.offsetWidth, H = wrap.offsetHeight, wr = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
    var pts = []; knots.forEach(function (k) { var b = k.getBoundingClientRect(); pts.push([b.left - wr.left + b.width / 2, b.top - wr.top + b.height / 2]); });
    if (!pts.length) return;
    var d = 'M' + pts[0][0] + ' ' + Math.max(0, pts[0][1] - 80);
    var prev = [pts[0][0], Math.max(0, pts[0][1] - 80)];
    pts.forEach(function (p) { var dy = p[1] - prev[1]; d += ' C' + prev[0] + ' ' + (prev[1] + dy * .8) + ' ' + p[0] + ' ' + (p[1] - dy * .8) + ' ' + p[0] + ' ' + p[1]; prev = p; });
    d += ' C' + prev[0] + ' ' + (prev[1] + 80) + ' ' + prev[0] + ' ' + (prev[1] + 120) + ' ' + prev[0] + ' ' + (prev[1] + 160);
    bg.setAttribute('d', d); fg.setAttribute('d', d); len = fg.getTotalLength(); upd();
  }
  function upd() {
    ticking = false; if (!len) return;
    var b = wrap.getBoundingClientRect(), p = Math.min(1, Math.max(0, (innerHeight * .6 - b.top) / b.height));
    fg.style.setProperty('--off', (1000 - p * 1000).toFixed(1));
    var pt = fg.getPointAtLength(p * len), pt2 = fg.getPointAtLength(Math.min(len, p * len + 2));
    var ang = Math.atan2(pt2.y - pt.y, pt2.x - pt.x) * 180 / Math.PI - 45;
    nd.style.setProperty('--nx', pt.x + 'px'); nd.style.setProperty('--ny', pt.y + 'px'); nd.style.setProperty('--nr', ang + 'deg');
    nd.style.opacity = p > 0 && p < 1 ? 1 : .4;
    knots.forEach(function (k) { var kb = k.getBoundingClientRect(); k.classList.toggle('is-on', kb.top < innerHeight * .6); });
  }
  addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(upd); } }, { passive: true });
  addEventListener('resize', build); addEventListener('load', build); setTimeout(build, 300); build();
  if ('ResizeObserver' in window) new ResizeObserver(build).observe(wrap);
})();
</script>
