{%- liquid
  assign s = section.settings
  assign sid = 'snjr-' | append: section.id
  assign bl = s.blog
  assign arts = 'bed-sheet,towel,pillow,duvet' | split: ','
  assign ph_titles = s.ph_titles | newline_to_br | split: '<br />'
-%}
<section id="{{ sid }}" class="sn-s snjr snjr--{{ s.layout }}" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap" data-sn-railwrap>
    {%- if bl != blank -%}{%- assign lurl = bl.url -%}{%- else -%}{%- assign lurl = '/blogs/news' -%}{%- endif -%}
    {% render 'sn-head', s: s, k: 3, link_label: s.link_label, link_url: lurl %}
    <div class="snjr__list{% if s.layout == 'rail' %} sn-rail{% endif %}"{% if s.layout == 'rail' %} data-sn-rail{% endif %}>
      {%- if bl != blank and bl.articles_count > 0 -%}
        {%- for a in bl.articles limit: s.limit -%}
          {%- assign words = a.content | strip_html | split: ' ' | size -%}
          {%- assign mins = words | divided_by: 200 | at_least: 1 -%}
          <article class="snjr__post{% if forloop.first and s.layout == 'feature' %} is-lead{% endif %}" data-r="rise" style="--i: {{ forloop.index0 }};">
            <a class="snjr__img" href="{{ a.url }}" aria-label="{{ a.title | escape }}">
              {%- assign ai = forloop.index0 | modulo: 4 -%}
              {% render 'sn-media', image: a.image, art: arts[ai], width: 1100, sizes: '(min-width: 990px) 40vw, 90vw', class: 'snjr__m sn-ripple' %}
              <span class="snjr__date"><b>{{ a.published_at | date: '%d' }}</b>{{ a.published_at | date: '%b' }}</span>
            </a>
            <div class="snjr__body">
              <p class="snjr__meta">{% if a.tags.first %}<span>{{ a.tags.first }}</span>{% endif %}{% if s.show_time %}<span>{% render 'sn-icon', name: 'clock', class: 'icon' %}{{ mins }} {{ s.min_label }}</span>{% endif %}</p>
              <h3 class="sn-h {% if forloop.first and s.layout == 'feature' %}sn-h--m{% else %}sn-h--s{% endif %}"><a href="{{ a.url }}">{{ a.title }}</a></h3>
              {%- if s.show_excerpt -%}<p class="snjr__ex">{{ a.excerpt_or_content | strip_html | truncatewords: 22 }}</p>{%- endif -%}
              <a class="sn-link" href="{{ a.url }}">{{ s.read_label }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for t in ph_titles limit: s.limit -%}
          <article class="snjr__post{% if forloop.first and s.layout == 'feature' %} is-lead{% endif %}" data-r="rise" style="--i: {{ forloop.index0 }};">
            <a class="snjr__img" href="{{ lurl }}">
              {%- assign ai = forloop.index0 | modulo: 4 -%}
              {% render 'sn-media', art: arts[ai], class: 'snjr__m sn-ripple' %}
              <span class="snjr__date"><b>{{ forloop.index | times: 7 }}</b>Oct</span>
            </a>
            <div class="snjr__body">
              <p class="snjr__meta"><span>Sleep notes</span>{% if s.show_time %}<span>{% render 'sn-icon', name: 'clock', class: 'icon' %}{{ forloop.index | plus: 3 }} {{ s.min_label }}</span>{% endif %}</p>
              <h3 class="sn-h {% if forloop.first and s.layout == 'feature' %}sn-h--m{% else %}sn-h--s{% endif %}"><a href="{{ lurl }}">{{ t | strip }}</a></h3>
              {%- if s.show_excerpt -%}<p class="snjr__ex">Pick a blog in the theme editor to show your latest articles here.</p>{%- endif -%}
              <a class="sn-link" href="{{ lurl }}">{{ s.read_label }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if s.layout == 'rail' -%}<div class="snjr__nav"><div class="sn-progress"><i data-sn-prog></i></div><div class="sn-rail-nav"><button type="button" class="sn-ibtn" data-sn-prev aria-label="Previous">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}</button><button type="button" class="sn-ibtn" data-sn-next aria-label="Next">{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button></div></div>{%- endif -%}
  </div>
</section>
<style>
#{{ sid }} .snjr__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 34px); }
#{{ sid }}.snjr--feature .snjr__list { grid-template-columns: 1.3fr 1fr; grid-auto-rows: auto; }
#{{ sid }}.snjr--feature .is-lead { grid-row: span 3; }
#{{ sid }}.snjr--feature .snjr__post:not(.is-lead) { grid-template-columns: 180px 1fr; align-items: center; gap: 22px; }
#{{ sid }}.snjr--feature .snjr__post:not(.is-lead) .snjr__ex { display: none; }
#{{ sid }}.snjr--rail .snjr__list { display: grid; --col: min(400px, 82vw); }
#{{ sid }} .snjr__post { display: grid; gap: 18px; align-content: start; }
#{{ sid }} .snjr__img { position: relative; display: block; }
#{{ sid }} .snjr__m { aspect-ratio: 4 / 3; border-radius: var(--r); }
#{{ sid }} .is-lead .snjr__m { aspect-ratio: 5 / 4; }
#{{ sid }}.snjr--feature .snjr__post:not(.is-lead) .snjr__m { aspect-ratio: 1; }
#{{ sid }} .snjr__post:hover .snjr__m img, #{{ sid }} .snjr__post:hover .snjr__m .sn-art { transform: scale(1.05); }
#{{ sid }} .snjr__date { position: absolute; z-index: 2; left: 14px; top: 14px; display: grid; justify-items: center; width: 56px; padding: 8px 0 7px; border-radius: 999px; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); font-size: 10.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--soft); transition: transform .6s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .snjr__date b { font: 400 1.35rem/1.1 var(--f-head); letter-spacing: 0; color: var(--tx); }
#{{ sid }} .snjr__post:hover .snjr__date { transform: translateY(-4px) rotate(-4deg); }
#{{ sid }}.snjr--feature .snjr__post:not(.is-lead) .snjr__date { display: none; }
#{{ sid }} .snjr__body { display: grid; gap: 10px; justify-items: start; }
#{{ sid }} .snjr__meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: 11.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ac-aa, var(--ac)); }
#{{ sid }} .snjr__meta span { display: inline-flex; align-items: center; gap: 6px; }
#{{ sid }} .snjr__meta span + span { color: var(--mute); }
#{{ sid }} .snjr__meta .icon { width: 13px; height: 13px; }
#{{ sid }} .snjr__body h3 a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .6s cubic-bezier(.3, .7, .2, 1); }
#{{ sid }} .snjr__post:hover h3 a { background-size: 100% 1px; }
#{{ sid }} .snjr__ex { color: var(--soft); font-size: 15px; line-height: 1.7; }
#{{ sid }} .snjr__nav { display: flex; align-items: center; gap: 24px; margin-top: 26px; }
#{{ sid }} .snjr__nav .sn-progress { flex: 1; }
@media (max-width: 989px) {
  #{{ sid }}:not(.snjr--rail) .snjr__list { grid-template-columns: 1fr 1fr; }
  #{{ sid }}.snjr--feature .is-lead { grid-row: auto; grid-column: 1 / -1; }
  #{{ sid }}.snjr--feature .snjr__post:not(.is-lead) { grid-template-columns: 1fr; }
}
@media (max-width: 599px) {
  #{{ sid }}:not(.snjr--rail) .snjr__list { grid-template-columns: 1fr; }
  #{{ sid }}.snjr--feature .snjr__post:not(.is-lead) { grid-template-columns: 110px 1fr; gap: 16px; }
}
</style>
{% schema %}
{
  "name": "Journal (blog posts)",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "The journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notes on"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "sleeping well"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "head_size",
      "label": "Heading size",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "l"
    },
    {
      "type": "select",
      "id": "head_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "feature",
          "label": "Lead story + list"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "rail",
          "label": "Slider"
        }
      ],
      "default": "feature"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Posts",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "text",
      "id": "min_label",
      "label": "Reading time label",
      "default": "min read"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Read link",
      "default": "Read the story"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all link",
      "default": "All stories"
    },
    {
      "type": "textarea",
      "id": "ph_titles",
      "label": "Placeholder titles (shown until a blog is chosen)",
      "default": "How to choose the right thread count\nCaring for cotton sateen sheets\nFive rituals for a calmer bedtime\nThe secret to a hotel-made bed"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Journal (blog posts)"
    }
  ]
}
{% endschema %}
