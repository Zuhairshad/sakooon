{%- liquid
  assign s = section.settings
  assign sid = 'sntg-' | append: section.id
  assign grades = section.blocks
  assign start = 0
  for b in grades
    if b.settings.featured
      assign start = forloop.index0
    endif
  endfor
  assign mlab = s.m1 | append: '|' | append: s.m2 | append: '|' | append: s.m3 | append: '|' | append: s.m4 | split: '|'
-%}
<section id="{{ sid }}" class="sn-s sntg" style="{% render 'sn-vars', s: s %}" data-sntg data-start="{{ start }}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 4 %}
    <div class="sntg__grid">
      <div class="sntg__loom sn-pillow sn-stitch" data-r="unfold">
        <canvas data-sntg-cv width="720" height="820" aria-hidden="true"></canvas>
        <div class="sntg__badge">
          <b data-sntg-num>{{ grades[start].settings.number }}</b>
          <span>{{ s.unit_label }}</span>
        </div>
        <p class="sntg__weave" data-sntg-weave>{{ grades[start].settings.weave }}</p>
      </div>

      <div class="sntg__side">
        <div class="sntg__spools" role="tablist" data-r>
          {%- for block in grades -%}
            {%- assign b = block.settings -%}
            <button type="button" role="tab" class="sntg__spool{% if forloop.index0 == start %} is-on{% endif %}" data-sntg-tab="{{ forloop.index0 }}" data-n="{{ b.number }}" data-w="{{ b.weave }}" data-tone="{{ b.tone }}" aria-selected="{% if forloop.index0 == start %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <span class="sntg__reel" style="--tone: {{ b.tone }};"><i></i></span>
              <span class="sntg__lab"><b>{{ b.label }}</b><small>{{ b.badge }}</small></span>
            </button>
          {%- endfor -%}
        </div>
        {%- for block in grades -%}
          {%- assign b = block.settings -%}
          <article class="sntg__panel{% if forloop.index0 == start %} is-on{% endif %}" data-sntg-panel{% unless forloop.index0 == start %} hidden{% endunless %}>
            <p class="sn-eyebrow">{{ b.label }} · {{ b.name }}</p>
            <h3 class="sn-h sn-h--m">{{ b.title }}</h3>
            {%- if b.text != blank -%}<div class="sn-rte">{{ b.text }}</div>{%- endif -%}
            <ul class="sntg__meters">
              {%- assign vals = b.m1 | append: '|' | append: b.m2 | append: '|' | append: b.m3 | append: '|' | append: b.m4 | split: '|' -%}
              {%- for l in mlab -%}
                {%- if l != blank -%}
                  {%- assign v = vals[forloop.index0] | plus: 0 -%}
                  <li style="--v: {{ v | times: 10 }}%; --i: {{ forloop.index0 }};"><span>{{ l }}</span><i><b></b></i><em>{{ v }}</em></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if b.best_for != blank -%}<div class="sntg__best">{%- assign bf = b.best_for | split: ',' -%}{%- for x in bf -%}<span class="sn-chip">{{ x | strip }}</span>{%- endfor -%}</div>{%- endif -%}
            <div class="sntg__foot">
              {%- if b.price != blank -%}<p class="sntg__price"><small>{{ s.from_label }}</small>{{ b.price }}</p>{%- endif -%}
              {%- if b.button != blank -%}<a class="sn-btn" href="{{ b.link | default: routes.all_products_collection_url }}"><span>{{ b.button }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>

    {%- if s.show_table and grades.size > 1 -%}
      <div class="sntg__table sn-pillow" data-r>
        <table>
          <thead><tr><th scope="col">{{ s.table_corner }}</th>{%- for b in grades -%}<th scope="col"{% if b.settings.featured %} class="is-f"{% endif %}>{{ b.settings.label }}<small>{{ b.settings.badge }}</small></th>{%- endfor -%}</tr></thead>
          <tbody>
            {%- for l in mlab -%}
              {%- if l != blank -%}
                {%- assign mi = forloop.index -%}
                <tr><th scope="row">{{ l }}</th>
                  {%- for b in grades -%}
                    {%- case mi -%}{%- when 1 -%}{%- assign v = b.settings.m1 -%}{%- when 2 -%}{%- assign v = b.settings.m2 -%}{%- when 3 -%}{%- assign v = b.settings.m3 -%}{%- else -%}{%- assign v = b.settings.m4 -%}{%- endcase -%}
                    <td{% if b.settings.featured %} class="is-f"{% endif %}><span class="sntg__moons" aria-label="{{ v }} / 10">{%- for d in (1..5) -%}{%- assign th = d | times: 2 -%}{%- assign th1 = th | minus: 1 -%}{%- if v >= th -%}{% render 'sn-phase', k: 4 %}{%- elsif v == th1 -%}{% render 'sn-phase', k: 2 %}{%- else -%}{% render 'sn-phase', k: 0 %}{%- endif -%}{%- endfor -%}</span></td>
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
            <tr><th scope="row">{{ s.best_label }}</th>{%- for b in grades -%}<td{% if b.settings.featured %} class="is-f"{% endif %}>{{ b.settings.best_for | split: ',' | first | strip }}</td>{%- endfor -%}</tr>
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</section>
<style>
#{{ sid }} .sntg__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(30px, 6vw, 100px); align-items: center; }
#{{ sid }} .sntg__loom { position: relative; aspect-ratio: 36 / 41; border-radius: calc(var(--r) * 1.6); overflow: hidden; background: color-mix(in srgb, var(--tx) 92%, var(--bg)); box-shadow: 0 60px 100px -60px rgba(20, 22, 40, .7); }
#{{ sid }} .sntg__loom canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
#{{ sid }} .sntg__badge { position: absolute; z-index: 2; right: 22px; top: 22px; display: grid; justify-items: center; padding: 18px 22px; border-radius: calc(var(--r) * .8); background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); color: var(--tx); text-align: center; }
#{{ sid }} .sntg__badge b { font: 300 clamp(2.6rem, 5vw, 4rem)/1 var(--f-head); font-variant-numeric: tabular-nums; }
#{{ sid }} .sntg__badge span { max-width: 9em; margin-top: 6px; font-size: 10px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); line-height: 1.4; }
#{{ sid }} .sntg__weave { position: absolute; z-index: 2; left: 22px; bottom: 20px; padding: 9px 16px; border-radius: 999px; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); font: italic 300 1.05rem var(--f-head); color: var(--tx); }
#{{ sid }} .sntg__side { display: grid; gap: 28px; }
#{{ sid }} .sntg__spools { display: flex; flex-wrap: wrap; gap: 10px; }
#{{ sid }} .sntg__spool { display: flex; align-items: center; gap: 14px; padding: 10px 20px 10px 10px; border-radius: 999px; border: 1px solid var(--line2); transition: background .5s, color .5s, border-color .5s, transform .5s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .sntg__spool:hover { transform: translateY(-3px); }
#{{ sid }} .sntg__spool.is-on { background: var(--tx); color: var(--bg); border-color: var(--tx); }
#{{ sid }} .sntg__reel { position: relative; width: 40px; height: 40px; border-radius: 50%; background: repeating-linear-gradient(0deg, var(--tone) 0 2px, color-mix(in srgb, var(--tone) 70%, #000) 2px 3px); box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--tone) 60%, #8b6a3e); }
#{{ sid }} .sntg__reel i { position: absolute; inset: 14px; border-radius: 50%; background: var(--bg); }
#{{ sid }} .sntg__spool.is-on .sntg__reel { animation: sn-spin 3s linear infinite; }
#{{ sid }} .sntg__lab { display: grid; text-align: left; }
#{{ sid }} .sntg__lab b { font: 400 1.3rem/1 var(--f-head); }
#{{ sid }} .sntg__lab small { margin-top: 3px; font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; opacity: .7; }
#{{ sid }} .sntg__panel { display: grid; gap: 16px; }
#{{ sid }} .sntg__panel[hidden] { display: none; }
#{{ sid }} .sntg__panel.is-on > * { animation: sntg-in .8s cubic-bezier(.2, .8, .2, 1) both; }
#{{ sid }} .sntg__panel.is-on > :nth-child(2) { animation-delay: .06s; } #{{ sid }} .sntg__panel.is-on > :nth-child(3) { animation-delay: .12s; } #{{ sid }} .sntg__panel.is-on > :nth-child(4) { animation-delay: .18s; } #{{ sid }} .sntg__panel.is-on > :nth-child(5) { animation-delay: .24s; } #{{ sid }} .sntg__panel.is-on > :nth-child(6) { animation-delay: .3s; }
@keyframes sntg-in { from { opacity: 0; transform: translateY(14px); filter: blur(8px); } }
#{{ sid }} .sntg__meters { display: grid; gap: 14px; margin-top: 8px; }
#{{ sid }} .sntg__meters li { display: grid; grid-template-columns: 130px 1fr 34px; align-items: center; gap: 16px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
#{{ sid }} .sntg__meters i { position: relative; height: 10px; border-radius: 10px; background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 9px); overflow: hidden; }
#{{ sid }} .sntg__meters b { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: inherit; background: repeating-linear-gradient(90deg, var(--ac) 0 6px, color-mix(in srgb, var(--ac) 60%, transparent) 6px 9px); transition: width 1.4s cubic-bezier(.3, .7, .2, 1) calc(var(--i) * 100ms + .2s); }
#{{ sid }} .sntg__panel.is-on .sntg__meters b { width: var(--v); }
#{{ sid }} .sntg__meters em { font: 300 1.2rem var(--f-head); font-style: normal; text-align: right; letter-spacing: 0; }
#{{ sid }} .sntg__best { display: flex; flex-wrap: wrap; gap: 8px; }
#{{ sid }} .sntg__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 30px; padding-top: 22px; margin-top: 6px; border-top: 1px dashed var(--line2); }
#{{ sid }} .sntg__price { font: 300 2rem/1 var(--f-head); }
#{{ sid }} .sntg__price small { display: block; margin-bottom: 6px; font: 600 10.5px var(--f-body); letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .sntg__table { margin-top: clamp(60px, 7vw, 100px); overflow-x: auto; border-radius: calc(var(--r) * 1.2); }
#{{ sid }} .sntg__table table { min-width: 560px; }
#{{ sid }} .sntg__table th, #{{ sid }} .sntg__table td { padding: 18px 20px; text-align: center; border-bottom: 1px solid var(--line); font-size: 14px; }
#{{ sid }} .sntg__table tr:last-child > * { border-bottom: 0; }
#{{ sid }} .sntg__table thead th { font: 300 1.5rem var(--f-head); }
#{{ sid }} .sntg__table thead small { display: block; margin-top: 4px; font: 600 10px var(--f-body); letter-spacing: .18em; text-transform: uppercase; color: var(--ac); }
#{{ sid }} .sntg__table tbody th { text-align: left; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .sntg__table .is-f { background: color-mix(in srgb, var(--ac) 9%, transparent); }
#{{ sid }} .sntg__moons { display: inline-flex; gap: 4px; color: var(--ac); }
#{{ sid }} .sntg__moons .sn-ph { width: 15px; height: 15px; }
@media (max-width: 989px) { #{{ sid }} .sntg__grid { grid-template-columns: 1fr; } #{{ sid }} .sntg__loom { max-width: 520px; width: 100%; justify-self: center; } }
@media (max-width: 599px) { #{{ sid }} .sntg__meters li { grid-template-columns: 96px 1fr 26px; gap: 10px; font-size: 10.5px; } #{{ sid }} .sntg__spool { padding-right: 14px; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var tabs = r.querySelectorAll('[data-sntg-tab]'), panels = r.querySelectorAll('[data-sntg-panel]');
  var cv = r.querySelector('[data-sntg-cv]'), ctx = cv.getContext('2d'), numEl = r.querySelector('[data-sntg-num]'), wv = r.querySelector('[data-sntg-weave]');
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || document.body.getAttribute('data-motion') === 'off';
  var cs = getComputedStyle(r), AC = cs.getPropertyValue('--ac').trim() || '#A8834F';
  var W = cv.width, H = cv.height, cols = 30, row = 0, rows = 0, gap = 0, tone = '#F4EEE2', pattern = 'plain', t = 0, raf = null, vis = false, shown = 0, target = 0;
  function hex(c) { c = c.replace('#', ''); if (c.length === 3) c = c.replace(/./g, '$&$&'); var n = parseInt(c, 16); return [n >> 16 & 255, n >> 8 & 255, n & 255]; }
  function shade(c, k) { var a = hex(c); return 'rgb(' + a.map(function (v) { return Math.max(0, Math.min(255, Math.round(v * k))); }).join(',') + ')'; }
  function setup(btn) {
    var n = parseFloat(btn.getAttribute('data-n')) || 200; target = n;
    tone = btn.getAttribute('data-tone') || '#F4EEE2';
    pattern = /sateen|satin/i.test(btn.getAttribute('data-w') || '') ? 'sateen' : (/terry|loop|gsm/i.test(btn.getAttribute('data-w') || '') ? 'terry' : 'plain');
    cols = Math.round(n / 9); gap = W / cols; rows = Math.ceil(H / gap) + 1; row = 0;
    if (wv) wv.textContent = btn.getAttribute('data-w') || '';
    ctx.fillStyle = shade(tone, .55); ctx.fillRect(0, 0, W, H);
    for (var c = 0; c < cols; c++) { var x = c * gap; var g = ctx.createLinearGradient(x, 0, x + gap, 0); g.addColorStop(0, shade(tone, .78)); g.addColorStop(.5, shade(tone, .95)); g.addColorStop(1, shade(tone, .7)); ctx.fillStyle = g; ctx.fillRect(x + gap * .08, 0, gap * .84, H); }
  }
  function over(c, rr) { if (pattern === 'sateen') return ((c + rr * 2) % 5) !== 0; return (c + rr) % 2 === 0; }
  function weaveRow(rr) {
    var y = rr * gap, th = gap * .86;
    if (pattern === 'terry') {
      for (var c = 0; c < cols; c++) { var x = c * gap + (rr % 2 ? gap / 2 : 0) + gap / 2, cy = y + gap / 2; var g = ctx.createRadialGradient(x - th * .2, cy - th * .25, 1, x, cy, th * .65); g.addColorStop(0, shade(tone, 1.06)); g.addColorStop(.6, shade(tone, .95)); g.addColorStop(1, shade(tone, .62)); ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, cy, th * .58, 0, 6.283); ctx.fill(); }
      return;
    }
    for (var c2 = 0; c2 < cols; c2++) {
      if (!over(c2, rr)) continue;
      var x2 = c2 * gap - gap * .06, g2 = ctx.createLinearGradient(0, y, 0, y + th);
      g2.addColorStop(0, shade(tone, 1.08)); g2.addColorStop(.45, shade(tone, 1)); g2.addColorStop(1, shade(tone, .72));
      ctx.fillStyle = g2; var w = gap * 1.12 * (pattern === 'sateen' ? 1 : 1); ctx.beginPath(); if (ctx.roundRect) ctx.roundRect(x2, y + gap * .07, w, th, th / 2); else ctx.rect(x2, y + gap * .07, w, th); ctx.fill();
    }
    if (pattern === 'sateen') { ctx.fillStyle = 'rgba(255,255,255,.07)'; ctx.fillRect(0, y + gap * .2, W, gap * .18); }
  }
  function shuttle(rr) {
    var y = rr * gap + gap / 2, x = (rr % 2 ? W - (t % 1) * W : (t % 1) * W);
    ctx.save(); ctx.fillStyle = AC; ctx.shadowColor = AC; ctx.shadowBlur = 18; ctx.beginPath(); ctx.ellipse(x, y, 16, 5, 0, 0, 6.283); ctx.fill(); ctx.restore();
  }
  function frame() {
    raf = null; if (!vis || document.hidden) return;
    var per = Math.max(1, Math.round(rows / 70));
    for (var k = 0; k < per && row < rows; k++) { weaveRow(row); row++; }
    shown += (target - shown) * .08; if (numEl) numEl.textContent = Math.round(shown);
    if (row < rows) raf = requestAnimationFrame(frame); else { numEl.textContent = target; }
  }
  function show(k) {
    tabs.forEach(function (b, j) { b.classList.toggle('is-on', j === k); b.setAttribute('aria-selected', j === k); });
    panels.forEach(function (p, j) { p.hidden = j !== k; p.classList.toggle('is-on', j === k); });
    setup(tabs[k]);
    if (reduce) { for (var i = 0; i < rows; i++) weaveRow(i); row = rows; numEl.textContent = target; return; }
    if (!raf) raf = requestAnimationFrame(frame);
  }
  tabs.forEach(function (b, j) { b.addEventListener('click', function () { show(j); }); });
  var start = parseInt(r.getAttribute('data-start'), 10) || 0;
  if (!tabs.length) return;
  setup(tabs[start]);
  if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { var was = vis; vis = es[0].isIntersecting; if (vis && !was) { if (row === 0) show(start); else if (!raf) raf = requestAnimationFrame(frame); } }, { threshold: .2 }).observe(cv);
  else { vis = true; show(start); }
  document.addEventListener('shopify:block:select', function (e) { var k = Array.prototype.indexOf.call(tabs, e.target); if (k > -1) show(k); });
})();
</script>
{% schema %}
{
  "name": "Thread count guide",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "The loom"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch your sheet being"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "woven"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Thread count is how many threads are woven into one square inch. Choose a weave and watch the loom work — denser weaves feel smoother and silkier."
    },
    {
      "type": "select",
      "id": "head_size",
      "label": "Heading size",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "l"
    },
    {
      "type": "select",
      "id": "head_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Loom"
    },
    {
      "type": "text",
      "id": "unit_label",
      "label": "Number label",
      "default": "Threads per sq. inch",
      "info": "For towels: Grams per sq. metre"
    },
    {
      "type": "text",
      "id": "m1",
      "label": "Bar 1",
      "default": "Softness"
    },
    {
      "type": "text",
      "id": "m2",
      "label": "Bar 2",
      "default": "Smoothness"
    },
    {
      "type": "text",
      "id": "m3",
      "label": "Bar 3",
      "default": "Breathability"
    },
    {
      "type": "text",
      "id": "m4",
      "label": "Bar 4",
      "default": "Durability"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "Price label",
      "default": "Sets from"
    },
    {
      "type": "text",
      "id": "best_label",
      "label": "Best for label",
      "default": "Best for"
    },
    {
      "type": "checkbox",
      "id": "show_table",
      "label": "Show comparison table",
      "default": true
    },
    {
      "type": "text",
      "id": "table_corner",
      "label": "Table corner",
      "default": "Compare"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "grade",
      "name": "Weave",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "T300"
        },
        {
          "type": "number",
          "id": "number",
          "label": "Thread count or GSM",
          "default": 300
        },
