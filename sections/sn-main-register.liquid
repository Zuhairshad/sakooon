{%- liquid
  assign s = section.settings
  assign sid = 'snrg-' | append: section.id
  assign perks = s.perks | newline_to_br | split: '<br />'
-%}
<section id="{{ sid }}" class="sn-s snau" style="{% render 'sn-vars', s: s %}">
  <div class="snau__grid">
    {% render 'sn-auth-side', s: s, k: 4 %}
    <div class="snau__main">
      <div class="snau__card">
        <p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 1 %}{{ s.eyebrow }}</p>
        <h1 class="sn-h sn-h--l" data-sn-split>{{ s.heading }} <em>{{ s.highlight }}</em></h1>
        {%- if s.perks != blank -%}
          <ul class="snau__perks" data-r>{%- for p in perks -%}{%- assign pp = p | strip -%}{%- if pp != blank -%}<li>{% render 'sn-icon', name: 'sparkle', class: 'icon' %}{{ pp }}</li>{%- endif -%}{%- endfor -%}</ul>
        {%- endif -%}
        {%- form 'create_customer', novalidate: 'novalidate' -%}
          {%- if form.errors -%}<p class="sn-msg sn-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="snau__row">
            <div class="snau__fl"><input class="sn-input" type="text" id="{{ sid }}-f" name="customer[first_name]" autocomplete="given-name" placeholder=" " value="{{ form.first_name }}"><label for="{{ sid }}-f">{{ s.l_first }}</label></div>
            <div class="snau__fl"><input class="sn-input" type="text" id="{{ sid }}-l" name="customer[last_name]" autocomplete="family-name" placeholder=" " value="{{ form.last_name }}"><label for="{{ sid }}-l">{{ s.l_last }}</label></div>
          </div>
          <div class="snau__fl"><input class="sn-input" type="email" id="{{ sid }}-e" name="customer[email]" autocomplete="email" placeholder=" " required value="{{ form.email }}"><label for="{{ sid }}-e">{{ s.l_email }}</label></div>
          <div class="snau__fl"><input class="sn-input" type="password" id="{{ sid }}-p" name="customer[password]" autocomplete="new-password" placeholder=" " required minlength="5" data-snrg-pw><label for="{{ sid }}-p">{{ s.l_pass }}</label><button type="button" class="snau__eye" data-snau-eye aria-label="Show password">{% render 'sn-icon', name: 'eye', class: 'icon' %}</button></div>
          <div class="snrg__str" aria-hidden="true"><i></i><i></i><i></i><i></i><span data-snrg-lbl></span></div>
          {%- if s.newsletter -%}<label class="sn-check"><input type="checkbox" name="customer[accepts_marketing]" value="true" checked><span>{{ s.nl_label }}</span></label>{%- endif -%}
          <button type="submit" class="sn-btn sn-btn--gold sn-btn--block"><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
        {%- endform -%}
        <div class="snau__links"><span class="sn-small">{{ s.have }}</span><a href="{{ routes.account_login_url }}">{{ s.login }}</a></div>
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snrg__str { display: flex; align-items: center; gap: 6px; margin-top: -4px; }
#{{ sid }} .snrg__str i { flex: 1; height: 3px; border-radius: 3px; background: var(--line); transition: background .4s; }
#{{ sid }} .snrg__str span { min-width: 64px; text-align: right; font-size: 11.5px; color: var(--soft); }
#{{ sid }} .snrg__str[data-l="1"] i:nth-child(-n + 1) { background: var(--c-danger); }
#{{ sid }} .snrg__str[data-l="2"] i:nth-child(-n + 2) { background: #D08A2E; }
#{{ sid }} .snrg__str[data-l="3"] i:nth-child(-n + 3) { background: var(--ac); }
#{{ sid }} .snrg__str[data-l="4"] i { background: var(--c-signal); }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var pw = r.querySelector('[data-snrg-pw]'), st = r.querySelector('.snrg__str'), lb = r.querySelector('[data-snrg-lbl]'), L = {{ s.strength | split: ',' | json }};
  pw.addEventListener('input', function () { var v = pw.value, n = 0; if (v.length >= 6) n++; if (/[A-Z]/.test(v) && /[a-z]/.test(v)) n++; if (/\d/.test(v)) n++; if (/[^A-Za-z0-9]/.test(v) || v.length > 11) n++; if (!v) n = 0; st.setAttribute('data-l', n); lb.textContent = n ? (L[n - 1] || '').trim() : ''; });
  r.addEventListener('click', function (e) { var eye = e.target.closest('[data-snau-eye]'); if (eye) { var i = eye.parentNode.querySelector('input'); i.type = i.type === 'password' ? 'text' : 'password'; } });
})();
</script>
{% schema %}
{
  "name": "Register",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Join Sakooon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create your"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "night-time account"
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks (one per line)",
      "default": "10% off your first order\nTrack every delivery\nSave favourites across devices"
    },
    {
      "type": "text",
      "id": "l_first",
      "label": "First name label",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "l_last",
      "label": "Last name label",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "l_email",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "l_pass",
      "label": "Password label",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "strength",
      "label": "Strength words (comma separated)",
      "default": "Weak, Fair, Good, Strong"
    },
    {
      "type": "checkbox",
      "id": "newsletter",
      "label": "Newsletter checkbox",
      "default": true
    },
    {
      "type": "text",
      "id": "nl_label",
      "label": "Newsletter label",
      "default": "Send me sleep notes and offers"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button",
      "default": "Create account"
    },
    {
      "type": "text",
      "id": "have",
      "label": "Have account text",
      "default": "Already a member?"
    },
    {
      "type": "text",
      "id": "login",
      "label": "Login link",
      "default": "Sign in"
    },
    {
      "type": "header",
      "content": "Night panel"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Image (optional)"
    },
    {
      "type": "text",
      "id": "side_eyebrow",
      "label": "Small heading",
      "default": "Sakooon members"
    },
    {
      "type": "text",
      "id": "side_title",
      "label": "Quote",
      "default": "Rest is the softest luxury."
    },
    {
      "type": "textarea",
      "id": "side_text",
      "label": "Text",
      "default": "Track orders, save favourites and get first access to new colours."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    }
  ]
}
{% endschema %}
