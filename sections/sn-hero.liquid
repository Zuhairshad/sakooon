{%- liquid
  assign s = section.settings
  assign sid = 'snhero-' | append: section.id
  assign slides = section.blocks | where: 'type', 'slide'
  assign chips = section.blocks | where: 'type', 'chip'
  assign n = slides.size
  assign c1 = s.silk_c1 | default: settings.color_dark_bg
  assign c2 = s.silk_c2 | default: settings.color_dusk
  assign c3 = s.silk_c3 | default: settings.color_moon
-%}
<section id="{{ sid }}" class="sn-s snhero snhero--{{ s.mode }} snhero--{{ s.align }} is-ready" style="{% render 'sn-vars', s: s %} --h: {{ s.height }}svh;" data-snhero data-auto="{{ s.autoplay }}" data-sn-silk-host>
  {% render 'sn-divider', s: s %}

  {%- if s.mode == 'silk' -%}
    <div class="snhero__silk" data-sn-silk data-c1="{{ c1 }}" data-c2="{{ c2 }}" data-c3="{{ c3 }}" data-speed="{{ s.silk_speed | divided_by: 10.0 }}" data-amp="1"></div>
  {%- endif -%}
  {%- if s.feathers -%}<div class="snhero__fx" data-sn-feathers="{{ s.feather_count }}" data-color="{{ c3 }}"></div>{%- endif -%}

  {%- if s.mode == 'image' -%}
    <div class="snhero__stage">
      {%- for block in slides -%}
        {%- assign b = block.settings -%}
        <figure class="snhero__bg{% if forloop.first %} is-on{% endif %}" data-snhero-bg {{ block.shopify_attributes }}>
          {%- if b.video != blank -%}
            {{ b.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
          {%- elsif b.image != blank -%}
            <picture>
              {%- if b.image_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ b.image_mobile | image_url: width: 900 }}">{%- endif -%}
              <img src="{{ b.image | image_url: width: 2200 }}" srcset="{{ b.image | image_url: width: 1000 }} 1000w, {{ b.image | image_url: width: 1600 }} 1600w, {{ b.image | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ b.image.alt | default: b.heading | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %}>
            </picture>
          {%- else -%}
            {% render 'sn-art', name: b.art %}
          {%- endif -%}
        </figure>
      {%- endfor -%}
      <span class="snhero__shade" style="--o: {{ s.overlay | divided_by: 100.0 }};"></span>
    </div>
  {%- endif -%}

  <div class="snhero__in sn-wrap">
    <div class="snhero__copy">
      {%- for block in slides -%}
        {%- assign b = block.settings -%}
        <div class="snhero__txt{% if forloop.first %} is-on{% endif %}" data-snhero-txt{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {%- if b.eyebrow != blank -%}<p class="sn-eyebrow snhero__eb">{% render 'sn-phase', k: forloop.index %}{{ b.eyebrow }}</p>{%- endif -%}
          {%- if forloop.first -%}<h1 class="sn-h snhero__h">{%- else -%}<h2 class="sn-h snhero__h">{%- endif -%}
            {%- assign words = b.heading | split: ' ' -%}
            {%- for w in words -%}<span class="snhero__w"><span style="--wi: {{ forloop.index0 }};">{{ w }}</span></span> {% endfor -%}
            {%- if b.highlight != blank -%}<br>{%- assign hw = b.highlight | split: ' ' -%}{%- for w in hw -%}<span class="snhero__w"><em style="--wi: {{ forloop.index0 | plus: words.size }};">{{ w }}</em></span> {% endfor -%}{%- endif -%}
          {%- if forloop.first -%}</h1>{%- else -%}</h2>{%- endif -%}
          {%- if b.text != blank -%}<p class="snhero__p">{{ b.text }}</p>{%- endif -%}
          <div class="snhero__btns">
            {%- if b.button_label != blank -%}<a class="sn-btn{% if s.mode != 'paper' %} sn-btn--light{% endif %}" href="{{ b.button_link | default: routes.all_products_collection_url }}"><span>{{ b.button_label }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
            {%- if b.button_label_2 != blank -%}<a class="sn-btn{% if s.mode != 'paper' %} sn-btn--glass{% else %} sn-btn--ghost{% endif %}" href="{{ b.button_link_2 | default: routes.collections_url }}"><span>{{ b.button_label_2 }}</span></a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}

      {%- if chips.size > 0 -%}
        <ul class="snhero__chips">
          {%- for block in chips -%}<li {{ block.shopify_attributes }} style="--i: {{ forloop.index0 }};">{% render 'sn-icon', name: block.settings.icon, class: 'icon' %}<span>{{ block.settings.text }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if s.mode != 'image' -%}
      <div class="snhero__vis" data-snhero-vis>
        <div class="snhero__frame">
          {%- for block in slides -%}
            {%- assign b = block.settings -%}
            <figure class="snhero__fig{% if forloop.first %} is-on{% endif %}" data-snhero-bg>
              {%- if b.image != blank -%}
                <img src="{{ b.image | image_url: width: 1200 }}" srcset="{{ b.image | image_url: width: 700 }} 700w, {{ b.image | image_url: width: 1200 }} 1200w" sizes="(min-width: 990px) 42vw, 90vw" alt="{{ b.image.alt | default: b.heading | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %}>
              {%- else -%}
                {% render 'sn-art', name: b.art %}
              {%- endif -%}
            </figure>
          {%- endfor -%}
          <span class="snhero__stitch" aria-hidden="true"></span>
        </div>
        {%- if s.swatch_label != blank -%}
          <div class="snhero__swatch sn-glass">
            <span class="snhero__sw-dots">{%- assign sws = s.swatch_colors | split: ',' -%}{%- for c in sws -%}<i style="background: {{ c | strip }}; --k: {{ forloop.index0 }};"></i>{%- endfor -%}</span>
            <span><b>{{ s.swatch_label }}</b>{% if s.swatch_text != blank %}<small>{{ s.swatch_text }}</small>{% endif %}</span>
          </div>
        {%- endif -%}
        {%- if s.seal_text != blank -%}
          <div class="snhero__seal" aria-hidden="true">
            <svg viewBox="0 0 140 140"><defs><path id="{{ sid }}-c" d="M70 70m-54 0a54 54 0 1 1 108 0a54 54 0 1 1-108 0"/></defs><text><textPath href="#{{ sid }}-c">{{ s.seal_text }}</textPath></text></svg>
            {% render 'sn-phase', k: 1 %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if n > 1 -%}
    <div class="snhero__nav sn-wrap">
      <div class="snhero__moons" role="tablist" aria-label="Slides">
        {%- for block in slides -%}
          <button type="button" role="tab" class="snhero__moon{% if forloop.first %} is-on{% endif %}" data-snhero-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}">
            <svg viewBox="0 0 30 30"><circle class="o" cx="15" cy="15" r="13"/><circle class="p" cx="15" cy="15" r="13" pathLength="100"/><circle class="m" cx="15" cy="15" r="5"/></svg>
          </button>
        {%- endfor -%}
      </div>
      <span class="snhero__count"><b data-snhero-cur>01</b> / {% if n < 10 %}0{% endif %}{{ n }}</span>
    </div>
  {%- endif -%}
  {%- if s.scroll_cue -%}<a class="snhero__cue" href="#{{ sid }}-end" aria-label="Scroll"><span>{{ s.scroll_text }}</span><i></i></a>{%- endif -%}
  <span id="{{ sid }}-end"></span>
</section>
<style>
#{{ sid }} { min-height: var(--h); display: flex; flex-direction: column; justify-content: center; overflow: hidden; padding: var(--pt) 0 var(--pb); }
#{{ sid }}.snhero--silk, #{{ sid }}.snhero--image { color: #fff; --tx: #fff; --soft: rgba(255, 255, 255, .78); --line: rgba(255, 255, 255, .2); --line2: rgba(255, 255, 255, .34); }
#{{ sid }}.snhero--silk { --ac: {{ c3 }}; background: {{ c1 }}; }
#{{ sid }}.snhero--image { --ac: {{ settings.color_moon }}; background: {{ settings.color_dark_bg }}; }
#{{ sid }} .snhero__silk { position: absolute; inset: 0; z-index: -2; }
#{{ sid }} .snhero__fx { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
#{{ sid }} .snhero__stage { position: absolute; inset: 0; z-index: -2; }
#{{ sid }} .snhero__bg { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.4s ease; }
#{{ sid }} .snhero__bg.is-on { opacity: 1; z-index: 1; }
#{{ sid }} .snhero__bg img, #{{ sid }} .snhero__bg video, #{{ sid }} .snhero__bg picture, #{{ sid }} .snhero__bg .sn-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .snhero__bg img, #{{ sid }} .snhero__bg .sn-art { transform: scale(1.14); transition: transform 9s cubic-bezier(.2, .6, .2, 1); }
#{{ sid }} .snhero__bg.is-on img, #{{ sid }} .snhero__bg.is-on .sn-art { transform: scale(1.02); }
#{{ sid }} .snhero__shade { position: absolute; inset: 0; z-index: 2; background: linear-gradient(90deg, rgba(12, 14, 26, var(--o)) 0%, rgba(12, 14, 26, calc(var(--o) * .4)) 55%, transparent 85%), linear-gradient(0deg, rgba(12, 14, 26, calc(var(--o) * .9)), transparent 50%); }

#{{ sid }} .snhero__in { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; gap: clamp(30px, 5vw, 90px); }
#{{ sid }}.snhero--image .snhero__in { grid-template-columns: minmax(0, 1fr); }
#{{ sid }}.snhero--center .snhero__in { grid-template-columns: 1fr; justify-items: center; text-align: center; }
#{{ sid }}.snhero--center .snhero__vis { display: none; }
#{{ sid }} .snhero__copy { display: grid; max-width: 780px; }
#{{ sid }} .snhero__txt { grid-area: 1 / 1; visibility: hidden; }
#{{ sid }} .snhero__txt.is-on { visibility: visible; }
#{{ sid }} .snhero__eb { margin-bottom: 26px; opacity: 0; transform: translateY(12px); transition: opacity .9s cubic-bezier(.2, .7, .2, 1), transform .9s cubic-bezier(.2, .7, .2, 1); }
#{{ sid }} .snhero__h { font-size: clamp(3rem, 7.4vw, 7rem); line-height: .96; letter-spacing: -.035em; }
#{{ sid }} .snhero__h em { color: var(--ac); }
#{{ sid }} .snhero__w { display: inline-block; }
#{{ sid }} .snhero__w > * { display: inline-block; opacity: 0; transform: translateY(.4em) scale(1.04); transition: opacity 1.2s cubic-bezier(.2, .7, .2, 1), transform 1.3s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--wi) * 80ms + 150ms); }
#{{ sid }} .snhero__p { margin-top: 26px; max-width: 48ch; font-size: clamp(1rem, 1.3vw, 1.18rem); line-height: 1.75; color: var(--soft); opacity: 0; transform: translateY(10px); transition: opacity 1s cubic-bezier(.2, .7, .2, 1) .5s, transform 1s cubic-bezier(.2, .7, .2, 1) .5s; }
#{{ sid }}.snhero--center .snhero__p { margin-inline: auto; }
#{{ sid }} .snhero__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; opacity: 0; transform: translateY(14px); transition: opacity 1s cubic-bezier(.2, .7, .2, 1) .65s, transform 1s cubic-bezier(.2, .7, .2, 1) .65s; }
#{{ sid }}.snhero--center .snhero__btns { justify-content: center; }
#{{ sid }}.is-ready .snhero__txt.is-on .snhero__eb, #{{ sid }}.is-ready .snhero__txt.is-on .snhero__p { opacity: 1; transform: none; }
#{{ sid }}.is-ready .snhero__txt.is-on .snhero__w > * { opacity: 1; transform: none; }
#{{ sid }}.is-ready .snhero__txt.is-on .snhero__btns { opacity: 1; transform: none; }
#{{ sid }} .snhero__txt.is-out .snhero__w > *, #{{ sid }} .snhero__txt.is-out .snhero__eb, #{{ sid }} .snhero__txt.is-out .snhero__p, #{{ sid }} .snhero__txt.is-out .snhero__btns { opacity: 0 !important; transform: translateY(-.3em) !important; transition-duration: .6s; transition-delay: 0s; }
#{{ sid }} .snhero__chips { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 44px; padding-top: 22px; border-top: 1px dashed var(--line2); }
#{{ sid }}.snhero--center .snhero__chips { justify-content: center; }
#{{ sid }} .snhero__chips li { display: inline-flex; align-items: center; gap: 9px; font-size: 13.5px; color: var(--soft); opacity: 0; transform: translateY(10px); transition: all .8s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i) * 90ms + 1s); }
#{{ sid }}.is-ready .snhero__chips li { opacity: 1; transform: none; }
#{{ sid }} .snhero__chips .icon { width: 17px; height: 17px; color: var(--ac); }

/* side visual: pillow frame */
#{{ sid }} .snhero__vis { position: relative; justify-self: end; width: min(520px, 100%); --mx: 0; --my: 0; }
#{{ sid }} .snhero__frame { position: relative; aspect-ratio: 4 / 5; border-radius: calc(var(--r) * 2.2); overflow: hidden; background: color-mix(in srgb, #fff 8%, transparent); box-shadow: 0 60px 120px -50px rgba(0, 0, 0, .7), inset 0 0 0 1px rgba(255, 255, 255, .14); transform: perspective(1400px) rotateY(calc(var(--mx) * -7deg)) rotateX(calc(var(--my) * 6deg)) translateZ(0); transition: transform .8s cubic-bezier(.2, .7, .2, 1); opacity: 0; scale: .9; filter: blur(10px); }
#{{ sid }}.is-ready .snhero__frame { opacity: 1; scale: 1; filter: none; transition: transform .8s cubic-bezier(.2, .7, .2, 1), opacity 1.4s ease .2s, scale 1.6s cubic-bezier(.2, .7, .2, 1) .2s, filter 1.4s ease .2s; }
#{{ sid }}.snhero--paper .snhero__frame { box-shadow: 0 60px 100px -50px rgba(27, 33, 48, .45); }
#{{ sid }} .snhero__fig { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.2s ease; }
#{{ sid }} .snhero__fig.is-on { opacity: 1; z-index: 1; }
#{{ sid }} .snhero__fig img, #{{ sid }} .snhero__fig .sn-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); transition: transform 8s cubic-bezier(.2, .6, .2, 1); }
#{{ sid }} .snhero__fig.is-on img, #{{ sid }} .snhero__fig.is-on .sn-art { transform: scale(1); }
#{{ sid }} .snhero__stitch { position: absolute; inset: 12px; z-index: 3; border-radius: calc(var(--r) * 2.2 - 10px); border: 1.5px dashed color-mix(in srgb, var(--ac) 70%, transparent); pointer-events: none; }
#{{ sid }} .snhero__swatch { position: absolute; z-index: 4; left: -44px; bottom: 14%; display: flex; align-items: center; gap: 16px; padding: 14px 22px 14px 14px; border-radius: 999px; color: var(--c-ink); background: color-mix(in srgb, #fff 78%, transparent); animation: snhero-float 7s ease-in-out infinite; transform: translate3d(calc(var(--mx) * 16px), calc(var(--my) * 16px), 0); }
@keyframes snhero-float { 50% { translate: 0 -10px; } }
#{{ sid }} .snhero__sw-dots { display: flex; }
#{{ sid }} .snhero__sw-dots i { width: 30px; height: 30px; border-radius: 50%; margin-left: -9px; box-shadow: 0 0 0 2px #fff; animation: snhero-sw 4s ease-in-out infinite; animation-delay: calc(var(--k) * .3s); }
#{{ sid }} .snhero__sw-dots i:first-child { margin-left: 0; }
@keyframes snhero-sw { 50% { transform: translateY(-4px); } }
#{{ sid }} .snhero__swatch b { display: block; font: 400 1.05rem/1.15 var(--f-head); }
#{{ sid }} .snhero__swatch small { display: block; font-size: 11.5px; letter-spacing: .08em; color: var(--c-ink-soft); }
#{{ sid }} .snhero__seal { position: absolute; z-index: 4; right: -34px; top: 8%; width: 132px; height: 132px; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, {{ c1 }} 80%, transparent); color: {{ c3 }}; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: 0 20px 40px -18px rgba(0, 0, 0, .55); }
#{{ sid }} .snhero__seal svg:not(.sn-ph) { position: absolute; inset: 0; width: 100%; height: 100%; animation: sn-spin 26s linear infinite; }
#{{ sid }} .snhero__seal text { font: 600 9.6px var(--f-body); letter-spacing: .34em; text-transform: uppercase; fill: currentColor; }
#{{ sid }} .snhero__seal .sn-ph { width: 32px; height: 32px; }

/* nav: moon dots */
#{{ sid }} .snhero__nav { position: relative; z-index: 3; display: flex; align-items: center; gap: 20px; margin-top: clamp(30px, 5vh, 60px); }
#{{ sid }}.snhero--center .snhero__nav { justify-content: center; }
#{{ sid }} .snhero__moons { display: flex; gap: 10px; }
#{{ sid }} .snhero__moon { width: 34px; height: 34px; }
#{{ sid }} .snhero__moon svg { width: 100%; height: 100%; transform: rotate(-90deg); }
#{{ sid }} .snhero__moon .o { fill: none; stroke: var(--line2); stroke-width: 1; }
#{{ sid }} .snhero__moon .p { fill: none; stroke: var(--ac); stroke-width: 1.6; stroke-dasharray: 100; stroke-dashoffset: 100; }
#{{ sid }} .snhero__moon .m { fill: var(--line2); transition: fill .4s, r .4s; }
#{{ sid }} .snhero__moon.is-on .m { fill: var(--ac); r: 6.5; }
#{{ sid }} .snhero__moon.is-on .p { animation: snhero-p var(--dur, 7s) linear forwards; }
#{{ sid }}.is-paused .snhero__moon.is-on .p { animation-play-state: paused; }
@keyframes snhero-p { to { stroke-dashoffset: 0; } }
#{{ sid }} .snhero__count { font: 300 1.1rem var(--f-head); color: var(--soft); font-variant-numeric: tabular-nums; }
#{{ sid }} .snhero__count b { font-weight: 300; color: var(--tx); font-size: 1.5rem; }
#{{ sid }} .snhero__cue { position: absolute; z-index: 3; right: clamp(16px, 3vw, 40px); bottom: 28px; display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; writing-mode: vertical-rl; color: var(--soft); }
#{{ sid }} .snhero__cue i { position: relative; width: 1px; height: 64px; background: var(--line2); overflow: hidden; }
#{{ sid }} .snhero__cue i::after { content: ""; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--ac); animation: snhero-cue 2.2s cubic-bezier(.6, 0, .4, 1) infinite; }
@keyframes snhero-cue { to { top: 100%; } }
/* These loops are decorative; they wait for html.sn-idle (set in theme.liquid
   after load + requestIdleCallback) so they never compete with first paint. */
html:not(.sn-idle) #{{ sid }} .snhero__swatch,
html:not(.sn-idle) #{{ sid }} .snhero__sw-dots i,
html:not(.sn-idle) #{{ sid }} .snhero__seal svg:not(.sn-ph),
html:not(.sn-idle) #{{ sid }} .snhero__cue i::after {
  animation-play-state: paused !important;
}
@media (max-width: 989px) {
  #{{ sid }} .snhero__in { grid-template-columns: 1fr; }
  #{{ sid }} .snhero__vis { justify-self: center; width: min(400px, 82%); order: -1; margin-top: 10px; }
  #{{ sid }} .snhero__swatch { left: -22px; } #{{ sid }} .snhero__seal { right: -20px; width: 104px; height: 104px; }
  #{{ sid }} .snhero__cue { display: none; }
}
@media (max-width: 599px) {
  #{{ sid }} .snhero__swatch { left: -12px; padding: 10px 16px 10px 10px; gap: 10px; } #{{ sid }} .snhero__sw-dots i { width: 24px; height: 24px; }
  #{{ sid }} .snhero__seal { right: -10px; width: 88px; height: 88px; } #{{ sid }} .snhero__seal text { font-size: 8px; }
  #{{ sid }} .snhero__btns .sn-btn { flex: 1 1 100%; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var bgs = r.querySelectorAll('[data-snhero-bg]'), txts = r.querySelectorAll('[data-snhero-txt]'), dots = r.querySelectorAll('[data-snhero-dot]');
  var cur = r.querySelector('[data-snhero-cur]'), vis = r.querySelector('[data-snhero-vis]');
  var n = txts.length, i = 0, timer = null, secs = parseFloat(r.getAttribute('data-auto')) || 0, tiltRaf = 0;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || document.body.getAttribute('data-motion') === 'off';
  r.style.setProperty('--dur', (secs || 7) + 's');
  function go(k) {
    if (n < 2) return; k = (k + n) % n; if (k === i) return;
    var prev = i; i = k;
    bgs.forEach(function (b, j) { b.classList.toggle('is-on', j === k); });
    txts[prev].classList.add('is-out');
    setTimeout(function () { txts.forEach(function (t, j) { t.classList.remove('is-out'); t.classList.toggle('is-on', j === k); t.setAttribute('aria-hidden', j === k ? 'false' : 'true'); }); }, 520);
    dots.forEach(function (d, j) { d.classList.toggle('is-on', j === k); });
    if (cur) cur.textContent = (k < 9 ? '0' : '') + (k + 1);
    restart();
  }
  function restart() { clearTimeout(timer); dots.forEach(function (d) { var p = d.querySelector('.p'); if (p) { p.style.animation = 'none'; void p.getBBox(); p.style.animation = ''; } }); if (secs > 0 && n > 1) timer = setTimeout(function () { go(i + 1); }, secs * 1000); }
  dots.forEach(function (d) { d.addEventListener('click', function () { go(+d.getAttribute('data-snhero-dot')); }); });
  r.addEventListener('mouseenter', function () { if (secs) { clearTimeout(timer); r.classList.add('is-paused'); } });
  r.addEventListener('mouseleave', function () { if (secs) { r.classList.remove('is-paused'); restart(); } });
  var x0 = null; r.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
  r.addEventListener('touchend', function (e) { if (x0 == null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) go(i + (dx < 0 ? 1 : -1)); x0 = null; });
  if (vis && !reduce && matchMedia('(hover: hover)').matches) {
    var tiltX = 0, tiltY = 0;
    r.addEventListener('pointermove', function (e) {
      tiltX = e.clientX; tiltY = e.clientY;
      if (tiltRaf) return;
      tiltRaf = requestAnimationFrame(function () {
        tiltRaf = 0;
        var b = r.getBoundingClientRect();
        vis.style.setProperty('--mx', ((tiltX - b.left) / b.width - .5).toFixed(3));
        vis.style.setProperty('--my', ((tiltY - b.top) / b.height - .5).toFixed(3));
      });
    }, { passive: true });
  }
  // The hero renders complete on first paint (.is-ready is server-rendered);
  // only the autoplay timer needs a start call, and it can start right away —
  // it no longer waits on a preloader that is off by default.
  restart();
