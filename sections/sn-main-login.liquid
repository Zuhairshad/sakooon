{%- liquid
  assign s = section.settings
  assign sid = 'snli-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snau" style="{% render 'sn-vars', s: s %}">
  <div class="snau__grid">
    {% render 'sn-auth-side', s: s, k: 3 %}
    <div class="snau__main">
      <div class="snau__flip" data-snli>
        <div class="snau__card" data-snli-login>
          <p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 2 %}{{ s.eyebrow }}</p>
          <h1 class="sn-h sn-h--l" data-sn-split>{{ s.heading }} <em>{{ s.highlight }}</em></h1>
          {%- if s.sub != blank -%}<p class="snau__sub" data-r>{{ s.sub }}</p>{%- endif -%}
          {%- form 'customer_login', novalidate: 'novalidate' -%}
            {%- if form.errors -%}<p class="sn-msg sn-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
            <div class="snau__fl"><input class="sn-input" type="email" id="{{ sid }}-e" name="customer[email]" autocomplete="email" placeholder=" " required><label for="{{ sid }}-e">{{ s.l_email }}</label></div>
            {%- if form.password_needed -%}
              <div class="snau__fl"><input class="sn-input" type="password" id="{{ sid }}-p" name="customer[password]" autocomplete="current-password" placeholder=" " required><label for="{{ sid }}-p">{{ s.l_pass }}</label><button type="button" class="snau__eye" data-snau-eye aria-label="Show password">{% render 'sn-icon', name: 'eye', class: 'icon' %}</button></div>
            {%- endif -%}
            <div class="snau__links"><a href="#recover" data-snli-to="recover">{{ s.forgot }}</a></div>
            <button type="submit" class="sn-btn sn-btn--gold sn-btn--block"><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
          {%- endform -%}
          <p class="snau__or">{{ s.or_label }}</p>
          <a class="sn-btn sn-btn--ghost sn-btn--block" href="{{ routes.account_register_url }}"><span>{{ s.register }}</span></a>
          {%- if shop.checkout.guest_login -%}
            {%- form 'guest_login' -%}<button type="submit" class="sn-link">{{ s.guest }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>{%- endform -%}
          {%- endif -%}
        </div>
        <div class="snau__card" data-snli-recover aria-hidden="true">
          <p class="sn-eyebrow">{% render 'sn-phase', k: 1 %}{{ s.r_eyebrow }}</p>
          <h2 class="sn-h sn-h--l">{{ s.r_heading }}</h2>
          <p class="snau__sub">{{ s.r_text }}</p>
          {%- form 'recover_customer_password' -%}
            {%- if form.posted_successfully? -%}<p class="sn-msg" data-snli-sent>{{ s.r_ok }}</p>{%- endif -%}
            {%- if form.errors -%}<p class="sn-msg sn-msg--err" data-snli-err>{{ form.errors | default_errors }}</p>{%- endif -%}
            <div class="snau__fl"><input class="sn-input" type="email" id="{{ sid }}-r" name="email" autocomplete="email" placeholder=" " required><label for="{{ sid }}-r">{{ s.l_email }}</label></div>
            <button type="submit" class="sn-btn sn-btn--gold sn-btn--block"><span>{{ s.r_btn }}</span></button>
          {%- endform -%}
          <div class="snau__links"><a href="#login" data-snli-to="login">← {{ s.r_back }}</a></div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var L = r.querySelector('[data-snli-login]'), R = r.querySelector('[data-snli-recover]');
  function show(w) { var rec = w === 'recover'; L.setAttribute('aria-hidden', rec); R.setAttribute('aria-hidden', !rec); var f = (rec ? R : L).querySelector('input:not([type=hidden])'); if (f) setTimeout(function () { f.focus(); }, 300); }
  r.addEventListener('click', function (e) {
    var t = e.target.closest('[data-snli-to]'); if (t) { e.preventDefault(); show(t.getAttribute('data-snli-to')); history.replaceState({}, '', '#' + t.getAttribute('data-snli-to')); }
    var eye = e.target.closest('[data-snau-eye]'); if (eye) { var i = eye.parentNode.querySelector('input'); i.type = i.type === 'password' ? 'text' : 'password'; }
  });
  if (location.hash === '#recover' || r.querySelector('[data-snli-sent],[data-snli-err]')) show('recover');
})();
</script>
