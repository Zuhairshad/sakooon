{%- liquid
  assign s = section.settings
  assign sid = 'snvd-' | append: section.id
  assign has_ext = false
  if s.video_url != blank
    assign has_ext = true
  endif
-%}
<section id="{{ sid }}" class="sn-s snvd snvd--{{ s.mode }}" style="{% render 'sn-vars', s: s %} --h: {{ s.height }}svh;">
  {% render 'sn-divider', s: s %}
  <div class="{% if s.full %}snvd__full{% else %}sn-wrap{% endif %}">
    {%- if s.mode != 'ambient' -%}{% render 'sn-head', s: s, k: 2 %}{%- endif -%}
    <div class="snvd__stage" data-snvd data-r="unfold">
      <div class="snvd__poster">
        {%- if s.mode == 'ambient' and s.video != blank -%}
          {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'snvd__bgv', image_size: '1600x' }}
        {%- else -%}
          {% render 'sn-media', image: s.poster, art: s.art, width: 2000, sizes: '100vw', class: 'snvd__pm' %}
        {%- endif -%}
      </div>
      <div class="snvd__veil"></div>
      {%- if s.mode == 'ambient' -%}
        <div class="snvd__over">
          {%- if s.eyebrow != blank -%}<p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 2 %}{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="sn-h sn-h--{{ s.head_size }}" data-sn-split>{{ s.heading }}{% if s.highlight != blank %} <em>{{ s.highlight }}</em>{% endif %}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="sn-lead" data-r style="--i: 2;">{{ s.text }}</p>{%- endif -%}
          {%- if s.btn != blank -%}<a class="sn-btn sn-btn--light" href="{{ s.link | default: routes.all_products_collection_url }}" data-r style="--i: 3;"><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.mode != 'ambient' or has_ext or s.video != blank -%}
        <button type="button" class="snvd__play" data-snvd-play aria-label="{{ s.play_label | escape }}">
          <svg class="snvd__ring" viewBox="0 0 200 200" aria-hidden="true"><defs><path id="{{ sid }}-p" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0"/></defs><text><textPath href="#{{ sid }}-p">{{ s.play_label | escape }} · {{ s.play_label | escape }} · {{ s.play_label | escape }} ·</textPath></text></svg>
          <span class="snvd__btn">{% render 'sn-icon', name: 'play', class: 'icon' %}</span>
        </button>
      {%- endif -%}
      {%- if s.caption != blank -%}<p class="snvd__cap"><span></span>{{ s.caption }}</p>{%- endif -%}
      <template data-snvd-tpl>
        {%- if has_ext -%}
          {%- if s.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ s.video_url.id }}?autoplay=1&rel=0&playsinline=1" title="{{ s.heading | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ s.video_url.id }}?autoplay=1&byline=0&title=0" title="{{ s.heading | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- endif -%}
        {%- elsif s.video != blank -%}
          {{ s.video | video_tag: autoplay: true, controls: true, playsinline: true }}
        {%- endif -%}
      </template>
    </div>
  </div>
  {%- if s.popup -%}
    <div class="sn-ov snvd__ov" id="SnVid-{{ section.id }}" hidden>
      <div class="sn-ov__bg" data-sn-close></div>
      <div class="snvd__box" role="dialog" aria-modal="true" aria-label="{{ s.heading | escape }}">
        <button type="button" class="sn-ibtn snvd__x" data-sn-close aria-label="Close">{% render 'sn-icon', name: 'close', class: 'icon' %}</button>
        <div class="snvd__frame" data-snvd-frame></div>
      </div>
    </div>
  {%- endif -%}
</section>
<style>
#{{ sid }} .snvd__full { width: 100%; }
#{{ sid }} .snvd__stage { position: relative; isolation: isolate; overflow: hidden; border-radius: {% if s.full %}0{% else %}calc(var(--r) * 1.4){% endif %}; aspect-ratio: {{ s.ratio }}; background: var(--c-dark); color: #fff; }
#{{ sid }}.snvd--ambient .snvd__stage { aspect-ratio: auto; min-height: var(--h); display: grid; align-items: end; }
#{{ sid }} .snvd__poster, #{{ sid }} .snvd__poster .sn-media { position: absolute; inset: 0; z-index: -2; border-radius: 0; }
#{{ sid }} .snvd__poster .sn-media { height: 100%; }
#{{ sid }} .snvd__poster img, #{{ sid }} .snvd__poster .sn-art, #{{ sid }} .snvd__bgv { transition: transform 2.4s cubic-bezier(.2, .7, .2, 1); }
#{{ sid }} .snvd__bgv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .snvd__stage:hover .snvd__poster img, #{{ sid }} .snvd__stage:hover .snvd__poster .sn-art { transform: scale(1.04); }
#{{ sid }} .snvd__veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--c-dark) {{ s.overlay }}%, transparent)); pointer-events: none; }
#{{ sid }} .snvd__over { position: relative; display: grid; gap: 20px; justify-items: start; max-width: 760px; padding: clamp(28px, 6vw, 90px); --tx: #fff; --soft: rgba(255,255,255,.82); --ac: var(--c-moon); --ac-aa: var(--c-moon); color: #fff; }
#{{ sid }} .snvd__play { position: absolute; z-index: 3; left: 50%; top: 50%; width: clamp(120px, 12vw, 170px); aspect-ratio: 1; translate: -50% -50%; display: grid; place-items: center; color: #fff; }
#{{ sid }}.snvd--ambient .snvd__play { left: auto; right: clamp(24px, 5vw, 70px); top: auto; bottom: clamp(24px, 5vw, 70px); translate: none; }
#{{ sid }} .snvd__ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: snvd-spin 18s linear infinite; }
#{{ sid }} .snvd__ring text { font: 600 13px var(--f-body); letter-spacing: .3em; text-transform: uppercase; fill: currentColor; }
#{{ sid }} .snvd__btn { position: relative; width: 50%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, #fff 18%, transparent); border: 1px solid rgba(255,255,255,.5); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); transition: transform .6s cubic-bezier(.3, 1.5, .5, 1), background .4s, color .4s; }
#{{ sid }} .snvd__btn::before, #{{ sid }} .snvd__btn::after { content: ""; position: absolute; inset: -1px; border-radius: 50%; border: 1px solid rgba(255,255,255,.55); animation: snvd-pulse 2.6s cubic-bezier(.2, .7, .2, 1) infinite; }
#{{ sid }} .snvd__btn::after { animation-delay: 1.3s; }
@keyframes snvd-pulse { to { transform: scale(1.9); opacity: 0; } }
#{{ sid }} .snvd__btn .icon { width: 28%; height: 28%; margin-left: 6%; }
#{{ sid }} .snvd__play:hover .snvd__btn { transform: scale(1.1); background: var(--c-moon); color: var(--c-dark); }
@keyframes snvd-spin { to { transform: rotate(360deg); } }
#{{ sid }} .snvd__cap { position: absolute; z-index: 2; left: clamp(20px, 3vw, 36px); bottom: clamp(18px, 3vw, 30px); display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
#{{ sid }} .snvd__cap span { width: 8px; height: 8px; border-radius: 50%; background: var(--c-danger); animation: snpr-blink2 1.4s infinite; }
@keyframes snpr-blink2 { 50% { opacity: .2; } }
#{{ sid }} .snvd__stage.is-playing > :not(.snvd__frame-in) { visibility: hidden; }
#{{ sid }} .snvd__frame-in, #{{ sid }} .snvd__frame-in iframe, #{{ sid }} .snvd__frame-in video, #SnVid-{{ section.id }} .snvd__frame iframe, #SnVid-{{ section.id }} .snvd__frame video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; background: #000; }
#{{ sid }} .snvd__frame-in { visibility: visible !important; z-index: 5; }
#SnVid-{{ section.id }} .snvd__box { position: absolute; left: 50%; top: 50%; width: min(1100px, calc(100% - 32px)); aspect-ratio: 16 / 9; translate: -50% -50%; border-radius: var(--r); overflow: hidden; background: #000; transform: scale(.9); opacity: 0; transition: transform .7s cubic-bezier(.3, 1.2, .4, 1), opacity .5s; }
#SnVid-{{ section.id }}.is-open .snvd__box { transform: none; opacity: 1; }
#SnVid-{{ section.id }} .snvd__frame { position: absolute; inset: 0; }
#SnVid-{{ section.id }} .snvd__x { position: absolute; z-index: 3; right: 12px; top: 12px; background: rgba(0,0,0,.5); color: #fff; border-color: rgba(255,255,255,.3); }
@media (max-width: 749px) {
  #{{ sid }} .snvd__stage { aspect-ratio: {% if s.ratio == '21 / 9' %}4 / 3{% else %}{{ s.ratio }}{% endif %}; }
  #{{ sid }} .snvd__play { width: 104px !important; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var st = r.querySelector('[data-snvd]'), b = r.querySelector('[data-snvd-play]'), tpl = r.querySelector('[data-snvd-tpl]');
  if (!b || !tpl) return;
  var popup = {{ s.popup | json }}, ov = r.querySelector('.snvd__ov');
  [].forEach.call(document.querySelectorAll('body > #SnVid-{{ section.id }}'), function (o) { o.remove(); });
  if (ov && ov.parentNode !== document.body) document.body.appendChild(ov);
  b.addEventListener('click', function () {
    var html = tpl.innerHTML.trim();
    if (!html) { SN.toast && SN.toast({{ s.empty_msg | json }}, 'info'); return; }
    if (popup && ov) { ov.querySelector('[data-snvd-frame]').innerHTML = html; SN.open(ov); ov.addEventListener('sn:close', function () {}, { once: true }); return; }
    var d = document.createElement('div'); d.className = 'snvd__frame-in'; d.innerHTML = html; st.appendChild(d); st.classList.add('is-playing');
  });
  if (ov) ov.addEventListener('click', function (e) { if (e.target.closest('[data-sn-close]')) setTimeout(function () { ov.querySelector('[data-snvd-frame]').innerHTML = ''; }, 400); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && ov) ov.querySelector('[data-snvd-frame]').innerHTML = ''; });
})();
</script>
{% schema %}
{
  "name": "Video",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Style",
      "options": [
        {
          "value": "poster",
          "label": "Poster with play button"
        },
        {
          "value": "ambient",
          "label": "Ambient background video + text"
        }
      ],
      "default": "poster"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Ambient style plays this muted on loop"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or YouTube / Vimeo link",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "select",
      "id": "art",
      "label": "Poster illustration",
      "options": [
        {
          "value": "bed",
          "label": "Bedroom"
        },
        {
          "value": "bed-cover",
          "label": "Bed cover"
        },
        {
          "value": "bed-sheet",
          "label": "Bed sheets"
        },
        {
          "value": "duvet",
          "label": "Duvet"
        },
        {
          "value": "duvet-cover",
          "label": "Duvet cover"
        },
        {
          "value": "pillow",
          "label": "Pillow"
        },
        {
          "value": "pillow-cover",
          "label": "Pillow cover"
        },
        {
          "value": "towel",
          "label": "Towels"
        }
      ],
      "default": "bed"
    },
    {
      "type": "checkbox",
      "id": "popup",
      "label": "Play in a popup",
      "default": true
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Shape",
      "options": [
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "21 / 9",
          "label": "Cinema 21:9"
        },
        {
          "value": "4 / 3",
          "label": "4:3"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "21 / 9"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Ambient height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Shade",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "checkbox",
      "id": "full",
      "label": "Full width",
      "default": false
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play ring text",
      "default": "Watch the film"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Corner caption",
      "default": "The making of Sakooon"
    },
    {
      "type": "text",
      "id": "empty_msg",
      "label": "Message when no video is set",
      "default": "Add a video in the theme editor"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Behind the seams"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch how"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "softness is made"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "head_size",
      "label": "Heading size",
      "options": [
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "l"
    },
    {
      "type": "select",
      "id": "head_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button (ambient style)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
