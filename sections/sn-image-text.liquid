{%- liquid
  assign s = section.settings
  assign sid = 'snit-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snit snit--{{ s.image_pos }} snit--{{ s.style }}" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap snit__grid">
    <div class="snit__vis" data-snit-vis>
      <div class="snit__main" data-r="unfold" data-px=".06">
        {% render 'sn-media', image: s.image, art: s.art, width: 1400, sizes: '(min-width: 990px) 50vw, 100vw', class: 'snit__img sn-ripple', ratio: s.ratio %}
      </div>
      {%- if s.style == 'layered' -%}
        <div class="snit__second" data-r="rise" style="--i: 3;" data-px="-.12">
          {% render 'sn-media', image: s.image2, art: s.art2, width: 800, sizes: '25vw', class: 'snit__img2', ratio: '4 / 5' %}
        </div>
      {%- endif -%}
      {%- if s.stat != blank -%}
        <div class="snit__stat sn-glass" data-r="zoom" style="--i: 4;" data-px="-.2">
          <b data-snit-count="{{ s.stat | escape }}">{{ s.stat }}</b><span>{{ s.stat_label }}</span>
        </div>
      {%- endif -%}
      {%- if s.ring != blank -%}
        <div class="snit__ring" aria-hidden="true">
          <svg viewBox="0 0 200 200"><defs><path id="{{ sid }}-r" d="M100 100m-80 0a80 80 0 1 1 160 0a80 80 0 1 1-160 0"/></defs><text><textPath href="#{{ sid }}-r">{{ s.ring | escape }} · {{ s.ring | escape }} ·</textPath></text></svg>
          {% render 'sn-icon', name: 'moon', class: 'icon' %}
        </div>
      {%- endif -%}
    </div>
    <div class="snit__copy">
      {% render 'sn-head', s: s, k: 2 %}
      {%- if s.body != blank -%}<div class="sn-rte" data-r style="--i: 3;">{{ s.body }}</div>{%- endif -%}
      {%- if s.points != blank -%}
        {%- assign pts = s.points | newline_to_br | split: '<br />' -%}
        <ul class="snit__pts">
          {%- for p in pts -%}{%- assign pp = p | strip -%}{%- if pp != blank -%}
            <li data-r style="--i: {{ forloop.index | plus: 3 }};"><i>{% render 'sn-icon', name: 'check', class: 'icon' %}</i>{{ pp }}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.btn != blank or s.btn2 != blank -%}
        <div class="snit__btns" data-r style="--i: 8;">
          {%- if s.btn != blank -%}<a class="sn-btn" href="{{ s.link | default: routes.all_products_collection_url }}"><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
          {%- if s.btn2 != blank -%}<a class="sn-link" href="{{ s.link2 | default: routes.all_products_collection_url }}">{{ s.btn2 }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
#{{ sid }} .snit__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(36px, 7vw, 120px); align-items: center; }
#{{ sid }}.snit--right .snit__vis { order: 2; }
#{{ sid }} .snit__vis { position: relative; padding: {% if s.style == 'layered' %}0 12% 12% 0{% else %}0{% endif %}; }
#{{ sid }}.snit--right.snit--layered .snit__vis { padding: 0 0 12% 12%; }
#{{ sid }} .snit__main, #{{ sid }} .snit__second, #{{ sid }} .snit__stat { will-change: transform; }
#{{ sid }} .snit__img { border-radius: calc(var(--r) * 1.3); box-shadow: 0 50px 90px -60px rgba(20, 22, 40, .6); }
#{{ sid }} .snit__second { position: absolute; right: 0; bottom: 0; width: 42%; z-index: 2; }
#{{ sid }}.snit--right .snit__second { right: auto; left: 0; }
#{{ sid }} .snit__img2 { border-radius: var(--r); border: 8px solid var(--bg); box-shadow: 0 40px 70px -40px rgba(20, 22, 40, .6); }
#{{ sid }} .snit__stat { position: absolute; z-index: 3; left: -26px; top: 12%; display: grid; gap: 2px; padding: 18px 24px; border-radius: var(--r); }
#{{ sid }}.snit--right .snit__stat { left: auto; right: -26px; }
#{{ sid }} .snit__stat b { font: 300 clamp(2rem, 3.4vw, 3rem)/1 var(--f-head); color: var(--ac); }
#{{ sid }} .snit__stat span { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snit__ring { position: absolute; z-index: 3; right: 4%; top: -40px; width: 120px; height: 120px; display: grid; place-items: center; border-radius: 50%; background: var(--tx); color: var(--bg); }
#{{ sid }}.snit--right .snit__ring { right: auto; left: 4%; }
#{{ sid }} .snit__ring svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: snit-spin 24s linear infinite; }
#{{ sid }} .snit__ring text { font: 600 14px var(--f-body); letter-spacing: .3em; text-transform: uppercase; fill: currentColor; }
#{{ sid }} .snit__ring .icon { width: 26px; height: 26px; color: var(--ac); }
@keyframes snit-spin { to { transform: rotate(360deg); } }
#{{ sid }} .snit__copy { display: grid; gap: 24px; }
#{{ sid }} .snit__copy .sn-head { margin: 0; }
#{{ sid }} .snit__pts { display: grid; gap: 12px; }
#{{ sid }} .snit__pts li { display: flex; align-items: center; gap: 14px; font-size: 15.5px; }
#{{ sid }} .snit__pts i { width: 28px; height: 28px; flex: none; border-radius: 50%; display: grid; place-items: center; border: 1px dashed var(--ac); color: var(--ac); }
#{{ sid }} .snit__pts .icon { width: 13px; height: 13px; }
#{{ sid }} .snit__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 6px; }
@media (max-width: 899px) {
  #{{ sid }} .snit__grid { grid-template-columns: 1fr; }
  #{{ sid }}.snit--right .snit__vis { order: 0; }
  #{{ sid }} .snit__stat { left: 10px !important; right: auto !important; top: auto; bottom: 14%; padding: 12px 16px; }
  #{{ sid }} .snit__ring { width: 90px; height: 90px; top: -24px; right: 10px !important; left: auto !important; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  if (document.body.getAttribute('data-motion') === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = [].slice.call(r.querySelectorAll('[data-px]')), tk = false;
  function upd() { tk = false; var b = r.getBoundingClientRect(), c = Math.max(-innerHeight, Math.min(innerHeight, b.top + b.height / 2 - innerHeight / 2)); els.forEach(function (e) { e.style.translate = '0 ' + (c * parseFloat(e.getAttribute('data-px'))).toFixed(1) + 'px'; }); }
  addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(upd); } }, { passive: true }); upd();
  var n = r.querySelector('[data-snit-count]');
  if (n && 'IntersectionObserver' in window) {
    var raw = n.getAttribute('data-snit-count'), m = raw.match(/[\d.,]+/);
    if (m) { var target = parseFloat(m[0].replace(/,/g, '')), pre = raw.slice(0, m.index), post = raw.slice(m.index + m[0].length), dec = (m[0].split('.')[1] || '').length;
      new IntersectionObserver(function (es, o) { if (!es[0].isIntersecting) return; o.disconnect(); var t0 = performance.now(); (function f(t) { var k = Math.min(1, (t - t0) / 1800), e = 1 - Math.pow(1 - k, 3); n.textContent = pre + (target * e).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + post; if (k < 1) requestAnimationFrame(f); })(t0); }).observe(n); }
  }
})();
</script>
