    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-slide (0 = off)",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_link",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "placeholder_title",
      "label": "Placeholder product name (no collection yet)",
      "default": "Choose a collection"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
