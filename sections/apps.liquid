<div class="{% if section.settings.include_margins %}section page-width{% endif %}">
  {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
</div>
{% schema %}
{
  "name": "t:sections.apps.name",
  "settings": [ { "type": "checkbox", "id": "include_margins", "label": "t:sections.apps.settings.include_margins.label", "default": true } ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "t:sections.apps.presets.name" } ]
}
{% endschema %}
