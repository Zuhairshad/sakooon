{%- comment -%}
  Product highlights: bestsellers / new arrivals rail with optional tabs. Owner: shad-2d.
  Pattern: Parachute tabbed product rail (title, filter tabs underneath, arrows above the rail, "view all" below).
  Each tab block picks a collection; one tab renders without a tab list. Tabs use <theme-tabs> (global.js).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tab_count = section.blocks.size
  assign base_id = 'Highlights-' | append: section.id
  comment
    Tabs with up to 4 products fill the row at >=1024 as equal columns (max ~480px each) instead of a part-empty rail;
    the section caps at 1440px when every tab fits.
  endcomment
  assign fit_max = 4
  assign all_fit = true
  for block in section.blocks
    assign n = block.settings.collection.products.size | default: 0 | at_most: s.products_to_show
    if n == 0 or n > fit_max
      assign all_fit = false
    endif
  endfor
-%}
<div class="section product-rail product-rail--carousel product-highlights{% if all_fit %} product-rail--fit{% endif %} color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --rail-card: {{ s.card_width }}px;">
  <div class="page-width page-width--full product-rail__inner">
    <theme-tabs class="product-highlights__tabs">
      <div class="product-rail__head product-rail__head--stacked">
        {%- render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, heading_size: s.heading_size -%}
        {%- if tab_count > 1 -%}
          <div class="product-highlights__tablist tabs__list" role="tablist" aria-label="{{ s.heading | escape }}">
            {%- for block in section.blocks -%}
              <button type="button" role="tab" class="tabs__tab" id="{{ base_id }}-tab-{{ forloop.index }}" aria-controls="{{ base_id }}-panel-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
                {{- block.settings.label | default: block.settings.collection.title | default: s.heading | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign count = collection.products.size | default: 0 | at_most: s.products_to_show
          assign fit = false
          if count > 0 and count <= fit_max
            assign fit = true
          endif
          assign card_sizes = '(min-width: 768px) 320px, 60vw'
          if fit
            assign card_sizes = '(min-width: 1024px) min(480px, 30vw), (min-width: 768px) 320px, 60vw'
          endif
        -%}
        <scroll-rail class="product-highlights__panel{% if fit %} product-highlights__panel--fit{% endif %}" id="{{ base_id }}-panel-{{ forloop.index }}"{% if tab_count > 1 %} role="tabpanel" aria-labelledby="{{ base_id }}-tab-{{ forloop.index }}"{% endif %}{% unless forloop.first %} hidden{% endunless %}>
          <div class="rail-buttons rail-buttons--end">
            <button type="button" class="rail-button" data-rail-prev aria-label="{{ 'storefront.sections.previous' | t }}">{% render 'icon', icon: 'chevron-left', size: 18 %}</button>
            <button type="button" class="rail-button" data-rail-next aria-label="{{ 'storefront.sections.next' | t }}">{% render 'icon', icon: 'chevron-right', size: 18 %}</button>
          </div>
          <ul class="product-rail__track list-unstyled no-scrollbar{% if fit %} product-rail__track--fit{% endif %}"{% if fit %} style="--rail-count: {{ count }}"{% endif %} role="list" data-rail-track tabindex="0" aria-label="{{ block.settings.label | default: collection.title | default: s.heading | escape }}">
            {%- if collection != blank and collection.products.size > 0 -%}
              {%- for product in collection.products limit: s.products_to_show -%}
                <li class="product-rail__item">{%- render 'product-card', product: product, image_ratio: s.image_ratio, sizes: card_sizes -%}</li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..s.products_to_show) -%}
                <li class="product-rail__item">{%- render 'product-card', product: blank, image_ratio: s.image_ratio -%}</li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          {%- if s.view_all_label != blank -%}
            <div class="product-rail__footer">
              {%- assign view_all_url = collection.url | default: routes.all_products_collection_url -%}
              {%- render 'button', label: s.view_all_label, url: view_all_url, style: s.view_all_style -%}
            </div>
          {%- endif -%}
        </scroll-rail>
      {%- endfor -%}
    </theme-tabs>
  </div>
</div>

{% schema %}
{
  "name": "Product highlights",
  "tag": "section",
  "class": "section-product-highlights",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for your bed" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h3", "options": [ { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" }, { "value": "h4", "label": "t:sections.all.heading_size.options.h4" } ] },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "card_width", "label": "Card width (desktop)", "min": 200, "max": 400, "step": 8, "unit": "px", "default": 256 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "adapt", "label": "Adapt to image" } ] },
    { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "Shop all" },
    { "type": "select", "id": "view_all_style", "label": "View all button style", "default": "primary", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "tertiary", "label": "Text link" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "white" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "tab", "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Defaults to the collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [ { "name": "Product highlights", "blocks": [ { "type": "tab", "settings": { "label": "All" } }, { "type": "tab", "settings": { "label": "Bedding" } }, { "type": "tab", "settings": { "label": "Bath" } } ] } ]
}
{% endschema %}
