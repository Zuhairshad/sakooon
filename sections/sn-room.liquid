{%- liquid
  assign s = section.settings
  assign sid = 'snr-' | append: section.id
  assign total = 0
  assign addable = ''
  for block in section.blocks
    assign p = block.settings.product
    if p != blank
      assign v = p.selected_or_first_available_variant
      assign total = total | plus: v.price
      if p.variants.size == 1 and v.available
        assign addable = addable | append: v.id | append: ','
      endif
    endif
  endfor
-%}
<section id="{{ sid }}" class="sn-s snr" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 3 %}
  </div>
  <div class="snr__stage sn-wrap{% if s.full %}--wide{% endif %}" data-r="unfold">
    <div class="snr__img sn-media" style="aspect-ratio: {{ s.ratio }};">
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 2200 }}" srcset="{{ s.image | image_url: width: 1000 }} 1000w, {{ s.image | image_url: width: 1600 }} 1600w, {{ s.image | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ s.image.alt | default: s.heading | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" loading="lazy">
      {%- else -%}{% render 'sn-art', name: s.art %}{%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign p = b.product
        assign v = p.selected_or_first_available_variant
        assign title = b.title
        if p != blank
          assign title = p.title
        endif
        assign side = 'r'
        if b.x > 60
          assign side = 'l'
        endif
      -%}
      <div class="snr__spot" style="--x: {{ b.x }}%; --y: {{ b.y }}%; --i: {{ forloop.index0 }};" data-snr-spot {{ block.shopify_attributes }}>
        <button type="button" class="snr__dot" aria-label="{{ title | escape }}" aria-expanded="false">
          <svg viewBox="0 0 44 44" aria-hidden="true"><circle class="a" cx="22" cy="22" r="20"/><circle class="b" cx="22" cy="22" r="7"/><path class="c" d="M22 16v12M16 22h12"/></svg>
        </button>
        <div class="snr__pop snr__pop--{{ side }} sn-glass">
          <a class="snr__pimg sn-media" href="{{ p.url | default: b.link | default: '#' }}">
            {%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 300 }}" alt="" loading="lazy" width="150" height="190">{%- else -%}{% render 'sn-art', name: b.art %}{%- endif -%}
          </a>
          <div class="snr__pinfo">
            <a href="{{ p.url | default: b.link | default: '#' }}" class="snr__pt">{{ title }}</a>
            <span class="snr__pp">{%- if p != blank -%}{% render 'sn-price', product: p %}{%- else -%}{{ b.price_text }}{%- endif -%}</span>
            {%- if p != blank and p.available -%}
              {%- if p.variants.size == 1 -%}<button type="button" class="sn-link" data-sn-add="{{ v.id }}">{{ s.add_label }}{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- else -%}<button type="button" class="sn-link" data-sn-quick="{{ p.handle }}">{{ s.choose_label }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>{%- endif -%}
            {%- else -%}
              <a class="sn-link" href="{{ b.link | default: '#' }}">{{ s.view_label }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}

    <div class="snr__bar sn-glass" data-r style="--i: 3;">
      <div class="snr__thumbs">
        {%- for block in section.blocks limit: 5 -%}
          {%- assign p = block.settings.product -%}
          <span class="sn-media">{%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 120 }}" alt="" loading="lazy" width="60" height="60">{%- else -%}{% render 'sn-art', name: block.settings.art %}{%- endif -%}</span>
        {%- endfor -%}
      </div>
      <div class="snr__sum"><small>{{ s.total_label }} · {{ section.blocks.size }} {{ s.pieces_word }}</small><b>{% if total > 0 %}{{ total | money }}{% else %}{{ s.total_text }}{% endif %}</b></div>
      {%- if addable != blank -%}
        <button type="button" class="sn-btn sn-btn--gold sn-btn--sm" data-snr-all="{{ addable }}"><span>{{ s.add_all }}</span>{% render 'sn-icon', name: 'bag', class: 'icon' %}</button>
      {%- elsif s.button_label != blank -%}
        <a class="sn-btn sn-btn--gold sn-btn--sm" href="{{ s.button_link | default: routes.all_products_collection_url }}"><span>{{ s.button_label }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
#{{ sid }} .snr__stage { position: relative; }
#{{ sid }} .snr__img { border-radius: calc(var(--r) * 1.4); box-shadow: 0 60px 100px -60px rgba(20, 22, 40, .6); }
#{{ sid }} .sn-wrap--wide .snr__img, #{{ sid }}.snr .sn-wrap--wide { border-radius: calc(var(--r) * 1.2); }
#{{ sid }} .snr__spot { position: absolute; z-index: 3; left: var(--x); top: var(--y); }
#{{ sid }} .snr__dot { position: relative; width: 44px; height: 44px; margin: -22px 0 0 -22px; display: block; color: #fff; filter: drop-shadow(0 6px 14px rgba(0, 0, 0, .35)); transition: transform .5s cubic-bezier(.3, 1.5, .5, 1); }
#{{ sid }} .snr__dot svg { width: 100%; height: 100%; overflow: visible; }
#{{ sid }} .snr__dot .a { fill: none; stroke: #fff; stroke-width: 1.2; stroke-dasharray: 3 4; transform-origin: 22px 22px; animation: sn-spin 9s linear infinite; }
#{{ sid }} .snr__dot .b { fill: color-mix(in srgb, #fff 92%, transparent); transition: r .4s, fill .4s; }
#{{ sid }} .snr__dot .c { stroke: var(--c-ink); stroke-width: 1.6; stroke-linecap: round; transform-origin: 22px 22px; transform: scale(.55); transition: transform .45s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .snr__dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid #fff; animation: snr-ping 2.6s ease-out infinite; animation-delay: calc(var(--i) * .5s); }
@keyframes snr-ping { from { transform: scale(.4); opacity: 1; } to { transform: scale(1.7); opacity: 0; } }
#{{ sid }} .snr__spot.is-on .snr__dot, #{{ sid }} .snr__dot:hover { transform: scale(1.15); }
#{{ sid }} .snr__spot.is-on .snr__dot .b { r: 13; fill: var(--ac); }
#{{ sid }} .snr__spot.is-on .snr__dot .c { stroke: #fff; transform: scale(.75) rotate(45deg); }
#{{ sid }} .snr__pop { position: absolute; top: -30px; left: 34px; width: 300px; display: grid; grid-template-columns: 80px 1fr; gap: 14px; padding: 12px; border-radius: calc(var(--r) * .8); color: var(--c-ink); --tx: var(--c-ink); --ac: var(--c-accent); --soft: var(--c-ink-soft); --mute: color-mix(in srgb, var(--c-ink) 50%, transparent); background: color-mix(in srgb, var(--c-surface) 88%, transparent); opacity: 0; visibility: hidden; transform: translateX(-10px) scale(.94); transform-origin: 0 50%; transition: opacity .4s, transform .55s cubic-bezier(.3, 1.4, .5, 1), visibility .4s; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .5); }
#{{ sid }} .snr__pop--l { left: auto; right: 34px; transform-origin: 100% 50%; transform: translateX(10px) scale(.94); }
#{{ sid }} .snr__spot.is-on .snr__pop { opacity: 1; visibility: visible; transform: none; }
#{{ sid }} .snr__pimg { aspect-ratio: 4 / 5; border-radius: calc(var(--r) * .45); }
#{{ sid }} .snr__pinfo { display: grid; align-content: center; gap: 6px; }
#{{ sid }} .snr__pt { font: 400 1.1rem/1.2 var(--f-head); }
#{{ sid }} .snr__pp { font-size: 14px; }
#{{ sid }} .snr__pinfo .sn-link { justify-self: start; font-size: 11px; }
#{{ sid }} .snr__bar { position: absolute; z-index: 4; left: 50%; bottom: 22px; translate: -50% 0; display: flex; align-items: center; gap: 20px; padding: 10px 10px 10px 14px; border-radius: 999px; color: var(--c-ink); background: color-mix(in srgb, var(--c-surface) 85%, transparent); --tx: var(--c-ink); --bg: var(--c-surface); --ac: var(--c-accent); white-space: nowrap; }
#{{ sid }} .snr__thumbs { display: flex; }
#{{ sid }} .snr__thumbs .sn-media { width: 40px; height: 40px; border-radius: 50%; margin-left: -10px; box-shadow: 0 0 0 2px #fff; }
#{{ sid }} .snr__thumbs .sn-media:first-child { margin-left: 0; }
#{{ sid }} .snr__sum { display: grid; }
#{{ sid }} .snr__sum small { font-size: 10.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--c-ink-soft); }
#{{ sid }} .snr__sum b { font: 400 1.25rem/1.1 var(--f-head); }
@media (max-width: 749px) {
  #{{ sid }} .snr__pop { width: 230px; grid-template-columns: 64px 1fr; }
  #{{ sid }} .snr__bar { position: static; translate: none; margin: 16px 0 0; width: 100%; flex-wrap: wrap; justify-content: space-between; border-radius: calc(var(--r) * .9); padding: 14px; }
  #{{ sid }} .snr__bar .sn-btn { flex: 1 1 100%; }
  #{{ sid }} .snr__thumbs { display: none; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var spots = r.querySelectorAll('[data-snr-spot]');
  function set(sp) { spots.forEach(function (x) { var on = x === sp && !x.classList.contains('is-on'); x.classList.toggle('is-on', on); x.querySelector('.snr__dot').setAttribute('aria-expanded', on); }); }
  spots.forEach(function (sp) {
    sp.querySelector('.snr__dot').addEventListener('click', function (e) { e.stopPropagation(); set(sp); });
    if (matchMedia('(hover: hover)').matches) { sp.addEventListener('mouseenter', function () { spots.forEach(function (x) { x.classList.toggle('is-on', x === sp); }); }); sp.addEventListener('mouseleave', function () { sp.classList.remove('is-on'); }); }
  });
  document.addEventListener('click', function (e) { if (!r.contains(e.target)) spots.forEach(function (x) { x.classList.remove('is-on'); }); });
  function fit() { var W = document.documentElement.clientWidth; r.querySelectorAll('.snr__pop').forEach(function (p) { p.style.translate = '0 0'; var b = p.getBoundingClientRect(), dx = 0; if (b.right > W - 22) dx = W - 22 - b.right; if (b.left + dx < 22) dx = 22 - b.left; p.style.translate = dx + 'px 0'; }); }
  fit(); addEventListener('resize', fit); addEventListener('load', fit);
  var all = r.querySelector('[data-snr-all]');
  if (all) all.addEventListener('click', function () {
    var ids = all.getAttribute('data-snr-all').split(',').filter(Boolean).map(function (i) { return { id: +i, quantity: 1 }; });
    all.classList.add('is-busy'); SN.cart.add(ids).catch(function () {}).then(function () { all.classList.remove('is-busy'); });
  });
  document.addEventListener('shopify:block:select', function (e) { if (r.contains(e.target)) { spots.forEach(function (x) { x.classList.toggle('is-on', x === e.target); }); } });
})();
</script>
