{%- liquid
  assign s = section.settings
  assign goal = settings.free_ship | times: 100000
  assign left = goal | minus: cart.total_price
  assign pct = 0
  if goal > 0
    assign pct = cart.total_price | times: 100 | divided_by: goal
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<div class="sn-ov snc" id="SnCart" hidden aria-label="Cart">
  <div class="sn-ov__bg" data-sn-close></div>
  <aside class="sn-drawer snc__d" role="dialog" aria-modal="true" aria-labelledby="snc-t">
    <div data-sn-cart-inner>
      <span hidden data-sn-cart-total-count="{{ cart.item_count }}"></span>
      <div class="sn-drawer__head">
        <p class="sn-drawer__title" id="snc-t">{{ s.title }} <sup>{{ cart.item_count }}</sup></p>
        <button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-close aria-label="Close">{% render 'sn-icon', name: 'close', class: 'icon' %}</button>
      </div>

      {%- if goal > 0 and cart.item_count > 0 -%}
        <div class="snc__goal">
          <div class="snc__goal-t">
            {%- if left > 0 -%}{%- assign amt = left | money | prepend: '<b>' | append: '</b>' -%}{{ settings.free_ship_text | replace: '[amount]', amt }}{%- else -%}{{ settings.free_ship_done }}{%- endif -%}
          </div>
          <div class="snc__track" style="--p: {{ pct }}%;">
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5H100" class="b"/><path d="M0 5H100" class="d" style="clip-path: inset(0 {{ 100 | minus: pct }}% 0 0)"/></svg>
            <span class="snc__moon{% if left <= 0 %} is-full{% endif %}">{% render 'sn-icon', name: 'moon', class: 'icon' %}</span>
          </div>
        </div>
      {%- endif -%}

      <div class="sn-drawer__body snc__body">
        {%- if cart.item_count == 0 -%}
          <div class="snc__empty">
            <div class="snc__empty-art">{% render 'sn-art', name: 'pillow' %}</div>
            <p class="sn-h sn-h--s">{{ s.empty_title }}</p>
            <p class="sn-small">{{ s.empty_text }}</p>
            <a class="sn-btn sn-btn--sm" href="{{ s.empty_link | default: routes.all_products_collection_url }}"><span>{{ s.empty_button }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
          </div>
        {%- else -%}
          <ul class="snc__items">
            {%- for item in cart.items -%}
              <li class="snc__item" data-sn-line style="--i: {{ forloop.index0 }};">
                <a class="snc__img sn-media" href="{{ item.url }}">
                  {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="125" loading="lazy">{%- else -%}{% render 'sn-art', name: 'bed-sheet' %}{%- endif -%}
                </a>
                <div class="snc__info">
                  <a class="snc__name" href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="snc__var">{{ item.variant.title }}</p>{%- endunless -%}
                  {%- for p in item.properties -%}{%- unless p.last == blank or p.first contains '_' -%}<p class="snc__var">{{ p.first }}: {{ p.last }}</p>{%- endunless -%}{%- endfor -%}
                  <div class="snc__row">
                    <div class="sn-qty sn-qty--sm">
                      <button type="button" data-sn-line-qty="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="Decrease">{% render 'sn-icon', name: 'minus', class: 'icon' %}</button>
                      <input type="number" value="{{ item.quantity }}" readonly aria-label="Quantity">
                      <button type="button" data-sn-line-qty="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="Increase">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>
                    </div>
                    <div class="snc__price">
                      {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                      <b>{{ item.final_line_price | money }}</b>
                    </div>
                  </div>
                </div>
                <button type="button" class="snc__rm" data-sn-line-qty="0" data-line="{{ forloop.index }}" aria-label="Remove">{% render 'sn-icon', name: 'close', class: 'icon' %}</button>
              </li>
            {%- endfor -%}
          </ul>

          {%- assign up = settings.cart_upsell -%}
          {%- if up != blank and up.products.size > 0 -%}
            <div class="snc__up">
              <p class="sn-eyebrow">{% render 'sn-phase', k: 2 %}{{ s.upsell_title }}</p>
              <div class="snc__up-rail">
                {%- assign shown = 0 -%}
                {%- for p in up.products -%}
                  {%- assign incart = false -%}{%- for it in cart.items -%}{%- if it.product_id == p.id -%}{%- assign incart = true -%}{%- endif -%}{%- endfor -%}
                  {%- if incart or p.available == false -%}{%- continue -%}{%- endif -%}
                  {%- assign shown = shown | plus: 1 -%}{%- if shown > 6 -%}{%- break -%}{%- endif -%}
                  <div class="snc__upc">
                    <a class="sn-media" href="{{ p.url }}">{%- if p.featured_media -%}<img src="{{ p.featured_media | image_url: width: 240 }}" alt="" loading="lazy" width="120" height="150">{%- else -%}{% render 'sn-art', name: 'pillow-cover' %}{%- endif -%}</a>
                    <div><a href="{{ p.url }}" class="snc__upn">{{ p.title }}</a><span>{{ p.price | money }}</span></div>
                    {%- if p.variants.size == 1 -%}<button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-add="{{ p.selected_or_first_available_variant.id }}" aria-label="Add">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- else -%}<button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-quick="{{ p.handle }}" aria-label="Choose">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="sn-drawer__foot snc__foot">
          {%- if settings.cart_note -%}
            <details class="snc__note"><summary>{% render 'sn-icon', name: 'message', class: 'icon' %}{{ s.note_label }}</summary>
              <textarea class="sn-textarea" name="note" form="snc-form" placeholder="{{ s.note_placeholder | escape }}">{{ cart.note }}</textarea>
            </details>
          {%- endif -%}
          <div class="snc__sum"><span>{{ s.subtotal }}</span><b>{{ cart.total_price | money }}</b></div>
          {%- if cart.total_discount > 0 -%}<p class="snc__save">{{ s.savings }} {{ cart.total_discount | money }}</p>{%- endif -%}
          <p class="sn-small">{{ s.tax_note }}</p>
          <form action="{{ routes.cart_url }}" method="post" id="snc-form" class="snc__actions">
            <button type="submit" name="checkout" class="sn-btn sn-btn--block"><span>{{ s.checkout }}</span>{% render 'sn-icon', name: 'lock', class: 'icon' %}</button>
          </form>
          <div class="snc__links">
            <a href="{{ routes.cart_url }}" class="sn-link">{{ s.view_cart }}</a>
            {%- if s.show_whatsapp -%}
              {%- capture wa -%}{{ s.wa_message }}{% for item in cart.items %}
- {{ item.quantity }} x {{ item.product.title }}{% unless item.product.has_only_default_variant %} ({{ item.variant.title }}){% endunless %}{% endfor %}
Total: {{ cart.total_price | money_without_currency }}{%- endcapture -%}
              <a href="https://wa.me/{{ settings.whatsapp }}?text={{ wa | url_encode }}" class="sn-link snc__wa" target="_blank" rel="noopener">{% render 'sn-icon', name: 'whatsapp', class: 'icon' %}{{ s.wa_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </aside>
</div>
<style>
.snc__d { width: min(480px, calc(100% - 20px)); }
.snc__d > [data-sn-cart-inner] { display: flex; flex-direction: column; height: 100%; min-height: 0; }
.snc .sn-drawer__title sup { font: 600 12px var(--f-body); color: var(--ac); vertical-align: super; }
.snc__goal { padding: 16px 24px 18px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--ac) 8%, var(--bg)); }
.snc__goal-t { font-size: 13.5px; margin-bottom: 12px; }
.snc__goal-t .money, .snc__goal-t b { color: var(--ac); font-weight: 600; }
.snc__track { position: relative; height: 12px; }
.snc__track svg { width: 100%; height: 100%; overflow: visible; }
.snc__track .b { stroke: var(--line2); stroke-width: 1.2; stroke-dasharray: 4 4; fill: none; }
.snc__track .d { stroke: var(--ac); stroke-width: 2.4; stroke-dasharray: 6 3; fill: none; transition: clip-path 1s cubic-bezier(.3, .7, .2, 1); }
.snc__moon { position: absolute; top: 50%; left: var(--p); width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); border: 1px solid var(--ac); color: var(--ac); transition: left 1s cubic-bezier(.3, .7, .2, 1); }
.snc__moon .icon { width: 15px; height: 15px; }
.snc__moon.is-full { background: var(--ac); color: #fff; animation: snc-glow 2s ease-in-out infinite; }
@keyframes snc-glow { 50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--ac) 20%, transparent); } }
.snc__body { display: grid; align-content: start; gap: 26px; }
.snc__empty { display: grid; justify-items: center; text-align: center; gap: 14px; padding: 30px 10px; }
.snc__empty-art { width: 170px; aspect-ratio: 4 / 5; border-radius: var(--r); overflow: hidden; margin-bottom: 8px; animation: snc-float 5s ease-in-out infinite; }
@keyframes snc-float { 50% { transform: translateY(-8px) rotate(-1deg); } }
.snc__items { display: grid; gap: 16px; }
.snc__item { position: relative; display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 16px; padding: 12px; border-radius: calc(var(--r) * .7); background: var(--card); animation: snc-in .7s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 70ms); transition: opacity .3s; }
.snc__item.is-busy { opacity: .45; pointer-events: none; }
@keyframes snc-in { from { opacity: 0; transform: translateX(26px); filter: blur(6px); } }
.snc__img { aspect-ratio: 4 / 5; border-radius: calc(var(--r) * .45); }
.snc__info { display: grid; align-content: start; gap: 4px; padding-right: 22px; }
.snc__name { font: 400 1.08rem/1.25 var(--f-head); }
.snc__var { font-size: 12.5px; color: var(--soft); }
.snc__row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; }
.snc__price { display: grid; justify-items: end; font-size: 14.5px; }
.snc__price s { font-size: 12px; color: var(--mute); }
.snc__rm { position: absolute; top: 10px; right: 10px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; color: var(--soft); transition: background .3s, color .3s; }
.snc__rm:hover { background: var(--c-danger); color: #fff; }
.snc__rm .icon { width: 13px; height: 13px; }
.snc__up { display: grid; gap: 14px; padding-top: 18px; border-top: 1px dashed color-mix(in srgb, var(--ac) 40%, transparent); }
.snc__up-rail { display: grid; gap: 10px; }
.snc__upc { display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 12px; }
.snc__upc .sn-media { aspect-ratio: 4 / 5; border-radius: 10px; }
.snc__upc > div { display: grid; gap: 2px; font-size: 13px; }
.snc__upn { font: 400 1rem/1.2 var(--f-head); }
.snc__foot { display: grid; gap: 10px; }
.snc__note summary { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; color: var(--soft); list-style: none; }
.snc__note summary::-webkit-details-marker { display: none; }
.snc__note summary .icon { width: 16px; height: 16px; }
.snc__note textarea { margin-top: 10px; min-height: 80px; }
.snc__sum { display: flex; justify-content: space-between; align-items: baseline; }
.snc__sum span { font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--soft); }
.snc__sum b { font: 400 1.7rem/1 var(--f-head); }
.snc__save { font-size: 13px; color: var(--c-signal); }
.snc__links { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 4px; }
.snc__wa { color: #1f9e57; } .snc__wa .icon { width: 16px; height: 16px; }
</style>
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your bag"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty title",
      "default": "Your bag is resting"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Let's find something soft to wake it up."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Empty button",
      "default": "Shop bedding"
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty button link"
    },
    {
      "type": "text",
      "id": "upsell_title",
      "label": "Suggestions title",
      "default": "Complete the bed"
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Note label",
      "default": "Add a gift note or delivery instruction"
    },
    {
      "type": "text",
      "id": "note_placeholder",
      "label": "Note placeholder",
      "default": "Gift message, delivery time…"
    },
    {
      "type": "text",
      "id": "subtotal",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "savings",
      "label": "Savings label",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Delivery and discounts are calculated at checkout."
    },
    {
      "type": "text",
      "id": "checkout",
      "label": "Checkout button",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "view_cart",
      "label": "View cart link",
      "default": "View bag"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Order on WhatsApp link",
      "default": true
    },
    {
      "type": "text",
      "id": "wa_label",
      "label": "WhatsApp label",
      "default": "Order on WhatsApp"
    },
    {
      "type": "text",
      "id": "wa_message",
      "label": "WhatsApp message start",
      "default": "Hi Sakooon, I'd like to order:"
    }
  ]
}
{% endschema %}
