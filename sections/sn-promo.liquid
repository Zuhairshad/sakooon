{%- liquid
  assign s = section.settings
  assign sid = 'snpr-' | append: section.id
  assign c1 = s.silk_c1 | default: settings.color_dark_bg
  assign c2 = s.silk_c2 | default: settings.color_dusk
  assign c3 = s.silk_c3 | default: settings.color_moon
-%}
<section id="{{ sid }}" class="sn-s snpr snpr--{{ s.layout }}" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="{% if s.full %}sn-wrap--wide{% else %}sn-wrap{% endif %}" style="margin-inline: auto;">
    <div class="snpr__box" data-r="unfold" data-sn-silk-host>
      {%- if s.style == 'silk' -%}
        <div class="sn-silk" data-sn-silk data-c1="{{ c1 }}" data-c2="{{ c2 }}" data-c3="{{ c3 }}" data-speed=".6" data-amp="1"></div>
      {%- elsif s.bg_image != blank -%}
        <img class="snpr__bgimg" src="{{ s.bg_image | image_url: width: 2000 }}" alt="" loading="lazy" width="{{ s.bg_image.width }}" height="{{ s.bg_image.height }}">
      {%- endif -%}
      {%- if s.feathers -%}<div data-sn-feathers="26" data-color="{{ c3 }}" style="position:absolute;inset:0;z-index:0"></div>{%- endif -%}
      <div class="snpr__in">
        <div class="snpr__copy">
          {%- if s.eyebrow != blank -%}<p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 2 %}{{ s.eyebrow }}</p>{%- endif -%}
          <h2 class="sn-h sn-h--{{ s.head_size }}" data-sn-split>{{ s.heading }}{% if s.highlight != blank %} <em>{{ s.highlight }}</em>{% endif %}</h2>
          {%- if s.text != blank -%}<p class="sn-lead" data-r style="--i: 2;">{{ s.text }}</p>{%- endif -%}

          {%- if s.end_date != blank -%}
            <div class="snpr__cd" data-sn-countdown="{{ s.end_date }}" data-r style="--i: 3;">
              {%- assign lbls = s.labels | split: ',' -%}
              <div><span data-d>00</span><small>{{ lbls[0] | strip }}</small></div><i aria-hidden="true"></i>
              <div><span data-h>00</span><small>{{ lbls[1] | strip }}</small></div><i aria-hidden="true"></i>
              <div><span data-m>00</span><small>{{ lbls[2] | strip }}</small></div><i aria-hidden="true"></i>
              <div><span data-s>00</span><small>{{ lbls[3] | strip }}</small></div>
              {%- if s.over_text != blank -%}<p class="snpr__over">{{ s.over_text }}</p>{%- endif -%}
            </div>
          {%- endif -%}

          <div class="snpr__acts" data-r style="--i: 4;">
            {%- if s.code != blank -%}
              <button type="button" class="snpr__code" data-snpr-code="{{ s.code | escape }}" aria-label="Copy code {{ s.code | escape }}">
                <span class="snpr__codel">{{ s.code_label }}</span>
                <b>{{ s.code }}</b>
                <span class="snpr__cbtn">{% render 'sn-icon', name: 'layers', class: 'icon' %}<em data-snpr-msg>{{ s.copy_text }}</em></span>
              </button>
            {%- endif -%}
            {%- if s.btn != blank -%}<a class="sn-btn sn-btn--gold" href="{{ s.link | default: routes.all_products_collection_url }}"><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
          </div>
        </div>
        {%- if s.layout != 'center' -%}
          <div class="snpr__vis" data-r="zoom" style="--i: 2;">
            <div class="snpr__disc">
              <svg viewBox="0 0 200 200" aria-hidden="true"><defs><path id="{{ sid }}-c" d="M100 100m-82 0a82 82 0 1 1 164 0a82 82 0 1 1-164 0"/></defs><text><textPath href="#{{ sid }}-c">{{ s.ring_text | escape }} · {{ s.ring_text | escape }} ·</textPath></text></svg>
              <b>{{ s.big }}</b>
            </div>
            {% render 'sn-media', image: s.image, art: s.art, width: 1100, sizes: '(min-width: 990px) 40vw, 90vw', class: 'snpr__img sn-ripple' %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snpr__box { position: relative; isolation: isolate; overflow: hidden; border-radius: calc(var(--r) * 1.4); padding: clamp(36px, 6vw, 90px); background: {% if s.style == 'plain' %}var(--card){% else %}{{ c1 }}{% endif %}; {% unless s.style == 'plain' %}--tx: {{ settings.color_dark_text }}; --soft: color-mix(in srgb, {{ settings.color_dark_text }} 72%, transparent); --ac: {{ c3 }}; --ac-aa: {{ c3 }}; --ac-ink: {{ c1 }}; --line: rgba(255,255,255,.16); color: var(--tx);{% endunless %} }
#{{ sid }} .snpr__bgimg { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; opacity: .45; }
#{{ sid }} .snpr__in { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(30px, 5vw, 80px); align-items: center; }
#{{ sid }}.snpr--right .snpr__vis { order: -1; }
#{{ sid }}.snpr--center .snpr__in { grid-template-columns: 1fr; justify-items: center; text-align: center; }
#{{ sid }}.snpr--center .sn-lead { margin-inline: auto; }
#{{ sid }} .snpr__copy { display: grid; gap: 22px; justify-items: start; }
#{{ sid }}.snpr--center .snpr__copy { justify-items: center; }
#{{ sid }} .snpr__cd { position: relative; display: flex; align-items: center; gap: clamp(8px, 1.4vw, 18px); margin-top: 6px; }
#{{ sid }} .snpr__cd > div { display: grid; justify-items: center; gap: 6px; min-width: clamp(64px, 7vw, 92px); padding: 14px 6px 12px; border-radius: calc(var(--r) * .8); background: color-mix(in srgb, var(--tx) 7%, transparent); border: 1px solid var(--line); }
#{{ sid }} .snpr__cd span { font: 300 clamp(2rem, 4vw, 3.4rem)/1 var(--f-head); font-variant-numeric: tabular-nums; color: var(--tx); }
#{{ sid }} .snpr__cd span.is-tick { animation: snpr-tick .7s cubic-bezier(.2, .8, .2, 1); }
@keyframes snpr-tick { from { opacity: 0; transform: translateY(-40%) scaleY(.6); filter: blur(6px); } }
#{{ sid }} .snpr__cd small { font-size: 10.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snpr__cd > i { width: 5px; height: 5px; border-radius: 50%; background: var(--ac); box-shadow: 0 0 10px var(--ac); animation: snpr-blink 1s steps(2) infinite; }
@keyframes snpr-blink { 50% { opacity: .2; } }
#{{ sid }} .snpr__over { display: none; }
#{{ sid }} .snpr__cd.is-over > * { display: none; }
#{{ sid }} .snpr__cd.is-over .snpr__over { display: block; font: italic 300 1.4rem var(--f-head); }
#{{ sid }} .snpr__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 6px; }
#{{ sid }} .snpr__code { position: relative; display: inline-flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 8px 0 22px; border-radius: 999px; border: 1.5px dashed color-mix(in srgb, var(--ac) 70%, transparent); color: var(--tx); background: color-mix(in srgb, var(--ac) 9%, transparent); transition: background .4s, transform .5s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .snpr__code:hover { background: color-mix(in srgb, var(--ac) 18%, transparent); transform: translateY(-2px); }
#{{ sid }} .snpr__codel { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snpr__code b { font: 600 15px/1 var(--f-body); letter-spacing: .24em; }
#{{ sid }} .snpr__cbtn { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: 999px; background: var(--ac); color: var(--ac-ink); font-size: 11.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
#{{ sid }} .snpr__cbtn em { font-style: normal; }
#{{ sid }} .snpr__cbtn .icon { width: 15px; height: 15px; }
#{{ sid }} .snpr__code.is-done .snpr__cbtn { animation: snpr-pop .5s cubic-bezier(.3, 1.6, .5, 1); }
@keyframes snpr-pop { 50% { transform: scale(1.12); } }
#{{ sid }} .snpr__vis { position: relative; }
#{{ sid }} .snpr__img { aspect-ratio: 4 / 5; border-radius: calc(var(--r) * 1.2); box-shadow: 0 50px 90px -50px rgba(0, 0, 0, .7); }
#{{ sid }} .snpr__disc { position: absolute; z-index: 3; left: -40px; top: 12%; width: clamp(120px, 13vw, 170px); aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: var(--ac); color: var(--ac-ink); box-shadow: 0 24px 50px -20px rgba(0, 0, 0, .5); }
#{{ sid }} .snpr__disc svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: snft-turn2 22s linear infinite; }
#{{ sid }} .snpr__disc text { font: 600 13px var(--f-body); letter-spacing: .26em; text-transform: uppercase; fill: currentColor; }
#{{ sid }} .snpr__disc b { font: 300 clamp(1.8rem, 2.6vw, 2.6rem)/1 var(--f-head); }
@keyframes snft-turn2 { to { transform: rotate(360deg); } }
@media (max-width: 899px) {
  #{{ sid }} .snpr__in { grid-template-columns: 1fr; }
  #{{ sid }}.snpr--right .snpr__vis { order: 0; }
  #{{ sid }} .snpr__disc { left: auto; right: -8px; top: -20px; }
  #{{ sid }} .snpr__img { aspect-ratio: 5 / 4; }
  #{{ sid }} .snpr__cd > div { min-width: 0; flex: 1; }
  #{{ sid }} .snpr__cd { width: 100%; gap: 6px; }
  #{{ sid }} .snpr__cd > i { display: none; }
  #{{ sid }} .snpr__box { padding: 32px 20px; }
  #{{ sid }} .snpr__codel { display: none; }
  #{{ sid }} .snpr__code { padding-left: 18px; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var b = r.querySelector('[data-snpr-code]'); if (!b) return;
  b.addEventListener('click', function () {
    var c = b.getAttribute('data-snpr-code'), m = b.querySelector('[data-snpr-msg]'), o = m.textContent;
    var done = function () { m.textContent = {{ s.copied_text | json }}; b.classList.remove('is-done'); void b.offsetWidth; b.classList.add('is-done'); setTimeout(function () { m.textContent = o; }, 2000); };
    if (navigator.clipboard) navigator.clipboard.writeText(c).then(done, done); else done();
  });
})();
</script>
