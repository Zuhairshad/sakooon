{%- comment -%}
  Image with text (editorial). Owner: shad-2d. Image beside a text column at desktop, stacked on mobile.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  case s.image_ratio
    when 'portrait'
      assign aspect = '4/5'
    when 'square'
      assign aspect = '1/1'
    when 'landscape'
      assign aspect = '4/3'
    else
      assign aspect = 'natural'
  endcase
-%}
<div class="section image-with-text image-with-text--{{ s.image_position }} image-with-text--{{ s.image_width }} image-with-text--{{ s.vertical_align }} color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px">
  <div class="page-width page-width--full image-with-text__grid">
    <div class="media image-with-text__media"{% if aspect != 'natural' %} style="--aspect: {{ aspect }}"{% endif %}>
      {%- liquid
        assign crop = nil
        if aspect != 'natural'
          assign crop = 'center'
        endif
        render 'image', image: s.image, sizes: '(min-width: 768px) 60vw, 100vw', aspect: aspect, crop: crop, placeholder: 'lifestyle-2'
      -%}
    </div>
    <div class="image-with-text__copy stack">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="image-with-text__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte image-with-text__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}<div>{%- render 'button', label: s.button_label, url: s.button_link, style: s.button_style -%}</div>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "image_width", "label": "Image width", "default": "half", "options": [ { "value": "half", "label": "Half" }, { "value": "wide", "label": "Wide (60%)" } ] },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait 4:5" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape 4:3" }, { "value": "adapt", "label": "Adapt to image" } ] },
    { "type": "select", "id": "vertical_align", "label": "Text alignment", "default": "center", "options": [ { "value": "start", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "end", "label": "Bottom" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The story behind sukoon" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h2", "options": [ { "value": "h1", "label": "t:sections.all.heading_size.options.h1" }, { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" } ] },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A short story about a fabric, a product or a quiet moment at home.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "tertiary", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "tertiary", "label": "Text link" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "paper" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
