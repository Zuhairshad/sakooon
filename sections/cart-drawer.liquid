{%- comment -%}
  Cart drawer. Owner: shad-d8. Lives in sections/header-group.json (added by storefront).
  Opened by [data-drawer-open="cart-drawer"] (header), by `cart:open-request`, and after a successful add (`cart:updated` with open: true).
  Re-rendered by assets/cart.js through the `sections` parameter of the Cart AJAX API, keyed by section.id;
  only [data-cart-content] is swapped, so the open state and focus survive.
  Renders nothing when the cart type is "page" or on the cart page itself; header cart links then navigate to /cart.
{%- endcomment -%}
{%- liquid
  assign show_drawer = true
  if settings.cart_type != 'drawer' or template.name == 'cart'
    assign show_drawer = false
  endif
-%}
{%- if show_drawer -%}
  <theme-drawer id="cart-drawer" class="cart-drawer" data-side="right" data-lock-scroll>
    <div class="overlay" data-drawer-close></div>
    <div
      class="drawer drawer--right cart-drawer__panel color-scheme-{{ section.settings.color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="CartDrawerTitle"
      style="--drawer-width: {{ section.settings.drawer_width }}px"
    >
      <cart-items class="cart-drawer__inner" data-cart-section="{{ section.id }}">
        <div class="cart-drawer__content" data-cart-content>
          <div class="drawer__header cart-drawer__header">
            <h2 class="drawer__title cart-drawer__title" id="CartDrawerTitle">
              {{- 'sections.cart.title' | t -}}
              {%- if cart.item_count > 0 %} <span class="cart-drawer__count">({{ cart.item_count }})</span>{% endif -%}
            </h2>
            <button type="button" class="button--icon cart-drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
              {%- render 'icon', icon: 'close', size: 20 -%}
            </button>
          </div>

          {%- if cart.item_count > 0 -%}
            {%- liquid
              assign threshold = settings.cart_free_shipping_threshold | strip | plus: 0
              assign threshold_cents = threshold | times: 100
            -%}
            {%- if settings.cart_free_shipping_bar and threshold_cents > 0 -%}
              {%- liquid
                assign remaining = threshold_cents | minus: cart.total_price
                assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
                if progress > 100
                  assign progress = 100
                endif
              -%}
              <div class="cart-drawer__shipping">
                <p class="cart-drawer__shipping-text">
                  {%- if remaining > 0 -%}
                    {%- assign remaining_money = remaining | money -%}{{ 'sections.cart.free_shipping_remaining_html' | t: remaining: remaining_money }}
                  {%- else -%}
                    {{ 'sections.cart.free_shipping_reached' | t }}
                  {%- endif -%}
                </p>
                <div class="cart-drawer__meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-hidden="true">
                  <span style="width: {{ progress }}%"></span>
                </div>
              </div>
            {%- endif -%}

            <div class="drawer__body cart-drawer__body">
              <ul class="cart-drawer__lines list-unstyled" role="list" aria-label="{{ 'sections.cart.caption' | t }}">
                {%- for item in cart.items -%}
                  {%- render 'cart-line', item: item, index: forloop.index, id_prefix: 'CartDrawer' -%}
                {%- endfor -%}
              </ul>
              {%- if section.settings.show_recommendations and cart.items.size > 0 -%}
                {%- comment -%} Complementary products of the most recently added line, via Product Recommendations (filled by cart.js). {%- endcomment -%}
                <cart-recommendations
                  class="cart-drawer__recommendations"
                  data-url="{{ routes.product_recommendations_url }}?product_id={{ cart.items.first.product_id }}&limit=4&intent=complementary&section_id=complementary-products"
                  data-heading="{{ section.settings.recommendations_heading | escape }}"
                ></cart-recommendations>
              {%- endif -%}
            </div>

            <div class="drawer__footer cart-drawer__footer">
              <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" class="cart-drawer__form" novalidate>
                {%- if settings.cart_show_note -%}
                  <details class="cart-drawer__note">
                    <summary>{{ 'sections.cart.note' | t }}</summary>
                    <label class="visually-hidden" for="CartDrawerNote">{{ 'sections.cart.note' | t }}</label>
                    <textarea id="CartDrawerNote" name="note" class="cart-note" rows="3" data-cart-note>{{ cart.note }}</textarea>
                  </details>
                {%- endif -%}

                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="cart-drawer__discounts list-unstyled">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="cart-drawer__row"><span>{{ discount.title }}</span><span>&minus;{{ discount.total_allocated_amount | money }}</span></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="cart-drawer__row cart-drawer__subtotal">
                  <span>{{ 'sections.cart.subtotal' | t }}</span>
                  <span data-cart-subtotal>{{ cart.total_price | money_with_currency }}</span>
                </div>
                <p class="cart-drawer__taxes">
                  {%- if cart.duties_included and cart.taxes_included or cart.taxes_included -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- else -%}
                      {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                    {%- endif -%}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </p>
                <button type="submit" name="checkout" class="button button--full cart-drawer__checkout">
                  {{- 'sections.cart.checkout' | t -}}
                </button>
                <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart link">{{ 'sections.cart.view_cart' | t }}</a>
              </form>
            </div>
          {%- else -%}
            <div class="drawer__body cart-drawer__empty">
              <p class="cart-drawer__empty-text">{{ 'sections.cart.empty' | t }}</p>
              <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="button button--secondary">
                {{- 'sections.cart.continue_shopping' | t -}}
              </a>
            </div>
          {%- endif -%}
          <p class="cart-drawer__error form__message form__message--error" role="alert" data-cart-error hidden></p>
        </div>
      </cart-items>
    </div>
  </theme-drawer>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.cart-drawer.name",
  "class": "section-cart-drawer",
  "limit": 1,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "white" },
    { "type": "range", "id": "drawer_width", "min": 360, "max": 600, "step": 20, "unit": "px", "label": "t:sections.cart-drawer.settings.drawer_width.label", "default": 500 },
    { "type": "url", "id": "empty_link", "label": "t:sections.cart-drawer.settings.empty_link.label", "info": "t:sections.cart-drawer.settings.empty_link.info" },
    { "type": "header", "content": "t:sections.cart-drawer.settings.recommendations.header" },
    { "type": "checkbox", "id": "show_recommendations", "label": "t:sections.cart-drawer.settings.show_recommendations.label", "info": "t:sections.cart-drawer.settings.show_recommendations.info", "default": true },
    { "type": "text", "id": "recommendations_heading", "label": "t:sections.cart-drawer.settings.recommendations_heading.label", "default": "Complete the bed" }
  ]
}
{% endschema %}
