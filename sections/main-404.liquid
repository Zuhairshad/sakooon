<div class="section page-width page-width--narrow text-center color-scheme-{{ section.settings.color_scheme }}" style="--section-pt: var(--section-padding-lg); --section-pb: var(--section-padding-lg)">
  <p class="eyebrow">404</p>
  <h1 class="h1">{{ 'general.404.title' | t }}</h1>
  <p class="text-muted measure-narrow" style="margin: var(--space-4) auto 0">{{ 'general.404.subtext' | t }}</p>
  {%- assign continue_label = 'general.continue_shopping' | t -%}
  <div style="margin-top: var(--space-8)">{% render 'button', label: continue_label, url: routes.all_products_collection_url %}</div>
</div>
{% schema %}
{ "name": "t:sections.main-404.name", "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "paper" } ] }
{% endschema %}
