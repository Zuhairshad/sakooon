{%- liquid
  assign s = section.settings
  assign sid = 'snq-' | append: section.id
  assign qs = section.blocks | where: 'type', 'question'
  assign rs = section.blocks | where: 'type', 'result'
-%}
<section id="{{ sid }}" class="sn-s snqz" style="{% render 'sn-vars', s: s %}" data-sn-silk-host>
  {% render 'sn-divider', s: s %}
  {%- if s.silk -%}<div class="sn-silk" data-sn-silk data-c1="{{ settings.color_dark_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ settings.color_moon }}" data-speed=".7" data-amp=".9"></div>{%- endif -%}
  <div data-sn-feathers="24" data-color="{{ settings.color_moon }}" style="position:absolute;inset:0;z-index:-1"></div>
  <div class="sn-wrap snqz__in">
    <div class="snqz__deck" data-snqz>
      <div class="snqz__card snqz__intro is-on" data-step="intro">
        <div class="snqz__moonrise" aria-hidden="true"><svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="40" fill="{{ settings.color_moon }}"/><circle class="sh" cx="44" cy="54" r="42" fill="{{ settings.color_dusk }}"/></svg></div>
        <p class="sn-eyebrow">{{ s.eyebrow }}</p>
        <h2 class="sn-h sn-h--l">{{ s.heading }}{% if s.highlight != blank %} <em>{{ s.highlight }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<p class="sn-lead">{{ s.text }}</p>{%- endif -%}
        <button type="button" class="sn-btn sn-btn--light" data-snqz-start><span>{{ s.start }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
        <p class="sn-small">{{ s.note }}</p>
      </div>
      {%- for block in qs -%}
        {%- assign b = block.settings -%}
        <div class="snqz__card" data-step="{{ forloop.index0 }}" hidden {{ block.shopify_attributes }}>
          <div class="snqz__phases" aria-hidden="true">{%- for q in qs -%}<span class="{% if forloop.index0 < forloop.parentloop.index %}is-on{% endif %}">{% render 'sn-phase', k: forloop.index %}</span>{%- endfor -%}</div>
          <p class="sn-eyebrow">{{ s.q_word }} {{ forloop.index }} / {{ qs.size }}</p>
          <h3 class="sn-h sn-h--m">{{ b.question }}</h3>
          <div class="snqz__opts">
            {%- for k in (1..4) -%}
              {%- liquid
                case k
                  when 1
                    assign at = b.a1
                    assign ai = b.a1_icon
                    assign ar = b.a1_to
                  when 2
                    assign at = b.a2
                    assign ai = b.a2_icon
                    assign ar = b.a2_to
                  when 3
                    assign at = b.a3
                    assign ai = b.a3_icon
                    assign ar = b.a3_to
                  else
                    assign at = b.a4
                    assign ai = b.a4_icon
                    assign ar = b.a4_to
                endcase
              -%}
              {%- if at != blank -%}<button type="button" class="snqz__opt" data-to="{{ ar }}" style="--i: {{ k }};"><span class="snqz__oi">{% render 'sn-icon', name: ai, class: 'icon' %}</span><span>{{ at }}</span><i>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</i></button>{%- endif -%}
            {%- endfor -%}
          </div>
          {%- unless forloop.first -%}<button type="button" class="snqz__back" data-snqz-back>← {{ s.back }}</button>{%- endunless -%}
        </div>
      {%- endfor -%}
      <div class="snqz__card snqz__res" data-step="result" hidden>
        {%- for block in rs -%}
          {%- assign b = block.settings -%}
          <div class="snqz__r" data-r-id="{{ forloop.index }}" hidden {{ block.shopify_attributes }}>
            {% render 'sn-media', image: b.image, art: b.art, width: 800, sizes: '40vw', class: 'snqz__rimg' %}
            <div class="snqz__rc">
              <p class="sn-eyebrow">{{ s.result_label }}</p>
              <h3 class="sn-h sn-h--l">{{ b.title }}</h3>
              {%- if b.line != blank -%}<p class="snqz__line">{{ b.line }}</p>{%- endif -%}
              {%- if b.text != blank -%}<p class="sn-lead">{{ b.text }}</p>{%- endif -%}
              <div class="snqz__ra">
                {%- if b.button != blank -%}<a class="sn-btn sn-btn--light" href="{{ b.link | default: routes.all_products_collection_url }}"><span>{{ b.button }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
                <button type="button" class="sn-link" data-snqz-again>{{ s.again }}</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }} { overflow: hidden; color: {{ settings.color_dark_text }}; --tx: {{ settings.color_dark_text }}; --soft: color-mix(in srgb, {{ settings.color_dark_text }} 72%, transparent); --line2: rgba(255, 255, 255, .26); --ac: {{ settings.color_moon }}; --ac-aa: {{ settings.color_moon }}; }
#{{ sid }} .snqz__in { display: grid; place-items: center; min-height: {{ s.min_height }}px; }
#{{ sid }} .snqz__deck { position: relative; width: min(880px, 100%); display: grid; perspective: 1800px; }
#{{ sid }} .snqz__card { grid-area: 1 / 1; display: grid; gap: 18px; justify-items: center; text-align: center; padding: clamp(34px, 5vw, 70px); border-radius: calc(var(--r) * 1.6); background: color-mix(in srgb, #0c0f1c 38%, transparent); border: 1px solid rgba(255, 255, 255, .14); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 60px 120px -60px rgba(0, 0, 0, .8); transform-origin: 50% 50%; backface-visibility: hidden; }
#{{ sid }} .snqz__card::after { content: ""; position: absolute; inset: 10px; border-radius: calc(var(--r) * 1.6 - 8px); border: 1px dashed color-mix(in srgb, var(--ac) 40%, transparent); pointer-events: none; }
#{{ sid }} .snqz__card[hidden] { display: none; }
#{{ sid }} .snqz__card.is-enter { animation: snqz-in .9s cubic-bezier(.2, .8, .2, 1) both; }
#{{ sid }} .snqz__card.is-leave { display: grid; animation: snqz-out .55s cubic-bezier(.6, 0, .4, 1) both; pointer-events: none; }
@keyframes snqz-in { from { opacity: 0; transform: rotateY(-70deg) translateX(80px) scale(.92); filter: blur(8px); } }
@keyframes snqz-out { to { opacity: 0; transform: rotateY(70deg) translateX(-80px) scale(.92); filter: blur(8px); } }
#{{ sid }} .snqz__moonrise { width: 96px; }
#{{ sid }} .snqz__moonrise svg { width: 100%; overflow: visible; filter: drop-shadow(0 0 30px color-mix(in srgb, var(--ac) 60%, transparent)); }
#{{ sid }} .snqz__moonrise .sh { animation: snqz-wax 6s ease-in-out infinite alternate; }
@keyframes snqz-wax { to { cx: 92; } }
#{{ sid }} .sn-lead { margin-inline: auto; color: var(--soft); }
#{{ sid }} .snqz__phases { display: flex; gap: 10px; color: var(--ac); }
#{{ sid }} .snqz__phases span { opacity: .35; } #{{ sid }} .snqz__phases span.is-on { opacity: 1; }
#{{ sid }} .snqz__phases .sn-ph { width: 20px; height: 20px; }
#{{ sid }} .snqz__opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; width: 100%; margin-top: 10px; }
#{{ sid }} .snqz__opt { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border-radius: calc(var(--r) * .8); border: 1px solid rgba(255, 255, 255, .18); background: rgba(255, 255, 255, .05); text-align: left; font-size: 15.5px; color: #fff; opacity: 0; animation: snqz-opt .7s cubic-bezier(.2, .8, .2, 1) forwards; animation-delay: calc(var(--i) * 80ms + .25s); transition: background .4s, border-color .4s, transform .5s cubic-bezier(.3, 1.4, .5, 1); }
@keyframes snqz-opt { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
#{{ sid }} .snqz__opt:hover { background: rgba(255, 255, 255, .12); border-color: var(--ac); transform: translateY(-3px); }
#{{ sid }} .snqz__opt.is-picked { background: var(--ac); color: {{ settings.color_dark_bg }}; border-color: var(--ac); }
#{{ sid }} .snqz__oi { width: 46px; height: 46px; flex: none; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--ac) 18%, transparent); color: var(--ac); }
#{{ sid }} .snqz__opt.is-picked .snqz__oi { background: rgba(0, 0, 0, .12); color: inherit; }
#{{ sid }} .snqz__oi .icon { width: 21px; height: 21px; }
#{{ sid }} .snqz__opt > span:nth-child(2) { flex: 1; }
#{{ sid }} .snqz__opt i .icon { width: 16px; height: 16px; opacity: .5; }
#{{ sid }} .snqz__back { font-size: 13px; letter-spacing: .1em; color: var(--soft); }
#{{ sid }} .snqz__r { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 50px); align-items: center; text-align: left; width: 100%; }
#{{ sid }} .snqz__r[hidden] { display: none; }
#{{ sid }} .snqz__rimg { aspect-ratio: 4 / 5; border-radius: calc(var(--r) * 1.2); }
#{{ sid }} .snqz__rc { display: grid; gap: 14px; justify-items: start; }
#{{ sid }} .snqz__rc .sn-lead { margin: 0; }
#{{ sid }} .snqz__line { font: italic 300 1.35rem var(--f-head); color: var(--ac); }
#{{ sid }} .snqz__ra { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 8px; }
#{{ sid }} .snqz__ra .sn-link { color: #fff; --tx: #fff; }
@media (max-width: 749px) { #{{ sid }} .snqz__opts, #{{ sid }} .snqz__r { grid-template-columns: 1fr; } #{{ sid }} .snqz__rimg { width: 70%; justify-self: center; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var cards = r.querySelectorAll('[data-step]'), qs = r.querySelectorAll('.snqz__card[data-step]:not(.snqz__intro):not(.snqz__res)'), res = r.querySelector('.snqz__res'), picks = [], cur = r.querySelector('.snqz__intro');
  function go(el) {
    if (el === cur) return;
    var old = cur; cur = el;
    if (old) { old.classList.add('is-leave'); setTimeout(function () { old.classList.remove('is-leave'); old.hidden = true; }, 520); }
    el.hidden = false; el.classList.remove('is-enter'); void el.offsetWidth; el.classList.add('is-enter');
    el.querySelectorAll('.snqz__opt').forEach(function (o) { o.style.animation = 'none'; void o.offsetWidth; o.style.animation = ''; });
  }
  function finish() {
    var sc = {}; picks.forEach(function (p) { sc[p] = (sc[p] || 0) + 1; });
    var best = '1', m = -1; Object.keys(sc).sort().forEach(function (k) { if (sc[k] > m) { m = sc[k]; best = k; } });
    var rr = r.querySelectorAll('[data-r-id]'), match = r.querySelector('[data-r-id="' + best + '"]') || rr[0];
    rr.forEach(function (x) { x.hidden = x !== match; }); go(res);
  }
  r.querySelector('[data-snqz-start]').addEventListener('click', function () { picks = []; if (qs[0]) go(qs[0]); else finish(); });
  qs.forEach(function (q, i) {
    q.querySelectorAll('.snqz__opt').forEach(function (o) { o.addEventListener('click', function () { q.querySelectorAll('.snqz__opt').forEach(function (x) { x.classList.toggle('is-picked', x === o); }); picks[i] = o.getAttribute('data-to'); picks.length = i + 1; setTimeout(function () { if (qs[i + 1]) go(qs[i + 1]); else finish(); }, 420); }); });
    var b = q.querySelector('[data-snqz-back]'); if (b) b.addEventListener('click', function () { go(qs[i - 1]); });
  });
  r.querySelectorAll('[data-snqz-again]').forEach(function (b) { b.addEventListener('click', function () { picks = []; r.querySelectorAll('.is-picked').forEach(function (x) { x.classList.remove('is-picked'); }); go(qs[0] || r.querySelector('.snqz__intro')); }); });
  document.addEventListener('shopify:block:select', function (e) { if (!r.contains(e.target)) return; if (e.target.matches('.snqz__card')) go(e.target); else if (e.target.matches('[data-r-id]')) { r.querySelectorAll('[data-r-id]').forEach(function (x) { x.hidden = x !== e.target; }); go(res); } });
})();
</script>
