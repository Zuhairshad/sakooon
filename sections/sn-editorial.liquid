{%- liquid
  assign s = section.settings
  assign sid = 'sned-' | append: section.id
  assign stats = section.blocks | where: 'type', 'stat'
-%}
<section id="{{ sid }}" class="sn-s sned sned--{{ s.layout }}" style="{% render 'sn-vars', s: s %}" data-sned>
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap sned__in">
    <div class="sned__img sned__img--a" data-sned-par="-0.12">
      {% render 'sn-media', image: s.image, art: s.art, width: 1000, sizes: '(min-width: 990px) 28vw, 70vw', class: 'sned__m sn-ripple', reveal: 'unfold' %}
    </div>
    <div class="sned__img sned__img--b" data-sned-par="0.16">
      {% render 'sn-media', image: s.image_2, art: s.art_2, width: 700, sizes: '22vw', class: 'sned__m2', reveal: 'zoom' %}
    </div>
    <div class="sned__copy">
      {%- if s.eyebrow != blank -%}<p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 4 %}{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="sn-h sn-h--{{ s.head_size }}" data-sn-split>{{ s.heading }}{% if s.highlight != blank %} <em>{{ s.highlight }}</em>{% endif %}</h2>
      {%- if s.text != blank -%}<div class="sned__text sn-rte{% if s.dropcap %} has-drop{% endif %}" data-r style="--i: 2;">{{ s.text }}</div>{%- endif -%}
      {%- if s.signature != blank -%}
        <div class="sned__sign" data-r style="--i: 3;">
          <svg viewBox="0 0 320 70" aria-hidden="true"><text x="4" y="52" class="sned__sig" data-sned-sig>{{ s.signature }}</text></svg>
          {%- if s.sign_role != blank -%}<span>{{ s.sign_role }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.button_label != blank -%}<a class="sn-btn" data-r style="--i: 4;" href="{{ s.button_link | default: '/pages/about' }}"><span>{{ s.button_label }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
    </div>
  </div>
  {%- if stats.size > 0 -%}
    <div class="sn-wrap">
      <ul class="sned__stats" data-r>
        {%- for block in stats -%}
          {%- assign b = block.settings -%}
          <li {{ block.shopify_attributes }}>
            <b><span data-sned-count="{{ b.number }}">{{ b.number }}</span><i>{{ b.suffix }}</i></b>
            <small>{{ b.label }}</small>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>
<style>
#{{ sid }} .sned__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(30px, 6vw, 110px); align-items: center; }
#{{ sid }}.sned--letter .sned__in { grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr) minmax(0, .8fr); }
#{{ sid }} .sned__img { position: relative; transform: translateY(var(--py, 0px)); will-change: transform; }
#{{ sid }} .sned__m { aspect-ratio: 4 / 5; border-radius: calc(var(--r) * 2) calc(var(--r) * 2) calc(var(--r) * 2) calc(var(--r) * .3); box-shadow: 0 50px 90px -60px rgba(20, 22, 40, .6); }
#{{ sid }} .sned__m2 { aspect-ratio: 1; border-radius: 50%; border: 8px solid var(--bg); box-shadow: 0 30px 60px -30px rgba(20, 22, 40, .5); }
#{{ sid }}.sned--split .sned__img--a { grid-column: 1; grid-row: 1; }
#{{ sid }}.sned--split .sned__img--b { grid-column: 1; grid-row: 1; align-self: end; justify-self: end; width: 46%; margin: 0 -8% -10% 0; z-index: 2; }
#{{ sid }}.sned--split .sned__copy { grid-column: 2; grid-row: 1; }
#{{ sid }}.sned--letter .sned__img--a { grid-column: 1; margin-top: 18%; }
#{{ sid }}.sned--letter .sned__img--b { grid-column: 3; grid-row: 1; margin-bottom: 30%; }
#{{ sid }}.sned--letter .sned__copy { grid-column: 2; grid-row: 1; text-align: center; justify-items: center; }
#{{ sid }} .sned__copy { display: grid; gap: 22px; }
#{{ sid }} .sned__text { font-size: 1.06rem; max-width: 56ch; }
#{{ sid }}.sned--letter .sned__text { text-align: left; }
#{{ sid }} .sned__text.has-drop > p:first-child::first-letter { float: left; margin: .08em .12em 0 0; font: 300 4.6em/.82 var(--f-head); color: var(--ac); }
#{{ sid }} .sned__sign { display: grid; gap: 2px; }
#{{ sid }}.sned--letter .sned__sign { justify-items: center; }
#{{ sid }} .sned__sign svg { width: 240px; height: 56px; overflow: visible; }
#{{ sid }} .sned__sig { font: italic 300 46px var(--f-head); fill: transparent; stroke: var(--ac); stroke-width: .9; stroke-dasharray: 600; stroke-dashoffset: 600; transition: stroke-dashoffset 3s cubic-bezier(.5, .1, .3, 1), fill 1s ease 2.2s; }
#{{ sid }} .sned__sign.is-in .sned__sig { stroke-dashoffset: 0; fill: var(--ac); }
#{{ sid }} .sned__sign span { font-size: 11px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .sned__stats { display: grid; grid-template-columns: repeat({{ stats.size }}, minmax(0, 1fr)); margin-top: clamp(60px, 8vw, 110px); border-block: 1px dashed var(--line2); }
#{{ sid }} .sned__stats li { display: grid; justify-items: center; gap: 6px; padding: 34px 16px; text-align: center; position: relative; }
#{{ sid }} .sned__stats li + li::before { content: ""; position: absolute; left: 0; top: 30%; bottom: 30%; border-left: 1px solid var(--line); }
#{{ sid }} .sned__stats b { font: 300 clamp(2.6rem, 5vw, 4.4rem)/1 var(--f-head); font-variant-numeric: tabular-nums; letter-spacing: -.03em; }
#{{ sid }} .sned__stats i { font-style: italic; color: var(--ac); font-size: .6em; margin-left: 4px; }
#{{ sid }} .sned__stats small { font-size: 11.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
@media (max-width: 989px) {
  #{{ sid }} .sned__in, #{{ sid }}.sned--letter .sned__in { grid-template-columns: 1fr 1fr; }
  #{{ sid }}.sned--letter .sned__img--a { grid-column: 1; grid-row: 1; margin: 0; }
  #{{ sid }}.sned--letter .sned__img--b { grid-column: 2; grid-row: 1; margin: 30% 0 0; }
  #{{ sid }} .sned__copy, #{{ sid }}.sned--letter .sned__copy, #{{ sid }}.sned--split .sned__copy { grid-column: 1 / -1; grid-row: 2; }
  #{{ sid }}.sned--split .sned__img--a { grid-column: 1 / -1; width: 80%; }
  #{{ sid }}.sned--split .sned__img--b { grid-column: 1 / -1; }
}
@media (max-width: 599px) { #{{ sid }} .sned__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } #{{ sid }} .sned__stats li:nth-child(3)::before { display: none; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || document.body.getAttribute('data-motion') === 'off';
  var par = r.querySelectorAll('[data-sned-par]'), tk = false;
  function upd() { tk = false; var b = r.getBoundingClientRect(), p = Math.max(-1, Math.min(1, (b.top + b.height / 2 - innerHeight / 2) / innerHeight)); par.forEach(function (el) { el.style.setProperty('--py', (p * parseFloat(el.getAttribute('data-sned-par')) * 400).toFixed(1) + 'px'); }); }
  if (!reduce) { addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(upd); } }, { passive: true }); upd(); }
  var nums = r.querySelectorAll('[data-sned-count]');
  function fmt(v, dec) { return v.toFixed(dec).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
  nums.forEach(function (n) { var to = parseFloat(n.getAttribute('data-sned-count')); n.textContent = isNaN(to) ? n.textContent : fmt(to, (String(to).split('.')[1] || '').length); });
  if (reduce || !('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (!e.isIntersecting) return; io.unobserve(e.target); var el = e.target, to = parseFloat(el.getAttribute('data-sned-count')); if (isNaN(to)) return; var dec = (String(to).split('.')[1] || '').length, t0 = performance.now(); (function f(t) { var p = Math.min(1, (t - t0) / 1800), q = 1 - Math.pow(1 - p, 4); el.textContent = fmt(to * q, dec); if (p < 1) requestAnimationFrame(f); })(t0); }); }, { threshold: .5 });
  nums.forEach(function (n) { io.observe(n); });
})();
</script>
