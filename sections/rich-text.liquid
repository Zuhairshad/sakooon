{%- comment -%}
  Rich text / promo band. Owner: shad-2d. Pattern: Parachute homepage section 1 (solid colour band, 800px measure,
  heading left + text right on desktop, stacked on mobile) or a centred text block.
  Statement layout: content on 7 of 12 columns and the Sakooon calligraphy mark on the other 5 (mark above the text on
  mobile); light artwork on the ink scheme, dark elsewhere.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if s.layout == 'statement' -%}
  {%- liquid
    assign mark_tone = 'dark'
    if s.color_scheme == 'ink'
      assign mark_tone = 'light'
    endif
  -%}
<div class="section rich-text rich-text--statement color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px">
  <div class="page-width rich-text__statement">
    <div class="rich-text__statement-copy">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="rich-text__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte rich-text__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <div class="rich-text__button">{%- render 'button', label: s.button_label, url: s.button_link, style: s.button_style -%}</div>
      {%- endif -%}
    </div>
    {%- if s.show_mark -%}
      <div class="rich-text__mark" aria-hidden="true">
        {%- render 'brand-logo', variant: 'mark', tone: mark_tone, width: 240, class: 'rich-text__mark-img' -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- else -%}
<div class="section rich-text rich-text--{{ s.layout }} rich-text--{{ s.width }} color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px">
  <div class="page-width rich-text__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="rich-text__head">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="rich-text__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.text != blank or s.button_link != blank -%}
      <div class="rich-text__body">
        {%- if s.text != blank -%}<div class="rte rich-text__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank and s.button_link != blank -%}
          <div class="rich-text__button">{%- render 'button', label: s.button_label, url: s.button_link, style: s.button_style -%}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [ { "value": "split", "label": "Heading beside text" }, { "value": "center", "label": "Centred" }, { "value": "left", "label": "Left aligned" }, { "value": "statement", "label": "Statement with logo mark" } ] },
    { "type": "checkbox", "id": "show_mark", "label": "Show the Sakooon calligraphy mark", "default": true, "info": "Statement layout only." },
    { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "narrow", "label": "Narrow (800px)" }, { "value": "page", "label": "Page" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sukoon means calm" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h2", "options": [ { "value": "h1", "label": "t:sections.all.heading_size.options.h1" }, { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" }, { "value": "h4", "label": "t:sections.all.heading_size.options.h4" } ] },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>It is the Urdu word for peace of mind, and how we want every bed to feel.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "tertiary", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "tertiary", "label": "Text link" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "ink" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
