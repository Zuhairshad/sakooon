{%- comment -%}
  Footer. Owner: shad-2d. Pattern: docs/reference/storefront.md (Footer).
  12-column grid at desktop: blocks are wide (4/12, newsletter by default) or narrow (2/12, link lists, text,
  social, image); 2-up at tablet and mobile with the newsletter full width. Optional hairline column dividers
  (Tekla). Bottom bar: optional wordmark, country selector, legal links, payment icons, copyright.
{%- endcomment -%}
{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign logo_tone = 'dark'
  if section.settings.color_scheme == 'ink'
    assign logo_tone = 'light'
  endif
-%}
<footer class="footer section color-scheme-{{ section.settings.color_scheme }}{% if section.settings.dividers %} footer--dividers{% endif %}" style="--section-pt: {{ pt }}px; --section-pb: {{ pb }}px">
  <div class="footer__inner page-width page-width--full">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign width = block.settings.width | default: 'narrow'
            if block.type == 'newsletter'
              assign width = block.settings.width | default: 'wide'
            endif
          -%}
          <div class="footer__block footer__block--{{ block.type }} footer__block--{{ width }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="footer__text rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- form 'customer', id: 'FooterNewsletter', class: 'footer__newsletter' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="footer__newsletter-field">
                    <label class="visually-hidden" for="FooterNewsletter-email-{{ section.id }}">{{ 'storefront.footer.newsletter_label' | t }}</label>
                    <input
                      id="FooterNewsletter-email-{{ section.id }}"
                      class="footer__newsletter-input"
                      type="email"
                      name="contact[email]"
                      autocomplete="email"
                      autocorrect="off"
                      autocapitalize="off"
                      spellcheck="false"
                      required
                      placeholder="{{ 'storefront.footer.newsletter_label' | t }}"
                      {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletter-error-{{ section.id }}"{% endif %}
                    >
                    <button type="submit" class="footer__newsletter-submit" aria-label="{{ 'storefront.footer.newsletter_submit' | t }}">
                      {%- render 'icon', icon: 'arrow-right', size: 18 -%}
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <p class="field__error" id="FooterNewsletter-error-{{ section.id }}">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                  {%- elsif form.posted_successfully? -%}
                    <p class="form__message form__message--success" role="status">{{ 'storefront.footer.newsletter_success' | t }}</p>
                  {%- endif -%}
                {%- endform -%}
                {%- if block.settings.disclaimer != blank -%}<div class="footer__disclaimer rte">{{ block.settings.disclaimer }}</div>{%- endif -%}

              {%- when 'link_list' -%}
                {%- assign menu = block.settings.menu -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if menu != blank and menu.links.size > 0 -%}
                  <ul class="footer__links list-unstyled" role="list">
                    {%- for link in menu.links -%}
                      <li><a class="footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="footer__text footer__text--muted rte">{{ block.settings.text }}</div>{%- endif -%}

              {%- when 'social' -%}
                {%- liquid
                  assign networks = 'instagram,facebook,tiktok,pinterest,youtube,whatsapp' | split: ','
                  assign social_items = ''
                  for network in networks
                    assign key = 'social_' | append: network | append: '_link'
                    if settings[key] != blank
                      assign social_items = social_items | append: network | append: ','
                    endif
                  endfor
                  assign social_items = social_items | split: ','
                -%}
                {%- comment -%} Only networks with a URL in Theme settings; nothing at all when none are set. {%- endcomment -%}
                {%- if social_items.size > 0 -%}
                  {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                  <ul class="footer__links list-unstyled" role="list">
                    {%- for network in social_items -%}
                      {%- assign key = 'social_' | append: network | append: '_link' -%}
                      {%- assign label_key = 'general.social.links.' | append: network -%}
                      <li><a class="footer__link footer__social-link" href="{{ settings[key] }}" target="_blank" rel="noopener">{% render 'icon', icon: network, size: 16 %}<span>{{ label_key | t }}</span></a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'contact' -%}
                {%- liquid
                  assign c = block.settings
                  assign whatsapp = settings.social_whatsapp_link
                  assign has_contact = false
                  if c.email != blank or c.phone != blank or whatsapp != blank or c.hours != blank
                    assign has_contact = true
                  endif
                -%}
                {%- comment -%} Each line renders only when its setting is filled; the block is empty until then. {%- endcomment -%}
                {%- if has_contact -%}
                  {%- if c.heading != blank -%}<h2 class="footer__heading">{{ c.heading | escape }}</h2>{%- endif -%}
                  <ul class="footer__links list-unstyled" role="list">
                    {%- if c.email != blank -%}<li><a class="footer__link footer__contact-link" href="mailto:{{ c.email | strip }}">{% render 'icon', icon: 'mail', size: 16 %}<span>{{ c.email | strip | escape }}</span></a></li>{%- endif -%}
                    {%- if c.phone != blank -%}
                      {%- assign tel = c.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
                      <li><a class="footer__link footer__contact-link" href="tel:{{ tel }}">{% render 'icon', icon: 'phone', size: 16 %}<span>{{ c.phone | escape }}</span></a></li>
                    {%- endif -%}
                    {%- if whatsapp != blank -%}<li><a class="footer__link footer__contact-link" href="{{ whatsapp }}" target="_blank" rel="noopener">{% render 'icon', icon: 'whatsapp', size: 16 %}<span>{{ 'storefront.footer.whatsapp' | t }}</span></a></li>{%- endif -%}
                  </ul>
                  {%- if c.hours != blank -%}<p class="footer__text footer__text--muted">{{ c.hours | escape }}</p>{%- endif -%}
                {%- endif -%}

              {%- when 'logo' -%}
                <a class="footer__brand" href="{{ routes.root_url }}">
                  {%- render 'brand-logo', variant: 'stacked', tone: logo_tone, width: 176, class: 'footer__brand-logo' -%}
                </a>
                {%- if block.settings.text != blank -%}<div class="footer__text footer__text--muted rte">{{ block.settings.text }}</div>{%- endif -%}

              {%- when 'image' -%}
                {%- if block.settings.link != blank -%}<a class="footer__image-link" href="{{ block.settings.link }}">{%- endif -%}
                <div class="media footer__image" style="--aspect: {{ block.settings.ratio }}">
                  {%- render 'image', image: block.settings.image, sizes: '(min-width: 1024px) 33vw, 100vw', widths: '320,480,640,960', aspect: block.settings.ratio, placeholder: 'lifestyle-2' -%}
                </div>
                {%- if block.settings.caption != blank -%}<span class="footer__caption">{{ block.settings.caption | escape }}</span>{%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section.settings.show_wordmark -%}
        <a class="footer__wordmark" href="{{ routes.root_url }}">
          {%- if settings.logo != blank and logo_tone == 'dark' -%}<span class="visually-hidden">{{ shop.name }}</span>{%- endif -%}
          {%- render 'brand-logo', variant: 'wordmark', tone: logo_tone, width: 128, class: 'footer__logo' -%}
        </a>
      {%- endif -%}
      <div class="footer__meta">
        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'FooterCountryForm', class: 'footer__localization' -%}
            <label class="visually-hidden" for="FooterCountry-{{ section.id }}">{{ 'storefront.footer.country_label' | t }}</label>
            <select id="FooterCountry-{{ section.id }}" name="country_code" class="footer__country" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit" class="button button--small">{{ 'storefront.footer.country_label' | t }}</button></noscript>
          {%- endform -%}
        {%- endif -%}
        {%- assign legal = section.settings.legal_menu -%}
        {%- if legal != blank and legal.links.size > 0 -%}
          <ul class="footer__legal list-unstyled" role="list">
            {%- for link in legal.links -%}
              <li><a class="footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.copyright != blank %}. {{ section.settings.copyright | escape }}{% endif %}</p>
      </div>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payments">
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="footer__payment-list list-unstyled" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "sand" },
    { "type": "checkbox", "id": "dividers", "label": "Show column dividers", "default": false },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show logo", "default": true },
    { "type": "checkbox", "id": "show_country_selector", "label": "Show country/region selector", "default": true, "info": "Shown when the store sells to more than one country." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal links", "default": "legal" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "All rights reserved" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "newsletter", "name": "Newsletter", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in touch" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New colours, care tips and the odd quiet note.</p>" },
        { "type": "richtext", "id": "disclaimer", "label": "Small print", "default": "<p>You can unsubscribe at any time.</p>" },
        { "type": "select", "id": "width", "label": "Width", "default": "wide", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    },
    {
      "type": "link_list", "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    },
    {
      "type": "social", "name": "Social links", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "paragraph", "content": "Links come from Theme settings > Social media." },
        { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    },
    {
      "type": "contact", "name": "Contact", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Each line shows only when it is filled in. WhatsApp comes from Theme settings > Social media." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "text", "id": "email", "label": "Email" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "text", "id": "hours", "label": "Hours", "info": "For example: Monday to Saturday, 10am to 6pm" },
        { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    },
    {
      "type": "logo", "name": "Logo", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows the stacked Sakooon logo with its tagline, or the logo from Theme settings when one is uploaded." },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    },
    {
      "type": "image", "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "ratio", "label": "Image shape", "default": "4/5", "options": [ { "value": "4/5", "label": "Portrait" }, { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape" } ] },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" } ] }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
