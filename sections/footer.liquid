{%- comment -%} STUB handed to shad-2d. Replace entirely. {%- endcomment -%}
<footer class="footer color-scheme-{{ section.settings.color_scheme }} section" style="--section-pt: var(--section-padding-sm); --section-pb: var(--section-padding-sm)">
  <div class="page-width">
    {%- assign menu = section.settings.menu | default: settings.menu_footer -%}
    {%- if linklists[menu].links.size > 0 -%}
    <nav aria-label="Footer"><ul class="list-unstyled flex flex-wrap gap-6 text-small">{%- for link in linklists[menu].links -%}<li><a class="link--plain" href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul></nav>
    {%- endif -%}
    <p class="text-caption" style="margin-top: var(--space-8)">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.copyright' | t }} {{ powered_by_link }}</p>
  </div>
</footer>
{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "sand" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
