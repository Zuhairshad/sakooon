{%- liquid
  assign s = section.settings
  assign sid = 'snmk-' | append: section.id
  assign goal = settings.free_ship | times: 100000
  assign left = goal | minus: cart.total_price
  assign pct = 0
  if goal > 0
    assign pct = cart.total_price | times: 100 | divided_by: goal | at_most: 100
  endif
  assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
-%}
<section id="{{ sid }}" class="sn-s snmk" style="{% render 'sn-vars', s: s %}" data-section="{{ section.id }}">
  <div class="sn-wrap" data-snmk-root>
    {%- if cart.item_count == 0 -%}
      <div class="snmk__empty" data-sn-silk-host>
        {%- if s.silk -%}<div class="sn-silk" data-sn-silk data-c1="{{ settings.color_dark_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ settings.color_moon }}" data-speed=".45" data-amp=".8"></div>{%- endif -%}
        <div data-sn-feathers="26" data-color="{{ settings.color_moon }}" style="position:absolute;inset:0;z-index:0"></div>
        <div class="snmk__ein">
          <div class="snmk__bed" aria-hidden="true">{% render 'sn-art', name: 'pillow' %}<span class="snmk__z">z</span><span class="snmk__z">z</span><span class="snmk__z">z</span></div>
          <p class="sn-eyebrow">{% render 'sn-phase', k: 0 %}{{ s.empty_eyebrow }}</p>
          <h1 class="sn-h sn-h--l" data-sn-split>{{ s.empty_title }} <em>{{ s.empty_hl }}</em></h1>
          <p class="sn-lead">{{ s.empty_text }}</p>
          <div class="snmk__ebtn"><a class="sn-btn sn-btn--light" href="{{ s.empty_link | default: routes.all_products_collection_url }}"><span>{{ s.empty_btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
          {%- if customer == nil and shop.customer_accounts_enabled -%}<a class="sn-link snmk__login" href="{{ routes.account_login_url }}">{{ s.login_label }}</a>{%- endif -%}</div>
        </div>
      </div>
    {%- else -%}
      <div class="snmk__head">
        <h1 class="sn-h sn-h--l" data-sn-split>{{ s.title }} <em>{{ s.title_hl }}</em></h1>
        <p class="snmk__cnt"><b>{{ cart.item_count }}</b> {{ s.items_label }}</p>
      </div>
      {%- if goal > 0 -%}
        <div class="snmk__goal sn-pillow" data-r>
          <p>{%- if left > 0 -%}{%- assign amt = left | money | prepend: '<b>' | append: '</b>' -%}{{ settings.free_ship_text | replace: '[amount]', amt }}{%- else -%}{{ settings.free_ship_done }}{%- endif -%}</p>
          <div class="snmk__track" style="--p: {{ pct }}%;">
            <span class="snmk__tl"><i></i></span>
            {%- for k in (0..4) -%}<span class="snmk__ph{% assign need = k | times: 25 %}{% if pct >= need %} is-on{% endif %}" style="--x: {{ k | times: 25 }}%;">{% render 'sn-phase', k: k %}</span>{%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post" class="snmk__grid" novalidate>
        <div class="snmk__lines">
          {%- assign cols = s.cols | split: ',' -%}<div class="snmk__lh" aria-hidden="true"><span>{{ cols[0] | strip }}</span><span>{{ cols[1] | strip }}</span><span>{{ cols[2] | strip }}</span></div>
          {%- for item in cart.items -%}
            <div class="snmk__line" data-snmk-line="{{ forloop.index }}" data-r="rise" style="--i: {{ forloop.index0 | at_most: 6 }};">
              <a class="snmk__img" href="{{ item.url }}">{%- if item.image -%}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" width="120" height="150" loading="lazy">{%- else -%}{% render 'sn-art', name: 'bed-sheet' %}{%- endif -%}</a>
              <div class="snmk__info">
                {%- if item.vendor != blank and s.vendor -%}<small class="snmk__v">{{ item.vendor }}</small>{%- endif -%}
                <a class="snmk__t" href="{{ item.url }}">{{ item.product_title | default: item.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="snmk__opt">{%- for o in item.options_with_values -%}<span>{{ o.name }}: <b>{{ o.value }}</b></span>{%- endfor -%}</p>{%- endunless -%}
                {%- for p in item.properties -%}{%- assign pk = p.first | slice: 0 -%}{%- if p.last != blank and pk != '_' -%}<p class="snmk__prop">{{ p.first }}: {{ p.last }}</p>{%- endif -%}{%- endfor -%}
                {%- for d in item.line_level_discount_allocations -%}<p class="snmk__disc">{% render 'sn-icon', name: 'tag', class: 'icon' %}{{ d.discount_application.title }} (−{{ d.amount | money }})</p>{%- endfor -%}
                <p class="snmk__unit">{%- if item.original_price > item.final_price -%}<s>{{ item.original_price | money }}</s> {%- endif -%}{{ item.final_price | money }}</p>
                <button type="button" class="snmk__rm" data-snmk-q="0" data-line="{{ forloop.index }}">{% render 'sn-icon', name: 'trash', class: 'icon' %}{{ s.remove_label }}</button>
              </div>
              <div class="sn-qty sn-qty--sm snmk__qty">
                <button type="button" data-snmk-q="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="Decrease">{% render 'sn-icon', name: 'minus', class: 'icon' %}</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}" data-snmk-in aria-label="Quantity">
                <button type="button" data-snmk-q="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="Increase">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>
              </div>
              <p class="snmk__lt">{%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}<b>{{ item.final_line_price | money }}</b></p>
            </div>
          {%- endfor -%}
          {%- if s.note -%}
            <details class="snmk__note"{% if cart.note != blank %} open{% endif %}>
              <summary>{% render 'sn-icon', name: 'message', class: 'icon' %}{{ s.note_label }}</summary>
              <textarea class="sn-textarea" name="note" data-snmk-note placeholder="{{ s.note_ph | escape }}">{{ cart.note }}</textarea>
            </details>
          {%- endif -%}
        </div>

        <aside class="snmk__sum">
          <div class="snmk__card sn-pillow sn-stitch">
            <p class="sn-h sn-h--s">{{ s.summary_title }}</p>
            <dl class="snmk__rows">
              <div><dt>{{ s.sub_label }}</dt><dd>{{ cart.items_subtotal_price | money }}</dd></div>
              {%- for d in cart.cart_level_discount_applications -%}<div class="is-disc"><dt>{% render 'sn-icon', name: 'tag', class: 'icon' %}{{ d.title }}</dt><dd>−{{ d.total_allocated_amount | money }}</dd></div>{%- endfor -%}
              <div><dt>{{ s.ship_label }}</dt><dd class="sn-small">{% if left <= 0 and goal > 0 %}<b class="snmk__free">{{ s.free_label }}</b>{% else %}{{ s.ship_note }}{% endif %}</dd></div>
            </dl>
            <div class="snmk__tot"><span>{{ s.total_label }}</span><b>{{ cart.total_price | money_with_currency }}</b></div>
            {%- if cart.total_discount > 0 -%}<p class="snmk__saved">{% render 'sn-icon', name: 'sparkle', class: 'icon' %}{{ s.saved_text | replace: '[amount]', '' }}<b>{{ cart.total_discount | money }}</b></p>{%- endif -%}
            {%- if s.terms != blank -%}<label class="sn-check snmk__terms"><input type="checkbox" data-snmk-terms><span>{{ s.terms }}</span></label>{%- endif -%}
            <button type="submit" name="checkout" class="sn-btn sn-btn--gold sn-btn--block snmk__go" data-snmk-go><span>{{ s.checkout_label }}</span>{% render 'sn-icon', name: 'lock', class: 'icon' %}</button>
            {%- if additional_checkout_buttons and s.express -%}<div class="snmk__x">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
            {%- if s.wa and wa != blank -%}
              {%- capture wtxt -%}{{ s.wa_msg }}{% for item in cart.items %}
- {{ item.quantity }} x {{ item.title }} ({{ item.final_line_price | money_without_currency }}){% endfor %}
{{ s.total_label }}: {{ cart.total_price | money_without_currency }}{%- endcapture -%}
              <a class="snmk__wa" href="https://wa.me/{{ wa }}?text={{ wtxt | url_encode }}" target="_blank" rel="noopener">{% render 'sn-icon', name: 'whatsapp', class: 'icon' %}<span>{{ s.wa_label }}</span></a>
            {%- endif -%}
            <ul class="snmk__trust">
              {%- assign tl = s.trust | newline_to_br | split: '<br />' -%}
              {%- assign ticons = 'lock,truck,return,shield-check,heart' | split: ',' -%}
              {%- for l in tl -%}{%- assign ll = l | strip -%}{%- if ll != blank -%}<li>{% render 'sn-icon', name: ticons[forloop.index0], class: 'icon' %}{{ ll }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          </div>
          <a class="sn-link snmk__cont" href="{{ routes.all_products_collection_url }}">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}{{ s.continue_label }}</a>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>
<style>
#{{ sid }} .snmk__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 14px; margin-bottom: 28px; }
#{{ sid }} .snmk__cnt { font-size: 14px; color: var(--soft); }
#{{ sid }} .snmk__cnt b { font: 400 1.6rem var(--f-head); color: var(--ac); }
#{{ sid }} .snmk__goal { display: grid; gap: 18px; padding: 20px 26px 26px; margin-bottom: 30px; }
#{{ sid }} .snmk__goal p { font-size: 14.5px; }
#{{ sid }} .snmk__track { position: relative; height: 26px; margin-inline: 13px; }
#{{ sid }} .snmk__tl { position: absolute; left: 0; right: 0; top: 50%; height: 0; border-top: 1px dashed var(--line2); }
#{{ sid }} .snmk__tl i { position: absolute; left: 0; top: -1.5px; height: 2px; width: var(--p); background: var(--ac); border-radius: 2px; animation: snmk-grow 1.6s cubic-bezier(.3, .8, .2, 1); }
@keyframes snmk-grow { from { width: 0; } }
#{{ sid }} .snmk__ph { position: absolute; left: var(--x); top: 0; width: 26px; height: 26px; margin-left: -13px; display: grid; place-items: center; border-radius: 50%; background: var(--card); color: var(--mute); transition: color .6s; }
#{{ sid }} .snmk__ph .sn-ph { width: 18px; height: 18px; }
#{{ sid }} .snmk__ph.is-on { color: var(--ac); filter: drop-shadow(0 0 6px color-mix(in srgb, var(--ac) 60%, transparent)); }
#{{ sid }} .snmk__grid { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: clamp(24px, 4vw, 60px); align-items: start; }
#{{ sid }} .snmk__lh { display: grid; grid-template-columns: 1fr 140px 130px; gap: 20px; padding: 0 0 12px; border-bottom: 1px solid var(--line); font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--mute); }
#{{ sid }} .snmk__lh span:first-child { padding-left: 0; }
#{{ sid }} .snmk__lh span:not(:first-child) { text-align: right; }
#{{ sid }} .snmk__line { display: grid; grid-template-columns: 110px minmax(0, 1fr) 140px 130px; gap: 20px; align-items: start; padding: 24px 0; border-bottom: 1px dashed var(--line2); transition: opacity .4s, filter .4s; }
#{{ sid }} .snmk__line.is-busy { opacity: .4; filter: blur(2px); pointer-events: none; }
#{{ sid }} .snmk__line.is-gone { animation: snmk-out .5s cubic-bezier(.6, 0, .4, 1) forwards; }
@keyframes snmk-out { to { opacity: 0; transform: translateX(40px); filter: blur(6px); } }
#{{ sid }} .snmk__img { aspect-ratio: 4 / 5; border-radius: calc(var(--r) * .7); overflow: hidden; background: var(--card2); }
#{{ sid }} .snmk__img img, #{{ sid }} .snmk__img svg { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2, .7, .2, 1); }
#{{ sid }} .snmk__img:hover img { transform: scale(1.06); }
#{{ sid }} .snmk__info { display: grid; gap: 5px; align-content: start; }
#{{ sid }} .snmk__v { font-size: 10.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }
#{{ sid }} .snmk__t { font: 400 1.2rem/1.3 var(--f-head); }
#{{ sid }} .snmk__t:hover { color: var(--ac); }
#{{ sid }} .snmk__opt { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 13px; color: var(--soft); }
#{{ sid }} .snmk__opt b { font-weight: 500; color: var(--tx); }
#{{ sid }} .snmk__prop { font-size: 12.5px; color: var(--soft); }
#{{ sid }} .snmk__disc { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--c-danger); }
#{{ sid }} .snmk__disc .icon { width: 13px; height: 13px; }
#{{ sid }} .snmk__unit { font-size: 13.5px; color: var(--soft); }
#{{ sid }} .snmk__unit s { color: var(--mute); margin-right: 6px; }
#{{ sid }} .snmk__rm { justify-self: start; display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; font-size: 12px; color: var(--mute); transition: color .3s; }
#{{ sid }} .snmk__rm:hover { color: var(--c-danger); }
#{{ sid }} .snmk__rm .icon { width: 14px; height: 14px; }
#{{ sid }} .snmk__qty { justify-self: end; }
#{{ sid }} .snmk__lt { display: grid; justify-items: end; gap: 2px; font-variant-numeric: tabular-nums; }
#{{ sid }} .snmk__lt s { font-size: 12.5px; color: var(--mute); }
#{{ sid }} .snmk__lt b { font-weight: 600; font-size: 15.5px; }
#{{ sid }} .snmk__note { margin-top: 24px; }
#{{ sid }} .snmk__note summary { list-style: none; display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
#{{ sid }} .snmk__note summary::-webkit-details-marker { display: none; }
#{{ sid }} .snmk__note summary .icon { width: 17px; height: 17px; color: var(--ac); }
#{{ sid }} .snmk__note textarea { margin-top: 14px; min-height: 110px; }
#{{ sid }} .snmk__sum { position: sticky; top: 110px; display: grid; gap: 16px; }
#{{ sid }} .snmk__card { display: grid; gap: 18px; padding: 28px; }
#{{ sid }} .snmk__rows { display: grid; gap: 12px; margin: 0; padding-bottom: 16px; border-bottom: 1px dashed var(--line2); }
#{{ sid }} .snmk__rows > div { display: flex; justify-content: space-between; gap: 12px; font-size: 14.5px; }
#{{ sid }} .snmk__rows dt { color: var(--soft); display: inline-flex; align-items: center; gap: 6px; }
#{{ sid }} .snmk__rows dd { margin: 0; text-align: right; }
#{{ sid }} .snmk__rows .is-disc { color: var(--c-danger); } #{{ sid }} .snmk__rows .is-disc dt { color: inherit; }
#{{ sid }} .snmk__rows .icon { width: 14px; height: 14px; }
#{{ sid }} .snmk__free { color: var(--c-signal); letter-spacing: .1em; text-transform: uppercase; font-size: 12px; }
#{{ sid }} .snmk__tot { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
#{{ sid }} .snmk__tot span { font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
#{{ sid }} .snmk__tot b { font: 400 1.75rem/1 var(--f-head); font-variant-numeric: tabular-nums; }
#{{ sid }} .snmk__saved { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px; background: color-mix(in srgb, var(--c-signal) 12%, transparent); font-size: 13px; }
#{{ sid }} .snmk__saved .icon { width: 15px; height: 15px; color: var(--ac); }
#{{ sid }} .snmk__terms { font-size: 13px; }
#{{ sid }} .snmk__go.is-shake { animation: snmk-shake .5s; }
@keyframes snmk-shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
#{{ sid }} .snmk__x { display: grid; gap: 8px; }
#{{ sid }} .snmk__wa { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 50px; border-radius: 999px; border: 1px dashed color-mix(in srgb, #25D366 70%, transparent); font-size: 12.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: background .4s, color .4s; }
#{{ sid }} .snmk__wa .icon { width: 18px; height: 18px; color: #25D366; }
#{{ sid }} .snmk__wa:hover { background: #25D366; color: #fff; } #{{ sid }} .snmk__wa:hover .icon { color: #fff; }
#{{ sid }} .snmk__trust { display: grid; gap: 8px; padding-top: 14px; border-top: 1px dashed var(--line2); }
#{{ sid }} .snmk__trust li { display: flex; align-items: center; gap: 10px; font-size: 12.5px; color: var(--soft); }
#{{ sid }} .snmk__trust .icon { width: 16px; height: 16px; color: var(--ac); }
#{{ sid }} .snmk__cont { justify-self: center; }
#{{ sid }} .snmk__empty { position: relative; isolation: isolate; overflow: hidden; display: grid; place-items: center; min-height: 70vh; border-radius: calc(var(--r) * 1.4); background: {{ settings.color_dark_bg }}; color: {{ settings.color_dark_text }}; --tx: {{ settings.color_dark_text }}; --soft: color-mix(in srgb, {{ settings.color_dark_text }} 72%, transparent); --ac: {{ settings.color_moon }}; text-align: center; }
#{{ sid }} .snmk__ein { position: relative; z-index: 2; display: grid; justify-items: center; gap: 18px; padding: 60px 20px; }
#{{ sid }} .snmk__ein .sn-lead { margin-inline: auto; }
#{{ sid }} .snmk__ebtn { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 22px; margin-top: 8px; }
#{{ sid }} .snmk__login { color: var(--tx); }
#{{ sid }} .snmk__bed { position: relative; width: 170px; aspect-ratio: 4 / 5; border-radius: 50%; overflow: visible; }
#{{ sid }} .snmk__bed > svg { width: 100%; height: 100%; border-radius: 50%; clip-path: circle(48%); animation: snmk-breathe 5s ease-in-out infinite; }
@keyframes snmk-breathe { 50% { transform: scale(1.03) translateY(-3px); } }
#{{ sid }} .snmk__z { position: absolute; right: 6%; top: 10%; font: italic 400 1.6rem var(--f-head); color: var(--ac); opacity: 0; animation: snmk-z 3.6s ease-out infinite; }
#{{ sid }} .snmk__z:nth-of-type(2) { animation-delay: 1.2s; font-size: 1.3rem; } #{{ sid }} .snmk__z:nth-of-type(3) { animation-delay: 2.4s; font-size: 1rem; }
@keyframes snmk-z { 0% { opacity: 0; transform: translate(0, 0) scale(.6); } 30% { opacity: 1; } 100% { opacity: 0; transform: translate(30px, -50px) scale(1.2); } }
@media (max-width: 989px) {
  #{{ sid }} .snmk__grid { grid-template-columns: 1fr; }
  #{{ sid }} .snmk__sum { position: static; }
}
@media (max-width: 649px) {
  #{{ sid }} .snmk__lh { display: none; }
  #{{ sid }} .snmk__line { grid-template-columns: 86px minmax(0, 1fr) auto; grid-template-areas: "img info info" "img qty tot"; gap: 10px 14px; }
  #{{ sid }} .snmk__img { grid-area: img; } #{{ sid }} .snmk__info { grid-area: info; } #{{ sid }} .snmk__qty { grid-area: qty; justify-self: start; } #{{ sid }} .snmk__lt { grid-area: tot; align-self: center; }
  #{{ sid }} .snmk__card { padding: 22px; }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var root = SN && SN.root ? SN.root : '/';
  function refresh() {
    return fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart?section_id={{ section.id }}').then(function (x) { return x.text(); }).then(function (h) {
      var d = new DOMParser().parseFromString(h, 'text/html'), n = d.querySelector('[data-snmk-root]'), c = r.querySelector('[data-snmk-root]');
      if (n && c) { c.innerHTML = n.innerHTML; SN.reveal(c); [].forEach.call(c.querySelectorAll('[data-r]'), function (e) { e.classList.add('is-in'); }); if (window.SNSilk) SNSilk.init(c); SN.feathers(c); }
      if (SN.cart && SN.cart.refresh) SN.cart.refresh(false);
    });
  }
  function change(line, q) {
    var row = r.querySelector('[data-snmk-line="' + line + '"]'); if (row) row.classList.add(q === 0 ? 'is-gone' : 'is-busy');
    return fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ line: line, quantity: q }) })
      .then(function (x) { return x.json(); }).then(function (d) { if (d.status && d.description) SN.toast(d.description, 'close'); return refresh(); }).catch(function () { location.reload(); });
  }
  r.addEventListener('click', function (e) {
    var b = e.target.closest('[data-snmk-q]'); if (b) { e.preventDefault(); change(+b.getAttribute('data-line'), Math.max(0, +b.getAttribute('data-snmk-q'))); return; }
    var g = e.target.closest('[data-snmk-go]'), t = r.querySelector('[data-snmk-terms]');
    if (g && t && !t.checked) { e.preventDefault(); g.classList.remove('is-shake'); void g.offsetWidth; g.classList.add('is-shake'); SN.toast({{ s.terms_msg | json }}, 'info'); }
  });
  var tq = null;
  r.addEventListener('change', function (e) {
    if (e.target.matches('[data-snmk-in]')) { clearTimeout(tq); var i = e.target; tq = setTimeout(function () { change(+i.getAttribute('data-line'), Math.max(0, +i.value || 0)); }, 400); }
    if (e.target.matches('[data-snmk-note]')) fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ note: e.target.value }) });
  });
  document.addEventListener('sn:cart:updated', function () { if (!r.dataset.busy) { r.dataset.busy = 1; setTimeout(function () { delete r.dataset.busy; }, 1500); } });
})();
</script>
{% schema %}
{
  "name": "Cart page",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your"
    },
    {
      "type": "text",
      "id": "title_hl",
      "label": "Heading, italic part",
      "default": "sleep bag"
    },
    {
      "type": "text",
      "id": "items_label",
      "label": "Items label",
      "default": "items"
    },
    {
      "type": "checkbox",
      "id": "vendor",
