<script>
(function () {
  var h = document.getElementById('snh'); if (!h || h.dataset.on) return; h.dataset.on = 1;
  var lis = h.querySelectorAll('[data-snh-li].has-mega'), t = null, beh = h.getAttribute('data-behavior');
  var ann = document.querySelector('.sn-announcement-section');
  function setTop() { var a = ann ? ann.getBoundingClientRect().height : 0; h.style.setProperty('--snh-top', h.classList.contains('snh--clear') ? Math.max(0, a - scrollY) + 'px' : '0px'); h.style.setProperty('--snh-bottom', h.getBoundingClientRect().bottom + 'px'); }
  function close() { lis.forEach(function (l) { l.classList.remove('is-open'); var a = l.querySelector('[aria-expanded]'); if (a) a.setAttribute('aria-expanded', 'false'); }); h.classList.remove('is-open'); }
  lis.forEach(function (li) {
    var a = li.querySelector('.snh__a');
    function open() { clearTimeout(t); t = setTimeout(function () { lis.forEach(function (x) { x.classList.toggle('is-open', x === li); }); h.classList.add('is-open'); if (a) a.setAttribute('aria-expanded', 'true'); setTop(); }, {{ s.hover_delay }}); }
    li.addEventListener('mouseenter', open);
    li.addEventListener('mouseleave', function () { clearTimeout(t); t = setTimeout(close, 180); });
    li.addEventListener('focusin', open);
    if (a) a.addEventListener('keydown', function (e) { if (e.key === 'Escape') { close(); a.focus(); } });
  });
  h.addEventListener('focusout', function (e) { if (!h.contains(e.relatedTarget)) close(); });
  var lastY = scrollY, ticking = false;
  function onScroll() {
    ticking = false; var y = scrollY;
    h.classList.toggle('is-scrolled', y > 20);
    if (beh === 'hide' && !h.classList.contains('is-open')) h.classList.toggle('is-hidden', y > lastY && y > 300);
    lastY = y; setTop();
  }
  addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  addEventListener('resize', setTop); onScroll();
  var ov = document.getElementById('SnSearch');
  if (ov) ov.addEventListener('sn:open', function () { if (window.SN && SN.search) SN.search(ov); });
  if (window.SN && SN.search) SN.search(ov);
})();
</script>

