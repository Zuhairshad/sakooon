{%- comment -%}
  Brand values. Owner: shad-2d. Larger sibling of service-info: optional image or icon per value, heading, text.
  Desktop 2–4 columns; mobile horizontal swipe or stack.
  With a section image it becomes an editorial split: photograph on one side, heading and compact rows (title, one line,
  text link) separated by hairlines on the other, vertically centred; icons are not shown in that layout.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if s.image != blank -%}
<div class="section brand-values brand-values--editorial brand-values--media-{{ s.media_position }} color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;">
  <div class="page-width brand-values__split">
    <div class="media brand-values__feature" style="--aspect: 4/5">
      {%- render 'image', image: s.image, sizes: '(min-width: 1024px) 50vw, 100vw', widths: '480,720,960,1280,1600', aspect: '4/5', crop: 'center' -%}
    </div>
    <div class="brand-values__content">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="brand-values__title {{ s.heading_size }}">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="brand-values__lead rte">{{ s.text }}</div>{%- endif -%}
      <ul class="brand-values__rows list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li class="brand-values__row" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h3 class="brand-values__row-title h5">{{ block.settings.heading | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="brand-values__text rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="link brand-values__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if s.footnote != blank -%}<div class="brand-values__footnote rte">{{ s.footnote }}</div>{%- endif -%}
    </div>
  </div>
</div>
{%- else -%}
<div class="section brand-values brand-values--{{ s.align }} brand-values--mobile-{{ s.mobile_layout }} color-scheme-{{ s.color_scheme }}" style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --values-columns: {{ s.columns }}; --tablet-columns: {% if section.blocks.size == 3 %}3{% else %}2{% endif %};">
  <div class="page-width page-width--full">
    {%- render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, heading_size: s.heading_size, text: s.text, align: s.align -%}
    <ul class="brand-values__list list-unstyled{% if s.mobile_layout == 'scroll' %} no-scrollbar{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li class="brand-values__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media brand-values__media" style="--aspect: {{ s.image_ratio }}">
              {%- render 'image', image: block.settings.image, sizes: '(min-width: 1024px) 25vw, 70vw', aspect: s.image_ratio -%}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="brand-values__icon">{% render 'icon', icon: block.settings.icon, size: 32 %}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}<h3 class="brand-values__heading h4">{{ block.settings.heading | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="brand-values__text rte">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}<a class="link brand-values__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.footnote != blank -%}<div class="brand-values__footnote rte">{{ s.footnote }}</div>{%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Brand values",
  "tag": "section",
  "class": "section-brand-values",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Sakooon" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h2", "options": [ { "value": "h1", "label": "t:sections.all.heading_size.options.h1" }, { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" } ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "richtext", "id": "footnote", "label": "Closing line", "info": "Optional. Shown below the values." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Switches to a two-column layout: photograph beside the values, shown as rows with hairlines (icons hidden)." },
    { "type": "select", "id": "media_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "4/5", "options": [ { "value": "4/5", "label": "Portrait" }, { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape" } ] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ] },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "stack", "options": [ { "value": "stack", "label": "Stack" }, { "value": "scroll", "label": "Swipe" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "paper" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "value", "name": "Value",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "icon", "label": "Icon (when there is no image)", "default": "leaf",
          "options": [ { "value": "none", "label": "None" }, { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Water" }, { "value": "shield", "label": "Shield" }, { "value": "heart", "label": "Heart" }, { "value": "sun", "label": "Sun" }, { "value": "moon", "label": "Moon" }, { "value": "wind", "label": "Air" }, { "value": "star", "label": "Star" }, { "value": "map-pin", "label": "Place" } ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A value" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say what this means for your sleep, plainly.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Brand values", "blocks": [ { "type": "value", "settings": { "icon": "leaf" } }, { "type": "value", "settings": { "icon": "drop" } }, { "type": "value", "settings": { "icon": "heart" } } ] } ]
}
{% endschema %}
