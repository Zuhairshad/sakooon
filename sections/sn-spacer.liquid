{%- liquid
  assign s = section.settings
  assign sid = 'snsp-' | append: section.id
-%}
<div id="{{ sid }}" class="sn-s snsp" style="{% render 'sn-vars', s: s %} --pt: 0px; --pb: 0px;" aria-hidden="true">
  <div class="snsp__in snsp__in--{{ s.style }}">
    {%- if s.style == 'stitch' -%}<i></i>{% render 'sn-phase', k: 2 %}<i></i>
    {%- elsif s.style == 'wave' -%}<svg viewBox="0 0 1200 30" preserveAspectRatio="none"><path d="M0 15C100 0 200 0 300 15S500 30 600 15 800 0 900 15 1100 30 1200 15"/></svg>
    {%- elsif s.style == 'moons' -%}{%- for k in (0..4) -%}{% render 'sn-phase', k: k %}{%- endfor -%}
    {%- endif -%}
  </div>
</div>
<style>
#{{ sid }} .snsp__in { height: {{ s.height }}px; display: flex; align-items: center; justify-content: center; gap: 16px; width: min(var(--pw, 1380px), 100% - 56px); margin-inline: auto; color: var(--ac); }
#{{ sid }} .snsp__in i { flex: 1; border-top: 1px dashed currentColor; opacity: .55; }
#{{ sid }} .snsp__in .sn-ph { width: 16px; height: 16px; }
#{{ sid }} .snsp__in svg { width: 100%; height: 30px; }
#{{ sid }} .snsp__in svg path { fill: none; stroke: currentColor; stroke-width: 1; opacity: .6; vector-effect: non-scaling-stroke; }
#{{ sid }} .snsp__in--moons .sn-ph { animation: snsp-glow 3s ease-in-out infinite; }
#{{ sid }} .snsp__in--moons .sn-ph:nth-child(2) { animation-delay: .3s; } #{{ sid }} .snsp__in--moons .sn-ph:nth-child(3) { animation-delay: .6s; } #{{ sid }} .snsp__in--moons .sn-ph:nth-child(4) { animation-delay: .9s; } #{{ sid }} .snsp__in--moons .sn-ph:nth-child(5) { animation-delay: 1.2s; }
@keyframes snsp-glow { 50% { opacity: .35; transform: translateY(-3px); } }
@media (max-width: 749px) { #{{ sid }} .snsp__in { height: {{ s.height_m }}px; width: calc(100% - 32px); } }
</style>
{% schema %}
{
  "name": "Spacer & divider",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "height_m",
      "label": "Height (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "style",
      "label": "Divider",
      "options": [
        {
          "value": "none",
          "label": "Empty space"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        },
        {
          "value": "wave",
          "label": "Silk wave"
        },
        {
          "value": "moons",
          "label": "Moon phases"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    }
  ],
  "presets": [
    {
      "name": "Spacer & divider"
    }
  ]
}
{% endschema %}
