<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  /* description more */
  var more = r.querySelector('[data-snmp-more]');
  if (more) { var d = r.querySelector('[data-snmp-desc]'), ml = more.textContent; if (d.scrollHeight <= d.clientHeight + 8) { d.classList.remove('is-clamp'); more.hidden = true; } more.addEventListener('click', function () { var o = d.classList.toggle('is-open'); more.textContent = o ? more.getAttribute('data-less') : ml; }); }
  /* delivery estimate */
  var del = r.querySelector('[data-snmp-del]');
  if (del) {
    var addDays = function (n) { var dt = new Date(), c = 0; if (dt.getHours() >= +del.getAttribute('data-cut')) n++; while (c < n) { dt.setDate(dt.getDate() + 1); if (del.getAttribute('data-sun') === 'true' && dt.getDay() === 0) continue; c++; } return dt; };
    var f = function (dt) { return dt.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' }); };
    del.querySelector('[data-snmp-dates]').textContent = f(addDays(+del.getAttribute('data-min'))) + ' – ' + f(addDays(+del.getAttribute('data-max')));
    var cut = del.querySelector('[data-snmp-cut]'), tpl = cut.getAttribute('data-tpl');
    (function tick() { var now = new Date(), end = new Date(); end.setHours(+del.getAttribute('data-cut'), 0, 0, 0); var ms = end - now; if (ms <= 0 || !tpl) { cut.textContent = ''; return; } var h = Math.floor(ms / 36e5), m = Math.floor(ms % 36e5 / 6e4); cut.textContent = tpl.replace('[time]', h + 'h ' + m + 'm'); setTimeout(tick, 30000); })();
  }
  /* whatsapp link follows variant */
  var wa = r.querySelector('[data-snmp-wa]');
  r.addEventListener('sn:variant', function (e) { if (wa) { var u = new URL(wa.href); u.searchParams.set('text', wa.getAttribute('data-base') + ' {{ product.title | escape }} (' + e.detail.title + ') – ' + location.origin + '{{ product.url }}?variant=' + e.detail.id); wa.href = u.toString(); } });
  /* copy link */
  var cp = r.querySelector('[data-snmp-copy]'); if (cp) cp.addEventListener('click', function () { if (navigator.share) navigator.share({ url: cp.getAttribute('data-snmp-copy') }).catch(function () {}); else if (navigator.clipboard) navigator.clipboard.writeText(cp.getAttribute('data-snmp-copy')).then(function () { SN.toast({{ s.copied | json }}); }); });
  /* sticky bar */
  var st = r.querySelector('[data-snmp-sticky]'), buy = r.querySelector('[data-snmp-buy]');
  if (st && buy && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (es) { var b = es[0], show = !b.isIntersecting && b.boundingClientRect.top < 0; st.classList.toggle('is-on', show); st.setAttribute('aria-hidden', !show); }).observe(buy);
    st.querySelector('[data-snmp-sadd]').addEventListener('click', function () { var p = r.querySelector('[data-sn-product]').snProduct; if (p) p.add(); });
  }
  /* lightbox */
  var lb = r.querySelector('[data-snmp-lb]'), lbt = lb && lb.querySelector('[data-snmp-lbt]');
  if (lb) {
    [].forEach.call(document.querySelectorAll('body > #{{ sid }}-lb'), function (o) { if (o !== lb) o.remove(); }); document.body.appendChild(lb);
    var close = function () { lb.classList.remove('is-open'); document.documentElement.classList.remove('sn-lock'); setTimeout(function () { lb.hidden = true; }, 500); };
    r.addEventListener('click', function (e) {
      var z = e.target.closest('[data-snmp-zoom]'); if (!z || {{ s.zoom | json }} === false) return;
      var idx = +z.getAttribute('data-snmp-zoom'), imgs = [].slice.call(lb.querySelectorAll('img[data-src]'));
      imgs.forEach(function (im) { if (!im.src) im.src = im.getAttribute('data-src'); });
      var ii = [].slice.call(r.querySelectorAll('[data-snmp-zoom]')).indexOf(z);
      lb.hidden = false; document.documentElement.classList.add('sn-lock');
      requestAnimationFrame(function () { lb.classList.add('is-open'); lbt.scrollLeft = lbt.clientWidth * ii; });
    });
    lb.querySelector('[data-snmp-lbx]').addEventListener('click', close);
    var lbGo = function (d) {
      var n = lbt.children.length; if (!n) return;
      var cur = Math.round(lbt.scrollLeft / lbt.clientWidth), nx = (cur + d + n) % n;
      [].forEach.call(lbt.querySelectorAll('.snmp__lbf.is-z'), function (f) { f.classList.remove('is-z'); });
      lbt.scrollTo({ left: lbt.clientWidth * nx, behavior: 'smooth' });
    };
    [].forEach.call(lb.querySelectorAll('[data-snmp-lbn]'), function (b) { b.addEventListener('click', function (e) { e.stopPropagation(); lbGo(+b.getAttribute('data-snmp-lbn')); }); });
    window.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); close(); }
      else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); e.stopImmediatePropagation(); lbGo(e.key === 'ArrowRight' ? 1 : -1); }
    }, true);
    lbt.addEventListener('click', function (e) { var f = e.target.closest('.snmp__lbf'); if (!f) return; if (e.target.tagName !== 'IMG') { close(); return; } var im = f.querySelector('img'), b = im.getBoundingClientRect(); im.style.transformOrigin = ((e.clientX - b.left) / b.width * 100) + '% ' + ((e.clientY - b.top) / b.height * 100) + '%'; f.classList.toggle('is-z'); });
    lbt.addEventListener('pointermove', function (e) { var f = e.target.closest('.snmp__lbf.is-z'); if (!f) return; var im = f.querySelector('img'), b = f.getBoundingClientRect(); im.style.transformOrigin = ((e.clientX - b.left) / b.width * 100) + '% ' + ((e.clientY - b.top) / b.height * 100) + '%'; });
  }
  /* size drawer moves to body so it sits above the header */
  var sg = document.getElementById('SnSize-{{ section.id }}'); if (sg && sg.parentNode !== document.body) { [].forEach.call(document.querySelectorAll('body > #SnSize-{{ section.id }}'), function (o) { o.remove(); }); document.body.appendChild(sg); }
})();
</script>
