{%- liquid
  assign s = section.settings
  assign sid = 'snmp-' | append: section.id
  assign uid = 'mp' | append: section.id
  assign cv = product.selected_or_first_available_variant
  assign fm = cv.featured_media | default: product.featured_media
  assign size_ov = 'SnSize-' | append: section.id
  assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
-%}
<section id="{{ sid }}" class="sn-s snmp snmp--{{ s.gallery }}" style="{% render 'sn-vars', s: s %}">
  <div class="sn-wrap">
    {%- if s.crumbs -%}
      <nav class="sn-crumbs snmp__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ s.home_label }}</a><i></i>
        {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a><i></i>{%- elsif product.collections.first -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a><i></i>{%- endif -%}
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="snmp__grid" data-sn-product data-history id="{{ uid }}">
      <script type="application/json" data-sn-pjson>{{ product | json }}</script>
      <script type="application/json" data-sn-pinv>{ {%- for v in product.variants -%}"{{ v.id }}": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity | default: 0 }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}{%- endfor -%} }</script>

      {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
      <div class="snmp__gal" data-sn-gallery>
        <div class="snmp__stage">
          <div class="snmp__track" data-sn-track>
            {%- if product.media.size > 0 -%}
              {%- for m in product.media -%}
                {%- assign on = false -%}{%- if m.id == fm.id -%}{%- assign on = true -%}{%- endif -%}
                <div class="snmp__slide{% if on %} is-on{% endif %} snmp__slide--{{ m.media_type }}" data-sn-slide="{{ m.id }}" style="--i: {{ forloop.index0 | at_most: 5 }};">
                  {%- case m.media_type -%}
                    {%- when 'image' -%}
                      <button type="button" class="sn-media snmp__m" data-snmp-zoom="{{ forloop.index0 }}" aria-label="{{ s.zoom_label | escape }}">
                        <img src="{{ m | image_url: width: 1400 }}" srcset="{{ m | image_url: width: 700 }} 700w, {{ m | image_url: width: 1100 }} 1100w, {{ m | image_url: width: 1600 }} 1600w" sizes="(min-width: 990px) 55vw, 100vw" alt="{{ m.alt | escape }}" width="{{ m.width }}" height="{{ m.height }}" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                        <span class="snmp__zi">{% render 'sn-icon', name: 'zoom', class: 'icon' %}</span>
                      </button>
                    {%- when 'video' -%}
                      <div class="sn-media snmp__m">{{ m | video_tag: controls: true, playsinline: true, muted: true, loop: true, image_size: '1400x' }}</div>
                    {%- when 'external_video' -%}
                      <div class="sn-media snmp__m snmp__ext">{{ m | external_video_tag }}</div>
                    {%- when 'model' -%}
                      <div class="sn-media snmp__m">{{ m | model_viewer_tag: image_size: '1400x' }}</div>
                    {%- else -%}
                      <div class="sn-media snmp__m">{{ m | media_tag }}</div>
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="snmp__slide is-on" data-sn-slide="0">{% render 'sn-media', art: s.art, class: 'snmp__m' %}</div>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="snmp__arrows"><button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-gnav="-1" aria-label="Previous">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}</button><button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-gnav="1" aria-label="Next">{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button></div>
            <div class="snmp__gbar"><i data-sn-gprog style="width: {{ 100.0 | divided_by: product.media.size }}%;"></i></div>
          {%- endif -%}
          {%- if s.wish_on_gallery -%}<button type="button" class="snmp__wish sn-card__wish" data-sn-wish="{{ product.handle }}" aria-label="Wishlist">{% render 'sn-icon', name: 'heart', class: 'icon icon--outline' %}{% render 'sn-icon', name: 'heart-filled', class: 'icon icon--filled' %}</button>{%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="snmp__thumbs">
            {%- for m in product.media -%}
              <button type="button" class="snmp__th{% if m.id == fm.id %} is-on{% endif %}" data-sn-thumb="{{ m.id }}" aria-label="Media {{ forloop.index }}">
                <img src="{{ m.preview_image | image_url: width: 180 }}" alt="" width="90" height="112" loading="lazy">
                {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}<i>{% render 'sn-icon', name: 'play', class: 'icon' %}</i>{%- elsif m.media_type == 'model' -%}<i>3D</i>{%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ============ INFO ============ {%- endcomment -%}
      <div class="snmp__info">
        <div class="snmp__inner">
          {%- assign pfid = 'SnPF-' | append: section.id -%}
          {%- form 'product', product, id: pfid, data-sn-pform: '', class: 'snmp__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ cv.id }}" data-sn-pvid>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- case block.type -%}
              {%- when '@app' -%}{% render block %}
              {%- when 'eyebrow' -%}
                <p class="sn-eyebrow snmp__eb" {{ block.shopify_attributes }}>{% render 'sn-phase', k: 3 %}{% if b.text != blank %}{{ b.text }}{% else %}{{ product.vendor }}{% endif %}</p>
              {%- when 'title' -%}
                <h1 class="sn-h sn-h--{{ b.size }} snmp__title" data-sn-split {{ block.shopify_attributes }}>{{ product.title }}</h1>
                {%- if b.subtitle and product.metafields.custom.subtitle != blank -%}<p class="snmp__sub">{{ product.metafields.custom.subtitle.value }}</p>{%- endif -%}
              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  {%- assign rv = product.metafields.reviews.rating.value.rating | times: 20 -%}
                  <a class="snmp__rate" href="{{ b.link | default: '#reviews' }}" {{ block.shopify_attributes }}><span class="sn-stars" style="--p: {{ rv }}%;"></span><b>{{ product.metafields.reviews.rating.value.rating }}</b><span>{{ product.metafields.reviews.rating_count.value }} {{ b.label }}</span></a>
                {%- endif -%}
              {%- when 'price' -%}
                <div class="snmp__pricebox" {{ block.shopify_attributes }}>
                  <div class="sn-pprice" data-sn-pprice>
                    <span class="sn-price__now{% if cv.compare_at_price > cv.price %} is-sale{% endif %}">{{ cv.price | money }}</span>
                    {%- if cv.compare_at_price > cv.price -%}{%- assign pdiff = cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price | floor -%}<s class="sn-price__was">{{ cv.compare_at_price | money }}</s><span class="sn-badge sn-badge--sale">−{{ pdiff }}%</span>{%- endif -%}
                  </div>
                  {%- if b.tax_note != blank -%}<p class="sn-small">{{ b.tax_note }}</p>{%- endif -%}
                  {%- if b.installments -%}<div class="snmp__pay">{{ form | payment_terms }}</div>{%- endif -%}
                </div>
              {%- when 'specs' -%}
                {%- assign spec_src = b.items -%}{%- if product.metafields.custom.spec_chips != blank -%}{%- assign spec_src = product.metafields.custom.spec_chips.value -%}{%- endif -%}
                {%- assign lines = spec_src | newline_to_br | split: '<br />' -%}
                <ul class="snmp__specs" {{ block.shopify_attributes }}>
                  {%- if product.metafields.custom.thread_count != blank -%}<li><b>T{{ product.metafields.custom.thread_count.value }}</b><span>{{ b.tc_label }}</span></li>{%- endif -%}
                  {%- for l in lines -%}{%- assign ll = l | strip -%}{%- if ll != blank -%}{%- assign kv = ll | split: '|' -%}<li><b>{{ kv[0] }}</b><span>{{ kv[1] }}</span></li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- when 'description' -%}
                <div class="sn-rte snmp__desc{% if b.clamp %} is-clamp{% endif %}" data-snmp-desc {{ block.shopify_attributes }}>{{ product.description }}</div>
                {%- if b.clamp -%}<button type="button" class="sn-link snmp__more" data-snmp-more data-less="{{ b.less | escape }}">{{ b.more }}</button>{%- endif -%}
              {%- when 'variant_picker' -%}
                <div class="snmp__picker" {{ block.shopify_attributes }}>{% render 'sn-picker', product: product, style: b.style, swatches: b.swatches, uid: uid, size_link: b.size_label, size_target: size_ov %}</div>
              {%- when 'stock' -%}
                <div class="sn-stock" data-sn-pstock data-low="{{ b.low }}" data-in="{{ b.in_text | escape }}" data-out="{{ b.out_text | escape }}" data-lowtxt="{{ b.low_text | escape }}" {{ block.shopify_attributes }}><span class="sn-stock__t" data-sn-pstock-t>{{ b.in_text }}</span>{%- if b.bar -%}<span class="sn-stock__bar"><i data-sn-pstock-b style="width: 100%;"></i></span>{%- endif -%}</div>
              {%- when 'properties' -%}
                <div class="snmp__props" {{ block.shopify_attributes }}>
                  {%- if b.gift -%}<label class="sn-check snmp__gift"><input type="checkbox" name="properties[{{ b.gift_name | escape }}]" value="Yes"><span>{% render 'sn-icon', name: 'gift', class: 'icon' %}{{ b.gift_label }}</span></label>{%- endif -%}
                  {%- if b.mono -%}<div class="sn-field"><label for="{{ uid }}-mono">{{ b.mono_label }}</label><input class="sn-input" id="{{ uid }}-mono" type="text" maxlength="{{ b.mono_max }}" name="properties[{{ b.mono_name | escape }}]" placeholder="{{ b.mono_ph | escape }}"></div>{%- endif -%}
                </div>
              {%- when 'buy_buttons' -%}
                <div class="snmp__buy" data-snmp-buy {{ block.shopify_attributes }}>
                  <div class="sn-buy">
                    {%- if b.qty -%}<div class="sn-qty"><button type="button" data-sn-q="-1" aria-label="Decrease">{% render 'sn-icon', name: 'minus', class: 'icon' %}</button><input type="number" name="quantity" value="1" min="1" data-sn-pqty aria-label="{{ 'products.product.quantity' | t }}"><button type="button" data-sn-q="1" aria-label="Increase">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button></div>{%- endif -%}
                    <button type="submit" class="sn-btn sn-btn--gold sn-buy__atc" data-sn-patc data-label="{{ 'products.product.add_to_cart' | t | escape }}" data-sold="{{ 'products.product.sold_out' | t | escape }}"{% unless cv.available %} disabled{% endunless %}><span>{% if cv.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>{% render 'sn-icon', name: 'bag', class: 'icon' %}</button>
                    {%- if b.wish -%}<button type="button" class="sn-ibtn snmp__wishb" data-sn-wish="{{ product.handle }}" aria-label="Wishlist">{% render 'sn-icon', name: 'heart', class: 'icon' %}</button>{%- endif -%}
                    {%- if b.dynamic -%}<div class="sn-buy__now" data-sn-buynow>{{ form | payment_button }}</div>{%- endif -%}
                  </div>
                  {%- if b.whatsapp and wa != blank -%}
                    {%- capture wmsg -%}{{ b.wa_msg }} {{ product.title }} – {{ shop.url }}{{ product.url }}{%- endcapture -%}
                    <a class="snmp__wa" href="https://wa.me/{{ wa }}?text={{ wmsg | url_encode }}" target="_blank" rel="noopener" data-snmp-wa data-base="{{ b.wa_msg | escape }}">{% render 'sn-icon', name: 'whatsapp', class: 'icon' %}<span>{{ b.wa_label }}</span></a>
                  {%- endif -%}
                  {%- if b.pickup -%}
                    {%- assign pk = cv.store_availabilities | where: 'pick_up_enabled', true -%}
                    {%- if pk.size > 0 -%}<p class="snmp__pick">{% render 'sn-icon', name: 'map-pin', class: 'icon' %}<span>{% if pk.first.available %}{{ b.pickup_yes }}{% else %}{{ b.pickup_no }}{% endif %} <b>{{ pk.first.location.name }}</b> · {{ pk.first.pick_up_time }}</span></p>{%- endif -%}
                  {%- endif -%}
                </div>
              {%- when 'delivery' -%}
                <div class="snmp__del sn-pillow" data-snmp-del data-min="{{ b.min_days }}" data-max="{{ b.max_days }}" data-cut="{{ b.cutoff }}" data-sun="{{ b.skip_sunday }}" {{ block.shopify_attributes }}>
                  <span class="snmp__truck">{% render 'sn-icon', name: 'truck', class: 'icon' %}<i></i></span>
                  <div><p>{{ b.text }} <b data-snmp-dates>—</b></p><p class="sn-small" data-snmp-cut data-tpl="{{ b.cut_text | escape }}"></p></div>
                </div>
              {%- when 'trust' -%}
                <ul class="snmp__trust" {{ block.shopify_attributes }}>
                  {%- if b.t1 != blank -%}<li>{% render 'sn-icon', name: b.i1, class: 'icon' %}<span>{{ b.t1 }}</span></li>{%- endif -%}
                  {%- if b.t2 != blank -%}<li>{% render 'sn-icon', name: b.i2, class: 'icon' %}<span>{{ b.t2 }}</span></li>{%- endif -%}
                  {%- if b.t3 != blank -%}<li>{% render 'sn-icon', name: b.i3, class: 'icon' %}<span>{{ b.t3 }}</span></li>{%- endif -%}
                  {%- if b.t4 != blank -%}<li>{% render 'sn-icon', name: b.i4, class: 'icon' %}<span>{{ b.t4 }}</span></li>{%- endif -%}
                </ul>
              {%- when 'tab' -%}
                <details class="sn-acc snmp__acc"{% if b.open %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary><span class="snmp__acct">{% render 'sn-icon', name: b.icon, class: 'icon' %}{{ b.title }}</span><i aria-hidden="true"></i></summary>
                  <div class="sn-acc__body sn-rte">
                    {%- if b.source == 'description' -%}{{ product.description }}
                    {%- elsif b.source == 'care' -%}{% render 'sn-care-icons' %}{{ b.content }}
                    {%- elsif b.source == 'page' and b.page != blank -%}{{ b.page.content }}
                    {%- else -%}{{ b.content }}{%- endif -%}
                  </div>
                </details>
              {%- when 'complementary' -%}
                {%- assign comp = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value -%}
                {%- if comp.size > 0 -%}
                  <div class="snmp__comp" {{ block.shopify_attributes }}>
                    <p class="snmp__ct">{{ b.title }}</p>
                    <div class="snmp__crow">
                      {%- for cp in comp limit: b.limit -%}
                        <div class="snmp__cp">
                          <a href="{{ cp.url }}" class="snmp__cimg">{%- if cp.featured_media -%}<img src="{{ cp.featured_media | image_url: width: 200 }}" alt="" width="80" height="100" loading="lazy">{%- else -%}{% render 'sn-art', name: 'pillow' %}{%- endif -%}</a>
                          <span><a href="{{ cp.url }}">{{ cp.title }}</a>{% render 'sn-price', product: cp %}</span>
                          {%- if cp.has_only_default_variant -%}<button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-add="{{ cp.selected_or_first_available_variant.id }}" aria-label="Add {{ cp.title | escape }}">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- else -%}<button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-quick="{{ cp.handle }}" aria-label="Choose {{ cp.title | escape }}">{% render 'sn-icon', name: 'plus', class: 'icon' %}</button>{%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- when 'share' -%}
                <div class="snmp__share" {{ block.shopify_attributes }}>
                  <span>{{ b.label }}</span>
                  <a class="sn-ibtn sn-ibtn--sm" target="_blank" rel="noopener" href="https://wa.me/?text={{ shop.url | append: product.url | url_encode }}" aria-label="WhatsApp">{% render 'sn-icon', name: 'whatsapp', class: 'icon' %}</a>
                  <a class="sn-ibtn sn-ibtn--sm" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" aria-label="Facebook">{% render 'sn-icon', name: 'facebook', class: 'icon' %}</a>
                  <button type="button" class="sn-ibtn sn-ibtn--sm" data-snmp-copy="{{ shop.url }}{{ product.url }}" aria-label="Copy link">{% render 'sn-icon', name: 'share', class: 'icon' %}</button>
                </div>
              {%- when 'sku' -%}
                <p class="snmp__sku sn-small" {{ block.shopify_attributes }}>{{ b.label }} <span data-sn-psku>{{ cv.sku }}</span></p>
              {%- when 'text' -%}
                <div class="sn-rte snmp__txt" {{ block.shopify_attributes }}>{{ b.text }}</div>
              {%- when 'custom_liquid' -%}
                <div {{ block.shopify_attributes }}>{{ b.code }}</div>
            {%- endcase -%}
          {%- endfor -%}
          {%- endform -%}
        </div>
      </div>

      {%- comment -%} ============ STICKY BAR ============ {%- endcomment -%}
      {%- if s.sticky -%}
        <div class="snmp__sticky" data-snmp-sticky aria-hidden="true">
          <div class="snmp__sin">
            <span class="snmp__simg">{%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="48" height="60">{%- endif -%}</span>
            <span class="snmp__st"><b>{{ product.title }}</b><span class="sn-small"><span data-sn-optv="0">{{ cv.options[0] }}</span>{% if cv.options[1] %} · <span data-sn-optv="1">{{ cv.options[1] }}</span>{% endif %}</span></span>
            <div class="sn-pprice snmp__sp" data-sn-pprice>{% render 'sn-price', product: product, variant: cv %}</div>
            <button type="button" class="sn-btn sn-btn--gold sn-btn--sm" data-sn-patc data-snmp-sadd data-label="{{ 'products.product.add_to_cart' | t | escape }}" data-sold="{{ 'products.product.sold_out' | t | escape }}" tabindex="-1"><span>{{ 'products.product.add_to_cart' | t }}</span></button>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ============ LIGHTBOX ============ {%- endcomment -%}
  <div class="snmp__lb" id="{{ sid }}-lb" data-snmp-lb hidden role="dialog" aria-modal="true" aria-label="{{ product.title | escape }}">
    <div class="snmp__lbtrack" data-snmp-lbt>
      {%- for m in product.media -%}{%- if m.media_type == 'image' -%}<figure class="snmp__lbf"><img data-src="{{ m | image_url: width: 2400 }}" alt="{{ m.alt | escape }}" width="{{ m.width }}" height="{{ m.height }}"></figure>{%- endif -%}{%- endfor -%}
    </div>
    {%- assign lb_imgs = product.media | where: 'media_type', 'image' -%}
    {%- if lb_imgs.size > 1 -%}
    <button type="button" class="sn-ibtn snmp__lbn snmp__lbn--prev" data-snmp-lbn="-1" aria-label="Previous image">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}</button>
    <button type="button" class="sn-ibtn snmp__lbn snmp__lbn--next" data-snmp-lbn="1" aria-label="Next image">{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
    {%- endif -%}
    <button type="button" class="sn-ibtn snmp__lbx" data-snmp-lbx aria-label="Close">{% render 'sn-icon', name: 'close', class: 'icon' %}</button>
    <p class="snmp__lbhint">{{ s.lb_hint }}</p>
  </div>

  {%- comment -%} ============ SIZE GUIDE DRAWER ============ {%- endcomment -%}
  <div class="sn-ov" id="{{ size_ov }}" hidden>
    <div class="sn-ov__bg" data-sn-close></div>
    <div class="sn-drawer snmp__sg" role="dialog" aria-modal="true" aria-label="{{ s.sg_title | escape }}">
      <div class="sn-drawer__head"><p class="sn-drawer__title">{{ s.sg_title }}</p><button type="button" class="sn-ibtn sn-ibtn--sm" data-sn-close aria-label="Close">{% render 'sn-icon', name: 'close', class: 'icon' %}</button></div>
      <div class="sn-drawer__body sn-rte">
        {%- if s.sg_page != blank -%}{{ s.sg_page.content }}{%- else -%}{{ s.sg_content }}{%- endif -%}
        {%- if s.sg_link_label != blank -%}<p><a href="{{ s.sg_link | default: '/pages/size-guide' }}">{{ s.sg_link_label }}</a></p>{%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org", "@type": "Product",
    "name": {{ product.title | json }}, "url": {{ shop.url | append: product.url | json }},
    {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1600 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- if product.metafields.reviews.rating.value != blank -%}"aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }}, "reviewCount": {{ product.metafields.reviews.rating_count.value | json }} },{%- endif -%}
    "offers": [{%- for v in product.variants -%}{ "@type": "Offer", "sku": {{ v.sku | json }}, "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}", "price": {{ v.price | divided_by: 100.0 | json }}, "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }}, "url": {{ shop.url | append: v.url | json }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  }
  </script>
</section>
<style>
#{{ sid }} .snmp__crumbs { margin-bottom: 22px; }
#{{ sid }} .snmp__grid { display: grid; grid-template-columns: minmax(0, {{ s.gal_w }}fr) minmax(0, {{ 100 | minus: s.gal_w }}fr); gap: clamp(30px, 4.5vw, 80px); align-items: start; }
/* gallery */
#{{ sid }} .snmp__gal { position: relative; display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 16px; }
#{{ sid }} .snmp__stage { position: relative; grid-column: 2; min-width: 0; }
#{{ sid }} .snmp__track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: calc(var(--r) * 1.2); overscroll-behavior-x: contain; }
#{{ sid }} .snmp__track::-webkit-scrollbar { display: none; }
#{{ sid }} .snmp__slide { scroll-snap-align: start; }
#{{ sid }} .snmp__m { display: block; width: 100%; aspect-ratio: {{ s.ratio }}; border-radius: calc(var(--r) * 1.2); cursor: zoom-in; }
#{{ sid }} .snmp__m video, #{{ sid }} .snmp__m iframe, #{{ sid }} .snmp__m model-viewer { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
