{%- liquid
  assign s = section.settings
  assign sid = 'snlg-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snlg snlg--{{ s.layout }}" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 1 %}
    {%- if s.layout == 'press' -%}
      <div class="snlg__press" data-snlg>
        <div class="snlg__quotes">
          {%- for block in section.blocks -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="snlg__q sn-h sn-h--m{% if forloop.first %} is-on{% endif %}" data-snlg-q="{{ forloop.index0 }}">“{{ block.settings.quote }}”</blockquote>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="snlg__tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" class="snlg__logo{% if forloop.first %} is-on{% endif %}" data-snlg-t="{{ forloop.index0 }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.name | escape }}">
              {%- if block.settings.logo != blank -%}<img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" style="max-height: {{ s.logo_h }}px;">{%- else -%}<span>{{ block.settings.name }}</span>{%- endif -%}
              <i class="snlg__bar"></i>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  {%- if s.layout == 'marquee' -%}
    <div class="sn-marq snlg__marq" style="--dur: {{ s.speed }}s; --gap: clamp(40px, 6vw, 90px);" data-r>
      {%- for c in (1..2) -%}
        <div class="sn-marq__t is-pausable"{% if c == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} class="snlg__item" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}<img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" style="max-height: {{ s.logo_h }}px;">{%- else -%}<span>{{ block.settings.name }}</span>{%- endif -%}
            </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
            <i class="snlg__sep" aria-hidden="true">{% render 'sn-phase', k: 2 %}</i>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- elsif s.layout == 'grid' -%}
    <div class="sn-wrap"><ul class="snlg__grid">
      {%- for block in section.blocks -%}
        <li class="snlg__cell" data-r="zoom" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} class="snlg__item">
            {%- if block.settings.logo != blank -%}<img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" style="max-height: {{ s.logo_h }}px;">{%- else -%}<span>{{ block.settings.name }}</span>{%- endif -%}
          </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
        </li>
      {%- endfor -%}
    </ul></div>
  {%- endif -%}
</section>
<style>
#{{ sid }} .snlg__item { display: grid; place-items: center; color: var(--soft); transition: color .4s, opacity .4s, filter .5s; {% if s.mono %}filter: grayscale(1); opacity: .65;{% endif %} }
#{{ sid }} .snlg__item:hover { color: var(--tx); filter: none; opacity: 1; }
#{{ sid }} .snlg__item span, #{{ sid }} .snlg__logo span { font: 400 clamp(1.3rem, 2vw, 1.9rem)/1 var(--f-head); letter-spacing: .02em; white-space: nowrap; }
#{{ sid }} .snlg__item img, #{{ sid }} .snlg__logo img { width: auto; max-width: 180px; object-fit: contain; }
#{{ sid }} .snlg__sep { color: var(--ac); display: grid; place-items: center; }
#{{ sid }} .snlg__sep .sn-ph { width: 12px; height: 12px; }
#{{ sid }} .snlg__marq { padding-block: 10px; }
#{{ sid }} .snlg__grid { display: grid; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); border-top: 1px dashed var(--line2); border-left: 1px dashed var(--line2); }
#{{ sid }} .snlg__cell { border-right: 1px dashed var(--line2); border-bottom: 1px dashed var(--line2); }
#{{ sid }} .snlg__cell .snlg__item { min-height: 130px; padding: 20px; }
#{{ sid }} .snlg__press { display: grid; gap: clamp(30px, 4vw, 54px); justify-items: center; text-align: center; }
#{{ sid }} .snlg__quotes { display: grid; max-width: 900px; }
#{{ sid }} .snlg__q { grid-area: 1 / 1; font-style: italic; opacity: 0; transform: translateY(14px); filter: blur(8px); transition: opacity .8s, transform .9s cubic-bezier(.2, .7, .2, 1), filter .8s; pointer-events: none; }
#{{ sid }} .snlg__q.is-on { opacity: 1; transform: none; filter: none; pointer-events: auto; }
#{{ sid }} .snlg__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px clamp(20px, 4vw, 60px); }
#{{ sid }} .snlg__logo { position: relative; display: grid; place-items: center; min-height: 60px; padding: 10px 4px; color: var(--mute); opacity: 1; transition: opacity .4s, color .4s; }
#{{ sid }} .snlg__logo.is-on, #{{ sid }} .snlg__logo:hover { opacity: 1; color: var(--tx); }
#{{ sid }} .snlg__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--line); overflow: hidden; }
#{{ sid }} .snlg__bar::after { content: ""; position: absolute; inset: 0; background: var(--ac); transform: scaleX(0); transform-origin: left; }
#{{ sid }} .snlg__logo.is-on .snlg__bar::after { animation: snlg-fill {{ s.speed | divided_by: 6 }}s linear forwards; }
@keyframes snlg-fill { to { transform: scaleX(1); } }
@media (max-width: 749px) { #{{ sid }} .snlg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } #{{ sid }} .snlg__cell .snlg__item { min-height: 96px; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var p = r.querySelector('[data-snlg]'); if (!p) return;
  var ts = [].slice.call(p.querySelectorAll('[data-snlg-t]')), i = 0, t = null, dur = {{ s.speed | divided_by: 6 | times: 1000 }};
  function go(n) {
    i = (n + ts.length) % ts.length;
    ts.forEach(function (b, k) { b.classList.toggle('is-on', k === i); b.setAttribute('aria-selected', String(k === i)); });
    [].forEach.call(p.querySelectorAll('[data-snlg-q]'), function (q) { q.classList.toggle('is-on', +q.getAttribute('data-snlg-q') === i); });
    clearTimeout(t); t = setTimeout(function () { go(i + 1); }, dur);
  }
  ts.forEach(function (b, k) { b.addEventListener('click', function () { go(k); }); });
  document.addEventListener('shopify:block:select', function (e) { var k = ts.indexOf(e.target); if (k > -1) go(k); });
  go(0);
})();
</script>
{% schema %}
{
