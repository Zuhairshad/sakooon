{%- comment -%}
  Editorial grid / campaign tiles. Owner: shad-2d.
  Patterns: Parachute split campaign tiles (2 columns, 8px gap, 24px gutters, ~3:4, copy over the image bottom-left)
  and Tekla 2-up/4-up (full bleed, 2px gap, 4:5, caption below). Mobile: stack or horizontal scroll.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  case s.image_ratio
    when 'portrait'
      assign aspect = '3/4'
    when 'tall'
      assign aspect = '4/5'
    when 'square'
      assign aspect = '1/1'
    when 'landscape'
      assign aspect = '4/3'
    else
      assign aspect = 'natural'
  endcase
  assign col_vw = 100 | divided_by: s.columns
  assign sizes = '(min-width: 1024px) ' | append: col_vw | append: 'vw, (min-width: 768px) 50vw, 100vw'
-%}
<div class="section editorial-grid editorial-grid--{{ s.caption_position }} editorial-grid--mobile-{{ s.mobile_layout }}{% if s.full_bleed %} editorial-grid--bleed{% endif %} color-scheme-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --tile-columns: {{ s.columns }}; --tile-gap: {{ s.gap }}px;">
  <div class="page-width{% if s.full_bleed %} full-bleed{% else %} page-width--full{% endif %}">
    {%- if s.heading != blank -%}
      <div class="editorial-grid__head{% if s.full_bleed %} page-width page-width--full{% endif %}">{%- render 'section-heading', heading: s.heading, heading_size: s.heading_size -%}</div>
    {%- endif -%}
    <ul class="editorial-grid__list list-unstyled{% if s.mobile_layout == 'scroll' %} no-scrollbar{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li class="editorial-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="editorial-grid__link" href="{{ block.settings.link }}">{%- else -%}<div class="editorial-grid__link">{%- endif -%}
            <div class="media editorial-grid__media{% if block.settings.image == blank %} editorial-grid__media--placeholder{% endif %}"{% if aspect != 'natural' %} style="--aspect: {{ aspect }}"{% endif %}>
              {%- render 'image', image: block.settings.image, sizes: sizes, aspect: aspect, placeholder: 'lifestyle-1', class: 'editorial-grid__img' -%}
            </div>
            {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
              <div class="editorial-grid__copy{% if s.caption_position == 'overlay' and block.settings.image != blank %} editorial-grid__copy--{{ s.text_color }}{% endif %}">
                {%- if block.settings.heading != blank -%}<h3 class="editorial-grid__heading {{ s.tile_heading_size }}">{{ block.settings.heading | escape }}</h3>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="editorial-grid__text rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank -%}<span class="button button--small editorial-grid__button">{{ block.settings.button_label | escape }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Campaign tiles",
  "tag": "section",
  "class": "section-editorial-grid",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h3", "options": [ { "value": "h2", "label": "t:sections.all.heading_size.options.h2" }, { "value": "h3", "label": "t:sections.all.heading_size.options.h3" } ] },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 2 },
    { "type": "select", "id": "gap", "label": "Gap", "default": "8", "options": [ { "value": "0", "label": "None" }, { "value": "2", "label": "Hairline" }, { "value": "8", "label": "Small" }, { "value": "16", "label": "Medium" } ] },
    { "type": "checkbox", "id": "full_bleed", "label": "Full width", "default": false },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait 3:4" }, { "value": "tall", "label": "Portrait 4:5" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape 4:3" }, { "value": "adapt", "label": "Adapt to image" } ] },
    { "type": "select", "id": "caption_position", "label": "Text position", "default": "overlay", "options": [ { "value": "overlay", "label": "Over the image, bottom left" }, { "value": "below", "label": "Below the image" } ] },
    { "type": "select", "id": "text_color", "label": "Text over images", "default": "light", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "select", "id": "tile_heading_size", "label": "Tile heading size", "default": "h2", "options": [ { "value": "h2", "label": "Large" }, { "value": "h4", "label": "Small" }, { "value": "text-body", "label": "Caption" } ] },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "stack", "options": [ { "value": "stack", "label": "Stack" }, { "value": "scroll", "label": "Swipe" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "white" },
    { "type": "header", "content": "t:sections.all.padding.header" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.padding.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.padding.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tile", "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Campaign headline" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Campaign tiles", "blocks": [ { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
