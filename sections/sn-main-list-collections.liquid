{%- liquid
  assign s = section.settings
  assign sid = 'snlc-' | append: section.id
  assign arts = 'bed-sheet,duvet,duvet-cover,towel,pillow,pillow-cover,bed-cover,bed' | split: ','
  case s.sort
    when 'alpha'
      assign list = collections | sort: 'title'
    when 'count'
      assign list = collections | sort: 'all_products_count' | reverse
    else
      assign list = collections
  endcase
-%}
<section id="{{ sid }}" class="sn-s snlc" style="{% render 'sn-vars', s: s %}">
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 2, tag: 'h1' %}
    <div class="snlc__grid" style="--cols: {{ s.columns }};">
      {%- for c in list -%}
        {%- if c.handle == 'all' or c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {%- assign ai = forloop.index0 | modulo: 8 -%}
        {%- assign big = forloop.index0 | modulo: 5 -%}
        <a class="snlc__card{% if s.mosaic and big == 0 %} is-big{% endif %}" href="{{ c.url }}" data-r="rise" style="--i: {{ forloop.index0 | modulo: 6 }};">
          {%- assign cimg = c.image | default: c.featured_image -%}
          {% render 'sn-media', image: cimg, art: arts[ai], width: 1200, sizes: '(min-width: 990px) 33vw, 50vw', class: 'snlc__m sn-ripple' %}
          <span class="snlc__shade"></span>
          <span class="snlc__txt">
            <span class="snlc__cnt">{{ c.all_products_count }} {{ s.items_label }}</span>
            <b class="sn-h sn-h--s">{{ c.title }}</b>
            <span class="snlc__go"><i></i>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
#{{ sid }} .snlc__grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); grid-auto-rows: clamp(260px, 26vw, 380px); grid-auto-flow: dense; gap: clamp(12px, 1.6vw, 22px); }
#{{ sid }} .snlc__card { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: end; border-radius: calc(var(--r) * 1.1); color: #fff; }
#{{ sid }} .snlc__card.is-big { grid-column: span 2; grid-row: span 2; }
#{{ sid }} .snlc__m { position: absolute; inset: 0; z-index: -2; border-radius: 0; }
#{{ sid }} .snlc__card:hover .snlc__m img, #{{ sid }} .snlc__card:hover .snlc__m .sn-art { transform: scale(1.07); }
#{{ sid }} .snlc__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, color-mix(in srgb, var(--c-dark) 70%, transparent), transparent 55%); transition: opacity .6s; }
#{{ sid }} .snlc__txt { display: grid; gap: 6px; padding: clamp(18px, 2.4vw, 30px); }
#{{ sid }} .snlc__cnt { font-size: 10.5px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--c-moon); }
#{{ sid }} .snlc__card.is-big .sn-h { font-size: clamp(1.8rem, 3vw, 2.8rem); }
#{{ sid }} .snlc__go { display: flex; align-items: center; gap: 0; height: 20px; margin-top: 4px; }
#{{ sid }} .snlc__go i { width: 0; height: 1px; border-top: 1px dashed currentColor; transition: width .7s cubic-bezier(.3, .8, .2, 1); }
#{{ sid }} .snlc__go .icon { width: 18px; height: 18px; opacity: .6; transition: opacity .4s, transform .6s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} .snlc__card:hover .snlc__go i { width: 60px; }
#{{ sid }} .snlc__card:hover .snlc__go .icon { opacity: 1; transform: translateX(4px); }
@media (max-width: 989px) { #{{ sid }} .snlc__grid { --cols: 2 !important; grid-auto-rows: 240px; } }
@media (max-width: 599px) { #{{ sid }} .snlc__grid { grid-auto-rows: 200px; gap: 10px; } #{{ sid }} .snlc__card.is-big { grid-column: span 2; grid-row: span 1; } }
</style>
{% schema %}
{
  "name": "All collections",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Shop by room"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every corner of"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "your sleep"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "head_size",
      "label": "Heading size",
      "options": [
        {
          "value": "s",
          "label": "Small"
        },
        {
          "value": "m",
          "label": "Medium"
        },
        {
          "value": "l",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "l"
    },
    {
      "type": "select",
      "id": "head_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Order",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "alpha",
          "label": "Alphabetical"
        },
        {
          "value": "count",
          "label": "Most products"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "mosaic",
      "label": "Mosaic (some cards larger)",
      "default": true
    },
    {
      "type": "text",
      "id": "items_label",
      "label": "Products label",
      "default": "pieces"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ]
}
{% endschema %}
