{%- comment -%} STUB handed to shad-2d. Replace entirely. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="announcement-bar color-scheme-{{ section.settings.color_scheme }} text-small" data-announcement role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="page-width announcement-bar__inner">
    {%- for block in section.blocks -%}
      <p class="announcement-bar__message" {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{% else %}{{ block.settings.text | escape }}{% endif %}</p>
      {%- break -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% style %}
  .announcement-bar { border-bottom: var(--border-width) solid var(--color-border); }
  .announcement-bar__inner { display: flex; justify-content: center; align-items: center; min-height: 40px; }
  .announcement-bar__message a { text-decoration: none; }
{% endstyle %}
{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "section-announcement",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "ink" }
  ],
  "blocks": [
    { "type": "announcement", "name": "Announcement", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free delivery on orders over a threshold" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
