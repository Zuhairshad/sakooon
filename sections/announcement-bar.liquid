{%- comment -%}
  Announcement bar. Owner: shad-2d. One message, or several rotating in place (crossfade, all stacked in one grid
  cell so the bar never changes height). Rotation pauses on hover/focus, has a pause button (WCAG 2.2.2), and is
  off under reduced motion. Optional dismiss for the session.
{%- endcomment -%}
{%- liquid
  assign count = section.blocks.size
  assign controls = false
  if count > 1 or section.settings.dismissible
    assign controls = true
  endif
-%}
{%- if count > 0 -%}
<announcement-bar
  class="announcement-bar color-scheme-{{ section.settings.color_scheme }}{% if controls %} announcement-bar--controls{% endif %}"
  data-announcement
  data-key="{{ section.id }}"
  data-speed="{{ section.settings.speed }}"
  {% if section.settings.autoplay and count > 1 %}data-autoplay{% endif %}
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  style="--announcement-align: {{ section.settings.align }}"
>
  <div class="announcement-bar__inner">
    {%- if count > 1 -%}
      <div class="announcement-bar__controls">
        <button type="button" class="announcement-bar__button" data-announcement-prev aria-label="{{ 'storefront.announcement.previous' | t }}">{% render 'icon', icon: 'chevron-left', size: 16 %}</button>
        <button type="button" class="announcement-bar__button" data-announcement-next aria-label="{{ 'storefront.announcement.next' | t }}">{% render 'icon', icon: 'chevron-right', size: 16 %}</button>
      </div>
    {%- elsif controls -%}
      <span aria-hidden="true"></span>
    {%- endif -%}
    <div class="announcement-bar__slides" aria-live="off">
      {%- for block in section.blocks -%}
        <p class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" data-slide{% unless forloop.first %} aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}"{% unless forloop.first %} tabindex="-1"{% endunless %}>{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    {%- if controls -%}
      <div class="announcement-bar__controls">
        {%- if count > 1 and section.settings.autoplay -%}
          <button type="button" class="announcement-bar__button" data-announcement-toggle aria-pressed="false"
            aria-label="{{ 'storefront.announcement.pause' | t }}" data-label-pause="{{ 'storefront.announcement.pause' | t }}" data-label-play="{{ 'storefront.announcement.play' | t }}">
            <span data-icon="pause">{% render 'icon', icon: 'pause', size: 14 %}</span><span data-icon="play" hidden>{% render 'icon', icon: 'play', size: 14 %}</span>
          </button>
        {%- endif -%}
        {%- if section.settings.dismissible -%}
          <button type="button" class="announcement-bar__button" data-announcement-dismiss aria-label="{{ 'storefront.announcement.dismiss' | t }}">{% render 'icon', icon: 'close', size: 16 %}</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</announcement-bar>
{%- if section.settings.dismissible -%}
  <script>
    try { if (sessionStorage.getItem('announcement-dismissed:{{ section.id }}')) document.getElementById('shopify-section-{{ section.id }}').hidden = true; } catch (e) {}
  </script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "sand" },
    {
      "type": "select", "id": "align", "label": "Text alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ]
    },
    { "type": "checkbox", "id": "autoplay", "label": "Rotate messages", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "dismissible", "label": "Show close button", "default": false, "info": "Hidden for the rest of the visit once closed." }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Sukoon means calm" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "t:sections.announcement-bar.name", "blocks": [ { "type": "announcement" } ] } ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
