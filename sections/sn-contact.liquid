{%- liquid
  assign s = section.settings
  assign sid = 'snct-' | append: section.id
  assign fid = 'SnContact-' | append: section.id
  assign topics = s.topics | split: ','
  assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
-%}
<section id="{{ sid }}" class="sn-s snct" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 3 %}
    <div class="snct__grid">
      <aside class="snct__info" data-r="unfold" data-sn-silk-host>
        {%- if s.silk -%}<div class="sn-silk" data-sn-silk data-c1="{{ settings.color_dark_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ settings.color_moon }}" data-speed=".45" data-amp=".7" data-quality="low"></div>{%- endif -%}
        <div data-sn-feathers="18" data-color="{{ settings.color_moon }}" style="position:absolute;inset:0;z-index:0"></div>
        <div class="snct__iin">
          {%- if s.info_title != blank -%}<p class="sn-h sn-h--s">{{ s.info_title }}</p>{%- endif -%}
          <ul class="snct__ch">
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              {%- liquid
                assign href = b.link
                if block.type == 'whatsapp'
                  assign num = b.value | default: settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
                  assign href = 'https://wa.me/' | append: num
                elsif block.type == 'phone'
                  assign pv = b.value | default: settings.phone | remove: ' '
                  assign href = 'tel:' | append: pv
                elsif block.type == 'email'
                  assign ev = b.value | default: settings.email
                  assign href = 'mailto:' | append: ev
                endif
                assign shown = b.value
                if shown == blank and block.type == 'whatsapp'
                  assign shown = settings.whatsapp
                elsif shown == blank and block.type == 'phone'
                  assign shown = settings.phone
                elsif shown == blank and block.type == 'email'
                  assign shown = settings.email
                endif
                case block.type
                  when 'whatsapp'
                    assign ic = 'whatsapp'
                  when 'phone'
                    assign ic = 'phone'
                  when 'email'
                    assign ic = 'mail'
                  else
                    assign ic = b.icon
                endcase
              -%}
              <li style="--i: {{ forloop.index0 }};" data-r {{ block.shopify_attributes }}>
                <a {% if href != blank %}href="{{ href }}"{% if block.type == 'whatsapp' %} target="_blank" rel="noopener"{% endif %}{% endif %} class="snct__c">
                  <span class="snct__ic">{% render 'sn-icon', name: ic, class: 'icon' %}</span>
                  <span><small>{{ b.label }}</small><b>{{ shown }}</b>{% if b.note != blank %}<em>{{ b.note }}</em>{% endif %}</span>
                  {%- if href != blank -%}{% render 'sn-icon', name: 'arrow-up-right', class: 'icon snct__go' %}{%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
          {%- if s.map_query != blank -%}
            <div class="snct__map"><iframe title="Map" loading="lazy" src="https://maps.google.com/maps?q={{ s.map_query | url_encode }}&z=14&output=embed"></iframe></div>
          {%- endif -%}
        </div>
      </aside>
      <div class="snct__form sn-pillow sn-stitch" data-r="rise" style="--i: 2;">
        {%- form 'contact', id: fid -%}
          {%- if form.posted_successfully? -%}
            <div class="snct__ok" role="status">
              <svg viewBox="0 0 60 60" aria-hidden="true"><circle cx="30" cy="30" r="27" pathLength="100"/><path d="m19 31 8 8 15-17" pathLength="100"/></svg>
              <p class="sn-h sn-h--s">{{ s.ok_title }}</p><p class="sn-small">{{ s.ok_text }}</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}<p class="sn-msg sn-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
            {%- if s.form_title != blank -%}<p class="sn-h sn-h--s snct__ft">{{ s.form_title }}</p>{%- endif -%}
            {%- if topics.size > 0 and s.topics != blank -%}
              <fieldset class="snct__topics"><legend class="sr">{{ s.topic_label }}</legend>
                {%- for t in topics -%}{%- assign tt = t | strip -%}
                  <label class="snct__topic"><input type="radio" name="contact[Topic]" value="{{ tt | escape }}"{% if forloop.first %} checked{% endif %}><span>{{ tt }}</span></label>
                {%- endfor -%}
              </fieldset>
            {%- endif -%}
            <div class="snct__row">
              <div class="sn-field snct__fl"><input class="sn-input" id="{{ fid }}-n" type="text" name="contact[name]" placeholder=" " autocomplete="name" value="{{ form.name }}"><label for="{{ fid }}-n">{{ s.l_name }}</label></div>
              <div class="sn-field snct__fl"><input class="sn-input" id="{{ fid }}-p" type="tel" name="contact[phone]" placeholder=" " autocomplete="tel" value="{{ form.phone }}"><label for="{{ fid }}-p">{{ s.l_phone }}</label></div>
            </div>
            <div class="sn-field snct__fl"><input class="sn-input" id="{{ fid }}-e" type="email" name="contact[email]" placeholder=" " autocomplete="email" required value="{{ form.email }}"><label for="{{ fid }}-e">{{ s.l_email }} *</label></div>
            {%- if s.order_field -%}<div class="sn-field snct__fl"><input class="sn-input" id="{{ fid }}-o" type="text" name="contact[Order number]" placeholder=" "><label for="{{ fid }}-o">{{ s.l_order }}</label></div>{%- endif -%}
            <div class="sn-field snct__fl"><textarea class="sn-textarea" id="{{ fid }}-m" name="contact[body]" placeholder=" " required>{{ form.body }}</textarea><label for="{{ fid }}-m">{{ s.l_msg }} *</label></div>
            <button type="submit" class="sn-btn sn-btn--gold sn-btn--block"><span>{{ s.btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
            {%- if s.note != blank -%}<p class="sn-small snct__note">{{ s.note }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snct__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(18px, 2.6vw, 34px); align-items: stretch; }
#{{ sid }} .snct__info { position: relative; isolation: isolate; overflow: hidden; border-radius: calc(var(--r) * 1.2); background: {{ settings.color_dark_bg }}; color: {{ settings.color_dark_text }}; --tx: {{ settings.color_dark_text }}; --soft: color-mix(in srgb, {{ settings.color_dark_text }} 70%, transparent); --ac: {{ settings.color_moon }}; --ac-aa: {{ settings.color_moon }}; --line: rgba(255,255,255,.14); }
#{{ sid }} .snct__iin { position: relative; z-index: 1; display: grid; gap: 22px; padding: clamp(26px, 3.4vw, 46px); }
#{{ sid }} .snct__ch { display: grid; gap: 4px; }
#{{ sid }} .snct__c { display: flex; align-items: center; gap: 16px; padding: 16px 14px; margin-inline: -14px; border-radius: calc(var(--r) * .7); transition: background .4s; }
#{{ sid }} a.snct__c[href]:hover { background: rgba(255,255,255,.07); }
#{{ sid }} .snct__ic { width: 48px; height: 48px; flex: none; display: grid; place-items: center; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--ac) 45%, transparent); color: var(--ac); transition: background .4s, color .4s, transform .6s cubic-bezier(.3, 1.5, .5, 1); }
#{{ sid }} .snct__ic .icon { width: 20px; height: 20px; }
#{{ sid }} a.snct__c[href]:hover .snct__ic { background: var(--ac); color: {{ settings.color_dark_bg }}; transform: rotate(-10deg); }
#{{ sid }} .snct__c > span:nth-child(2) { flex: 1; display: grid; gap: 2px; min-width: 0; }
#{{ sid }} .snct__c small { font-size: 10.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snct__c b { font: 400 1.12rem/1.3 var(--f-head); overflow-wrap: anywhere; }
#{{ sid }} .snct__c em { font-style: normal; font-size: 12.5px; color: var(--soft); }
#{{ sid }} .snct__go { width: 18px; height: 18px; color: var(--ac); opacity: 0; transform: translate(-6px, 6px); transition: opacity .4s, transform .5s cubic-bezier(.3, 1.4, .5, 1); }
#{{ sid }} a.snct__c[href]:hover .snct__go { opacity: 1; transform: none; }
#{{ sid }} .snct__map { border-radius: calc(var(--r) * .8); overflow: hidden; aspect-ratio: 16 / 9; filter: grayscale(.6) invert(.9) hue-rotate(190deg) contrast(.85); }
#{{ sid }} .snct__map iframe { width: 100%; height: 100%; border: 0; }
#{{ sid }} .snct__form { padding: clamp(24px, 3.4vw, 46px); }
#{{ sid }} .snct__form form { display: grid; gap: 16px; }
#{{ sid }} .snct__ft { margin-bottom: 4px; }
#{{ sid }} .snct__topics { display: flex; flex-wrap: wrap; gap: 8px; border: 0; margin: 0 0 6px; padding: 0; }
#{{ sid }} .snct__topic input { position: absolute; opacity: 0; pointer-events: none; }
#{{ sid }} .snct__topic span { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line2); font-size: 13.5px; cursor: pointer; transition: background .35s, color .35s, border-color .35s; }
#{{ sid }} .snct__topic input:checked + span { background: var(--tx); color: var(--bg); border-color: var(--tx); }
#{{ sid }} .snct__topic input:focus-visible + span { outline: 2px solid var(--ac); outline-offset: 2px; }
#{{ sid }} .snct__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
#{{ sid }} .snct__fl { position: relative; display: block; }
#{{ sid }} .snct__fl label { position: absolute; left: 20px; top: 17px; pointer-events: none; text-transform: none; letter-spacing: .01em; font-size: 15px; font-weight: 400; color: var(--mute); transform-origin: 0 0; transition: transform .35s cubic-bezier(.3, .8, .3, 1), color .35s; }
#{{ sid }} .snct__fl .sn-input, #{{ sid }} .snct__fl .sn-textarea { padding-top: 24px; padding-bottom: 8px; }
#{{ sid }} .snct__fl :is(input, textarea):focus + label, #{{ sid }} .snct__fl :is(input, textarea):not(:placeholder-shown) + label { transform: translateY(-11px) scale(.72); color: var(--ac); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
#{{ sid }} .snct__note { text-align: center; }
#{{ sid }} .snct__ok { display: grid; justify-items: center; gap: 12px; padding: 40px 0; text-align: center; }
#{{ sid }} .snct__ok svg { width: 70px; height: 70px; }
#{{ sid }} .snct__ok circle, #{{ sid }} .snct__ok path { fill: none; stroke: var(--ac); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 100; animation: snct-draw 1.4s cubic-bezier(.6, 0, .2, 1) both; }
#{{ sid }} .snct__ok path { animation-delay: .6s; }
@keyframes snct-draw { from { stroke-dashoffset: 100; } }
@media (max-width: 899px) { #{{ sid }} .snct__grid { grid-template-columns: 1fr; } #{{ sid }} .snct__row { grid-template-columns: 1fr; } }
</style>
