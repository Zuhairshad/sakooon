{%- liquid
  assign s = section.settings
  assign sid = 'snwl-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snwl" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    <div class="snwl__head">
      {% render 'sn-head', s: s, k: 4 %}
      <div class="snwl__tools" data-snwl-tools hidden>
        <span class="snwl__count"><b data-sn-wish-count>0</b> {{ s.count_label }}</span>
        <button type="button" class="sn-btn sn-btn--sm sn-btn--ghost" data-snwl-share><span>{{ s.share_label }}</span>{% render 'sn-icon', name: 'share', class: 'icon' %}</button>
        <button type="button" class="sn-btn sn-btn--sm sn-btn--ghost" data-snwl-clear><span>{{ s.clear_label }}</span>{% render 'sn-icon', name: 'trash', class: 'icon' %}</button>
      </div>
    </div>
    <div class="sn-grid snwl__grid" style="--cols: {{ s.columns }};" data-snwl-out>
      {%- for i in (1..4) -%}<div class="snwl__sk" aria-hidden="true"><i></i><b></b></div>{%- endfor -%}
    </div>
    <div class="snwl__empty" data-snwl-empty hidden>
      <div class="snwl__heart" aria-hidden="true">
        <svg viewBox="0 0 120 120"><path pathLength="1" d="M60 100S18 74 18 44a22 22 0 0 1 42-9 22 22 0 0 1 42 9c0 30-42 56-42 56Z"/></svg>
        {% render 'sn-phase', k: 1 %}
      </div>
      <p class="sn-h sn-h--m">{{ s.empty_title }}</p>
      <p class="sn-lead">{{ s.empty_text }}</p>
      <a class="sn-btn sn-btn--gold" href="{{ s.empty_link | default: routes.all_products_collection_url }}"><span>{{ s.empty_btn }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snwl__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(30px, 4vw, 54px); }
#{{ sid }} .snwl__head .sn-head { margin: 0; }
#{{ sid }} .snwl__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
#{{ sid }} .snwl__count { margin-right: 10px; font-size: 13px; color: var(--soft); }
#{{ sid }} .snwl__count b { font: 400 1.6rem var(--f-head); color: var(--ac); }
#{{ sid }} .snwl__sk { display: grid; gap: 12px; }
#{{ sid }} .snwl__sk i { aspect-ratio: 4 / 5; border-radius: var(--r); background: linear-gradient(100deg, var(--card2) 40%, color-mix(in srgb, var(--card2) 50%, #fff) 50%, var(--card2) 60%) 0 0 / 300% 100%; animation: snwl-sh 1.6s linear infinite; }
#{{ sid }} .snwl__sk b { height: 12px; width: 60%; border-radius: 6px; background: var(--card2); }
@keyframes snwl-sh { to { background-position: -150% 0; } }
#{{ sid }} .snwl__grid .sn-card.is-gone { animation: snwl-out .6s cubic-bezier(.6, 0, .4, 1) forwards; }
@keyframes snwl-out { to { opacity: 0; transform: scale(.85) rotate(-3deg); filter: blur(6px); } }
#{{ sid }} .snwl__empty { display: grid; justify-items: center; gap: 16px; padding: 40px 0 20px; text-align: center; }
#{{ sid }} .snwl__heart { position: relative; width: 130px; height: 130px; display: grid; place-items: center; color: var(--ac); }
#{{ sid }} .snwl__heart svg { position: absolute; inset: 0; width: 100%; height: 100%; }
#{{ sid }} .snwl__heart path { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-dasharray: .02 .02; animation: snwl-draw 3s linear infinite; }
@keyframes snwl-draw { to { stroke-dashoffset: -.4; } }
#{{ sid }} .snwl__heart .sn-ph { width: 30px; height: 30px; animation: snwl-float 4s ease-in-out infinite; }
@keyframes snwl-float { 50% { transform: translateY(-6px) rotate(-10deg); } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var out = r.querySelector('[data-snwl-out]'), empty = r.querySelector('[data-snwl-empty]'), tools = r.querySelector('[data-snwl-tools]');
  SN.ready(function () {
    var shared = new URLSearchParams(location.search).get('wish');
    if (shared) { var add = shared.split(',').filter(Boolean), cur = SN.wish.get(); add.forEach(function (h) { if (cur.indexOf(h) < 0) cur.push(h); }); SN.wish.set(cur); }
    function render() {
      var list = SN.wish.get();
      if (!list.length) { out.innerHTML = ''; out.hidden = true; empty.hidden = false; tools.hidden = true; SN.reveal(empty); return; }
      tools.hidden = false;
      Promise.all(list.map(function (h) { return SN.product(h).catch(function () { return null; }); })).then(function (ps) {
        var ok = ps.filter(Boolean);
        if (!ok.length) { out.hidden = true; empty.hidden = false; return; }
        out.innerHTML = ok.map(SN.cardHTML).join(''); [].forEach.call(out.children, function (c, i) { c.setAttribute('data-r', 'rise'); c.style.setProperty('--i', i); });
        SN.reveal(out); SN.wish.paint();
      });
    }
    render();
    out.addEventListener('click', function (e) {
      var b = e.target.closest('[data-sn-wish]'); if (!b) return;
      setTimeout(function () { if (!SN.wish.has(b.getAttribute('data-sn-wish'))) { var c = b.closest('.sn-card'); c.classList.add('is-gone'); setTimeout(function () { c.remove(); if (!SN.wish.get().length) render(); }, 600); } }, 10);
    });
    r.querySelector('[data-snwl-clear]').addEventListener('click', function () { SN.wish.set([]); render(); });
    r.querySelector('[data-snwl-share]').addEventListener('click', function () {
      var u = location.origin + location.pathname + '?wish=' + SN.wish.get().join(',');
      if (navigator.share) navigator.share({ title: document.title, url: u }).catch(function () {});
      else if (navigator.clipboard) navigator.clipboard.writeText(u).then(function () { SN.toast({{ s.copied | json }}, 'heart'); });
    });
  });
})();
</script>
{% schema %}
{
  "name": "Wishlist",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
