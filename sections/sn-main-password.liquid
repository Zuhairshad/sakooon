{%- liquid
  assign s = section.settings
  assign sid = 'snpw-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snpw" style="{% render 'sn-vars', s: s %}" data-sn-silk-host>
  <div class="sn-silk" data-sn-silk data-c1="{{ settings.color_dark_bg }}" data-c2="{{ settings.color_dusk }}" data-c3="{{ settings.color_moon }}" data-speed=".45" data-amp="1"></div>
  <div data-sn-feathers="50" data-color="{{ settings.color_moon }}" style="position:absolute;inset:0;z-index:0"></div>
  <header class="snpw__top">
    <span class="snpw__logo">{%- if settings.logo_light != blank -%}<img src="{{ settings.logo_light | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" height="60">{%- else -%}{% render 'sn-logo', color: settings.color_moon %}{%- endif -%}</span>
    <button type="button" class="snpw__key" data-snpw-open>{% render 'sn-icon', name: 'lock', class: 'icon' %}<span>{{ s.owner_label }}</span></button>
  </header>
  <div class="snpw__in">
    <div class="snpw__orb" aria-hidden="true"><i></i></div>
    <p class="sn-eyebrow" data-r>{% render 'sn-phase', k: 1 %}{{ s.eyebrow }}</p>
    <h1 class="sn-h sn-h--xl" data-sn-split>{{ s.heading }} <em>{{ s.highlight }}</em></h1>
    {%- if shop.password_message != blank -%}<p class="sn-lead" data-r style="--i: 2;">{{ shop.password_message }}</p>{%- elsif s.text != blank -%}<p class="sn-lead" data-r style="--i: 2;">{{ s.text }}</p>{%- endif -%}
    {%- if s.launch != blank -%}
      <div class="snpw__cd" data-sn-countdown="{{ s.launch }}" data-r style="--i: 3;">
        <div><b data-d>00</b><small>{{ s.l_d }}</small></div><div><b data-h>00</b><small>{{ s.l_h }}</small></div><div><b data-m>00</b><small>{{ s.l_m }}</small></div><div><b data-s>00</b><small>{{ s.l_s }}</small></div>
      </div>
    {%- endif -%}
    <div class="snpw__form" data-r style="--i: 4;">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,launch">
        {%- if form.posted_successfully? -%}
          <p class="sn-msg">{{ s.ok_text }}</p>
        {%- else -%}
          <div class="sn-pill-form"><input type="email" name="contact[email]" required placeholder="{{ s.placeholder | escape }}" aria-label="{{ s.placeholder | escape }}"><button class="sn-btn sn-btn--gold sn-btn--sm" type="submit"><span>{{ s.btn }}</span></button></div>
          {%- if form.errors -%}<p class="sn-msg sn-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank -%}
      <div class="snpw__soc" data-r style="--i: 5;">
        {%- if settings.social_instagram != blank -%}<a class="sn-ibtn sn-ibtn--sm" href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'sn-icon', name: 'instagram', class: 'icon' %}</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a class="sn-ibtn sn-ibtn--sm" href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'sn-icon', name: 'facebook', class: 'icon' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a class="sn-ibtn sn-ibtn--sm" href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'sn-icon', name: 'tiktok', class: 'icon' %}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="snpw__ov" data-snpw-ov hidden>
    <div class="snpw__bg" data-snpw-close></div>
    <div class="snpw__box sn-pillow sn-stitch" role="dialog" aria-modal="true" aria-label="{{ s.owner_label | escape }}">
      <button type="button" class="sn-ibtn sn-ibtn--sm snpw__x" data-snpw-close aria-label="Close">{% render 'sn-icon', name: 'close', class: 'icon' %}</button>
      <p class="sn-h sn-h--s">{{ s.pw_title }}</p>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="sn-msg sn-msg--err" data-snpw-err>{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="sn-field"><label for="{{ sid }}-pw">{{ s.pw_label }}</label><input class="sn-input" id="{{ sid }}-pw" type="password" name="password" autocomplete="current-password" required></div>
        <button class="sn-btn sn-btn--block" type="submit"><span>{{ s.enter_label }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button>
      {%- endform -%}
      <p class="sn-small">{{ s.admin_text }} <a href="/admin" class="sn-link">{{ s.admin_link }}</a></p>
    </div>
  </div>
</section>
<style>
#{{ sid }} { min-height: 100svh; display: grid; grid-template-rows: auto 1fr; padding: 0; overflow: hidden; background: {{ settings.color_dark_bg }}; color: {{ settings.color_dark_text }}; --tx: {{ settings.color_dark_text }}; --soft: color-mix(in srgb, {{ settings.color_dark_text }} 72%, transparent); --ac: {{ settings.color_moon }}; --line2: rgba(255,255,255,.26); }
#{{ sid }} .snpw__top { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px clamp(16px, 4vw, 48px); }
#{{ sid }} .snpw__logo { display: block; width: 170px; color: var(--ac); }
#{{ sid }} .snpw__logo svg, #{{ sid }} .snpw__logo img { width: 100%; height: auto; }
#{{ sid }} .snpw__key { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.24); font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; transition: background .4s, color .4s; }
#{{ sid }} .snpw__key:hover { background: var(--ac); color: {{ settings.color_dark_bg }}; }
#{{ sid }} .snpw__key .icon { width: 15px; height: 15px; }
#{{ sid }} .snpw__in { position: relative; z-index: 2; display: grid; justify-items: center; align-content: center; gap: 22px; width: min(820px, calc(100% - 32px)); margin: 0 auto; padding: 20px 0 80px; text-align: center; }
#{{ sid }} .snpw__in .sn-lead { margin-inline: auto; }
#{{ sid }} .snpw__orb { position: relative; width: 120px; height: 120px; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 34% 32%, #fff, var(--c-moon) 50%, color-mix(in srgb, var(--c-moon) 60%, #5d4a2a)); box-shadow: 0 0 60px color-mix(in srgb, var(--c-moon) 60%, transparent), 0 0 160px color-mix(in srgb, var(--c-moon) 30%, transparent); }
#{{ sid }} .snpw__orb i { position: absolute; inset: -2px; border-radius: 50%; background: {{ settings.color_dark_bg }}; animation: snpw-wax 8s cubic-bezier(.6, 0, .4, 1) infinite alternate; }
@keyframes snpw-wax { from { transform: translateX(-10%); } to { transform: translateX(104%); } }
#{{ sid }} .snpw__cd { display: flex; gap: 10px; }
#{{ sid }} .snpw__cd div { display: grid; gap: 4px; min-width: 76px; padding: 14px 6px; border-radius: 18px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); }
#{{ sid }} .snpw__cd b { font: 300 2.4rem/1 var(--f-head); font-variant-numeric: tabular-nums; }
#{{ sid }} .snpw__cd b.is-tick { animation: snpr-tick2 .7s cubic-bezier(.2, .8, .2, 1); }
@keyframes snpr-tick2 { from { opacity: 0; transform: translateY(-30%); filter: blur(5px); } }
#{{ sid }} .snpw__cd small { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snpw__form { width: min(500px, 100%); }
#{{ sid }} .snpw__form .sn-pill-form { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.22); }
#{{ sid }} .snpw__form input { color: #fff; }
#{{ sid }} .snpw__soc { display: flex; gap: 8px; }
#{{ sid }} .snpw__soc .sn-ibtn { border-color: rgba(255,255,255,.24); color: #fff; }
#{{ sid }} .snpw__ov { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 16px; }
#{{ sid }} .snpw__bg { position: absolute; inset: 0; background: rgba(8, 10, 20, .6); backdrop-filter: blur(8px); }
#{{ sid }} .snpw__box { position: relative; display: grid; gap: 18px; width: min(420px, 100%); padding: 32px; background: var(--c-surface); color: var(--c-ink); --tx: var(--c-ink); --soft: var(--c-ink-soft); --ac: var(--c-accent); --line2: color-mix(in srgb, var(--c-ink) 22%, transparent); --card: var(--c-surface); --bg: var(--c-surface); animation: snpw-in .7s cubic-bezier(.2, 1.1, .3, 1); }
#{{ sid }} .snpw__box form { display: grid; gap: 14px; }
#{{ sid }} .snpw__x { position: absolute; right: 14px; top: 14px; }
@keyframes snpw-in { from { opacity: 0; transform: translateY(30px) scale(.95); } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var ov = r.querySelector('[data-snpw-ov]');
  r.addEventListener('click', function (e) { if (e.target.closest('[data-snpw-open]')) { ov.hidden = false; setTimeout(function () { var i = ov.querySelector('input[type=password]'); if (i) i.focus(); }, 100); } if (e.target.closest('[data-snpw-close]')) ov.hidden = true; });
  if (r.querySelector('[data-snpw-err]')) ov.hidden = false;
})();
</script>
{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Opening soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something soft"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading, italic part",
      "default": "is on its way"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text (if no store message)",
      "default": "Luxury bedding and bath, made for Pakistani nights. Be the first to know when we open."
    },
    {
      "type": "text",
      "id": "launch",
      "label": "Launch date",
      "info": "Format 2026-12-01T10:00:00+05:00. Empty hides the countdown."
    },
    {
      "type": "text",
      "id": "l_d",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "l_h",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "l_m",
      "label": "Minutes label",
      "default": "Mins"
    },
    {
      "type": "text",
      "id": "l_s",
      "label": "Seconds label",
      "default": "Secs"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "ok_text",
      "label": "Success text",
      "default": "You're on the list. Sweet dreams until then."
    },
    {
      "type": "text",
      "id": "owner_label",
      "label": "Owner button",
      "default": "Enter store"
    },
    {
      "type": "text",
      "id": "pw_title",
      "label": "Password title",
      "default": "Enter with password"
    },
    {
      "type": "text",
      "id": "pw_label",
      "label": "Password label",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "enter_label",
      "label": "Enter button",
      "default": "Enter"
    },
    {
      "type": "text",
      "id": "admin_text",
      "label": "Admin text",
      "default": "Are you the owner?"
    },
    {
      "type": "text",
      "id": "admin_link",
      "label": "Admin link",
      "default": "Log in here"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "midnight"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    }
  ]
}
{% endschema %}
