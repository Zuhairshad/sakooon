{%- liquid
  assign s = section.settings
  assign sid = 'snrt-' | append: section.id
-%}
<section id="{{ sid }}" class="sn-s snrt snrt--{{ s.align }}" style="{% render 'sn-vars', s: s %} --mw: {{ s.width }}px;">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    <div class="snrt__in">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="sn-eyebrow" data-r {{ block.shopify_attributes }}>{% render 'sn-phase', k: b.phase %}{{ b.text }}</p>
          {%- when 'heading' -%}
            <h2 class="sn-h sn-h--{{ b.size }}" data-sn-split {{ block.shopify_attributes }}>{{ b.heading }}{% if b.highlight != blank %} <em>{{ b.highlight }}</em>{% endif %}{% if b.after != blank %} {{ b.after }}{% endif %}</h2>
          {%- when 'text' -%}
            <div class="sn-rte snrt__text snrt__text--{{ b.size }}" data-r style="--i: 2;" {{ block.shopify_attributes }}>{{ b.text }}</div>
          {%- when 'quote' -%}
            <figure class="snrt__quote" data-r="dream" {{ block.shopify_attributes }}>
              {% render 'sn-icon', name: 'quote', class: 'icon' %}
              <blockquote class="sn-h sn-h--m">{{ b.text }}</blockquote>
              {%- if b.author != blank -%}<figcaption>{{ b.author }}</figcaption>{%- endif -%}
            </figure>
          {%- when 'signature' -%}
            <div class="snrt__sig" data-r {{ block.shopify_attributes }}>
              <svg viewBox="0 0 320 70" aria-hidden="true"><path pathLength="1" d="M8 52c18-30 34-42 40-34 8 12-20 40-8 40 14 0 26-46 40-46 10 0-4 34 6 34s18-24 26-24-2 22 8 22 16-20 26-20 0 18 10 18 14-14 22-14 2 14 10 14c12 0 30-18 44-18 10 0 8 12 18 12s24-10 52-14"/></svg>
              {%- if b.name != blank -%}<span>{{ b.name }}</span>{%- endif -%}
            </div>
          {%- when 'buttons' -%}
            <div class="snrt__btns" data-r style="--i: 3;" {{ block.shopify_attributes }}>
              {%- if b.btn1 != blank -%}<a class="sn-btn{% if b.style1 == 'gold' %} sn-btn--gold{% elsif b.style1 == 'ghost' %} sn-btn--ghost{% endif %}" href="{{ b.link1 | default: routes.all_products_collection_url }}"><span>{{ b.btn1 }}</span>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
              {%- if b.btn2 != blank -%}<a class="sn-link" href="{{ b.link2 | default: routes.all_products_collection_url }}">{{ b.btn2 }}{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}
            </div>
          {%- when 'stitch' -%}
            <div class="snrt__stitch" aria-hidden="true" {{ block.shopify_attributes }}><i></i>{% render 'sn-phase', k: 2 %}<i></i></div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
#{{ sid }} .snrt__in { display: grid; gap: 24px; max-width: var(--mw); }
#{{ sid }}.snrt--center .snrt__in { margin-inline: auto; justify-items: center; text-align: center; }
#{{ sid }}.snrt--right .snrt__in { margin-left: auto; justify-items: end; text-align: right; }
#{{ sid }} .snrt__text--l { font-size: 1.2rem; }
#{{ sid }} .snrt__text--xl { font: 300 clamp(1.5rem, 2.4vw, 2.2rem)/1.45 var(--f-head); color: var(--tx); }
#{{ sid }} .snrt__quote { display: grid; gap: 18px; justify-items: inherit; }
#{{ sid }} .snrt__quote .icon { width: 38px; height: 38px; color: var(--ac); }
#{{ sid }} .snrt__quote blockquote { font-style: italic; }
#{{ sid }} .snrt__quote figcaption { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snrt__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 8px; }
#{{ sid }} .snrt__sig { display: grid; gap: 6px; justify-items: inherit; }
#{{ sid }} .snrt__sig svg { width: 220px; height: auto; }
#{{ sid }} .snrt__sig path { fill: none; stroke: var(--ac); stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
#{{ sid }} .snrt__sig.is-in path { transition: stroke-dashoffset 2.6s cubic-bezier(.6, 0, .3, 1) .3s; stroke-dashoffset: 0; }
#{{ sid }} .snrt__sig span { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--soft); }
#{{ sid }} .snrt__stitch { display: flex; align-items: center; gap: 14px; width: min(320px, 80%); color: var(--ac); }
#{{ sid }} .snrt__stitch i { flex: 1; border-top: 1px dashed currentColor; opacity: .6; }
#{{ sid }} .snrt__stitch .sn-ph { width: 16px; height: 16px; }
</style>
{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Max width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "champagne",
          "label": "Champagne"
        },
        {
          "value": "dusk",
          "label": "Dusk (night)"
        },
        {
          "value": "midnight",
          "label": "Midnight (night)"
        }
      ],
      "default": "linen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Custom accent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Top edge",
      "options": [
        {
          "value": "none",
          "label": "Straight"
        },
        {
          "value": "wave",
          "label": "Soft silk wave"
        },
        {
          "value": "stitch",
          "label": "Stitched seam"
        }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Small heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Our philosophy"
        },
        {
          "type": "range",
          "id": "phase",
          "label": "Moon phase",
          "min": 0,
          "max": 4,
          "step": 1,
          "default": 2
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Rest is not a luxury,"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Italic part",
          "default": "it is a ritual"
        },
        {
          "type": "text",
          "id": "after",
          "label": "Text after italic"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "s",
              "label": "Small"
            },
            {
              "value": "m",
              "label": "Medium"
            },
            {
              "value": "l",
              "label": "Large"
            },
            {
              "value": "xl",
              "label": "Extra large"
            },
            {
              "value": "xxl",
              "label": "Huge"
            }
          ],
          "default": "l"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We weave every Sakooon sheet from long-staple cotton and finish it by hand, so the first night feels like the hundredth.</p>"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "m",
              "label": "Normal"
            },
            {
              "value": "l",
              "label": "Large"
            },
            {
              "value": "xl",
              "label": "Editorial (serif)"
            }
          ],
          "default": "l"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "The softest sheets I have owned. I sleep through the night now."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Ayesha, Lahore"
        }
      ]
    },
    {
      "type": "signature",
      "name": "Signature",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name under signature",
          "default": "Founder, Sakooon"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "text",
          "id": "btn1",
          "label": "Button",
          "default": "Explore the collection"
        },
        {
          "type": "url",
          "id": "link1",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style1",
          "label": "Button style",
          "options": [
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "gold",
              "label": "Gold"
            },
            {
              "value": "ghost",
              "label": "Outline"
            }
          ],
          "default": "dark"
        },
        {
          "type": "text",
          "id": "btn2",
          "label": "Text link",
          "default": "Our story"
        },
        {
          "type": "url",
          "id": "link2",
          "label": "Text link URL"
        }
      ]
    },
    {
      "type": "stitch",
      "name": "Stitched divider",
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
