{%- liquid
  assign s = section.settings
  assign sid = 'snrc-' | append: section.id
  assign list = nil
  if s.source == 'related' or s.source == 'complementary'
    if recommendations.performed and recommendations.products_count > 0
      assign list = recommendations.products
    endif
  elsif s.source == 'collection'
    assign list = s.collection.products
    if s.collection == blank
      assign list = collections.all.products
    endif
  endif
  assign pid = product.id | default: ''
-%}
<section id="{{ sid }}" class="sn-s snrc snrc--{{ s.source }}" style="{% render 'sn-vars', s: s %}"
  data-src="{{ s.source }}" data-limit="{{ s.limit }}"
  {% if s.source == 'related' or s.source == 'complementary' %}data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ pid }}&limit={{ s.limit }}&intent={{ s.source }}"{% endif %}
  {% if s.source == 'recent' %}data-current="{{ product.handle }}"{% endif %}>
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap" data-sn-railwrap>
    <div class="snrc__head">
      {% render 'sn-head', s: s, k: 2 %}
      {%- if s.layout == 'rail' -%}<div class="sn-rail-nav"><button type="button" class="sn-ibtn" data-sn-prev aria-label="Previous">{% render 'sn-icon', name: 'arrow-left', class: 'icon' %}</button><button type="button" class="sn-ibtn" data-sn-next aria-label="Next">{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</button></div>{%- endif -%}
    </div>
    <div class="snrc__out{% if s.layout == 'rail' %} sn-rail{% else %} sn-grid{% endif %}" {% if s.layout == 'rail' %}data-sn-rail style="--col: {{ s.card_w }}px;"{% else %}style="--cols: {{ s.columns }};"{% endif %} data-snrc-out>
      {%- if list -%}
        {%- for p in list limit: s.limit -%}
          {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
          {% render 'sn-card', product: p, i: forloop.index0, sizes: '(min-width: 990px) 25vw, 60vw' %}
        {%- endfor -%}
      {%- elsif s.source != 'recent' -%}
        {%- for i in (1..4) -%}<div class="snrc__sk" aria-hidden="true"><i></i><b></b><b></b></div>{%- endfor -%}
      {%- endif -%}
    </div>
    {%- if s.layout == 'rail' -%}<div class="sn-progress snrc__prog"><i data-sn-prog></i></div>{%- endif -%}
    {%- if s.source == 'recent' -%}<p class="snrc__empty sn-small" data-snrc-empty hidden>{{ s.empty_text }}</p>{%- endif -%}
  </div>
</section>
<style>
#{{ sid }}[data-hide] { display: none; }
#{{ sid }} .snrc__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(30px, 4vw, 54px); }
#{{ sid }} .snrc__head .sn-head { margin: 0; }
#{{ sid }} .snrc__prog { margin-top: 26px; }
#{{ sid }} .snrc__sk { display: grid; gap: 12px; }
#{{ sid }} .snrc__sk i { aspect-ratio: var(--ratio, 4 / 5); border-radius: var(--r); background: linear-gradient(100deg, var(--card2) 40%, color-mix(in srgb, var(--card2) 50%, #fff) 50%, var(--card2) 60%) 0 0 / 300% 100%; animation: snrc-sh 1.6s linear infinite; }
#{{ sid }} .snrc__sk b { height: 12px; width: 70%; border-radius: 6px; background: var(--card2); }
#{{ sid }} .snrc__sk b + b { width: 40%; }
@keyframes snrc-sh { to { background-position: -150% 0; } }
@media (max-width: 749px) { #{{ sid }} .snrc__head .sn-rail-nav { display: none; } #{{ sid }} .sn-rail { --col: 64vw !important; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var out = r.querySelector('[data-snrc-out]'), src = r.getAttribute('data-src');
  function done() { SN.reveal(out); SN.rail(r); SN.wish.paint(); }
  SN.ready(function () {
    if (src === 'recent') {
      var cur = r.getAttribute('data-current'), list = SN.recent.get().filter(function (h) { return h && h !== cur; }).slice(0, +r.getAttribute('data-limit') || 8);
      if (!list.length) { if (window.Shopify && Shopify.designMode) { r.querySelector('[data-snrc-empty]').hidden = false; } else r.setAttribute('data-hide', ''); return; }
      Promise.all(list.map(function (h) { return SN.product(h).catch(function () { return null; }); })).then(function (ps) {
        out.innerHTML = ps.filter(Boolean).map(SN.cardHTML).join(''); [].forEach.call(out.children, function (c, i) { c.setAttribute('data-r', ''); c.style.setProperty('--i', i); }); done();
      });
      return;
    }
    var url = r.getAttribute('data-url');
    if (!url || r.querySelector('.sn-card')) return;
    if (url.indexOf('product_id=&') > -1) return;
    fetch(url).then(function (x) { return x.text(); }).then(function (h) {
      var d = new DOMParser().parseFromString(h, 'text/html'), f = d.querySelector('[data-snrc-out]');
      if (f && f.querySelector('.sn-card')) { out.innerHTML = f.innerHTML; done(); } else r.setAttribute('data-hide', '');
    }).catch(function () { r.setAttribute('data-hide', ''); });
  });
})();
</script>
{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Products",
