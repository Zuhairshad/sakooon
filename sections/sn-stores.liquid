{%- liquid
  assign s = section.settings
  assign sid = 'snsr-' | append: section.id
  assign first = section.blocks.first.settings
-%}
<section id="{{ sid }}" class="sn-s snsr" style="{% render 'sn-vars', s: s %}">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 1 %}
    <div class="snsr__grid">
      <ul class="snsr__list" role="tablist">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li role="presentation" data-r="left" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <div tabindex="0" class="snsr__store sn-pillow{% if forloop.first %} is-on{% endif %}" data-snsr="{{ b.map | default: b.address | url_encode }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="snsr__city">{{ b.city }}</span>
              <span class="snsr__name sn-h sn-h--xs">{{ b.name }}</span>
              <span class="snsr__addr">{% render 'sn-icon', name: 'map-pin', class: 'icon' %}{{ b.address }}</span>
              {%- if b.hours != blank -%}<span class="snsr__hrs">{% render 'sn-icon', name: 'clock', class: 'icon' %}{{ b.hours }}</span>{%- endif -%}
              <span class="snsr__acts">
                <a class="sn-link" href="https://www.google.com/maps/dir/?api=1&destination={{ b.map | default: b.address | url_encode }}" target="_blank" rel="noopener">{{ s.dir_label }}{% render 'sn-icon', name: 'arrow-up-right', class: 'icon' %}</a>
                {%- if b.phone != blank -%}<a class="sn-link" href="tel:{{ b.phone | remove: ' ' }}">{{ b.phone }}</a>{%- endif -%}
              </span>
              <i class="snsr__pin" aria-hidden="true"></i>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="snsr__map" data-r="zoom">
        {%- if section.blocks.size > 0 -%}
          {%- assign q = first.map | default: first.address -%}
          <iframe data-snsr-frame title="{{ s.heading | escape }}" loading="lazy" src="https://maps.google.com/maps?q={{ q | url_encode }}&z=14&output=embed"></iframe>
        {%- endif -%}
        <div class="snsr__glow" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }} .snsr__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(18px, 2.6vw, 34px); align-items: stretch; }
#{{ sid }} .snsr__list { display: grid; gap: 12px; align-content: start; }
#{{ sid }} .snsr__store { cursor: pointer; position: relative; display: grid; gap: 8px; width: 100%; padding: 22px 24px; text-align: left; border: 1px solid transparent; transition: border-color .4s, transform .6s cubic-bezier(.3, 1.2, .4, 1), box-shadow .5s, background .5s; }
#{{ sid }} .snsr__store:hover { transform: translateX(6px); }
#{{ sid }} .snsr__store.is-on { border-color: var(--ac); box-shadow: 0 30px 60px -40px rgba(20, 22, 40, .45); background: color-mix(in srgb, var(--ac) 7%, var(--card)); }
#{{ sid }} .snsr__city { font-size: 11px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--ac-aa, var(--ac)); }
#{{ sid }} .snsr__addr, #{{ sid }} .snsr__hrs { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--soft); }
#{{ sid }} .snsr__addr .icon, #{{ sid }} .snsr__hrs .icon { width: 16px; height: 16px; flex: none; margin-top: 3px; color: var(--ac); }
#{{ sid }} .snsr__acts { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 6px; }
#{{ sid }} .snsr__pin { position: absolute; right: 22px; top: 22px; width: 12px; height: 12px; border-radius: 50%; background: var(--line2); transition: background .4s, box-shadow .4s; }
#{{ sid }} .snsr__store.is-on .snsr__pin { background: var(--ac); animation: sngl-ping2 2s infinite; }
@keyframes sngl-ping2 { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ac) 60%, transparent); } 70% { box-shadow: 0 0 0 12px transparent; } }
#{{ sid }} .snsr__map { position: relative; min-height: 420px; border-radius: calc(var(--r) * 1.2); overflow: hidden; background: var(--card2); }
#{{ sid }} .snsr__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(.5) sepia(.15) contrast(.95); transition: opacity .5s, filter .6s; }
#{{ sid }} .snsr__map.is-loading iframe { opacity: .2; filter: blur(4px); }
#{{ sid }} .snsr__glow { position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 0 1px var(--line), inset 0 0 80px color-mix(in srgb, var(--bg) 60%, transparent); border-radius: inherit; }
@media (max-width: 899px) { #{{ sid }} .snsr__grid { grid-template-columns: 1fr; } #{{ sid }} .snsr__map { min-height: 300px; } }
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  var f = r.querySelector('[data-snsr-frame]'), m = r.querySelector('.snsr__map'), bs = [].slice.call(r.querySelectorAll('[data-snsr]'));
  function pick(b) {
    bs.forEach(function (x) { x.classList.toggle('is-on', x === b); x.setAttribute('aria-selected', x === b); });
    if (!f) return; m.classList.add('is-loading'); f.onload = function () { m.classList.remove('is-loading'); };
    f.src = 'https://maps.google.com/maps?q=' + b.getAttribute('data-snsr') + '&z=14&output=embed';
  }
  bs.forEach(function (b) { b.addEventListener('click', function (e) { if (e.target.closest('a')) return; pick(b); }); b.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(b); } }); });
  document.addEventListener('shopify:block:select', function (e) { var b = e.target.querySelector && e.target.querySelector('[data-snsr]'); if (b && r.contains(b)) pick(b); });
})();
</script>
