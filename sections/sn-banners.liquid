{%- liquid
  assign s = section.settings
  assign sid = 'snbn-' | append: section.id
  assign n = section.blocks.size
-%}
<section id="{{ sid }}" class="sn-s snbn snbn--{{ s.layout }}" style="{% render 'sn-vars', s: s %} --n: {{ n }};">
  {% render 'sn-divider', s: s %}
  <div class="sn-wrap">
    {% render 'sn-head', s: s, k: 2 %}
    <div class="snbn__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="snbn__tile snbn__tile--{{ b.text_pos }}{% if b.dark_text %} is-darktx{% endif %}" href="{{ b.link | default: routes.all_products_collection_url }}" data-r="rise" data-tilt style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="snbn__media">
            {% render 'sn-media', image: b.image, art: b.art, width: 1400, sizes: '(min-width: 990px) 50vw, 100vw', class: 'snbn__m sn-ripple' %}
          </div>
          <span class="snbn__shine" aria-hidden="true"></span>
          <div class="snbn__copy">
            {%- if b.tag != blank -%}<span class="snbn__tag">{{ b.tag }}</span>{%- endif -%}
            <h3 class="sn-h sn-h--m">{{ b.title }}{% if b.highlight != blank %} <em>{{ b.highlight }}</em>{% endif %}</h3>
            {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
            {%- if b.btn != blank -%}<span class="snbn__btn"><span>{{ b.btn }}</span><i>{% render 'sn-icon', name: 'arrow-right', class: 'icon' %}</i></span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
#{{ sid }} .snbn__grid { display: grid; grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr)); gap: clamp(14px, 2vw, 26px); perspective: 1400px; }
#{{ sid }}.snbn--hero .snbn__grid { grid-template-columns: 1.4fr 1fr; grid-auto-rows: minmax(0, 1fr); }
#{{ sid }}.snbn--hero .snbn__tile:first-child { grid-row: span 2; }
#{{ sid }} .snbn__tile { position: relative; isolation: isolate; display: grid; min-height: {{ s.height }}px; border-radius: calc(var(--r) * 1.2); overflow: hidden; color: #fff; transform-style: preserve-3d; transition: transform .6s cubic-bezier(.2, .8, .2, 1), box-shadow .6s; }
#{{ sid }}.snbn--hero .snbn__tile:not(:first-child) { min-height: calc({{ s.height }}px * .5 - 13px); }
#{{ sid }} .snbn__tile:hover { box-shadow: 0 50px 80px -50px rgba(20, 22, 40, .7); }
#{{ sid }} .snbn__media { position: absolute; inset: 0; z-index: -2; }
#{{ sid }} .snbn__m { position: absolute; inset: 0; border-radius: 0; }
#{{ sid }} .snbn__tile:hover .snbn__m img, #{{ sid }} .snbn__tile:hover .snbn__m .sn-art { transform: scale(1.06); }
#{{ sid }} .snbn__tile::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, color-mix(in srgb, {{ settings.color_dark_bg }} {{ s.shade }}%, transparent), transparent 70%); transition: opacity .5s; }
#{{ sid }} .snbn__tile.is-darktx { color: var(--c-ink); }
#{{ sid }} .snbn__tile.is-darktx::before { background: linear-gradient(0deg, color-mix(in srgb, #fff {{ s.shade }}%, transparent), transparent 70%); }
#{{ sid }} .snbn__shine { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(circle at var(--sx, 50%) var(--sy, 50%), rgba(255, 255, 255, .28), transparent 42%); opacity: 0; transition: opacity .5s; mix-blend-mode: soft-light; }
#{{ sid }} .snbn__tile:hover .snbn__shine { opacity: 1; }
#{{ sid }} .snbn__copy { position: relative; z-index: 2; align-self: end; display: grid; gap: 10px; justify-items: start; padding: clamp(22px, 3vw, 40px); transform: translateZ(40px); }
#{{ sid }} .snbn__tile--top .snbn__copy { align-self: start; }
#{{ sid }} .snbn__tile--center .snbn__copy { align-self: center; justify-items: center; text-align: center; }
#{{ sid }} .snbn__copy p { max-width: 40ch; opacity: .86; font-size: 15px; }
#{{ sid }} .snbn__copy em { color: var(--c-moon); }
#{{ sid }} .is-darktx .snbn__copy em { color: var(--c-accent); }
#{{ sid }} .snbn__tag { padding: 6px 12px; border-radius: 999px; background: color-mix(in srgb, #fff 18%, transparent); border: 1px solid rgba(255,255,255,.35); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); font-size: 10.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
#{{ sid }} .is-darktx .snbn__tag { background: rgba(255,255,255,.6); border-color: transparent; }
#{{ sid }} .snbn__btn { display: inline-flex; align-items: center; gap: 12px; margin-top: 8px; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
#{{ sid }} .snbn__btn i { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 1px solid currentColor; transition: background .4s, color .4s, border-color .4s, width .6s cubic-bezier(.3, 1.2, .4, 1); }
#{{ sid }} .snbn__btn .icon { width: 16px; height: 16px; }
#{{ sid }} .snbn__tile:hover .snbn__btn i { width: 64px; border-radius: 999px; background: var(--c-moon); border-color: var(--c-moon); color: var(--c-dark); }
@media (max-width: 899px) {
  #{{ sid }} .snbn__grid, #{{ sid }}.snbn--hero .snbn__grid { grid-template-columns: 1fr; }
  #{{ sid }}.snbn--hero .snbn__tile:first-child { grid-row: auto; }
  #{{ sid }} .snbn__tile, #{{ sid }}.snbn--hero .snbn__tile:not(:first-child) { min-height: calc({{ s.height }}px * .62); }
}
</style>
<script>
(function () {
  var r = document.getElementById('{{ sid }}'); if (!r || r.dataset.on) return; r.dataset.on = 1;
  if (!matchMedia('(hover: hover)').matches || document.body.getAttribute('data-motion') === 'off') return;
  [].forEach.call(r.querySelectorAll('[data-tilt]'), function (t) {
    t.addEventListener('pointermove', function (e) { var b = t.getBoundingClientRect(), x = (e.clientX - b.left) / b.width, y = (e.clientY - b.top) / b.height; t.style.transform = 'rotateY(' + ((x - .5) * {{ s.tilt }}).toFixed(2) + 'deg) rotateX(' + ((.5 - y) * {{ s.tilt }}).toFixed(2) + 'deg)'; t.style.setProperty('--sx', (x * 100).toFixed(1) + '%'); t.style.setProperty('--sy', (y * 100).toFixed(1) + '%'); });
    t.addEventListener('pointerleave', function () { t.style.transform = ''; });
  });
})();
</script>
