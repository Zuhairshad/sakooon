      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.body.header"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.settings.type_body_font.label",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "body_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "t:settings_schema.typography.settings.body_size.label",
        "default": 14
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.body_scale.label",
        "default": 100
