<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_schemes.paper.settings.background | default: '#F6F4F0' }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" href="data:,">{%- comment -%} no favicon set: suppress the browser's /favicon.ico request {%- endcomment -%}
  {%- endif -%}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  <title>
    {{ page_title -}}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  {%- unless settings.type_heading_font.system? -%}{{ settings.type_heading_font | font_url | preload_tag: as: 'font' }}{%- endunless -%}
  {%- unless settings.type_body_font.system? or settings.type_body_font == settings.type_heading_font -%}{{ settings.type_body_font | font_url | preload_tag: as: 'font' }}{%- endunless -%}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {%- comment -%} Area stylesheets: each owner's single stylesheet. Loaded here once so sections never duplicate. {%- endcomment -%}
  {{ 'storefront.css' | asset_url | stylesheet_tag }}
  {{ 'commerce.css' | asset_url | stylesheet_tag }}
  {{ 'editorial.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  {%- if template.name == 'product' or template.name == 'collection' or template.name == 'search' or template.name == 'cart' or settings.cart_type == 'drawer' -%}
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  {%- if template.name == 'product' -%}<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  {%- if template.name == 'collection' or template.name == 'search' -%}<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  {%- if settings.predictive_search_enabled -%}<script src="{{ 'search.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'editorial.js' | asset_url }}" defer="defer"></script>
  <script>
    window.theme = window.theme || {};
    window.theme.routes = {
      root: '{{ routes.root_url }}',
      cart: '{{ routes.cart_url }}',
      cartAdd: '{{ routes.cart_add_url }}',
      cartChange: '{{ routes.cart_change_url }}',
      cartUpdate: '{{ routes.cart_update_url }}',
      predictiveSearch: '{{ routes.predictive_search_url }}',
      search: '{{ routes.search_url }}',
      productRecommendations: '{{ routes.product_recommendations_url }}'
    };
    window.theme.moneyFormat = {{ shop.money_format | json }};
    window.theme.moneyWithCurrencyFormat = {{ shop.money_with_currency_format | json }};
    window.theme.settings = { cartType: {{ settings.cart_type | json }}, reveal: {{ settings.animations_reveal | json }} };
    window.theme.strings = {
      addToCart: {{ 'products.product.add_to_cart' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      unavailable: {{ 'products.product.unavailable' | t | json }},
      unavailableWithOption: {{ 'products.product.value_unavailable' | t: option_value: '[value]' | json }},
      soldOutWithOption: {{ 'products.product.value_sold_out' | t: option_value: '[value]' | json }},
      cartError: {{ 'sections.cart.cart_error' | t | json }},
      quantityError: {{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' | json }},
      itemAdded: {{ 'general.cart.item_added' | t | json }},
      loading: {{ 'general.accessibility.loading' | t | json }},
      close: {{ 'general.accessibility.close' | t | json }},
      searchNoResults: {{ 'general.search.no_results' | t: terms: '[terms]' | json }},
      searchResults: {{ 'general.search.results_with_count' | t: count: '[count]', terms: '[terms]' | json }},
      searchError: {{ 'general.search.error' | t | json }},
      cartUpdated: {{ 'sections.cart.updated' | t | json }},
      shareSuccess: {{ 'general.share.success_message' | t | json }}
    };
  </script>
  {{ content_for_header }}
  {% render 'structured-data' %}
</head>
<body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}--{{ template.suffix | handle }}{% endif %} color-scheme-paper{% if settings.focus_ring_visible_always %} focus-always{% endif %}">
  {% render 'skip-link' %}
  {% sections 'header-group' %}
  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  <div class="visually-hidden" aria-live="polite" aria-atomic="true" id="LiveRegion" data-live-region></div>
</body>
</html>
